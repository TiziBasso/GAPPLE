@page "/orden/creacion"

@inject ProductosService ProductosService
@inject OrdenesService OrdenesService
@inject ClientesService ClientesService
@inject OfertasService OfertasService
@inject NotificationService NotificationService
@inject DialogService DialogService
@inject DialogCustom DialogCustom
@using System.Linq

@if (showForm)
{
    <RadzenTemplateForm Data="orden" TItem="Orden" Submit="Guardar" EditContext="editContext">
        <DataAnnotationsValidator />
        <CustomValidation @ref="customValidation" />

        <RadzenRow Style="margin-top:10px;">
            <RadzenColumn Size="4">
                <RadzenStack Orientation="Orientation.Vertical" Gap="0">
                    <RadzenLabel Text="Línea:" />
                    <RadzenDropDown Data="lstLineas" @bind-Value="valorAux" Change="BuscarProductos" />
                    <ValidationMessage For="@(() => orden.Linea)" />
                </RadzenStack>
            </RadzenColumn>

            <RadzenColumn Size="4">
                <RadzenStack Orientation="Orientation.Vertical" Gap="0">
                    <RadzenLabel Text="Cliente:" />
                    <RadzenDropDownDataGrid Data="clientes" @bind-Value="orden.CodCliente" TextProperty="@nameof(Cliente.RazonSocial)" ValueProperty="@nameof(Cliente.CodigoCliente)"
                                            AllowVirtualization="true" Change="AsignarVariables" Name="clientes">
                        <Columns>
                            <RadzenDropDownDataGridColumn Property="@nameof(Cliente.CodigoCliente)" Title="Código"></RadzenDropDownDataGridColumn>
                            <RadzenDropDownDataGridColumn Property="@nameof(Cliente.RazonSocial)" Title="Razón Social"></RadzenDropDownDataGridColumn>
                        </Columns>
                    </RadzenDropDownDataGrid>
                    <ValidationMessage For="@(() => orden.CodCliente)" />
                </RadzenStack>
            </RadzenColumn>
            <RadzenColumn Size="4">
                <RadzenStack Orientation="Orientation.Vertical" Gap="0">
                    <RadzenLabel Text="Zona:" />
                    <RadzenDropDownDataGrid Data="zonas" Disabled="true" @bind-Value="orden.Zona" TextProperty="@nameof(Zonas.Descripcion)" ValueProperty="@nameof(Zonas.CodigoTango)" AllowVirtualization="true">
                        <Columns>
                            <RadzenDropDownDataGridColumn Property="@nameof(Zonas.CodigoTango)" Title="Código"></RadzenDropDownDataGridColumn>
                            <RadzenDropDownDataGridColumn Property="@nameof(Zonas.Descripcion)" Title="Descripción"></RadzenDropDownDataGridColumn>
                        </Columns>
                    </RadzenDropDownDataGrid>
                    <ValidationMessage For="@(() => orden.Zona)" />
                </RadzenStack>
            </RadzenColumn>
        </RadzenRow>

        <RadzenRow Style="margin-top:10px;">
            <RadzenColumn Size="4">
                <RadzenStack Orientation="Orientation.Vertical" Gap="0">
                    <RadzenLabel Text="Entregar en:" />
                    <RadzenTextBox @bind-Value="orden.Entrega" />
                    <ValidationMessage For="@(() => orden.Entrega)" />
                </RadzenStack>
            </RadzenColumn>

            <RadzenColumn Size="4">
                <RadzenStack Orientation="Orientation.Vertical" Gap="0">
                    <RadzenLabel Text="Lista de precios:" />
                    <RadzenDropDownDataGrid Data="listasDePrecio" @bind-Value="orden.CodListaPrecio" Disabled="true" TextProperty="@nameof(ListaDePrecios.Descripcion)" ValueProperty="@nameof(ListaDePrecios.CodigoTango)" AllowVirtualization="true">
                        <Columns>
                            <RadzenDropDownDataGridColumn Property="@nameof(ListaDePrecios.CodigoTango)" Title="Código"></RadzenDropDownDataGridColumn>
                            <RadzenDropDownDataGridColumn Property="@nameof(ListaDePrecios.Descripcion)" Title="Descripción"></RadzenDropDownDataGridColumn>
                        </Columns>
                    </RadzenDropDownDataGrid>
                    <ValidationMessage For="@(() => orden.CodListaPrecio)" />
                </RadzenStack>
            </RadzenColumn>

            <RadzenColumn Size="4">
                <RadzenStack Orientation="Orientation.Vertical" Gap="0">
                    <RadzenLabel Text="Cond.Venta:" />
                    <RadzenDropDownDataGrid Data="condicionesDeVenta" @bind-Value="orden.CondicionVenta" TextProperty="@nameof(CondicionDeVenta.Descripcion)" ValueProperty="@nameof(CondicionDeVenta.CodigoTango)" AllowVirtualization="true">
                        <Columns>
                            <RadzenDropDownDataGridColumn Property="@nameof(CondicionDeVenta.CodigoTango)" Title="Código"></RadzenDropDownDataGridColumn>
                            <RadzenDropDownDataGridColumn Property="@nameof(CondicionDeVenta.Descripcion)" Title="Descripción"></RadzenDropDownDataGridColumn>
                        </Columns>
                    </RadzenDropDownDataGrid>
                    <ValidationMessage For="@(() => orden.CondicionVenta)" />
                </RadzenStack>
            </RadzenColumn>
        </RadzenRow>

        <RadzenRow Style="margin-top:10px;">
            <RadzenColumn Size="3">
                <RadzenStack Orientation="Orientation.Vertical" Gap="0">
                    <RadzenLabel Text="F.Entrega:" />
                    <RadzenDatePicker @bind-Value="orden.FechaEntrega" DateFormat="dd/MM/yyyy" />
                </RadzenStack>
                <ValidationMessage For="@(() => orden.FechaEntrega)" />
            </RadzenColumn>

            <RadzenColumn Size="4">
                <RadzenStack Orientation="Orientation.Vertical" Gap="0">
                    <RadzenLabel Text="Transporte:" />
                    <RadzenDropDownDataGrid Data="transportes" @bind-Value="orden.CodTransporte" TextProperty="@nameof(Transporte.Descripcion)" ValueProperty="@nameof(Transporte.CodigoTango)" AllowVirtualization="true">
                        <Columns>
                            <RadzenDropDownDataGridColumn Property="@nameof(Transporte.CodigoTango)" Title="Código"></RadzenDropDownDataGridColumn>
                            <RadzenDropDownDataGridColumn Property="@nameof(Transporte.Descripcion)" Title="Descripción"></RadzenDropDownDataGridColumn>
                        </Columns>
                    </RadzenDropDownDataGrid>
                </RadzenStack>
            </RadzenColumn>

            <RadzenColumn Size="5">
                <RadzenStack Orientation="Orientation.Horizontal">
                    <RadzenStack Orientation="Orientation.Vertical" Gap="5px">
                        <RadzenStack Orientation="Orientation.Horizontal" Gap="0">
                            <RadzenLabel Text="Probadores:" />
                            <RadzenCheckBox @bind-Value="@orden.Probadores" />
                        </RadzenStack>
                        <RadzenStack Orientation="Orientation.Horizontal" Gap="0">
                            <RadzenLabel Text="Obsequios/CartasColores/Desc.Extra:" />
                            <RadzenCheckBox @bind-Value="@orden.Obsequios" />
                        </RadzenStack>
                        <RadzenStack Orientation="Orientation.Horizontal" Gap="0">
                            <RadzenLabel Text="Multitester/Exhibidor:" />
                            <RadzenCheckBox @bind-Value="@orden.Exhibidor" />
                        </RadzenStack>
                    </RadzenStack>
                    <RadzenStack Orientation="Orientation.Vertical">
                        <RadzenStack Orientation="Orientation.Horizontal" Gap="0">
                            <RadzenLabel Text="F:" />
                            <RadzenCheckBox @bind-Value="@orden.Factura" />
                        </RadzenStack>
                        <RadzenStack Orientation="Orientation.Horizontal" Gap="0">
                            <RadzenLabel Text="P:" />
                            <RadzenCheckBox @bind-Value="@orden.Presupuesto" />
                        </RadzenStack>
                    </RadzenStack>
                </RadzenStack>
            </RadzenColumn>
        </RadzenRow>


        <RadzenRow Style="margin-top:10px;">
            <RadzenColumn Size="4">
                <RadzenStack Orientation="Orientation.Vertical" Gap="0">
                    <RadzenLabel Text="Notas:" />
                    <RadzenTextArea @bind-Value="orden.Notas" />
                </RadzenStack>
            </RadzenColumn>

            <RadzenColumn Size="4">
                <RadzenStack Orientation="Orientation.Vertical" Gap="0">
                    <RadzenLabel Text="Ofertas:" />
                    <RadzenDropDown AllowFiltering="true" AllowVirtualization="true" Data="ofertas" @bind-Value="orden.Ofertas" Change="RecalcularOfertas"
                                    TextProperty="@nameof(Oferta.Descripcion)" ValueProperty="@nameof(Oferta.IdOferta)" Multiple="true" AllowClear="true"
                                    Placeholder="Seleccionar ofertas..." MaxSelectedLabels="2" SelectAllText="Todas" SelectedItemsText="seleccionadas" />
                </RadzenStack>
            </RadzenColumn>
        </RadzenRow>

        @if (lstProductos != null && lstProductos.Any())
        {
            <RadzenRow Style="margin-top:10px;">
                <RadzenColumn Size="12">
                    <RadzenFieldset Text="Selección de productos">
                        <ValidationMessage For="@(() => orden.Detalle)" />
                        <div class="cards-container">
                            @foreach (var card in Cards)
                            {
                                <div class="card">
                                    <h6 style="text-align:center;">@card.FamilyName</h6>
                                    @foreach (var product in card.Products)
                                    {
                                        <div class="product">
                                            <label style="width:60px;">@product.CodigoProducto</label>
                                            <input id="input-@product.CodigoProducto" type="text" data-code="@product.CodigoProducto" class="product-input" @bind-value="product.CantidadSeleccionada" />
                                            @if (codigosEnOfertas != null && codigosEnOfertas.Any() && codigosEnOfertas.ContainsKey(product.CodigoProducto))
                                            {
                                                codigosEnOfertas.TryGetValue(product.CodigoProducto, out var ofertasDondeSeEncuentra);
                                                var ofertaConDescuentoMasAlto = ofertasDondeSeEncuentra.OrderByDescending(o => o.Descuento).FirstOrDefault();
                                                var descuentoFinal = 100 * (1 - (1 - ofertaConDescuentoMasAlto.Descuento / 100) * (1 - (articulosPorClientes.Exists(x => x.CodProducto == product.CodigoProducto) ? articulosPorClientes.Find(x => x.CodProducto == product.CodigoProducto).Descuento : 0) / 100));
                                                product.DescuentoFinal = Math.Round(descuentoFinal, 2);
                                                <div style="background:yellow;">
                                                    <span>@Math.Round(descuentoFinal, 2)</span>
                                                    <strong>%</strong>
                                                </div>
                                            }
                                            else
                                            {
                                                @if (articulosPorClientes.Any() && articulosPorClientes.Exists(x => x.CodProducto == product.CodigoProducto))
                                                {
                                                    <span>@articulosPorClientes.Find(x => x.CodProducto == product.CodigoProducto).Descuento</span>
                                                    product.DescuentoFinal = articulosPorClientes.Find(x => x.CodProducto == product.CodigoProducto).Descuento;
                                                }
                                                else
                                                {
                                                    <span>0</span>
                                                }
                                                <strong>%</strong>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </RadzenFieldset>
                </RadzenColumn>
            </RadzenRow>
        }

        <RadzenRow Style="margin-top:10px;" JustifyContent="JustifyContent.Center">
            <RadzenStack JustifyContent="JustifyContent.Center">
                <RadzenButton ButtonStyle="ButtonStyle.Success" ButtonType="ButtonType.Submit" Text="Guardar" Style="width:fit-content;" />
            </RadzenStack>
        </RadzenRow>
    </RadzenTemplateForm>
}
else
{
    <Loader />
}

<script>
    document.addEventListener('keydown', function (event) {
        if (event.target.classList.contains('product-input')) {
            const currentInput = event.target;
            const inputs = Array.from(document.querySelectorAll('.product-input'));
            const currentCard = currentInput.closest('.card');
            const allCards = Array.from(document.querySelectorAll('.card'));
            const inputsInCurrentCard = Array.from(currentCard.querySelectorAll('.product-input'));

            const inputIndexInCard = inputsInCurrentCard.findIndex(input => input === currentInput);
            const currentCardRect = currentCard.getBoundingClientRect();

            // Manejo de teclas
            if (event.key === 'ArrowUp') {
                if (inputIndexInCard > 0) {
                    inputsInCurrentCard[inputIndexInCard - 1].focus();
                    setTimeout(() => inputsInCurrentCard[inputIndexInCard - 1].select(), 0);
                } else {
                    const targetCard = findCardAbove(allCards, currentCardRect);
                    if (targetCard) {
                        const targetInputs = targetCard.querySelectorAll('.product-input');
                        const targetInput = targetInputs[targetInputs.length - 1];
                        targetInput.focus();
                        setTimeout(() => targetInput.select(), 0);
                    }
                }
            } else if (event.key === 'ArrowDown') {
                if (inputIndexInCard < inputsInCurrentCard.length - 1) {
                    inputsInCurrentCard[inputIndexInCard + 1].focus();
                    setTimeout(() => inputsInCurrentCard[inputIndexInCard + 1].select(), 0);
                } else {
                    const targetCard = findCardBelow(allCards, currentCardRect);
                    if (targetCard) {
                        const targetInputs = targetCard.querySelectorAll('.product-input');
                        const targetInput = targetInputs[0];
                        targetInput.focus();
                        setTimeout(() => targetInput.select(), 0);
                    }
                }
            } else if (event.key === 'ArrowLeft') {
                const currentCardIndex = allCards.findIndex(card => card === currentCard);
                if (currentCardIndex > 0) {
                    const previousCard = allCards[currentCardIndex - 1];
                    const inputsInPreviousCard = previousCard.querySelectorAll('.product-input');
                    const targetInput = inputsInPreviousCard[inputIndexInCard] || inputsInPreviousCard[inputsInPreviousCard.length - 1];
                    targetInput.focus();
                    setTimeout(() => targetInput.select(), 0);
                }
            } else if (event.key === 'ArrowRight') {
                const currentCardIndex = allCards.findIndex(card => card === currentCard);
                if (currentCardIndex < allCards.length - 1) {
                    const nextCard = allCards[currentCardIndex + 1];
                    const inputsInNextCard = nextCard.querySelectorAll('.product-input');
                    const targetInput = inputsInNextCard[inputIndexInCard] || inputsInNextCard[inputsInNextCard.length - 1];
                    targetInput.focus();
                    setTimeout(() => targetInput.select(), 0);
                }
            }
        }
    });


    // Función para encontrar la tarjeta en la fila superior
    function findCardAbove(cards, currentRect) {
        return cards.reverse().find(card => {
            const rect = card.getBoundingClientRect();
            return rect.bottom <= currentRect.top && rect.left < currentRect.right && rect.right > currentRect.left;
        });
    }

    // Función para encontrar la tarjeta en la fila inferior
    function findCardBelow(cards, currentRect) {
        return cards.find(card => {
            const rect = card.getBoundingClientRect();
            return rect.top >= currentRect.bottom && rect.left < currentRect.right && rect.right > currentRect.left;
        });
    }
</script>

@code {
    List<ProductoParaOfertas> lstProductosOferta = null;
    List<ProductoParaOfertas> lstProductos = null;
    Orden orden = new();
    List<string> lstLineas = new();
    string? valorAux;
    EditContext editContext;
    private List<Card> Cards = new();
    CustomValidation customValidation;

    bool showForm;

    List<Transporte> transportes = new();
    List<ListaDePrecios> listasDePrecio = new();
    List<CondicionDeVenta> condicionesDeVenta = new();
    List<Zonas> zonas = new();
    List<Cliente> clientes = new();
    List<Oferta> ofertas = new();
    List<ArticulosPorCliente> articulosPorClientes = new();

    Dictionary<string, List<Oferta>> codigosEnOfertas;

    protected override async Task OnInitializedAsync()
    {
        lstLineas = await ProductosService.GetLineas();
        clientes = await ClientesService.GetClientes(null, null, null, null);
        transportes = await OrdenesService.GetTransportes();
        listasDePrecio = await OrdenesService.GetListasDePrecio();
        condicionesDeVenta = await OrdenesService.GetCondicionesDeVenta();
        zonas = await OrdenesService.GetZonas();
        editContext = new(orden);
        showForm = true;
    }

    async Task BuscarProductos()
    {
        if (!orden.Detalle.Any() || (await DialogService.Confirm("Si cambia de linea todos los productos seleccionados se eliminaran ¿desea continuar?", "ATENCIÓN", new() { OkButtonText = "Sí", CancelButtonText = "No" })) == true)
        {
            showForm = false;
            orden.Linea = valorAux;
            lstProductos = await ProductosService.GetProductosParaOfertas(orden.Linea!);
            lstProductos = lstProductos.OrderBy(x => x.Familia).ToList();
            var grouped = lstProductos.GroupBy(p => p.Familia);
            Cards.Clear();
            foreach (var group in grouped)
            {
                var productChunks = group.Select((p, i) => new { Product = p, Index = i })
                                          .GroupBy(x => x.Index / 10)
                                          .Select(g => g.Select(x => x.Product).ToList());
                foreach (var chunk in productChunks)
                {
                    Cards.Add(new Card(group.Key, chunk));
                }
            }
            StateHasChanged();
            ofertas = await OfertasService.GetOfertas(null, orden.Linea, null, null, true);
            if (orden.Ofertas != null && orden.Ofertas.Any())
            {
                await RecalcularOfertas();
            }
            showForm = true;
        }
        else
            valorAux = orden.Linea;

        editContext.Validate();
    }

    async Task AsignarVariables()
    {
        DialogCustom.OpenBusyWithLoader("Cargando...");
        articulosPorClientes = await ClientesService.GetArticulosPorCliente(orden.CodCliente);
        var index = clientes.FindIndex(x => x.CodigoCliente == orden.CodCliente);
        orden.CodListaPrecio = clientes[index].CodListaPrecioDefault!;
        orden.CondicionVenta = clientes[index].CondVentaDefault;
        orden.Zona = clientes[index].ZonaDefault;
        editContext.Validate();
        DialogCustom.CloseDialog();
    }

    async Task RecalcularOfertas()
    {
        if (orden.Ofertas != null && orden.Ofertas.Any())
        {
            var ofertasFiltradas = ofertas.Where(o => orden.Ofertas!.Contains(o.IdOferta));

            codigosEnOfertas = ofertasFiltradas
                .SelectMany(o => o.Inclusiones.Split('|').Select(codigo => new { CodigoProducto = codigo, Oferta = o }))
                .GroupBy(x => x.CodigoProducto)
                .ToDictionary(g => g.Key, g => g.Select(x => x.Oferta).ToList());
        }
        else
        {
            codigosEnOfertas.Clear();
        }
    }

    async Task Guardar()
    {
        if (orden.Factura == false && orden.Presupuesto == false)
        {
            NotificationService.Notify(NotificationSeverity.Info, "Debe ingrear al menos 1 tipo de pedido");
        }
        else
        {
            bool error = false;
            foreach (var card in Cards)
            {
                if (card.Products.Exists(e => e.CantidadSeleccionada < 0))
                {
                    NotificationService.Notify(NotificationSeverity.Info, "Hay productos con cantidad negativa");
                    error = true;
                    break;
                }
            }
            if (!error)
            {
                foreach (var card in Cards)
                {
                    foreach (var product in card.Products)
                    {
                        if (product.CantidadSeleccionada > 0)
                            orden.Detalle.Add(new OrdenDetalle()
                                {
                                    Cantidad = product.CantidadSeleccionada,
                                    CodProducto = product.CodigoProducto,
                                    Descuento1 = product.DescuentoFinal
                                });
                    }
                }
            }
        }

        if (!orden.Detalle.Any())
            NotificationService.Notify(NotificationSeverity.Info, "Debe ingresar al menos 1 producto");
        else
        await OrdenesService.PostPedido(orden);
    }

    private class Card
    {
        public string FamilyName { get; }
        public List<ProductoParaOfertas> Products { get; }

        public Card(string familyName, List<ProductoParaOfertas> products)
        {
            FamilyName = familyName;
            Products = products;
        }
    }
}

<style>
    .cards-container {
        display: flex;
        flex-wrap: wrap;
        gap: 2px;
        max-height: 55vh;
        overflow-y: auto;
        overflow-x: hidden;
    }

    .card {
        border: 1px solid #ccc;
        padding: 5px;
        border-radius: 5px;
        width: 180px;
        display: flex;
        flex-direction: column;
        gap: 1px;
    }

    .product {
        display: flex;
        flex-direction: row;
        gap: 5px;
        font-size: smaller;
        align-items: center;
    }

    .product-input {
        width: 50px;
        font-size: smaller;
    }
</style>