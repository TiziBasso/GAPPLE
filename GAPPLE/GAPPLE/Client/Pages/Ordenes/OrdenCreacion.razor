                    </RadzenStack>
                    <ValidationMessage For="@(() => orden.FechaEntrega)" />
                </RadzenColumn>

                <RadzenColumn Size="4">
                    <RadzenStack Orientation="Orientation.Vertical" Gap="0">
                        <RadzenLabel Text="Transporte:" />
                        <RadzenDropDownDataGrid Data="transportes" @bind-Value="orden.CodTransporte" Density="Density.Compact" AllowSorting=false
                                                AllowFiltering=true FilterCaseSensitivity=FilterCaseSensitivity.CaseInsensitive FilterOperator=StringFilterOperator.Contains AllowFilteringByAllStringColumns=true
                                                TextProperty="@nameof(Transporte.Descripcion)" ValueProperty="@nameof(Transporte.CodigoTango)" AllowVirtualization="true">
                            <Columns>
                                <RadzenDropDownDataGridColumn Property="@nameof(Transporte.CodigoTango)" Title="Código" Width="4rem" />
                                <RadzenDropDownDataGridColumn Property="@nameof(Transporte.Descripcion)" Title="Descripción" />
                            </Columns>
                        </RadzenDropDownDataGrid>
                    </RadzenStack>
                </RadzenColumn>

                <RadzenColumn Size="3">
                    <RadzenStack Orientation="Orientation.Vertical" Gap="0">
                        <RadzenLabel Text="O.C.:" />
                        <RadzenTextArea @bind-Value="orden.Notas" />
                        <ValidationMessage For="@(() => orden.Notas)" />
                    </RadzenStack>
                </RadzenColumn>

                <RadzenColumn Size="2">
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems=AlignItems.Center Style="height:100%;">
                        <RadzenStack Orientation="Orientation.Horizontal" Gap="0">
                            <RadzenLabel Text="F:" />
                            <RadzenCheckBox @bind-Value="@orden.Factura" />
                        </RadzenStack>

                        <RadzenStack Orientation="Orientation.Horizontal" Gap="0">
                            <RadzenLabel Text="P:" />
                            <RadzenCheckBox @bind-Value="@orden.Presupuesto" />
                        </RadzenStack>
                    </RadzenStack>
                </RadzenColumn>
            </RadzenRow>
            <RadzenRow Style="margin-top:10px;">

                <RadzenColumn Size="8">
                    <RadzenStack Orientation="Orientation.Vertical" Gap="0">
                        <RadzenLabel Text="Notas:" />
                        <RadzenTextArea @bind-Value="orden.ObservacionesZentra" />
                        <ValidationMessage For="@(() => orden.ObservacionesZentra)" />
                    </RadzenStack>
                </RadzenColumn>

                <RadzenColumn Size="4">
                    <RadzenStack Orientation="Orientation.Vertical" Gap="0">
                        <RadzenLabel Text="Ofertas:" />
                        <RadzenDropDown AllowFiltering="true" AllowVirtualization="true" Data="ofertas" @bind-Value="ofertasSeleccionadas" Change="RecalcularOfertas"
                                        TextProperty="@nameof(Oferta.Nombre)" ValueProperty="@nameof(Oferta.IdOferta)" Multiple="true" AllowClear="true"
                                        Placeholder="Seleccionar ofertas..." MaxSelectedLabels="2" SelectAllText="Todas" SelectedItemsText="seleccionadas" />
                    </RadzenStack>
                </RadzenColumn>
            </RadzenRow>
        </RadzenFieldset>

        <RadzenRow Style="margin-top:10px;">
            <RadzenColumn Size="4">
                <RadzenStack Orientation="Orientation.Vertical" Gap="0">
                    <RadzenLabel Text="Línea:" />
                    <RadzenDropDown Data="lstLineas" @bind-Value="valorAux" Change="BuscarProductos" />
                    <ValidationMessage For="@(() => orden.Linea)" />
                </RadzenStack>
            </RadzenColumn>
            <RadzenColumn Size="3">
                <RadzenStack Orientation="Orientation.Vertical" Gap="0">
                    <RadzenLabel Text="Tipo cantidad:" />
                    <RadzenDropDown AllowVirtualization="true" Data="propiedades" @bind-Value="propiedad" Change="BuscarProductos"
                                    TextProperty="@nameof(Opcion.Descripcion)" ValueProperty="@nameof(Opcion.Id)" />
                </RadzenStack>
            </RadzenColumn>
        </RadzenRow>

        <RadzenRow Style="margin-top:10px;max-height: 100%;overflow: auto;">
            <RadzenColumn Size="12">
                <RadzenFieldset Text="Selección de productos">
                    <ValidationMessage For="@(() => orden.Detalle)" />
                    @if (showCards && lstProductos != null && lstProductos.Any())
                    {
                        <div class="cards-container">
                            <Virtualize Items="Cards" Context="card">
                                @* @foreach (var card in Cards)
                            { *@
                                <div class="card" @key="card.Guid">
                                    <h6 style="text-align:center;">@card.FamilyName</h6>
                                    @foreach (var product in card.Products)
                                    {
                                        <div class="product">
                                            <label style="width:65px;">@product.CodigoProducto</label>
                                            <label style="font-size: 14px;width: 50px;font-weight: 900;">@product.Sinonimo</label>
                                            @if (propiedad == 0)
                                            {
                                                <input id="input-@product.CodigoProducto"
                                                       type="text"
                                                       class="product-input"
                                                       value="@product.CantidadSeleccionada"
                                                       @onfocus="@(() => product.CantidadSeleccionadaAnterior = product.CantidadSeleccionada)"
                                                       @onchange="@(async e => await OnCantidadChanged(e.Value?.ToString(), product))" />
                                                <label style="font-size: 12px;width: 90px;font-weight: 600;">$ @product.PrecioConDescuento.ToString("N2")</label>
                                                @if (codigosEnOfertas != null && codigosEnOfertas.Any() && codigosEnOfertas.ContainsKey(product.CodigoProducto))
                                                {
                                                    <div style="background:yellow; display:flex;">
                                                        @if (SesionDTO.Rol == "1")
                                                        {
                                                            <RadzenNumeric Min="0" TValue="decimal" Style="padding: 0;width: 32px;border: none;" ValueChanged="@((e) => ModificarDescuento(e, product))" Value="@product.DescuentoFinal" ShowUpDown="false"></RadzenNumeric>
                                                            @* <input style="padding: 0;width: 32px;border: none;" type="number" value="@product.DescuentoFinal" @onchange="@((e) => ModificarDescuento(e, product))" /> *@
                                                        }
                                                        else
                                                        {
                                                            <span>@product.DescuentoFinal</span>
                                                        }

                                                        <strong>%</strong>
                                                    </div>
                                                }
                                                else
                                                {
                                                    @if (articulosPorClientes.Any() && articulosPorClientes.Exists(x => x.CodProducto == product.CodigoProducto))
                                                    {

                                                        <div style="display:flex;">
                                                            @if (SesionDTO.Rol == "1")
                                                            {
                                                                <RadzenNumeric Min="0" TValue="decimal" Style="padding: 0;width: 32px;border: none;" ValueChanged="@((e) => ModificarDescuento(e, product))" Value="@product.DescuentoFinal" ShowUpDown="false"></RadzenNumeric>
                                                                @* <input style="padding: 0;width: 32px;border: none;" type="number" value="@product.DescuentoFinal" @onchange="@((e) => ModificarDescuento(e, product))" /> *@
                                                            }
                                                            else
                                                            {

                                                                <span>@product.DescuentoFinal</span>
                                                            }
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        @if (SesionDTO.Rol == "1")
                                                        {
                                                            <RadzenNumeric Min="0" TValue="decimal" Style="padding: 0;width: 32px;border: none;" ValueChanged="@((e) => ModificarDescuento(e, product))" Value="@product.DescuentoFinal" ShowUpDown="false"></RadzenNumeric>
                                                            @* <input style="padding: 0;width: 32px;border: none;" type="number" value="@product.DescuentoFinal" @onchange="@((e) => ModificarDescuento(e, product))" /> *@
                                                        }
                                                        else
                                                        {
                                                            <span>0</span>
                                                        }
                                                    }
                                                    <strong>%</strong>
                                                }
                                                <RadzenCheckBox @bind-Value=product.Probador />
                                            }
                                            else
                                            {
                                                <input id="input-@product.CodigoProducto"
                                                       type="text"
                                                       class="product-input"
                                                       value="@product.CantidadObsequio"
                                                       @onchange="@(async e => await OnCantidadChanged(e.Value?.ToString(), product))" />
                                            }
                                        </div>
                                    }
                                </div>
                                @* } *@
                            </Virtualize>
                        </div>
                    }
                </RadzenFieldset>
            </RadzenColumn>
        </RadzenRow>

        <RadzenStack JustifyContent="JustifyContent.Center" Gap="3rem" Orientation="Orientation.Horizontal" class="rz-mt-2">
            <RadzenButton ButtonStyle="ButtonStyle.Danger" Icon="cancel" Text="Cancelar" Click="Cancelar" />
            <RadzenButton ButtonStyle="ButtonStyle.Success" Icon="save" ButtonType="ButtonType.Submit" Text="Guardar" />
        </RadzenStack>
    </RadzenTemplateForm>
}
else
{
    <Loader />
}

<script>
    document.addEventListener('keydown', function (event) {
    if (event.target.classList.contains('product-input')) {
    if (event.key === 'Enter') {
    event.preventDefault(); // Evita el submit del formulario
    }
    const currentInput = event.target;
    const inputs = Array.from(document.querySelectorAll('.product-input'));
    const currentCard = currentInput.closest('.card');
    const allCards = Array.from(document.querySelectorAll('.card'));
    const inputsInCurrentCard = Array.from(currentCard.querySelectorAll('.product-input'));

    const inputIndexInCard = inputsInCurrentCard.findIndex(input => input === currentInput);
    const currentCardRect = currentCard.getBoundingClientRect();

    // Manejo de teclas
    if (event.key === 'ArrowUp') {
    if (inputIndexInCard > 0) {
    inputsInCurrentCard[inputIndexInCard - 1].focus();
    setTimeout(() => inputsInCurrentCard[inputIndexInCard - 1].select(), 0);
    } else {
    const targetCard = findCardAbove(allCards, currentCardRect);
    if (targetCard) {
    const targetInputs = targetCard.querySelectorAll('.product-input');
    const targetInput = targetInputs[targetInputs.length - 1];
    targetInput.focus();
    setTimeout(() => targetInput.select(), 0);
    }
    }
    } else if (event.key === 'ArrowDown' || event.key === 'Enter') {
    if (inputIndexInCard < inputsInCurrentCard.length - 1) {
    inputsInCurrentCard[inputIndexInCard + 1].focus();
    setTimeout(() => inputsInCurrentCard[inputIndexInCard + 1].select(), 0);
    } else {
    const targetCard = findCardBelow(allCards, currentCardRect);
    if (targetCard) {
    const targetInputs = targetCard.querySelectorAll('.product-input');
    const targetInput = targetInputs[0];
    targetInput.focus();
    setTimeout(() => targetInput.select(), 0);
    }
    }
    } else if (event.key === 'ArrowLeft') {
    const currentCardIndex = allCards.findIndex(card => card === currentCard);
    if (currentCardIndex > 0) {
    const previousCard = allCards[currentCardIndex - 1];
    const inputsInPreviousCard = previousCard.querySelectorAll('.product-input');
    const targetInput = inputsInPreviousCard[inputIndexInCard] || inputsInPreviousCard[inputsInPreviousCard.length - 1];
    targetInput.focus();
    setTimeout(() => targetInput.select(), 0);
    }
    } else if (event.key === 'ArrowRight') {
    const currentCardIndex = allCards.findIndex(card => card === currentCard);
    if (currentCardIndex < allCards.length - 1) {
    const nextCard = allCards[currentCardIndex + 1];
    const inputsInNextCard = nextCard.querySelectorAll('.product-input');
    const targetInput = inputsInNextCard[inputIndexInCard] || inputsInNextCard[inputsInNextCard.length - 1];
    targetInput.focus();
    setTimeout(() => targetInput.select(), 0);
    }
    }
    }
    });


    // Función para encontrar la tarjeta en la fila superior
    function findCardAbove(cards, currentRect) {
    return cards.reverse().find(card => {
    const rect = card.getBoundingClientRect();
    return rect.bottom <= currentRect.top && rect.left < currentRect.right && rect.right > currentRect.left;
    });
    }

    // Función para encontrar la tarjeta en la fila inferior
    function findCardBelow(cards, currentRect) {
    return cards.find(card => {
    const rect = card.getBoundingClientRect();
    return rect.top >= currentRect.bottom && rect.left < currentRect.right && rect.right > currentRect.left;
    });
    }
</script>

@code {
    List<ProductoParaOfertas> lstProductosOferta = new();
    List<ProductoParaOfertas> lstProductos = new();
    List<ProductoParaOfertas> lstProductosDifLinea = new();
    List<ProductoParaOfertas> lstProductosConDescuentoManual = new();
    Orden orden = new() { IdEstado = 1 };
    List<string> lstLineas = new();
    List<string> lstLineasDif = new();
    string valorAux;
    string entrega;
    EditContext editContext;
    private List<Card> Cards = new();
    CustomValidation customValidation;

    Dictionary<string, decimal> descuentosPersonalizados = new();

    bool showForm, showCards, unico, seleccionaVendedor;
    int propiedad = 0;

    List<Transporte> transportes = new();
    List<ListaDePrecios> listasDePrecio = new();
    List<CondicionDeVenta> condicionesDeVenta = new();
    List<Zonas> zonas = new();
    List<Cliente> clientes = new();
    List<Oferta> ofertas = new();
    List<ArticulosPorCliente> articulosPorClientes = new();
    List<SucursalesPorCliente> sucursalesPorClientes = new();
    List<Opcion> propiedades = [new(0, "Normal"), new(1, "Obsequio")];

    Dictionary<string, List<Oferta>> codigosEnOfertas = new();

    List<int> ofertasSeleccionadas = new();

    protected override async Task OnInitializedAsync()
    {
        var permisos = await SeguridadService.GetPermisos("ordenes");
        if (!permisos.Contains("alta"))
            NavigationManager.NavigateTo(Variables.ErrorPages.Desautorizado);

        seleccionaVendedor = permisos.Contains("seleccionaVendedor");

        lstLineas = await ProductosService.GetLineas();
        clientes = await ClientesService.GetClientes(null, null, null, null);
        transportes = await OrdenesService.GetTransportes();
        listasDePrecio = await OrdenesService.GetListasDePrecio();
        condicionesDeVenta = await OrdenesService.GetCondicionesDeVenta();
        zonas = await OrdenesService.GetZonas();
        editContext = new(orden);
        showForm = true;
    }

    private void GuardarProductosDiferenteLinea()
    {
        foreach (var card in Cards)
        {
            foreach (var product in card.Products.Where(x => x.CantidadSeleccionada > 0 || x.Probador || x.CantidadObsequio > 0))
            {
                if (lstProductosDifLinea.Exists(x => x.CodigoProducto == product.CodigoProducto))
                {
                    var ln = lstProductosDifLinea.First(x => x.CodigoProducto == product.CodigoProducto);
                    ln.CantidadSeleccionada = product.CantidadSeleccionada;
                    ln.CantidadObsequio = product.CantidadObsequio;
                    ln.Probador = product.Probador;
                    ln.TieneObsequio = ln.CantidadObsequio > 0;
                }
                else
                    lstProductosDifLinea!.Add((ProductoParaOfertas)product.Clone());
            }
            foreach (var product in card.Products.Where(x => x.ModificadoManual))
            {
                lstProductosConDescuentoManual.Add((ProductoParaOfertas)product.Clone());
            }
            lstLineasDif.Add(orden.Linea);

        }

    }

    async Task BuscarProductos()
    {
        if (!string.IsNullOrEmpty(valorAux))
        {
            RadzenDialogService.OpenBusy("Cargando...");
            showCards = false;
            GuardarProductosDiferenteLinea();
            orden.Linea = valorAux;

            lstProductos = await ProductosService.GetProductosParaOfertas(orden.Linea!, orden.CodListaPrecio);
            foreach (var product in lstProductosDifLinea.Where(x => lstProductos.Exists(y => y.CodigoProducto == x.CodigoProducto)))
            {
                var ln = lstProductos.First(x => x.CodigoProducto == product.CodigoProducto);
                ln.CantidadSeleccionada = product.CantidadSeleccionada;
                ln.CantidadObsequio = product.CantidadObsequio;
                ln.Probador = product.Probador;
                ln.TieneObsequio = ln.CantidadObsequio > 0;
            }

            var grouped = lstProductos.GroupBy(p => p.Familia);

            foreach (var product in lstProductos)
            {
                int esManual = lstProductosConDescuentoManual.FindIndex(x => product.CodigoProducto == x.CodigoProducto);
                if (esManual != -1)
                {
                    product.ModificadoManual = true;
                    product.DescuentoFinal = lstProductosConDescuentoManual[esManual].DescuentoFinal;
                }
                if (!product.ModificadoManual)
                {
                    if (articulosPorClientes.Any() && articulosPorClientes.Exists(x => x.CodProducto == product.CodigoProducto))
                    {
                        product.DescuentoFinal = articulosPorClientes.Find(x => x.CodProducto == product.CodigoProducto)!.Descuento;
                    }

                    if (codigosEnOfertas != null && codigosEnOfertas.Any() && codigosEnOfertas.ContainsKey(product.CodigoProducto))
                    {
                        var ofertaConDescuentoMasAlto = GetOfertaConMayorDescuento(product.CodigoProducto);
                        product.DescuentoFinal = 100 * (1 - (1 - ofertaConDescuentoMasAlto.Descuento / 100) * (1 - (articulosPorClientes.Exists(x => x.CodProducto == product.CodigoProducto) ? articulosPorClientes.Find(x => x.CodProducto == product.CodigoProducto).Descuento : 0) / 100));
                    }
                }
            }

            ReconstruirCards();

            ofertas = await OfertasService.GetOfertas(null, orden.Linea, null, null, true);
            ofertasSeleccionadas.AddRange(ofertas.Where(o => orden.Ofertas.Contains(o.IdOferta)).Select(x => x.IdOferta));
            RecalcularOfertas();

            //await JSRuntime.InvokeVoidAsync("refreshDomCache");
            showCards = true;
            RadzenDialogService.CloseDialog();
        }
    }

    void ReconstruirCards()
    {
        Cards.Clear();
        var grouped = lstProductos.GroupBy(p => p.Familia);
        foreach (var group in grouped)
        {
            var productChunks = group.Select((p, i) => new { Product = p, Index = i })
                                      .GroupBy(x => x.Index / 10)
                                      .Select(g => g.Select(x => x.Product).ToList());
            foreach (var chunk in productChunks)
                Cards.Add(new Card(group.Key, chunk));
        }
    }

    async Task AsignarVariables()
    {
        RadzenDialogService.OpenBusyWithLoader("Cargando...");
        articulosPorClientes = await ClientesService.GetArticulosPorCliente(orden.CodCliente);
        sucursalesPorClientes = await ClientesService.GetSucursalesPorCliente(orden.CodCliente);
        var index = clientes.FindIndex(x => x.CodigoCliente == orden.CodCliente);
        orden.CodListaPrecio = clientes[index].CodListaPrecioDefault!;
        await BuscarProductos();
        orden.CondicionVenta = clientes[index].CondVentaDefault;
        orden.Zona = clientes[index].ZonaDefault;
        editContext.NotifyFieldChanged(editContext.Field(nameof(Orden.Cliente)));
        editContext.NotifyFieldChanged(editContext.Field(nameof(Orden.CondicionVenta)));
        editContext.NotifyFieldChanged(editContext.Field(nameof(Orden.CodListaPrecio)));
        editContext.NotifyFieldChanged(editContext.Field(nameof(Orden.Zona)));
        orden.Entrega = null;

        if (sucursalesPorClientes.Count() == 0)
        {
            unico = true;
            var cliente = clientes.Find(x => x.CodigoCliente == orden.CodCliente);
            entrega = $"{cliente.Domicilio}, {cliente.Localidad}, {cliente.CodigoPostal}";
            orden.Entrega = entrega;
        }
        else if (sucursalesPorClientes.Count() == 1)
        {
            unico = true;
            entrega = sucursalesPorClientes.First().DireccionCompleta;
            orden.Entrega = entrega;
        }
        else
        {
            unico = false;
        }


        foreach (var product in lstProductos)
        {
            if (!product.ModificadoManual)
            {
                if (articulosPorClientes.Any() && articulosPorClientes.Exists(x => x.CodProducto == product.CodigoProducto))
                {
                    product.DescuentoFinal = articulosPorClientes.Find(x => x.CodProducto == product.CodigoProducto).Descuento;
                }
                if (codigosEnOfertas != null && codigosEnOfertas.Any() && codigosEnOfertas.ContainsKey(product.CodigoProducto))
                {
                    var ofertaConDescuentoMasAlto = GetOfertaConMayorDescuento(product.CodigoProducto);
                    product.DescuentoFinal = 100 * (1 - (1 - ofertaConDescuentoMasAlto.Descuento / 100) * (1 - (articulosPorClientes.Exists(x => x.CodProducto == product.CodigoProducto) ? articulosPorClientes.Find(x => x.CodProducto == product.CodigoProducto).Descuento : 0) / 100));
                }
            }
        }

        // Cards.Clear();
        // var grouped = lstProductos.GroupBy(p => p.Familia);
        // foreach (var group in grouped)
        // {
        //     var productChunks = group.Select((p, i) => new { Product = p, Index = i })
        //                               .GroupBy(x => x.Index / 10)
        //                               .Select(g => g.Select(x => x.Product).ToList());
        //     foreach (var chunk in productChunks)
        //         Cards.Add(new Card(group.Key, chunk));
        // }

        ofertas = await OfertasService.GetOfertas(null, orden.Linea, null, null, true);
        RecalcularOfertas();

        //await JSRuntime.InvokeVoidAsync("refreshDomCache");

        RadzenDialogService.CloseDialog();
    }

    Oferta GetOfertaConMayorDescuento(string codigoProducto)
    {
        codigosEnOfertas.TryGetValue(codigoProducto, out var ofertasDondeSeEncuentra);
        return ofertasDondeSeEncuentra.OrderByDescending(o => o.Descuento).FirstOrDefault();
    }


    void RecalcularOfertas()
    {
        var ofertasIdsMarcaActual = ofertas.Select(o => o.IdOferta).ToList();

        orden.Ofertas.RemoveAll(id => ofertasIdsMarcaActual.Contains(id) && !ofertasSeleccionadas.Contains(id));

        foreach (var id in ofertasSeleccionadas)
        {
            if (ofertasIdsMarcaActual.Contains(id) && !orden.Ofertas.Contains(id))
            {
                orden.Ofertas.Add(id);
            }
        }

        if (orden.Ofertas != null && orden.Ofertas.Any())
        {
            var ofertasFiltradas = ofertas.Where(o => orden.Ofertas!.Contains(o.IdOferta));

            codigosEnOfertas = ofertasFiltradas
                .SelectMany(o => o.Inclusiones.Split('|').Select(codigo => new { CodigoProducto = codigo, Oferta = o }))
                .GroupBy(x => x.CodigoProducto)
                .ToDictionary(g => g.Key, g => g.Select(x => x.Oferta).ToList());
        }
        else
            codigosEnOfertas.Clear();

        foreach (var product in lstProductos)
        {
            if (!product.ModificadoManual)
            {
                if (articulosPorClientes.Any() && articulosPorClientes.Exists(x => x.CodProducto == product.CodigoProducto))
                {
                    product.DescuentoFinal = articulosPorClientes.Find(x => x.CodProducto == product.CodigoProducto).Descuento;
                }

                if (codigosEnOfertas != null && codigosEnOfertas.Any() && codigosEnOfertas.ContainsKey(product.CodigoProducto))
                {
                    var ofertaConDescuentoMasAlto = GetOfertaConMayorDescuento(product.CodigoProducto);
                    product.DescuentoFinal = 100 * (1 - (1 - ofertaConDescuentoMasAlto.Descuento / 100) * (1 - (articulosPorClientes.Exists(x => x.CodProducto == product.CodigoProducto) ? articulosPorClientes.Find(x => x.CodProducto == product.CodigoProducto).Descuento : 0) / 100));
                }
            }
        }

        // Cards.Clear();
        // var grouped = lstProductos.GroupBy(p => p.Familia);
        // foreach (var group in grouped)
        // {
        //     var productChunks = group.Select((p, i) => new { Product = p, Index = i })
        //                               .GroupBy(x => x.Index / 10)
        //                               .Select(g => g.Select(x => x.Product).ToList());
        //     foreach (var chunk in productChunks)
        //         Cards.Add(new Card(group.Key, chunk));
        // }
    }

    bool Validar()
    {
        bool error = false;

        if (!orden.Factura && !orden.Presupuesto)
        {
            NotificationService.Notify(NotificationSeverity.Info, "Debe ingrear al menos 1 tipo de pedido");
            error = true;
        }

        foreach (var card in Cards)
        {
            if (card.Products.Exists(e => e.CantidadSeleccionada < 0))
            {
                NotificationService.Notify(NotificationSeverity.Info, "Hay productos con cantidad negativa");
                error = true;
                break;
            }
        }

        if (!error)
        {
            orden.Detalle!.Clear();
            foreach (var card in Cards)
            {
                foreach (var product in card.Products)
                {
                    if (product.CantidadSeleccionada > 0 || product.Probador || product.CantidadObsequio > 0)
                        orden.Detalle!.Add(new OrdenDetalle()
                            {
                                Cantidad = product.CantidadSeleccionada,
                                CodProducto = product.CodigoProducto,
                                Descuento = product.DescuentoFinal,
                                Probador = product.Probador,
                                CantidadObsequio = product.CantidadObsequio,
                                TieneObsequio = product.CantidadObsequio > 0,
                                Precio = product.Precio
                            });
                }
            }
            foreach (var product in lstProductosDifLinea)
            {
                if (!orden.Detalle.Any(x => x.CodProducto == product.CodigoProducto))
                    orden.Detalle!.Add(new OrdenDetalle()
                        {
                            Cantidad = product.CantidadSeleccionada,
                            CodProducto = product.CodigoProducto,
                            Descuento = product.DescuentoFinal,
                            Probador = product.Probador,
                            CantidadObsequio = product.CantidadObsequio,
                            TieneObsequio = product.CantidadObsequio > 0,
                            Precio = product.Precio
                        });
            }
            if (lstLineasDif.Any())
                orden.Linea = string.Join(',', lstLineasDif.Distinct());

            if (!orden.Detalle.Any())
            {
                NotificationService.Notify(NotificationSeverity.Info, "Debe ingresar al menos 1 producto");
                error = true;
            }

        }

        return !error;
    }

    void ModificarDescuento(decimal e, ProductoParaOfertas p)
    {
        RadzenDialogService.OpenBusyWithLoader("aplicando descuentos");

        foreach (var item in Cards.Where(x => x.FamilyName == p.Familia).ToList())
        {
            foreach (var producto in item.Products)
            {
                producto.DescuentoFinal = Math.Round(e, 2);
                p.ModificadoManual = true;
            }
        }
        RadzenDialogService.CloseDialog();
    }

    async Task Guardar()
    {
        if (Validar())
        {
            bool valid = false;
            if (orden.Detalle!.Any(x => x.Probador || x.TieneObsequio))
            {
                valid = await DialogService.OpenAsync<ModalCantidadesProbadores>("Seleccionar cantidad de probadores", new()
                {
                    { "Detalle", orden.Detalle}
                }, new()
                {
                    CloseDialogOnEsc = false,
                    ShowClose = false,
                    CloseDialogOnOverlayClick = false,
                    Style = "max-height:90vh; max-width:60vw;",
                    Height = "fit-content",
                    Width = "fit-content"
                });
                if (!valid) return;
            }

            if (seleccionaVendedor)
            {
                orden.Usuario = await DialogService.OpenAsync<SeleccionVendedor>("Seleccionar vendedor", null, new()
                    {
                        CloseDialogOnEsc = false,
                        ShowClose = false,
                        CloseDialogOnOverlayClick = false,
                        Style = "max-height:90vh; max-width:60vw;",
                        Height = "fit-content",
                        Width = "fit-content"
                    });
                if (orden.Usuario == null) return;
            }

            if (valid || await DialogService.Confirm(MensajesHelper.Confirm("confirmar", $"el pedido por un monto aproximado de ${orden.Detalle.Sum(x => x.Precio * x.Cantidad * (1 - x.Descuento / 100)).ToString("N2")}"), MensajesHelper.Title, new() { OkButtonText = "Sí", CancelButtonText = "No" }) == true)
            {
                RadzenDialogService.OpenBusyWithLoader("Guardando...");
                var result = await OrdenesService.PostPedido(orden);
                RadzenDialogService.CloseDialog();
                if (result.IsSuccessStatusCode)
                {
                    //parametros de consulta cambiar en el index para que inicie con los nuevos ingresados
                    NotificationService.Notify(NotificationSeverity.Success, MensajesHelper.SaveSuccess());
                    NavigationManager.NavigateTo("ordenes");
                }
                else
                    NotificationService.Notify(NotificationSeverity.Error, MensajesHelper.ErrorSummary500, MensajesHelper.ErrorDetail500);
            }
        }
    }

    private async Task Cancelar()
    {
        if (!editContext.IsModified() || await DialogService.Confirm(MensajesHelper.Cancel(), MensajesHelper.Title, new() { OkButtonText = "Sí", CancelButtonText = "No" }) == true)
            NavigationManager.NavigateTo("ordenes");
    }

    private async Task OnCantidadChanged(string? nuevoValor, ProductoParaOfertas product)
    {
        int cantidad = 0;

        if (!int.TryParse(nuevoValor, out cantidad))
            cantidad = 0;

        if (propiedad == 0)
        {
            if (cantidad != product.CantidadSeleccionada)
            {
                product.CantidadSeleccionada = cantidad;
                await AgregarComplemento(product);
            }
        }
        else if (propiedad == 1)
        {
            if (cantidad != product.CantidadObsequio)
                product.CantidadObsequio = cantidad;
        }
    }

    private async Task AgregarComplemento(ProductoParaOfertas product)
    {
        if (string.IsNullOrWhiteSpace(product.CodigoComplemento) && product.CantidadSeleccionadaAnterior == product.CantidadSeleccionada) return;

        foreach (var card in Cards)
        {
            var producto = card.Products.FirstOrDefault(p => p.CodigoProducto == product.CodigoComplemento);
            if (producto != null)
            {
                producto.CantidadSeleccionada -= product.CantidadSeleccionadaAnterior;
                producto.CantidadSeleccionada += product.CantidadSeleccionada;

                return;
            }
        }
    }

    private class Card
    {
        public Guid Guid { get; }
        public string FamilyName { get; }
        public List<ProductoParaOfertas> Products { get; }

        public Card(string familyName, List<ProductoParaOfertas> products)
        {
            Guid = Guid.NewGuid();
            FamilyName = familyName;
            Products = products;
        }
    }
