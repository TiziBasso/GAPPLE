@page "/ordenes"
@using GAPPLE.Client.Components.Ordenes
@using GAPPLE.Client.Components.Ordenes.Informes
@using GAPPLE.Client.Extensiones
@using Microsoft.AspNetCore.Components.Authorization

@inject DialogService DialogService
@inject DialogCustom DialogCustom
@inject OrdenesService OrdenesService
@inject ProductosService ProductosService
@inject NotificationService NotificationService
@inject NavigationManager NavigationManager
@inject DialogCustom DialogCustom
@inject IJSFunction JSFunction
@inject AuthenticationStateProvider AutenticacionProvider

@if (showPage)
{
    <RadzenText TextStyle="TextStyle.DisplayH4" TextAlign="TextAlign.Center" Text="Ordenes" class="mb-3" />

    <RadzenStack Orientation="Orientation.Horizontal" Wrap="FlexWrap.Wrap" Gap="4px" AlignItems="AlignItems.End">

        <RadzenStack Orientation="Orientation.Vertical">
            <RadzenLabel Text="Desde:" Component="desde" />
            <RadzenDatePicker @bind-Value="desde" DateFormat="dd/MM/yyyy" Name="desde" Style="width:8rem" />
        </RadzenStack>

        <RadzenStack Orientation="Orientation.Vertical">
            <RadzenLabel Text="Hasta:" Component="hasta" />
            <RadzenDatePicker @bind-Value="hasta" DateFormat="dd/MM/yyyy" Max="DateTime.Today" Name="hasta" Style="width:8rem" />
        </RadzenStack>

        <RadzenStack Orientation="Orientation.Vertical">
            <RadzenLabel Text="ID:" Component="id" />
            <input @ref="refIdOrden" type="number" @bind-value="@idPedido" @bind-value:event="oninput" @onkeypress="@((KeyboardEventArgs e) => KeyPress(e))"
                   class="rz-textbox" style="width: 5rem; text-align:right" disabled="@(isLoading)" id="id" />
        </RadzenStack>

        <RadzenStack Orientation="Orientation.Vertical">
            <RadzenLabel Text="Código:" Component="cod" />
            <input type="text" @bind-value="@codOrden" @bind-value:event="oninput" @onkeypress="@((KeyboardEventArgs e) => KeyPress(e))"
                   class="rz-textbox" style="width: 9rem;" disabled="@(isLoading)" id="cod" />
        </RadzenStack>

        <RadzenStack Orientation="Orientation.Vertical">
            <RadzenLabel Text="Cliente:" Component="cliente" />
            <input type="text" @bind-value="@razonSocial" @bind-value:event="oninput" @onkeypress="@((KeyboardEventArgs e) => KeyPress(e))"
                   class="rz-textbox" style="width: 15rem" disabled="@(isLoading)" id="cliente" />
        </RadzenStack>

        <RadzenStack Orientation="Orientation.Vertical">
            <RadzenLabel Text="Estado:" Component="estado" />
            <RadzenDropDown Data=@estados @bind-Value=@idEstado Name="estado"
                            ValueProperty=@nameof(Opcion.Id) TextProperty=@nameof(Opcion.Descripcion)
                            AllowClear=true Placeholder="(Todos)"
                            Disabled="@isLoading" Style="width: 9rem;" />
        </RadzenStack>

        <RadzenStack Orientation="Orientation.Vertical">
            <RadzenLabel Text="Presupuesto:" Component="presup" />
            <RadzenDropDown Data=@Variables.EstadosSiNo @bind-Value=@presupuesto Name="presup"
                            ValueProperty=@nameof(Opcion.Id) TextProperty=@nameof(Opcion.Descripcion)
                            Placeholder="(Todos)" AllowClear=true
                            Disabled="@isLoading" Style="width: 7rem;" />
        </RadzenStack>

        <RadzenStack Orientation="Orientation.Vertical">
            <RadzenLabel Text="Linea:" Component="linea" />
            <RadzenDropDown Data=@lineas @bind-Value=@linea Name="linea" AllowClear=true
                            Disabled="@isLoading" Style="width: 15rem;" />
        </RadzenStack>

        <RadzenStack Orientation="Orientation.Vertical">
            <RadzenLabel Text="Cód. tango:" Component="codTango" />
            <input type="text" @bind-value="@codTango" @bind-value:event="oninput" @onkeypress="@((KeyboardEventArgs e) => KeyPress(e))"
                   class="rz-textbox" style="width: 8rem" disabled="@(isLoading)" id="codTango" />
        </RadzenStack>

        <RadzenButton Click="FillOrdenes" IsBusy=isLoading ButtonStyle=ButtonStyle.Secondary Icon="search" Size="ButtonSize.Medium" />

    </RadzenStack>

    <RadzenStack Orientation=Orientation.Horizontal Gap="10px" class="rz-mb-1 rz-mt-3">
        <RadzenButton Text="Agregar orden" Icon="add" ButtonStyle="ButtonStyle.Secondary" Size=ButtonSize.Small Click="NuevaOrden" Visible=@(permisos.Contains("alta")) />
    </RadzenStack>

    <RadzenDataGrid @ref="grid" Data="lstOrdenes" AllowFiltering="true" FilterMode="FilterMode.Simple" AllowSorting="true"
                    AllowColumnResize=true
                    EmptyText="" Style="height:60vh" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive">
        <Columns>
            <RadzenDataGridColumn TItem="Orden" Title="ID" Property="@nameof(Orden.Id)" Width="80px" TextAlign="TextAlign.Right" FilterValue="idFilter" Resizable=false>
                <FilterTemplate>
                    <RadzenNumeric @bind-Value=idFilter Style="width:100%" ShowUpDown=false Min="0" TextAlign="TextAlign.Right" />
                </FilterTemplate>
            </RadzenDataGridColumn>

            <RadzenDataGridColumn TItem="Orden" Title="Cód." Property="@nameof(Orden.CodigoOrden)" Width="150px" FilterValue="codOrdenFilter" Resizable=false>
                <FilterTemplate>
                    <RadzenNumeric @bind-Value=codOrdenFilter Style="width:100%" ShowUpDown=false Min="0" TextAlign="TextAlign.Right" />
                </FilterTemplate>
            </RadzenDataGridColumn>

            <RadzenDataGridColumn TItem="Orden" Title="Presupuesto" Property="@nameof(Orden.Presupuesto)" Width="120px" TextAlign="TextAlign.Center" Filterable=false Resizable=false>
                <Template>
                    <RadzenCheckBox Value="context.Presupuesto" ReadOnly=true />
                </Template>
            </RadzenDataGridColumn>

            <RadzenDataGridColumn TItem="Orden" Title="Cliente" Property="@nameof(Orden.Cliente)" Width="180px" FilterOperator="FilterOperator.Contains" MinWidth="20px" />

            <RadzenDataGridColumn TItem="Orden" Title="Línea" Property="@nameof(Orden.Linea)" Width="150px" FilterOperator="FilterOperator.Contains" MinWidth="20px" />

            <RadzenDataGridColumn TItem="Orden" Title="Creación" Property="@nameof(Orden.Creacion)" Width="120px" TextAlign="TextAlign.Center" FormatString="{0:dd/MM/yyyy}" FilterValue="creacionFilter" Resizable=false>
                <FilterTemplate>
                    <RadzenDatePicker @bind-Value=creacionFilter Max="DateTime.Today" AllowClear=true Style="width:100%" DateFormat="dd/MM/yyyy" />
                </FilterTemplate>
            </RadzenDataGridColumn>

            <RadzenDataGridColumn TItem="Orden" Title="Zona" Property="@nameof(Orden.Zona)" Width="120px" FilterOperator="FilterOperator.Contains" FilterValue="zonaFilter" MinWidth="20px">
                <FilterTemplate>
                    <RadzenDropDown Data="zonasFilter" @bind-Value=zonaFilter AllowClear=true Style="width:100%" />
                </FilterTemplate>
            </RadzenDataGridColumn>

            <RadzenDataGridColumn TItem="Orden" Title="Estado" Property="@nameof(Orden.DescripcionEstado)" Width="130px" FilterValue="estadoFilter" MinWidth="20px">
                <FilterTemplate>
                    <RadzenDropDown Data="estadosFilter" @bind-Value=estadoFilter AllowClear=true Style="width:100%" />
                </FilterTemplate>
            </RadzenDataGridColumn>

            <RadzenDataGridColumn TItem="Orden" Title="Tango" Property="@nameof(Orden.IdTango)" Width="100px" FilterOperator="FilterOperator.Contains" MinWidth="20px">
                <Template>
                    @(context.IdTango != null ? context.IdTango : "NO")
                </Template>
            </RadzenDataGridColumn>

            <RadzenDataGridColumn TItem="Orden" Title="Factura" Property="@nameof(Orden.NumeroFactura)" Width="120px" FilterOperator="FilterOperator.Contains" MinWidth="20px" />

            <RadzenDataGridColumn TItem="Orden" Title="Unidad" Property="@nameof(Orden.Unidades)" Width="90px" TextAlign="TextAlign.Right" FilterValue="unidadesFilter" Resizable=false>
                <FilterTemplate>
                    <RadzenNumeric @bind-Value=unidadesFilter Style="width:100%" ShowUpDown=false Min="0" TextAlign="TextAlign.Right" />
                </FilterTemplate>
            </RadzenDataGridColumn>

            <RadzenDataGridColumn TItem="Orden" Title="Entrega" Property="@nameof(Orden.FechaEntrega)" Width="120px" FormatString="{0:dd/MM/yyyy}" TextAlign="TextAlign.Center" FilterValue="entregaFilter" Resizable=false>
                <FilterTemplate>
                    <RadzenDatePicker @bind-Value=entregaFilter AllowClear=true Style="width:100%" DateFormat="dd/MM/yyyy" />
                </FilterTemplate>
            </RadzenDataGridColumn>

            <RadzenDataGridColumn TItem="Orden" Title="Aprobado" Property="@nameof(Orden.Aprobado)" Width="90px" TextAlign="TextAlign.Center" Filterable=false Resizable=false>
                <Template>
                    <RadzenCheckBox Value="context.Aprobado" ReadOnly=true />
                </Template>
            </RadzenDataGridColumn>

            <RadzenDataGridColumn Frozen="true" FrozenPosition="FrozenColumnPosition.Right"
                                  TItem="Orden" Filterable="false" Sortable="false" Groupable="false" Resizable="false" TextAlign="TextAlign.Center" Width="35px">
                <Template Context="orden">
                    <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Warning" Variant="Variant.Flat" Size="ButtonSize.ExtraSmall" Visible=@(orden.IdEstado == 1)
                                  Click="@(() => EditarOrden(orden))" @onclick:stopPropagation="true" />
                </Template>
            </RadzenDataGridColumn>

            <RadzenDataGridColumn Frozen="true" FrozenPosition="FrozenColumnPosition.Right"
                                  TItem="Orden" Filterable="false" Sortable="false" Groupable="false" Resizable="false" TextAlign="TextAlign.Center" Width="35px">
                <Template Context="orden">
                    <RadzenButton Icon="info" ButtonStyle="ButtonStyle.Info" Variant="Variant.Flat" Size="ButtonSize.ExtraSmall"
                                  Click="@(() => VerOrden(orden))" @onclick:stopPropagation="true" />
                </Template>
            </RadzenDataGridColumn>

            <RadzenDataGridColumn Frozen="true" FrozenPosition="FrozenColumnPosition.Right"
                                  TItem="Orden" Filterable="false" Sortable="false" Groupable="false" Resizable="false" TextAlign="TextAlign.Center" Width="35px">
                <Template Context="orden">
                    <RadzenButton Icon="done" ButtonStyle="ButtonStyle.Success" Variant="Variant.Flat" Size="ButtonSize.ExtraSmall" Visible=@(orden.IdEstado == 1)
                                  Click="@(() => AprobarOrden(orden))" @onclick:stopPropagation="true" />
                </Template>
            </RadzenDataGridColumn>

            <RadzenDataGridColumn Frozen="true" FrozenPosition="FrozenColumnPosition.Right"
                                  TItem="Orden" Filterable="false" Sortable="false" Groupable="false" Resizable="false" TextAlign="TextAlign.Center" Width="35px">
                <Template Context="orden">
                    <RadzenButton Icon="upload" ButtonStyle="ButtonStyle.Success" title="Exportar a tango" Variant="Variant.Flat" Size="ButtonSize.ExtraSmall" Visible=@(orden.IdEstado == 4)
                                  Click="@(() => PasarATango(orden))" @onclick:stopPropagation="true" />
                </Template>
            </RadzenDataGridColumn>

            <RadzenDataGridColumn Frozen="true" FrozenPosition="FrozenColumnPosition.Right" TItem="Orden" Visible=@(permisos.Contains("eliminar"))
                                  Filterable="false" Sortable="false" Groupable="false" Resizable="false" TextAlign="TextAlign.Center" Width="35px">
                <Template Context="orden">
                    <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Flat" Size="ButtonSize.ExtraSmall" Visible=@(orden.IdEstado == 1)
                                  @onclick:stopPropagation="true" Click="@(() => CancelarOrden(orden))" />
                </Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>

    @if (showResumen)
    {
        <ImpresiónOrden Pedido=Resumen
                        Detalle="@(Resumen!.Detalle!.Where(x=>x.CantidadAprobada > 0).ToList())"
                        Pendientes=@(Resumen!.Detalle!.Any(x=>x.CantidadPendiente > 0) ? Resumen.Detalle!.Where(x=>x.CantidadPendiente > 0).ToList() : null)
                        Imprimir="@(async()=>await Imprimir())" />
    }
}
else
{
    <Loader />
}

@code {
    ElementReference refIdOrden;
    RadzenDataGrid<Orden> grid;
    List<string> lineas = new();
    List<Opcion> estados = new();
    List<Orden> lstOrdenes = new();
    Orden? Resumen = null;
    bool isLoading, showPage, showResumen;

    DateTime desde = DateTime.Today.AddMonths(-1), hasta = DateTime.Today;
    int? idPedido;
    object idEstado;
    bool? presupuesto;
    string? razonSocial, linea, codTango, codOrden;

    List<string> permisos = new() { "alta", "eliminar", "finanzas", "contaduria", "ventas" };


    //filters variables
    int? idFilter, unidadesFilter;
    DateTime? creacionFilter, entregaFilter;
    List<string> zonasFilter = new(), estadosFilter = new();
    string? zonaFilter, estadoFilter, codOrdenFilter;
    int render;

    protected override async Task OnInitializedAsync()
    {
        lineas = await ProductosService.GetLineas();
        estados = await OrdenesService.GetEstados();
        idEstado = estados[1].Id;
        //Parametros de consulta
        showPage = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        render++;
        if (render == 2)
            await FillOrdenes();
    }


    private async Task KeyPress(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await Task.Delay(1);
            await FillOrdenes();
        }
    }

    private async Task FillOrdenes()
    {
        if (desde > hasta)
            NotificationService.Notify(NotificationSeverity.Info, MensajesHelper.Title, "La fecha hasta no puede ser mayor a la fecha desde");
        else
        {
            zonasFilter.Clear();
            estadosFilter.Clear();
            zonaFilter = null;
            estadoFilter = null;

            DialogCustom.OpenBusyWithLoader("Cargando...");
            //parametrosconsulta
            var autenticacionExt = (AutenticacionExtension)AutenticacionProvider;
            var auth = await autenticacionExt.GetAuthenticationStateAsync();
            lstOrdenes = await OrdenesService.GetOrdenes(desde, hasta, idPedido, codOrden, presupuesto, razonSocial, linea, null, idEstado != null ? int.Parse(idEstado.ToString()!) : null, codTango, int.Parse(auth.User.FindFirst("IdUsuario").Value));
            DialogCustom.CloseDialog();
            StateHasChanged();
            await grid.Reload();

            if (!lstOrdenes.Any())
                NotificationService.Notify(NotificationSeverity.Info, MensajesHelper.Title, MensajesHelper.EmptyResponse);
            else
            {
                zonasFilter = lstOrdenes.Where(x => x.Zona != null).Select(x => x.Zona!).Distinct().ToList();
                estadosFilter = lstOrdenes.Where(x => x.DescripcionEstado != null).Select(x => x.DescripcionEstado!).Distinct().ToList();
            }
        }
    }

    async Task CancelarOrden(Orden order)
    {
        if (await DialogService.Confirm(MensajesHelper.Confirm("cancelar", $"la orden con id {order.Id}"), MensajesHelper.Title, new() { OkButtonText = "Sí", CancelButtonText = "No" }) == true)
        {
            var response = await OrdenesService.CambiarEstadoPedidos(order.Id.ToString(), 2);
            if (response.IsSuccessStatusCode)
            {
                order.IdEstado = 2;
                order.DescripcionEstado = estados.First(x => x.Id != null && int.Parse(x.Id.ToString()!) == 2).Descripcion;

                await grid.Reload();
            }
            else
                NotificationService.Notify(NotificationSeverity.Error, MensajesHelper.Title, MensajesHelper.ErrorSummary500);
        }
    }

    async Task AprobarOrden(Orden order)
    {
        await DialogService.OpenAsync<OrdenAprobacion>($"Aprobar orden {order.Id}",
                                                        new() { { "Permisos", permisos }, { "Orden", order } },
                                                        new() { ShowClose = false, AutoFocusFirstElement = false, Height = "28rem", Width = "50rem" });
        StateHasChanged();
    }

    async Task PasarATango(Orden order)
    {
        if (await DialogService.Confirm(MensajesHelper.Confirm("exportar a tango", $"la orden con id {order.Id}"), MensajesHelper.Title, new() { OkButtonText = "Sí", CancelButtonText = "No" }) == true)
        {
            DialogCustom.OpenBusyWithLoader("Exportando...");
            var response = await OrdenesService.PasarATango(order);
            DialogCustom.CloseDialog();
            if (response.IsSuccessStatusCode)
                StateHasChanged();
            else
                NotificationService.Notify(NotificationSeverity.Error, MensajesHelper.Title, response.Message);
        }
    }

    void NuevaOrden()
    {
        NavigationManager.NavigateTo("/orden/creacion");
    }

    void EditarOrden(Orden orden)
    {
        NavigationManager.NavigateTo($"/orden/edicion/{orden.CodigoOrden}");
    }

    async Task VerOrden(Orden orden)
    {
        DialogCustom.OpenBusyWithLoader("Cargando...");
        Resumen = await OrdenesService.GetOrden(orden.CodigoOrden!);
        DialogCustom.CloseDialog();
        if (Resumen == null)
            NotificationService.Notify(NotificationSeverity.Error, MensajesHelper.Title, MensajesHelper.ErrorSummary500);
        else
        {
            Resumen.Detalle!.RemoveAll(x => x.Cantidad == x.CantidadCancelada);
            DialogCustom.OpenBusyWithLoader("Imprimiendo...");
            showResumen = true;
        }
    }

    public async Task Imprimir(string id = "print")
    {
        await JSFunction.Imprimir(id);
        showResumen = false;
        DialogCustom.CloseDialog();
        Resumen = null;
    }

    public async Task Export()
    {
        // DialogCustom.OpenBusy("Exportando...");
        // await ExcelService.ExportProductos(productos, new Query()
        //     {
        //         OrderBy = refGrid.Query.OrderBy,
        //         Filter = refGrid.Query.Filter,
        //         Select = string.Join(",", refGrid.ColumnsCollection.Where(c => c.GetVisible() && !string.IsNullOrEmpty(c.Property))
        //                                                                 .Select(c => c.Property.Contains(".") ? $"{c.Property} as {c.Property.Replace(".", "_")}" : c.Property))
        //     });
        // DialogCustom.CloseDialog();
    }
}
