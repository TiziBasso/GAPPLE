@page "/orden/creacion/excel"

@implements IAsyncDisposable

@inject SeguridadService SeguridadService
@inject ProductosService ProductosService
@inject OrdenesService OrdenesService
@inject ClientesService ClientesService
@inject NavigationManager NavigationManager
@inject OfertasService OfertasService
@inject NotificationService NotificationService
@inject DialogService DialogService
@inject DialogCustom DialogCustom
@inject SesionDTO SesionDTO
@inject SignalRService SignalRService
@using System.Linq
@using GAPPLE.Client.Components.Ordenes
@using GAPPLE.Client.ComponentsUI


@if (showPage)
{
    <RadzenTemplateForm Data="orden" TItem="Orden" Submit="Guardar" EditContext="editContext" Style="display: grid;grid-template-rows: auto auto 1fr auto;height: calc(100vh - 83px); gap:10px;">
        <DataAnnotationsValidator />
        <CustomValidation @ref="customValidation" />

        <RadzenFieldset AllowCollapse="true" Text="@($"Orden cabecera" + orden != null && orden.CodCliente != null ? clientes.Find(x => x.CodigoCliente == orden.CodCliente)!.RazonSocial : "Seleccionar cliente")">
            <RadzenRow Style="margin-top:10px;">
                <RadzenColumn Size="4">
                    <RadzenStack Orientation="Orientation.Vertical" Gap="0">
                        <RadzenLabel Text="Cliente:" />
                        <RadzenDropDownDataGrid Data="clientes" @bind-Value="orden.CodCliente" AllowSorting=false
                                                AllowFiltering=true FilterCaseSensitivity=FilterCaseSensitivity.CaseInsensitive FilterOperator=StringFilterOperator.Contains AllowFilteringByAllStringColumns=true
                                                TextProperty="@nameof(Cliente.RazonSocial)" ValueProperty="@nameof(Cliente.CodigoCliente)"
                                                AllowVirtualization="true" Change="AsignarVariables" Name="clientes" Density="Density.Compact">
                            <Columns>
                                <RadzenDropDownDataGridColumn Property="@nameof(Cliente.CodigoCliente)" Title="Código" Width="4rem" />
                                <RadzenDropDownDataGridColumn Property="@nameof(Cliente.RazonSocial)" Title="Razón Social" />
                            </Columns>
                        </RadzenDropDownDataGrid>
                        <ValidationMessage For="@(() => orden.CodCliente)" />
                    </RadzenStack>
                </RadzenColumn>
                <RadzenColumn Size="4">
                    <RadzenStack Orientation="Orientation.Vertical" Gap="0">
                        <RadzenLabel Text="Zona:" />
                        <RadzenDropDownDataGrid Data="zonas" Disabled="true" @bind-Value="orden.Zona" AllowSorting=false
                                                TextProperty="@nameof(Zonas.Descripcion)" ValueProperty="@nameof(Zonas.CodigoTango)" AllowVirtualization="true">
                            <Columns>
                                <RadzenDropDownDataGridColumn Property="@nameof(Zonas.CodigoTango)" Title="Código" Width="4rem" />
                                <RadzenDropDownDataGridColumn Property="@nameof(Zonas.Descripcion)" Title="Descripción" />
                            </Columns>
                        </RadzenDropDownDataGrid>
                        <ValidationMessage For="@(() => orden.Zona)" />
                    </RadzenStack>
                </RadzenColumn>

                <RadzenColumn Size="4">
                    <RadzenStack Orientation="Orientation.Vertical" Gap="0">
                        <RadzenLabel Text="Entregar en:" Component="sucursalesporcliente" />
                        <RadzenDropDownDataGrid Data="sucursalesPorClientes" @bind-Value="orden.Entrega" AllowSorting=false
                                                AllowFiltering=true FilterCaseSensitivity=FilterCaseSensitivity.CaseInsensitive FilterOperator=StringFilterOperator.Contains AllowFilteringByAllStringColumns=true
                                                TextProperty="@nameof(SucursalesPorCliente.DireccionCompleta)" ValueProperty="@nameof(SucursalesPorCliente.DireccionCompleta)"
                                                AllowVirtualization="true" Name="sucursalesporcliente" Density="Density.Compact">
                            <Columns>
                                <RadzenDropDownDataGridColumn Property="@nameof(SucursalesPorCliente.Direccion)" Title="Dirección" Width="9rem" />
                                <RadzenDropDownDataGridColumn Property="@nameof(SucursalesPorCliente.Localidad)" Title="Localidad" Width="8rem" />
                                <RadzenDropDownDataGridColumn Property="@nameof(SucursalesPorCliente.CodigoPostal)" Title="Cod.Postal" Width="5rem" />
                                <RadzenDropDownDataGridColumn Property="@nameof(SucursalesPorCliente.Habitual)" Title="Habitual" Width="4rem">
                                    <Template Context="sucCliente">
                                        @if (sucCliente.Habitual)
                                        {
                                            <span>SÍ</span>
                                        }
                                        else
                                        {
                                            <span>NO</span>
                                        }
                                    </Template>
                                </RadzenDropDownDataGridColumn>
                            </Columns>
                        </RadzenDropDownDataGrid>
                        <ValidationMessage For="@(() => orden.Entrega)" />
                    </RadzenStack>
                </RadzenColumn>
            </RadzenRow>

            <RadzenRow Style="margin-top:10px;">
                <RadzenColumn Size="4">
                    <RadzenStack Orientation="Orientation.Vertical" Gap="0">
                        <RadzenLabel Text="Lista de precios:" />
                        <RadzenDropDownDataGrid Data="listasDePrecio" @bind-Value="orden.CodListaPrecio" Disabled="@(SesionDTO.Rol != "1")" Density="Density.Compact" Change=ClearGrid
                                                TextProperty="@nameof(ListaDePrecios.Descripcion)" ValueProperty="@nameof(ListaDePrecios.CodigoTango)" AllowVirtualization="true">
                            <Columns>
                                <RadzenDropDownDataGridColumn Property="@nameof(ListaDePrecios.CodigoTango)" Title="Código" Width="4rem" />
                                <RadzenDropDownDataGridColumn Property="@nameof(ListaDePrecios.Descripcion)" Title="Descripción" />
                            </Columns>
                        </RadzenDropDownDataGrid>
                        <ValidationMessage For="@(() => orden.CodListaPrecio)" />
                    </RadzenStack>
                </RadzenColumn>

                <RadzenColumn Size="4">
                    <RadzenStack Orientation="Orientation.Vertical" Gap="0">
                        <RadzenLabel Text="Cond.Venta:" />
                        <RadzenDropDownDataGrid Data="condicionesDeVenta" @bind-Value="orden.CondicionVenta" Density="Density.Compact" AllowSorting=false Disabled="true"
                                                AllowFiltering=true FilterCaseSensitivity=FilterCaseSensitivity.CaseInsensitive FilterOperator=StringFilterOperator.Contains AllowFilteringByAllStringColumns=true
                                                TextProperty="@nameof(CondicionDeVenta.Descripcion)" ValueProperty="@nameof(CondicionDeVenta.CodigoTango)" AllowVirtualization="true">
                            <Columns>
                                <RadzenDropDownDataGridColumn Property="@nameof(CondicionDeVenta.CodigoTango)" Title="Código" Width="4rem" />
                                <RadzenDropDownDataGridColumn Property="@nameof(CondicionDeVenta.Descripcion)" Title="Descripción" />
                            </Columns>
                        </RadzenDropDownDataGrid>
                        <ValidationMessage For="@(() => orden.CondicionVenta)" />
                    </RadzenStack>
                </RadzenColumn>

                <RadzenColumn Size="3">
                    <RadzenStack Orientation="Orientation.Vertical" Gap="0">
                        <RadzenLabel Text="F.Entrega:" />
                        <RadzenDatePicker @bind-Value="orden.FechaEntrega" DateFormat="dd/MM/yyyy" Min="DateTime.Today" />
                    </RadzenStack>
                    <ValidationMessage For="@(() => orden.FechaEntrega)" />
                </RadzenColumn>
            </RadzenRow>

            <RadzenRow Style="margin-top:10px;">
                <RadzenColumn Size="4">
                    <RadzenStack Orientation="Orientation.Vertical" Gap="0">
                        <RadzenLabel Text="Transporte:" />
                        <RadzenDropDownDataGrid Data="transportes" @bind-Value="orden.CodTransporte" Density="Density.Compact" AllowSorting=false
                                                AllowFiltering=true FilterCaseSensitivity=FilterCaseSensitivity.CaseInsensitive FilterOperator=StringFilterOperator.Contains AllowFilteringByAllStringColumns=true
                                                TextProperty="@nameof(Transporte.Descripcion)" ValueProperty="@nameof(Transporte.CodigoTango)" AllowVirtualization="true">
                            <Columns>
                                <RadzenDropDownDataGridColumn Property="@nameof(Transporte.CodigoTango)" Title="Código" Width="4rem" />
                                <RadzenDropDownDataGridColumn Property="@nameof(Transporte.Descripcion)" Title="Descripción" />
                            </Columns>
                        </RadzenDropDownDataGrid>
                    </RadzenStack>
                </RadzenColumn>

                <RadzenColumn Size="3">
                    <RadzenStack Orientation="Orientation.Vertical" Gap="0">
                        <RadzenLabel Text="O.C.:" />
                        <RadzenTextArea @bind-Value="orden.Notas" />
                        <ValidationMessage For="@(() => orden.Notas)" />
                    </RadzenStack>
                </RadzenColumn>

                <RadzenColumn Size="2">
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems=AlignItems.Center Style="height:100%;">
                        <RadzenStack Orientation="Orientation.Horizontal" Gap="0">
                            <RadzenLabel Text="F:" />
                            <RadzenCheckBox @bind-Value="@orden.Factura" />
                        </RadzenStack>

                        <RadzenStack Orientation="Orientation.Horizontal" Gap="0">
                            <RadzenLabel Text="P:" />
                            <RadzenCheckBox @bind-Value="@orden.Presupuesto" />
                        </RadzenStack>
                    </RadzenStack>
                </RadzenColumn>
            </RadzenRow>
            <RadzenRow Style="margin-top:10px;">

                <RadzenColumn Size="8">
                    <RadzenStack Orientation="Orientation.Vertical" Gap="0">
                        <RadzenLabel Text="Notas:" />
                        <RadzenTextArea @bind-Value="orden.ObservacionesZentra" />
                        <ValidationMessage For="@(() => orden.ObservacionesZentra)" />
                    </RadzenStack>
                </RadzenColumn>

                <RadzenColumn Size="4">
                    <RadzenStack Orientation="Orientation.Vertical" Gap="0">
                        <RadzenLabel Text="Ofertas:" />
                        <RadzenDropDown AllowFiltering="true" AllowVirtualization="true" Data="ofertas" @bind-Value="ofertasSeleccionadas"
                                        TextProperty="@nameof(Oferta.Nombre)" ValueProperty="@nameof(Oferta.IdOferta)" Multiple="true" AllowClear="true"
                                        Placeholder="Seleccionar ofertas..." MaxSelectedLabels="2" SelectAllText="Todas" SelectedItemsText="seleccionadas" />
                    </RadzenStack>
                </RadzenColumn>
            </RadzenRow>
        </RadzenFieldset>

        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.Center" AlignItems="AlignItems.Center">
            <CustomFileInput @ref=refFileInput @bind-BytesFile=request.File ChangeFile="ClearGrid" />
            <RadzenButton ButtonStyle="ButtonStyle.Info" Text="Procesar" Icon="upload" Click="ProcesarArchivo" Size="ButtonSize.Small" Disabled=isLoading />
        </RadzenStack>

        <RadzenDataGrid @ref=refGrid Data="lstProductos" Style="display:grid" ShowEmptyMessage=false ColumnWidth="200px"
                        Density="Density.Compact"
                        AllowSorting=true AllowFiltering=true AllowColumnResize=true FilterMode="FilterMode.Simple" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive">
            <Columns>
                <RadzenDataGridColumn Property="@nameof(ProductoOrden.CodigoProducto)" Title="Cód." Width="80px" />
                <RadzenDataGridColumn Property="@nameof(ProductoOrden.Descripcion)" Title="Descripción" />
                <RadzenDataGridColumn Property="@nameof(ProductoOrden.CantidadSeleccionada)" Title="Cant." Width="50px" TextAlign="TextAlign.Right" />
                <RadzenDataGridColumn Property="@nameof(ProductoOrden.CantidadProbador)" Title="Probadores" Width="50px" TextAlign="TextAlign.Right" />
                <RadzenDataGridColumn Property="@nameof(ProductoOrden.Descuento)" Title="Descuento" Width="50px" FormatString="{0:P2}" TextAlign="TextAlign.Right" />
                <RadzenDataGridColumn Property="@nameof(ProductoOrden.Precio)" Title="Unitario" Width="90px" FormatString="${0:N2}" TextAlign="TextAlign.Right" />
                <RadzenDataGridColumn Property="@nameof(ProductoOrden.PrecioTotal)" Title="Total" Width="90px" FormatString="${0:N2}" TextAlign="TextAlign.Right">
                    <FooterTemplate>
                        <strong>
                            Total: $@(lstProductos.Sum(x => x.PrecioTotal).ToString("N2"))
                        </strong>
                    </FooterTemplate>
                </RadzenDataGridColumn>
                @* <RadzenDataGridColumn Width="20px" Frozen=true FrozenPosition="FrozenColumnPosition.Right" Resizable=false TextAlign="TextAlign.Center">
                    <Template Context="data">
                        <RadzenButton ButtonStyle="ButtonStyle.Danger" Icon="delete" Size="ButtonSize.ExtraSmall" Click="@(()=>DeleteRow(data))" />
                    </Template>
                </RadzenDataGridColumn> *@
            </Columns>
        </RadzenDataGrid>

        <RadzenStack JustifyContent="JustifyContent.Center" Gap="3rem" Orientation="Orientation.Horizontal" class="rz-mt-2">
            <RadzenButton ButtonStyle="ButtonStyle.Danger" Icon="cancel" Text="Cancelar" Click="Cancelar" />
            <RadzenButton ButtonStyle="ButtonStyle.Success" Icon="save" ButtonType="ButtonType.Submit" Text="Guardar" />
        </RadzenStack>

    </RadzenTemplateForm>
}
else
{
    <Loader />
}

@code {
    bool showPage, seleccionaVendedor, isLoading;
    Orden orden = new() { IdEstado = 1 };
    EditContext editContext;
    CustomValidation customValidation;

    List<Transporte> transportes = new();
    List<ListaDePrecios> listasDePrecio = new();
    List<CondicionDeVenta> condicionesDeVenta = new();
    List<Zonas> zonas = new();
    List<Cliente> clientes = new();
    List<ArticulosPorCliente> articulosPorClientes = new();
    List<SucursalesPorCliente> sucursalesPorClientes = new();
    List<int> ofertasSeleccionadas = new();
    List<ProductoOrden> lstProductos = new();
    RadzenDataGrid<ProductoOrden> refGrid;
    List<Oferta> ofertas = new();

    CustomFileInput refFileInput;
    ByteArrayRequest request = new();

    protected override async Task OnInitializedAsync()
    {
        var permisos = await SeguridadService.GetPermisos("Ordenes");
        if (!permisos.Contains("alta"))
            NavigationManager.NavigateTo(Variables.ErrorPages.Desautorizado);

        seleccionaVendedor = permisos.Contains("seleccionaVendedor");

        clientes = await ClientesService.GetClientes(null, null, null, null);
        transportes = await OrdenesService.GetTransportes();
        listasDePrecio = await OrdenesService.GetListasDePrecio();
        condicionesDeVenta = await OrdenesService.GetCondicionesDeVenta();
        zonas = await OrdenesService.GetZonas();
        ofertas = await OfertasService.GetOfertas(null, null, null, null, true);
        editContext = new(orden);

        showPage = true;
    }

    private async Task Guardar()
    {
    }

    private async Task Cancelar()
    {
        if (!editContext.IsModified() || await DialogService.Confirm(MensajesHelper.Cancel(), MensajesHelper.Title, new() { OkButtonText = "Sí", CancelButtonText = "No" }) == true)
            NavigationManager.NavigateTo("ordenes");
    }

    private async Task ClearGrid()
    {
        if (lstProductos.Any())
        {
            NotificationService.Notify(NotificationSeverity.Info, "Alguno de los datos de la orden ha cambiado", "Procese el archivo nuevamente");
            lstProductos.Clear();
            await refGrid.Reload();
        }
    }

    private async Task ProcesarArchivo()
    {
        if (request.File == null)
            NotificationService.Notify(NotificationSeverity.Info, "Debe ingresar un archivo");
        else if (string.IsNullOrEmpty(orden.CodCliente))
            NotificationService.Notify(NotificationSeverity.Info, "Debe seleccionar un cliente");
        else if (string.IsNullOrEmpty(orden.CodListaPrecio))
            NotificationService.Notify(NotificationSeverity.Info, "Debe seleccionar una lista de precio");
        else
        {
            isLoading = true;
            DialogCustom.OpenProgressBar("Procesando archivo");
            await SignalRService.StartConnection();
            request.CodListaPrecio = orden.CodListaPrecio;
            request.CodCliente = orden.CodCliente;
            request.ConnectionId = SignalRService.GetConnectionId();
            if (ofertasSeleccionadas.Any())
                request.OfertasSeleccionadas = string.Join(",", ofertasSeleccionadas);

            var response = await ProductosService.ProcesarArchivo(request);
            DialogCustom.CloseDialog();
            if (response.IsSuccessStatusCode)
            {
                lstProductos = (List<ProductoOrden>)response.Data;
            }
            else if (response.Errors != null && response.Errors.Count > 0)
                DialogCustom.ShowErrors(response.Errors);
            else
                DialogCustom.NotifyInternalServerError();

            isLoading = false;
        }
    }

    async Task AsignarVariables()
    {
        DialogCustom.OpenBusyWithLoader("Cargando...");
        articulosPorClientes = await ClientesService.GetArticulosPorCliente(orden.CodCliente);
        sucursalesPorClientes = await ClientesService.GetSucursalesPorCliente(orden.CodCliente);
        var index = clientes.FindIndex(x => x.CodigoCliente == orden.CodCliente);
        orden.CodListaPrecio = clientes[index].CodListaPrecioDefault!;
        orden.CondicionVenta = clientes[index].CondVentaDefault;
        orden.Zona = clientes[index].ZonaDefault;
        editContext.NotifyFieldChanged(editContext.Field(nameof(Orden.Cliente)));
        editContext.NotifyFieldChanged(editContext.Field(nameof(Orden.CondicionVenta)));
        editContext.NotifyFieldChanged(editContext.Field(nameof(Orden.CodListaPrecio)));
        editContext.NotifyFieldChanged(editContext.Field(nameof(Orden.Zona)));

        await ClearGrid();

        DialogCustom.CloseDialog();
    }

    private async Task DeleteRow(ProductoOrden p)
    {
        lstProductos.Remove(p);
        await refGrid.Reload();
    }

    public async ValueTask DisposeAsync()
    {
        await SignalRService.StopConnection();
    }
}
