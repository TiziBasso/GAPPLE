@page "/orden/creacion/excel"
@page "/orden/edicion/{CodOrden}"

@implements IAsyncDisposable

@inject SeguridadService SeguridadService
@inject ProductosService ProductosService
@inject OrdenesService OrdenesService
@inject ClientesService ClientesService
@inject NavigationManager NavigationManager
@inject OfertasService OfertasService
@inject NotificationService NotificationService
@inject DialogService DialogService
@inject RadzenDialogService RadzenDialogService
@inject SesionDTO SesionDTO
@inject SignalRService SignalRService
@inject IJSFunction JSFunction
@using System.Linq
@using GAPPLE.Client.Components.Ordenes
@using GAPPLE.Client.ComponentsUI
@using GAPPLE.Client.Components.Productos


@if (showPage)
{
    <RadzenTemplateForm Data="orden" TItem="Orden" Submit="Guardar" EditContext="editContext"
                        Style="display: grid;grid-template-rows: auto auto 1fr auto;height: calc(100vh - 83px); gap:10px;">
        <DataAnnotationsValidator />
        <CustomValidation @ref="customValidation" />

        <RadzenFieldset AllowCollapse="true" Text="@($"Orden cabecera" + orden != null && orden.CodCliente != null ? clientes.Find(x => x.CodigoCliente == orden.CodCliente)!.RazonSocial : "Seleccionar cliente")">
            <RadzenRow Style="margin-top:10px;">
                <RadzenColumn Size="4">
                    <RadzenStack Orientation="Orientation.Vertical" Gap="0">
                        <RadzenLabel Text="Cliente:" />
                        <RadzenDropDownDataGrid Data="clientes" @bind-Value="orden.CodCliente" AllowSorting=false
                                                AllowFiltering=true FilterCaseSensitivity=FilterCaseSensitivity.CaseInsensitive FilterOperator=StringFilterOperator.Contains AllowFilteringByAllStringColumns=true
                                                TextProperty="@nameof(Cliente.RazonSocial)" ValueProperty="@nameof(Cliente.CodigoCliente)"
                                                AllowVirtualization="true" Change="AsignarVariables" Name="clientes" Density="Density.Compact">
                            <Columns>
                                <RadzenDropDownDataGridColumn Property="@nameof(Cliente.CodigoCliente)" Title="Código" Width="4rem" />
                                <RadzenDropDownDataGridColumn Property="@nameof(Cliente.RazonSocial)" Title="Razón Social" />
                            </Columns>
                        </RadzenDropDownDataGrid>
                        <ValidationMessage For="@(() => orden.CodCliente)" />
                    </RadzenStack>
                </RadzenColumn>
                <RadzenColumn Size="4">
                    <RadzenStack Orientation="Orientation.Vertical" Gap="0">
                        <RadzenLabel Text="Zona:" />
                        <RadzenDropDownDataGrid Data="zonas" Disabled="true" @bind-Value="orden.Zona" AllowSorting=false
                                                TextProperty="@nameof(Zonas.Descripcion)" ValueProperty="@nameof(Zonas.CodigoTango)" AllowVirtualization="true">
                            <Columns>
                                <RadzenDropDownDataGridColumn Property="@nameof(Zonas.CodigoTango)" Title="Código" Width="4rem" />
                                <RadzenDropDownDataGridColumn Property="@nameof(Zonas.Descripcion)" Title="Descripción" />
                            </Columns>
                        </RadzenDropDownDataGrid>
                        <ValidationMessage For="@(() => orden.Zona)" />
                    </RadzenStack>
                </RadzenColumn>

                <RadzenColumn Size="4">
                    <RadzenStack Orientation="Orientation.Vertical" Gap="0">
                        <RadzenLabel Text="Entregar en:" Component="sucursalesporcliente" />
                        @if (!unico)
                        {
                            <RadzenDropDownDataGrid Data="sucursalesPorClientes" @bind-Value="orden.Entrega" AllowSorting=false
                                                    AllowFiltering=true FilterCaseSensitivity=FilterCaseSensitivity.CaseInsensitive FilterOperator=StringFilterOperator.Contains AllowFilteringByAllStringColumns=true
                                                    TextProperty="@nameof(SucursalesPorCliente.DireccionCompleta)" ValueProperty="@nameof(SucursalesPorCliente.DireccionCompleta)"
                                                    AllowVirtualization="true" Name="sucursalesporcliente" Density="Density.Compact">
                                <Columns>
                                    <RadzenDropDownDataGridColumn Property="@nameof(SucursalesPorCliente.Direccion)" Title="Dirección" Width="9rem" />
                                    <RadzenDropDownDataGridColumn Property="@nameof(SucursalesPorCliente.Localidad)" Title="Localidad" Width="8rem" />
                                    <RadzenDropDownDataGridColumn Property="@nameof(SucursalesPorCliente.CodigoPostal)" Title="Cod.Postal" Width="5rem" />
                                    <RadzenDropDownDataGridColumn Property="@nameof(SucursalesPorCliente.Habitual)" Title="Habitual" Width="4rem">
                                        <Template Context="sucCliente">
                                            @if (sucCliente.Habitual)
                                            {
                                                <span>SÍ</span>
                                            }
                                            else
                                            {
                                                <span>NO</span>
                                            }
                                        </Template>
                                    </RadzenDropDownDataGridColumn>
                                </Columns>
                            </RadzenDropDownDataGrid>
                        }
                        else
                        {
                            <RadzenTextBox Disabled="unico" @bind-Value=entrega />
                        }
                        <ValidationMessage For="@(() => orden.Entrega)" />
                    </RadzenStack>
                </RadzenColumn>
            </RadzenRow>

            <RadzenRow Style="margin-top:10px;">
                <RadzenColumn Size="4">
                    <RadzenStack Orientation="Orientation.Vertical" Gap="0">
                        <RadzenLabel Text="Lista de precios:" />
                        <RadzenDropDownDataGrid Data="listasDePrecio" @bind-Value="orden.CodListaPrecio" Disabled="@(SesionDTO.Rol != "1")" Density="Density.Compact" Change="ClearGrid"
                                                TextProperty="@nameof(ListaDePrecios.Descripcion)" ValueProperty="@nameof(ListaDePrecios.CodigoTango)" AllowVirtualization="true"
                                                FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" AllowFilteringByAllStringColumns=true FilterOperator="StringFilterOperator.Contains">
                            <Columns>
                                <RadzenDropDownDataGridColumn Property="@nameof(ListaDePrecios.CodigoTango)" Title="Código" Width="4.5rem" />
                                <RadzenDropDownDataGridColumn Property="@nameof(ListaDePrecios.Descripcion)" Title="Descripción" />
                            </Columns>
                        </RadzenDropDownDataGrid>
                        <ValidationMessage For="@(() => orden.CodListaPrecio)" />
                    </RadzenStack>
                </RadzenColumn>

                <RadzenColumn Size="4">
                    <RadzenStack Orientation="Orientation.Vertical" Gap="0">
                        <RadzenLabel Text="Cond.Venta:" />
                        <RadzenDropDownDataGrid Data="condicionesDeVenta" @bind-Value="orden.CondicionVenta" Density="Density.Compact" AllowSorting=false Disabled="true"
                                                AllowFiltering=true FilterCaseSensitivity=FilterCaseSensitivity.CaseInsensitive FilterOperator=StringFilterOperator.Contains AllowFilteringByAllStringColumns=true
                                                TextProperty="@nameof(CondicionDeVenta.Descripcion)" ValueProperty="@nameof(CondicionDeVenta.CodigoTango)" AllowVirtualization="true">
                            <Columns>
                                <RadzenDropDownDataGridColumn Property="@nameof(CondicionDeVenta.CodigoTango)" Title="Código" Width="4rem" />
                                <RadzenDropDownDataGridColumn Property="@nameof(CondicionDeVenta.Descripcion)" Title="Descripción" />
                            </Columns>
                        </RadzenDropDownDataGrid>
                        <ValidationMessage For="@(() => orden.CondicionVenta)" />
                    </RadzenStack>
                </RadzenColumn>

                <RadzenColumn Size="3">
                    <RadzenStack Orientation="Orientation.Vertical" Gap="0">
                        <RadzenLabel Text="F.Entrega:" />
                        <RadzenDatePicker @bind-Value="orden.FechaEntrega" DateFormat="dd/MM/yyyy" Min="DateTime.Today" />
                    </RadzenStack>
                    <ValidationMessage For="@(() => orden.FechaEntrega)" />
                </RadzenColumn>
            </RadzenRow>

            <RadzenRow Style="margin-top:10px;">
                <RadzenColumn Size="4">
                    <RadzenStack Orientation="Orientation.Vertical" Gap="0">
                        <RadzenLabel Text="Transporte:" />
                        <RadzenDropDownDataGrid Data="transportes" @bind-Value="orden.CodTransporte" Density="Density.Compact" AllowSorting=false
                                                AllowFiltering=true FilterCaseSensitivity=FilterCaseSensitivity.CaseInsensitive FilterOperator=StringFilterOperator.Contains AllowFilteringByAllStringColumns=true
                                                TextProperty="@nameof(Transporte.Descripcion)" ValueProperty="@nameof(Transporte.CodigoTango)" AllowVirtualization="true">
                            <Columns>
                                <RadzenDropDownDataGridColumn Property="@nameof(Transporte.CodigoTango)" Title="Código" Width="4rem" />
                                <RadzenDropDownDataGridColumn Property="@nameof(Transporte.Descripcion)" Title="Descripción" />
                            </Columns>
                        </RadzenDropDownDataGrid>
                    </RadzenStack>
                </RadzenColumn>

                <RadzenColumn Size="3">
                    <RadzenStack Orientation="Orientation.Vertical" Gap="0">
                        <RadzenLabel Text="O.C.:" />
                        <RadzenTextArea @bind-Value="orden.Notas" />
                        <ValidationMessage For="@(() => orden.Notas)" />
                    </RadzenStack>
                </RadzenColumn>

                <RadzenColumn Size="2">
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems=AlignItems.Center Style="height:100%;">
                        <RadzenStack Orientation="Orientation.Horizontal" Gap="0">
                            <RadzenLabel Text="F:" />
                            <RadzenCheckBox @bind-Value="@orden.Factura" />
                        </RadzenStack>

                        <RadzenStack Orientation="Orientation.Horizontal" Gap="0">
                            <RadzenLabel Text="P:" />
                            <RadzenCheckBox @bind-Value="@orden.Presupuesto" />
                        </RadzenStack>
                    </RadzenStack>
                </RadzenColumn>
            </RadzenRow>
            <RadzenRow Style="margin-top:10px;">

                <RadzenColumn Size="4">
                    <RadzenStack Orientation="Orientation.Vertical" Gap="0">
                        <RadzenLabel Text="Notas:" />
                        <RadzenTextArea @bind-Value="orden.ObservacionesZentra" />
                        <ValidationMessage For="@(() => orden.ObservacionesZentra)" />
                    </RadzenStack>
                </RadzenColumn>

                <RadzenColumn Size="4">
                    <RadzenStack Orientation="Orientation.Vertical" Gap="0">
                        <RadzenLabel Text="Ofertas comunes:" />
                        <RadzenDropDown AllowFiltering="true" AllowVirtualization="true" Data="ofertas" @bind-Value="ofertasSeleccionadas" Change="RecalcularOfertas"
                                        TextProperty="@nameof(Oferta.Nombre)" ValueProperty="@nameof(Oferta.IdOferta)" Multiple="true" AllowClear="true"
                                        Placeholder="Seleccionar ofertas..." MaxSelectedLabels="2" SelectAllText="Todas" SelectedItemsText="seleccionadas" />
                    </RadzenStack>
                </RadzenColumn>

                <RadzenColumn Size="4">
                    <RadzenStack Orientation="Orientation.Vertical" Gap="0">
                        <RadzenLabel Text="Ofertas especiales:" />
                        <RadzenDropDown AllowFiltering="true" AllowVirtualization="true" Data="ofertasEspeciales" @bind-Value="ofertasEspecialesSeleccionadas" Change="RecalcularOfertas"
                                        TextProperty="@nameof(Oferta.Nombre)" ValueProperty="@nameof(Oferta.IdOferta)" Multiple="true" AllowClear="true"
                                        Placeholder="@(string.IsNullOrEmpty(orden.CodCliente) ? "Seleccione un cliente primero" : "Seleccionar ofertas especiales...")"
                                        Disabled="@(string.IsNullOrEmpty(orden.CodCliente))"
                                        MaxSelectedLabels="2" SelectAllText="Todas" SelectedItemsText="seleccionadas" />
                    </RadzenStack>
                </RadzenColumn>
            </RadzenRow>
        </RadzenFieldset>

        <RadzenDataGrid @ref=refGrid Data="lstProductos" Style="display:grid; grid-template-rows: auto 1fr; min-height:30rem;" ShowEmptyMessage=false ColumnWidth="200px"
                        Density="Density.Compact"
                        AllowSorting=true AllowFiltering=true AllowColumnResize=true FilterMode="FilterMode.Simple" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive">
            <HeaderTemplate>
                <RadzenButton ButtonStyle="ButtonStyle.Secondary" Icon="add" Text="Agregar producto" Click="@InsertRow" Size="ButtonSize.Small" Disabled=@(string.IsNullOrEmpty(orden.CodCliente) || string.IsNullOrEmpty(orden.CodListaPrecio)) />
                <RadzenButton ButtonStyle="ButtonStyle.Secondary" Icon="search" Text="Buscar producto" Click="@HandleBuscarSKU" Size="ButtonSize.Small" Disabled=@(string.IsNullOrEmpty(orden.CodCliente) || string.IsNullOrEmpty(orden.CodListaPrecio)) />
                <RadzenButton ButtonStyle="ButtonStyle.Primary" Icon="upload_file" Text="Cargar Excel" Click="AbrirModalExcel" Size="ButtonSize.Small" Disabled="@(string.IsNullOrEmpty(orden.CodCliente) || string.IsNullOrEmpty(orden.CodListaPrecio))" />
            </HeaderTemplate>
            <Columns>
                <RadzenDataGridColumn Property="@nameof(ProductoOrden.CodigoProducto)" Title="Cód." Width="90px">
                    <Template Context="data">
                        @if (data.IdProducto == 0)
                        {
                            <input id="sku-@lstProductos.IndexOf(data)" type="text"
                                   @bind-value="data.CodigoProducto" @bind-value:event="oninput"
                                   @onfocusout="@(() => HandleSKUFocusOut(data))"
                                   class="rz-textbox" style="width:100%; height:25px;" />
                        }
                        else
                        {
                            @data.CodigoProducto
                        }
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn Property="@nameof(ProductoOrden.Descripcion)" Title="Descripción" Width="300px" />
                <RadzenDataGridColumn Property="@nameof(ProductoOrden.CantidadSeleccionada)" Title="Cant. P" Width="150px" TextAlign="TextAlign.Right" Visible=@(orden.Presupuesto)>
                    <Template Context="data">
                        <RadzenNumeric @bind-Value=data.CantidadSeleccionada Min="0" TValue="int"
                                       ShowUpDown=false AutoCompleteType="AutoCompleteType.Off" TextAlign="TextAlign.Right" Style="width:100%" />
                    </Template>
                    <FooterTemplate>
                        <strong>Total P: @(lstProductos.Sum(x => x.CantidadSeleccionada).ToString())</strong>
                    </FooterTemplate>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn Property="@nameof(ProductoOrden.CantidadSeleccionada)" Title="Cant F." Width="150px" TextAlign="TextAlign.Right" Visible=@(orden.Factura)>
                    <Template Context="data">
                        <RadzenNumeric @bind-Value=data.CantidadSeleccionada Min="0" TValue="int" Disabled="@(orden.Presupuesto)"
                                       ShowUpDown=false AutoCompleteType="AutoCompleteType.Off" TextAlign="TextAlign.Right" Style="width:100%" />
                    </Template>
                    <FooterTemplate>
                        <strong>Total F: @(lstProductos.Sum(x => x.CantidadSeleccionada).ToString())</strong>
                    </FooterTemplate>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn Title="Cant. T" Width="150px" TextAlign="TextAlign.Right" Context="data" Visible=@(orden.Factura && orden.Presupuesto)>
                    <Template>
                        @(data.CantidadSeleccionada * 2)
                    </Template>
                    <FooterTemplate>
                        <strong>Total: @(lstProductos.Sum(x => x.CantidadSeleccionada * 2).ToString())</strong>
                    </FooterTemplate>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn Visible=@(orden.Factura || orden.Presupuesto) Property="@nameof(ProductoOrden.CantidadProbador)" Title="Probadores" Width="100px" TextAlign="TextAlign.Right">
                    <Template Context="data">
                        <RadzenNumeric @bind-Value=data.CantidadProbador Min="0" TValue="int"
                                       ShowUpDown=false AutoCompleteType="AutoCompleteType.Off" TextAlign="TextAlign.Right" Style="width:100%" />
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn Visible=@(orden.Factura || orden.Presupuesto) Property="@nameof(ProductoOrden.CantidadObsequio)" Title="Obsequios" Width="100px" TextAlign="TextAlign.Right">
                    <Template Context="data">
                        <RadzenNumeric @bind-Value=data.CantidadObsequio Min="0" TValue="int"
                                       ShowUpDown=false AutoCompleteType="AutoCompleteType.Off" TextAlign="TextAlign.Right" Style="width:100%" />
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn Property="@nameof(ProductoOrden.DescuentoTotal)" Title="Descuento" FormatString="{0:N2}%" TextAlign="TextAlign.Right" Width="100px">
                    <Template Context="data">
                        @if (permisoDescuento)
                        {
                            <RadzenNumeric @bind-Value=data.DescuentoTotal Min="0" Max="100" TValue="decimal" Change="@(args => ChangeDescuento(data))"
                                           ShowUpDown=false AutoCompleteType="AutoCompleteType.Off" TextAlign="TextAlign.Right" Style="width:100%" />
                        }
                        else
                        {
                            @data.DescuentoTotal
                        }
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn Property="@nameof(ProductoOrden.Precio)" Title="Unitario" Width="100px" FormatString="${0:N2}" TextAlign="TextAlign.Right" />
                <RadzenDataGridColumn Property="@nameof(ProductoOrden.PrecioConDescuento)" Title="Unit. c/desc" Width="100px" FormatString="${0:N2}" TextAlign="TextAlign.Right" />
                <RadzenDataGridColumn Property="@nameof(ProductoOrden.PrecioTotal)" Context="precio" Title="Total" Width="100px" FormatString="${0:N2}" TextAlign="TextAlign.Right">
                    <Template>
                        @if (orden.Presupuesto && orden.Factura)
                        {
                            <span>$@((precio.PrecioTotal * 2).ToString("N2"))</span>
                        }
                        else if (orden.Presupuesto || orden.Factura)
                        {
                            <span>$@precio.PrecioTotal.ToString("N2")</span>
                        }
                        else
                        {
                            <span>$@((0).ToString("N2"))</span>
                        }
                    </Template>
                    <FooterTemplate>
                        @if (orden.Presupuesto && orden.Factura)
                        {
                            <strong>Total: $@(lstProductos.Sum(x => x.PrecioTotal * 2).ToString("N2"))</strong>
                        }
                        else if (orden.Presupuesto || orden.Factura)
                        {
                            <strong>Total: $@(lstProductos.Sum(x => x.PrecioTotal).ToString("N2"))</strong>
                        }
                        else
                        {
                            <strong>Total: $@((0).ToString("N2"))</strong>
                        }
                    </FooterTemplate>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TextAlign="TextAlign.Center" Sortable=false Filterable=false Width="40px" Frozen=true FrozenPosition="FrozenColumnPosition.Right" Resizable=false>
                    <Template Context="data">
                        <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.ExtraSmall"
                                      Click="@(() => EliminarProducto(data))" @onclick:stopPropagation="true" title="Eliminar" />
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>

        <RadzenStack JustifyContent="JustifyContent.Center" Gap="3rem" Orientation="Orientation.Horizontal" class="rz-mt-2">
            <RadzenButton ButtonStyle="ButtonStyle.Danger" Icon="cancel" Text="Cancelar" Click="Cancelar" />
            <RadzenButton ButtonStyle="ButtonStyle.Success" Icon="save" ButtonType="ButtonType.Submit" Text="Guardar" />
        </RadzenStack>

    </RadzenTemplateForm>
}
else
{
    <Loader />
}

@code {
    [Parameter] public string CodOrden { get; set; }

    bool modoEdicion => !string.IsNullOrEmpty(CodOrden);

    bool showPage, seleccionaVendedor, isLoading, unico, permisoDescuento;
    string entrega;
    Orden orden = new() { IdEstado = 1, Linea = "excel" };
    EditContext editContext;
    CustomValidation customValidation;

    List<Transporte> transportes = new();
    List<ListaDePrecios> listasDePrecio = new();
    List<CondicionDeVenta> condicionesDeVenta = new();
    List<Zonas> zonas = new();
    List<Cliente> clientes = new();
    List<SucursalesPorCliente> sucursalesPorClientes = new();

    List<ProductoOrden> lstProductos = new();
    RadzenDataGrid<ProductoOrden> refGrid;
    bool isLoadingSKU;
    List<Oferta> ofertas = new();
    List<Oferta> ofertasEspeciales = new();
    List<int> ofertasSeleccionadas = new();
    List<int> ofertasEspecialesSeleccionadas = new();
    Dictionary<string, List<Oferta>> codigosEnOfertas = new();

    protected override async Task OnInitializedAsync()
    {
        var permisos = await SeguridadService.GetPermisos("Ordenes");
        if (!permisos.Contains("alta"))
            NavigationManager.NavigateTo(Variables.ErrorPages.Desautorizado);

        seleccionaVendedor = permisos.Contains("seleccionaVendedor");
        permisoDescuento = permisos.Contains(Permisos.DescuentoManual);

        clientes = await ClientesService.GetClientes(null, null, null, null);
        transportes = await OrdenesService.GetTransportes();
        listasDePrecio = await OrdenesService.GetListasDePrecio();
        condicionesDeVenta = await OrdenesService.GetCondicionesDeVenta();
        zonas = await OrdenesService.GetZonas();

        if (modoEdicion)
        {
            await CargarOrdenExistente();
        }
        else
        {
            var aux = await OfertasService.GetOfertas(null, null, null, true);
            ofertas = [.. aux.Where(x => x.Desde < DateTime.Now && x.Hasta > DateTime.Now)];
            orden = new() { IdEstado = 1, Linea = "excel" };
        }

        editContext = new(orden);
        showPage = true;
    }

    private async Task CargarOrdenExistente()
    {
        orden = await OrdenesService.GetOrden(CodOrden, true);
        orden.CodigoOrdenOriginal = orden.CodigoOrden;

        if (orden.IdEstado != 1)
        {
            await DialogService.Alert("La orden ya cambió de estado y no puede ser editada");
            NavigationManager.NavigateTo("ordenes");
            return;
        }

        orden.Factura = !orden.Presupuesto;

        sucursalesPorClientes = await ClientesService.GetSucursalesPorCliente(orden.CodCliente);
        if (sucursalesPorClientes.Count == 0)
        {
            unico = true;
            var cliente = clientes.Find(x => x.CodigoCliente == orden.CodCliente);
            entrega = $"{cliente?.Domicilio}, {cliente?.Localidad}, {cliente?.CodigoPostal}";
        }
        else if (sucursalesPorClientes.Count == 1)
        {
            unico = true;
            entrega = sucursalesPorClientes.First().DireccionCompleta;
        }

        // Cargar ofertas filtrando por vigencia
        var todasOfertas = await OfertasService.GetOfertas(null, null, null, true);
        var todasEspeciales = await OfertasService.GetOfertasEspeciales(null, null, null, true, orden.CodCliente);
        ofertas = [.. todasOfertas.Where(x => x.Desde < DateTime.Now && x.Hasta > DateTime.Now)];
        ofertasEspeciales = [.. todasEspeciales.Where(x => x.Desde < DateTime.Now && x.Hasta > DateTime.Now)];

        // Pre-seleccionar las ofertas que tenía la orden
        ofertasSeleccionadas.AddRange(ofertas.Where(o => orden.Ofertas.Contains(o.IdOferta)).Select(x => x.IdOferta));
        ofertasEspecialesSeleccionadas.AddRange(ofertasEspeciales.Where(o => orden.Ofertas.Contains(o.IdOferta)).Select(x => x.IdOferta));

        // Cargar productos desde el detalle de la orden existente
        CargarProductosDesdeDetalle();

        await RecalcularOfertas();
    }

    private void CargarProductosDesdeDetalle()
    {
        lstProductos = orden.Detalle.Select(d => new ProductoOrden
        {
            CodigoProducto = d.CodProducto,
            Descripcion = d.CodProducto, // descripción se actualiza al subir un nuevo Excel
            Linea = orden.Linea,
            CantidadSeleccionada = d.Cantidad,
            CantidadProbador = d.CantidadProbador,
            CantidadObsequio = d.CantidadObsequio,
            Precio = d.Precio,
            Pasivo = false
        }).ToList();

        // Aplicar descuentos manuales desde el detalle
        foreach (var (producto, detalle) in lstProductos.Zip(orden.Detalle))
        {
            producto.DescuentoTotal = detalle.Descuento;
        }
    }

    private async Task AbrirModalExcel()
    {
        if (string.IsNullOrEmpty(orden.CodCliente))
        {
            NotificationService.Notify(NotificationSeverity.Info, "Debe seleccionar un cliente");
            return;
        }
        if (string.IsNullOrEmpty(orden.CodListaPrecio))
        {
            NotificationService.Notify(NotificationSeverity.Info, "Debe seleccionar una lista de precio");
            return;
        }

        var ofertasStr = ofertasSeleccionadas.Any() ? string.Join(",", ofertasSeleccionadas) : null;

        var resultado = await DialogService.OpenAsync<SubirArchivoExcelModal>(
            modoEdicion ? "Actualizar productos desde Excel" : "Cargar productos desde Excel",
            new()
            {
                { "CodCliente", orden.CodCliente },
                { "CodListaPrecio", orden.CodListaPrecio },
                { "OfertasSeleccionadas", ofertasStr }
            },
            new()
            {
                Width = "fit-content",
                Height = "fit-content",
                Style = "max-width:70vw;",
                ShowClose = true,
                CloseDialogOnEsc = true,
                CloseDialogOnOverlayClick = false
            });

        if (resultado is List<ProductoArchivo> productos)
        {
            lstProductos = productos.Select(p => new ProductoOrden
            {
                IdProducto = p.IdProducto,
                CodigoProducto = p.CodigoProducto,
                Descripcion = p.Descripcion,
                Linea = p.Linea,
                CantidadSeleccionada = p.CantidadSeleccionada,
                CantidadProbador = p.CantidadProbador,
                CantidadObsequio = p.CantidadObsequio,
                DescuentoCliente = p.DescuentoCliente,
                Precio = p.Precio,
                Pasivo = p.Pasivo,
                CodComplemento = p.CodComplemento
            }).ToList();

            await RecalcularOfertas();
        }
    }

    private async Task Guardar()
    {
        if (Validar())
        {
            if (seleccionaVendedor)
            {
                orden.Usuario = await DialogService.OpenAsync<SeleccionVendedor>("Seleccionar vendedor", new() { { "Confirma", false } }, new()
                {
                    CloseDialogOnEsc = false,
                    ShowClose = false,
                    CloseDialogOnOverlayClick = false,
                    Style = "max-height:90vh; max-width:60vw;",
                    Height = "fit-content",
                    Width = "fit-content"
                });
                if (orden.Usuario == null) return;
            }

            var montoAprox = orden.Detalle.Sum(x => x.Precio * x.Cantidad * (1 - x.Descuento / 100)).ToString("N2");
            if (await DialogService.Confirm(MensajesHelper.Confirm("confirmar", $"el pedido por un monto aproximado de ${montoAprox}"), MensajesHelper.Title, new() { OkButtonText = "Sí", CancelButtonText = "No" }) == true)
            {
                RadzenDialogService.OpenBusyWithLoader("Guardando...");

                Response result;
                if (modoEdicion)
                    result = await OrdenesService.PutPedido(orden);
                else
                    result = await OrdenesService.PostPedido(orden);

                RadzenDialogService.CloseDialog();

                if (result.IsOk)
                {
                    NotificationService.Notify(NotificationSeverity.Success, MensajesHelper.SaveSuccess());
                    NavigationManager.NavigateTo("ordenes");
                }
                else
                    NotificationService.Notify(NotificationSeverity.Error, MensajesHelper.ErrorSummary500, MensajesHelper.ErrorDetail500);
            }
        }
    }

    private async Task Cancelar()
    {
        if (!editContext.IsModified() || await DialogService.Confirm(MensajesHelper.Cancel(), MensajesHelper.Title, new() { OkButtonText = "Sí", CancelButtonText = "No" }) == true)
            NavigationManager.NavigateTo("ordenes");
    }

    private async Task ClearGrid()
    {
        if (lstProductos.Any())
        {
            NotificationService.Notify(NotificationSeverity.Info, "Alguno de los datos de la orden ha cambiado", "Procese el archivo nuevamente");
            lstProductos.Clear();
            await refGrid.Reload();
        }
    }

    async Task AsignarVariables()
    {
        RadzenDialogService.OpenBusyWithLoader("Cargando...");
        sucursalesPorClientes = await ClientesService.GetSucursalesPorCliente(orden.CodCliente);
        var index = clientes.FindIndex(x => x.CodigoCliente == orden.CodCliente);
        orden.CodListaPrecio = clientes[index].CodListaPrecioDefault!;
        orden.CondicionVenta = clientes[index].CondVentaDefault;
        orden.Zona = clientes[index].ZonaDefault;
        editContext.NotifyFieldChanged(editContext.Field(nameof(Orden.Cliente)));
        editContext.NotifyFieldChanged(editContext.Field(nameof(Orden.CondicionVenta)));
        editContext.NotifyFieldChanged(editContext.Field(nameof(Orden.CodListaPrecio)));
        editContext.NotifyFieldChanged(editContext.Field(nameof(Orden.Zona)));
        orden.Entrega = null;

        if (sucursalesPorClientes.Count() == 0)
        {
            unico = true;
            var cliente = clientes.Find(x => x.CodigoCliente == orden.CodCliente);
            entrega = $"{cliente.Domicilio}, {cliente.Localidad}, {cliente.CodigoPostal}";
            orden.Entrega = entrega;
        }
        else if (sucursalesPorClientes.Count() == 1)
        {
            unico = true;
            entrega = sucursalesPorClientes.First().DireccionCompleta;
            orden.Entrega = entrega;
        }
        else
        {
            unico = false;
        }

        var aux = await OfertasService.GetOfertas(null, null, null, true);
        var aux2 = await OfertasService.GetOfertasEspeciales(null, null, null, true, orden.CodCliente);

        if (orden.Ofertas.Any())
        {
            var idsEspecialesPrevias = ofertasEspeciales.Select(o => o.IdOferta).ToList();
            orden.Ofertas.RemoveAll(x => idsEspecialesPrevias.Contains(x));
            ofertasEspecialesSeleccionadas.Clear();
        }

        ofertas = [.. aux.Where(x => x.Desde < DateTime.Now && x.Hasta > DateTime.Now)];
        ofertasEspeciales = [.. aux2.Where(x => x.Desde < DateTime.Now && x.Hasta > DateTime.Now)];
        await RecalcularOfertas();

        await ClearGrid();
        RadzenDialogService.CloseDialog();
    }

    Oferta GetOfertaConMayorDescuento(string codigoProducto)
    {
        codigosEnOfertas.TryGetValue(codigoProducto, out var ofertasDondeSeEncuentra);
        return ofertasDondeSeEncuentra.OrderByDescending(o => o.Descuento).FirstOrDefault();
    }

    private async Task RecalcularOfertas()
    {
        var idsComunesActuales = ofertas.Select(o => o.IdOferta).ToList();
        var idsEspecialesActuales = ofertasEspeciales.Select(o => o.IdOferta).ToList();

        orden.Ofertas.Clear();

        if (ofertasSeleccionadas != null)
            orden.Ofertas.AddRange(ofertasSeleccionadas.Where(id => idsComunesActuales.Contains(id)));

        if (ofertasEspecialesSeleccionadas != null)
            orden.Ofertas.AddRange(ofertasEspecialesSeleccionadas.Where(id => idsEspecialesActuales.Contains(id) && !orden.Ofertas.Contains(id)));

        if (orden.Ofertas != null && orden.Ofertas.Any())
        {
            var todas = ofertas.Concat(ofertasEspeciales);
            var ofertasFiltradas = todas.Where(o => orden.Ofertas.Contains(o.IdOferta));

            codigosEnOfertas = ofertasFiltradas
                .SelectMany(o => (o.Inclusiones ?? string.Empty)
                    .Split('|', StringSplitOptions.RemoveEmptyEntries)
                    .Select(codigo => new { CodigoProducto = codigo, Oferta = o }))
                .GroupBy(x => x.CodigoProducto)
                .ToDictionary(g => g.Key, g => g.Select(x => x.Oferta).ToList());
        }
        else
        {
            codigosEnOfertas.Clear();
        }

        foreach (var product in lstProductos)
        {
            if (codigosEnOfertas != null && codigosEnOfertas.Any() && codigosEnOfertas.ContainsKey(product.CodigoProducto))
                product.DescuentoOferta = GetOfertaConMayorDescuento(product.CodigoProducto).Descuento;
            else
                product.DescuentoOferta = 0;
        }

        if (refGrid != null)
            await refGrid.Reload();
    }

    private void ChangeDescuento(ProductoOrden p)
    {
        refGrid.UpdateRow(p);
    }

    private async Task InsertRow()
    {
        var nuevaFila = new ProductoOrden { IdProducto = 0, CantidadSeleccionada = 1 };
        lstProductos.Add(nuevaFila);
        await refGrid.Reload();
        await Task.Delay(10);
        await JSFunction.FocusInput($"sku-{lstProductos.Count - 1}");
    }

    private async Task HandleSKUFocusOut(ProductoOrden fila)
    {
        if (string.IsNullOrWhiteSpace(fila.CodigoProducto) || isLoadingSKU)
            return;

        isLoadingSKU = true;

        var producto = await ProductosService.GetProductoOrden(fila.CodigoProducto.Trim(), orden.CodListaPrecio);

        if (producto == null)
        {
            NotificationService.Notify(NotificationSeverity.Info, "Producto no encontrado", $"No se encontró el código '{fila.CodigoProducto}'");
            lstProductos.Remove(fila);
        }
        else if (lstProductos.Any(x => x.CodigoProducto == producto.CodigoProducto && x.IdProducto != 0))
        {
            NotificationService.Notify(NotificationSeverity.Warning, "Producto duplicado", $"El producto '{producto.CodigoProducto}' ya está en la lista");
            lstProductos.Remove(fila);
        }
        else
        {
            fila.IdProducto = producto.IdProducto;
            fila.CodigoProducto = producto.CodigoProducto;
            fila.Descripcion = producto.Descripcion;
            fila.Linea = producto.Linea;
            fila.Precio = producto.Precio;
            fila.DescuentoCliente = producto.DescuentoCliente;
            fila.CodComplemento = producto.CodComplemento;
        }

        await refGrid.Reload();
        isLoadingSKU = false;
    }

    private async Task HandleBuscarSKU()
    {
        await RadzenDialogService.OpenAsync<ProductoBusqueda>(
            "Búsqueda de SKU",
            new()
            {
                { "Pasivo", false },
                { "MultiSelect", true },
                { "CodListaPrecio", orden.CodListaPrecio },
                { "CallbackMultiple", EventCallback.Factory.Create<List<ProductoOrden>>(this, OnBuscarSKU) }
            },
            new() { Width = "60rem", Height = "90vh" });
    }

    private async Task OnBuscarSKU(List<ProductoOrden> seleccionados)
    {
        RadzenDialogService.CloseDialog();
        RadzenDialogService.OpenBusy("Cargando...");

        foreach (var producto in seleccionados)
        {
            if (!lstProductos.Any(x => x.CodigoProducto == producto.CodigoProducto && x.IdProducto != 0))
            {
                lstProductos.Add(new ProductoOrden
                {
                    IdProducto = producto.IdProducto,
                    CodigoProducto = producto.CodigoProducto,
                    Descripcion = producto.Descripcion,
                    Linea = producto.Linea,
                    Precio = producto.Precio,
                    DescuentoCliente = producto.DescuentoCliente,
                    CodComplemento = producto.CodComplemento,
                    CantidadSeleccionada = 1
                });
            }
        }

        await RecalcularOfertas();
        RadzenDialogService.CloseDialog();
    }

    private async Task EliminarProducto(ProductoOrden producto)
    {
        lstProductos.Remove(producto);
        await refGrid.Reload();
    }

    public async ValueTask DisposeAsync()
    {
        await SignalRService.StopConnection();
    }

    bool Validar()
    {
        bool error = false;

        if (!orden.Factura && !orden.Presupuesto)
        {
            NotificationService.Notify(NotificationSeverity.Info, "Debe ingresar al menos 1 tipo de pedido");
            error = true;
        }

        if (!error)
        {
            orden.Detalle!.Clear();
            foreach (var product in lstProductos)
            {
                orden.Detalle!.Add(new OrdenDetalle()
                {
                    Cantidad = product.CantidadSeleccionada,
                    CantidadProbador = product.CantidadProbador,
                    CantidadObsequio = product.CantidadObsequio,
                    CodProducto = product.CodigoProducto,
                    Descuento = product.DescuentoTotal,
                    Probador = product.CantidadProbador > 0,
                    Precio = product.Precio,
                });
            }

            if (!orden.Detalle.Any())
            {
                NotificationService.Notify(NotificationSeverity.Info, "Debe ingresar al menos 1 producto");
                error = true;
            }
            else
            {
                var lineas = lstProductos.Select(x => x.Linea).Where(x => !string.IsNullOrEmpty(x)).Distinct();
                if (lineas.Any())
                    orden.Linea = string.Join(",", lineas);
                // si no hay líneas en los productos (cargados desde detalle existente), se mantiene orden.Linea original
            }
        }

        return !error;
    }
}
