@page "/seguridad/usuarios"

@using GAPPLE.Client.Services;

@inject SeguridadService SeguridadService
@inject NavigationManager NavigationManager
@inject ParametrosDeConsulta ParametrosDeConsulta
@inject NotificationService NotificationService
@inject DialogService DialogService
@inject DialogCustom DialogCustom
@inject SesionDTO SesionDTO
@using Microsoft.AspNetCore.Authorization;
@using Microsoft.AspNetCore.Components.Authorization;
@attribute [Authorize]

@if (showForm)
{
    <RadzenText TextStyle="TextStyle.DisplayH4" TextAlign="TextAlign.Center" Text="Usuarios" Style="margin-bottom:1rem" />

    <RadzenRow AlignItems="AlignItems.End" Style="margin-bottom:1rem">

        <RadzenColumn Size="4" SizeMD="3" SizeLG="2">
            <RadzenLabel Text="Nombre de usuario:" Style="margin-bottom:5px" />
            <RadzenTextBox @ref="refNombreUsuario" Style="width:100%" @bind-Value="nombreUsuario" Change="@(()=>nombreUsuario = nombreUsuario.ToUpper())" @onkeypress="@((KeyboardEventArgs e) => KeyPress(e))" />
        </RadzenColumn>

        <RadzenColumn Size="3" SizeMD="3">
            <RadzenLabel Text="Apellido y nombre:" Style="margin-bottom:5px" />
            <RadzenTextBox Style="width:100%" @bind-Value=apeYNom @onkeypress="@((KeyboardEventArgs e) => KeyPress(e))" />
        </RadzenColumn>

        <RadzenColumn Size="5" SizeMD="4" SizeLG="3">
            <RadzenLabel Text="Perfil:" Style="margin-bottom:5px" />
            <RadzenDropDown Data=perfiles @bind-Value=perfil TextProperty="DescripcionPerfil" ValueProperty="DescripcionPerfil"
                            AllowClear=true AllowFiltering=true FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                            FilterOperator="Radzen.StringFilterOperator.Contains" Style="width:100%" />
        </RadzenColumn>

        <RadzenColumn Size="2">
            <RadzenLabel Text="Estado:" Style="margin-bottom:5px" />
            <RadzenDropDown TValue="int" @bind-Value=estado Data=@Variables.EstadosNum ValueProperty="@nameof(Opcion.Id)" TextProperty="@nameof(Opcion.Descripcion)" Style="width:100%" />
        </RadzenColumn>
        <RadzenColumn Size="1">
            <RadzenButton ButtonStyle="ButtonStyle.Secondary" Text="Buscar" Icon="search" Click="ObtenerUsuarios" IsBusy=@buscandoUsuarios />
        </RadzenColumn>
    </RadzenRow>

    <RadzenRow>
        <RadzenColumn Size="12">
            <RadzenButton ButtonStyle="ButtonStyle.Secondary" Text="Agregar usuario" Icon="add" Click="Agregar"
                          Size="ButtonSize.Small" Disabled=@(!permisos.Exists(x => x == "alta")) />
        </RadzenColumn>
    </RadzenRow>

    <RadzenRow class="rz-mt-2">
        <RadzenColumn Size="12">
            <RadzenDataGrid TItem="Usuario" Data="lstUsuarios" @ref="grid" IsLoading=@buscandoUsuarios
                            AllowVirtualization=true AllowSorting=true Style="Height:62vh" AllowFiltering=true
                            FilterMode="FilterMode.Simple" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive">
                <Columns>
                    <RadzenDataGridColumn TItem="Usuario" Property="@nameof(Usuario.NombreUsuario)" Title="Usuario" TextAlign="TextAlign.Left" Width="200px" />
                    <RadzenDataGridColumn TItem="Usuario" Property="@nameof(Usuario.ApellidoYNombre)" Title="Apellido y nombre" TextAlign="TextAlign.Left" Width="400px" />
                    <RadzenDataGridColumn TItem="Usuario" Property="@nameof(Usuario.Habilitado)" Title="Habilitado" TextAlign="TextAlign.Center" Width="85px" Filterable=false>
                        <Template>
                            <RadzenCheckBox Value="@context.Habilitado" ReadOnly=true />
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="Usuario" Property="@nameof(Usuario.Email)" Title="Email" TextAlign="TextAlign.Left" Width="150px" />
                    <RadzenDataGridColumn TItem="Usuario" Filterable=false Sortable=false Width="60px">
                        <Template>
                            <RadzenButton ButtonStyle="ButtonStyle.Info" Icon="info" Click="@(()=>Ver(context.IdUsuario))" Size="ButtonSize.ExtraSmall" Disabled=@(!permisos.Exists(x => x == "ver")) title="Ver datos" />
                            <RadzenButton ButtonStyle="ButtonStyle.Warning" Icon="edit" Click=@(()=>Editar(context.IdUsuario)) Size="ButtonSize.ExtraSmall" Disabled=@(!permisos.Exists(x => x == "edicion")) title="Editar usuario" />
                        </Template>
                    </RadzenDataGridColumn>
                </Columns>
                <EmptyTemplate>
                    <p style="color: lightgrey; font-size: 24px; text-align: center; margin: 2rem;">No hay registros para mostrar.</p>
                </EmptyTemplate>
            </RadzenDataGrid>
        </RadzenColumn>
    </RadzenRow>
}
else
{
    <Loader />
}

@code {
    List<PerfilUsuario> perfiles = Enumerable.Empty<PerfilUsuario>().ToList();
    RadzenDataGrid<Usuario> grid;
    List<Usuario> lstUsuarios = new();
    //List<string> permisos = new() { "ver","edicion","alta"};
    List<string> permisos;
    RadzenTextBox refNombreUsuario;
    bool showForm, buscandoUsuarios;
    string apeYNom = null, nombreUsuario = null, perfil;
    int estado = 2, render = 0;
    List<string> estados = new List<string> { "Ambos", "Activo", "Pasivo" };

    protected override async Task OnInitializedAsync()
    {
        await SeguridadService.ValidatePageAccess(SesionDTO.IdUsuario);
        permisos = await SeguridadService.GetPermisos("usuarios");
        perfiles = (await SeguridadService.GetPerfiles()).OrderBy(x => x.DescripcionPerfil).ToList();
        showForm = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        render++;
        if (render == 2)
        {
            await refNombreUsuario.FocusAsync();
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (ParametrosDeConsulta.PageName == "/seguridad/usuarios" && ParametrosDeConsulta.Parametros != null && ParametrosDeConsulta.Parametros.Any())
        {
            if (ParametrosDeConsulta.Parametros.ContainsKey("nombreDeUsuario"))
                nombreUsuario = (string)ParametrosDeConsulta.Parametros["nombreDeUsuario"];

            if (ParametrosDeConsulta.Parametros.ContainsKey("apellidoYNombre"))
                apeYNom = (string)ParametrosDeConsulta.Parametros["apellidoYNombre"];

            if (ParametrosDeConsulta.Parametros.ContainsKey("perfil"))
                perfil = (string)ParametrosDeConsulta.Parametros["perfil"];

            if (ParametrosDeConsulta.Parametros.ContainsKey("estado"))
                estado = (int)ParametrosDeConsulta.Parametros["estado"];

            await ObtenerUsuarios();
            ParametrosDeConsulta.Clear();
        }
    }

    private async Task ObtenerUsuarios()
    {
        buscandoUsuarios = true;
        await Task.Delay(1);

        bool? pasivo = null;
        if (estado == 2)
            pasivo = false;
        else if (estado == 3)
            pasivo = true;

        lstUsuarios = await SeguridadService.GetUsuarios(nombreUsuario, apeYNom, perfil, pasivo);

        if (lstUsuarios.Count == 0)
            ShowNotification(NotificationSeverity.Info, 3500, "La búsqueda no ha devuelto resultados");

        buscandoUsuarios = false;

    }

    private void GuardarParametros()
    {
        if (lstUsuarios != null && lstUsuarios.Any())
        {
            Dictionary<string, object> parametros = new();

            if (!string.IsNullOrEmpty(nombreUsuario)) parametros.Add("nombreDeUsuario", nombreUsuario);
            if (!string.IsNullOrEmpty(apeYNom)) parametros.Add("apellidoYNombre", apeYNom);
            if (perfil != null) parametros.Add("perfil", perfil);
            parametros.Add("estado", estado);

            ParametrosDeConsulta.Save("/seguridad/usuarios", parametros);
        }
    }

    private void Agregar()
    {
        GuardarParametros();
        NavigationManager.NavigateTo($"/seguridad/usuario/alta/");
    }

    private void Editar(int cod)
    {
        GuardarParametros();
        NavigationManager.NavigateTo($"/seguridad/usuario/edicion/{cod}");
    }

    private void Ver(int cod)
    {
        GuardarParametros();
        NavigationManager.NavigateTo($"/seguridad/usuario/ver/{cod}");
    }

    private async Task KeyPress(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await ObtenerUsuarios();
        }
    }

    private void ShowNotification(NotificationSeverity severity, int duration, string summary, string detail = null)
    {
        NotificationMessage message = new();
        message.Severity = severity;
        message.Duration = duration;
        message.Summary = summary;
        if (detail != null)
            message.Detail = detail;
        NotificationService.Notify(message);
    }

}
