@page "/perfiles"

@inject SeguridadService SeguridadService

@if (showPage)
{
    <RadzenText TextStyle="TextStyle.DisplayH4" TextAlign="TextAlign.Center" Text="Usuarios" Style="margin-bottom:1rem" />

    <RadzenDataGrid Data="lstPerfiles" @ref="grid" TItem="PerfilUsuario" AllowAlternatingRows="false" AllowFiltering="true" AllowSorting="true"
                    RowUpdate="@OnUpdateRow" RowCreate="@OnCreateRow">
        <HeaderTemplate>
            <RadzenButton ButtonStyle="ButtonStyle.Success" Icon="add_circle" Text="Add New Order" Click="@InsertRow" Disabled="@(perfilesToInsert.Count() > 0)" />
        </HeaderTemplate>
        <Columns>
            <RadzenDataGridColumn Property="@nameof(PerfilUsuario.DescripcionPerfil)" Title="Descripción">
                <EditTemplate Context="order">
                    <RadzenTextBox @bind-Value="order.DescripcionPerfil" Style="width:200px; display: block" Name="ShipName" aria-label="Enter ship name" />
                    <RadzenRequiredValidator Text="Debe ingresar una descripción" Component="ShipName" Popup="true" />
                </EditTemplate>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Context="order" Filterable="false" Sortable="false" TextAlign="TextAlign.Right" Frozen="true" FrozenPosition="FrozenColumnPosition.Right">
                <Template Context="order">
                    <RadzenButton Icon="add_circle" ButtonStyle="ButtonStyle.Success" Variant="Variant.Flat" Size="ButtonSize.Medium" Shade="Shade.Lighter" Click="@(() => InsertAfterRow(order))" title="Add new row after this row" Disabled="@(perfilesToInsert.Count() > 0)" />
                    <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat" Size="ButtonSize.Medium" class="rz-my-1 rz-ms-1" Click="@(args => EditRow(order))" @onclick:stopPropagation="true" />
                </Template>
                <EditTemplate Context="order">
                    <RadzenButton Icon="check" ButtonStyle="ButtonStyle.Success" Variant="Variant.Flat" Size="ButtonSize.Medium" Click="@((args) => SaveRow(order))" aria-label="Save" />
                    <RadzenButton Icon="close" ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat" Size="ButtonSize.Medium" class="rz-my-1 rz-ms-1" Click="@((args) => CancelEdit(order))" aria-label="Cancel" />
                </EditTemplate>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
}

@code {
    List<PerfilUsuario> lstPerfiles = new List<PerfilUsuario>();
    RadzenDataGrid<PerfilUsuario> grid;

    List<PerfilUsuario> perfilesToInsert = new List<PerfilUsuario>();
    List<PerfilUsuario> perfilesToUpdate = new List<PerfilUsuario>();

    bool showPage;

    protected override async Task OnInitializedAsync()
    {
        lstPerfiles = await SeguridadService.GetPerfiles();
        showPage = true;
    }

    void Reset()
    {
        perfilesToInsert.Clear();
        perfilesToUpdate.Clear();
    }

    void Reset(PerfilUsuario order)
    {
        perfilesToInsert.Remove(order);
        perfilesToUpdate.Remove(order);
    }

    async Task EditRow(PerfilUsuario order)
    {
        if (!grid.IsValid) return;

        Reset();

        perfilesToUpdate.Add(order);
        await grid.EditRow(order);
    }

    async Task OnUpdateRow(PerfilUsuario order)
    {
        Reset(order);

        await SeguridadService.PutPerfil(order);
    }

    async Task SaveRow(PerfilUsuario order)
    {
        await grid.UpdateRow(order);
    }

    void CancelEdit(PerfilUsuario order)
    {
        Reset(order);

        grid.CancelEditRow(order);
    }

    async Task InsertRow()
    {
        if (!grid.IsValid) return;

        Reset();

        var order = new PerfilUsuario();
        perfilesToInsert.Add(order);
        await grid.InsertRow(order);
    }

    async Task InsertAfterRow(PerfilUsuario row)
    {
        if (!grid.IsValid) return;

        Reset();

        var order = new PerfilUsuario();
        perfilesToInsert.Add(order);
        await grid.InsertAfterRow(order, row);
    }

    async Task OnCreateRow(PerfilUsuario order)
    {
        var response = await SeguridadService.PostPerfil(order);

        lstPerfiles.Find(x => x.DescripcionPerfil == order.DescripcionPerfil).IdPerfil = int.Parse(response.Message);

        perfilesToInsert.Remove(order);
    }
}
