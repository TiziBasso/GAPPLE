@page "/clientes"

@using GAPPLE.Client.Components.Cliente

@inject SeguridadService SeguridadService
@inject ClientesService ClientesService
@inject DialogService DialogService
@inject RadzenDialogService RadzenDialogService
@inject IJSFunction JSFunction

@if (showForm)
{
    <RadzenText Text="Clientes" TextStyle="TextStyle.DisplayH4" TextAlign="TextAlign.Center" />

    <RadzenDataGrid @ref="grilla" Data="clientes" AllowFiltering="true" AllowVirtualization="true" Density=Density.Compact
                    FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" FilterMode="FilterMode.Simple" EmptyText="No hay registros"
                    ShowEmptyMessage="true" IsLoading="isBusy" Style="height: 82vh;">
        <HeaderTemplate>
            <RadzenButton ButtonStyle="ButtonStyle.Secondary" Text="Agregar cliente" Click="AgregarCliente" />
        </HeaderTemplate>
        <Columns>
            <RadzenDataGridColumn Property="@nameof(Cliente.CodigoCliente)" Title="Código" TextAlign="TextAlign.Right" Width="90px" />
            <RadzenDataGridColumn Property="@nameof(Cliente.RazonSocial)" Title="Razón Social" TextAlign="TextAlign.Left" Width="200px" />
            <RadzenDataGridColumn Property="@nameof(Cliente.Observaciones)" Title="Nota" TextAlign="TextAlign.Left" Width="400px" Filterable="false" />
            <RadzenDataGridColumn TextAlign="TextAlign.Center" Width="@(permisoDescargarListaPrecios ? "60px" : "40px")" Filterable="false">
                <Template>
                    <RadzenButton Icon="info" ButtonStyle="ButtonStyle.Info" Variant="Variant.Flat" Size="ButtonSize.ExtraSmall"
                                  Click="@(() => Ver(context))" @onclick:stopPropagation="true" />
                    <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Warning" Variant="Variant.Flat" Size="ButtonSize.ExtraSmall" @onclick:stopPropagation="true" title="Editar cliente" Click="@(() => Editar(context))" />
                    @if (permisoDescargarListaPrecios)
                    {
                        <RadzenButton Icon="request_quote" ButtonStyle="ButtonStyle.Success" Variant="Variant.Flat" Size="ButtonSize.ExtraSmall" @onclick:stopPropagation="true"
                                      title="Descargar lista de precios" Click="@(() => DescargarListaPrecios(context))" />
                    }
                </Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
}
else
{
    <Loader />
}

@code
{

    List<Cliente> clientes = new();
    RadzenDataGrid<Cliente> grilla;
    RadzenDropDown<Opcion> dropdown;
    bool? opcion;
    bool showForm, isBusy, permisoDescargarListaPrecios;

    protected override async Task OnInitializedAsync()
    {
        await SeguridadService.ValidatePageAccess();
        var permisos = await SeguridadService.GetPermisos(GAPPLE.Shared.Helpers.Permisos.Menu.Clientes);
        permisoDescargarListaPrecios = permisos.Contains(GAPPLE.Shared.Helpers.Permisos.DescargarListaPrecios);
        clientes = await ClientesService.GetClientes();
        showForm = true;
    }

    async Task DescargarListaPrecios(Cliente cliente)
    {
        RadzenDialogService.OpenBusy("Generando lista de precios...");
        var response = await ClientesService.GetListaPrecios((int)cliente.IdCliente!);
        RadzenDialogService.CloseDialog();

        if (response.IsOk)
            await JSFunction.DownloadFile(response.DataBytes, $"ListaPrecios_{cliente.CodigoCliente}_{cliente.CodListaPrecioDefault}.xlsx");
        else if (response.IsBadRequest)
            await RadzenDialogService.ShowAlertAsync(response.Message, MensajesHelper.Title);
        else
            await RadzenDialogService.ShowAlertAsync("No se pudo descargar la lista de precios. Verifique que el cliente pertenezca a su cartera.", MensajesHelper.Title);
    }

    async Task AgregarCliente()
    {
        isBusy = true;
        await DialogService.OpenAsync<ClienteAdd>($"Agregar cliente ", null, new() { Width = "60vw", Height = "50vh" });
        opcion = true;
        clientes = await ClientesService.GetClientes();
        await grilla.Reload();
        isBusy = false;
    }

    async Task Editar(Cliente cliente)
    {
        isBusy = true;
        await DialogService.OpenAsync<ClienteAdd>($"Modificar a cliente especial", new() { { "Cliente", cliente } }, new() { Width = "40vw", Height = "46vh" });
        opcion = true;
        clientes = await ClientesService.GetClientes();
        await grilla.Reload();
        isBusy = false;
    }

    async Task Ver(Cliente cliente)
    {
        isBusy = true;
        await DialogService.OpenAsync<ClienteAdd>($"Ver cliente", new() { { "Cliente", cliente }, { "DisabledInputs", true } }, new() { Width = "40vw", Height = "46vh" });
        isBusy = false;
    }

    public async Task OnChange(bool? opcion)
    {
        isBusy = true;
        clientes = await ClientesService.GetClientes();
        await grilla.Reload();
        isBusy = false;
    }
}
