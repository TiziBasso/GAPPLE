@page "/clientes"
@using GAPPLE.Shared.Model

@inject ClientesService ClientesService

<RadzenRow>
	<RadzenText Text="Clientes" TextStyle="TextStyle.DisplayH4" />
</RadzenRow>

<RadzenDataGrid @ref="grilla" Data="clientes" AllowFiltering="true" AllowVirtualization="true">

	<HeaderTemplate>
		<RadzenButton ButtonStyle="ButtonStyle.Primary" />
	</HeaderTemplate>
	<Columns>
		<RadzenDataGridColumn Title="DNI/CUIT" Property="@nameof(Cliente.CUIT)">
			<EditTemplate>
				<RadzenTextBox @bind-Value=newDNICuit />
			</EditTemplate>
		</RadzenDataGridColumn>

		<RadzenDataGridColumn Title="Razon Social" Property="@nameof(Cliente.RazonSocial)">
			<EditTemplate>
				<RadzenTextBox @bind-Value=newRazonSocial />
			</EditTemplate>
		</RadzenDataGridColumn>

	</Columns>
</RadzenDataGrid>



@code
{

	List<Cliente> clientes = new();
	RadzenDataGrid<Cliente> grilla;
	Cliente clienteToInsert;
	Cliente clienteToUpdate;

	string newDNICuit;
	string newRazonSocial;

	protected override async Task OnInitializedAsync()
	{
		clientes = await ClientesService.GetClientes();
	}
}
