@page "/clientes"

@using GAPPLE.Client.Components.Cliente

@inject ClientesService ClientesService
@inject DialogService DialogService

@if (showForm)
{
        <RadzenText Text="Clientes especiales" TextStyle="TextStyle.DisplayH4" TextAlign="TextAlign.Center"/>

    <RadzenDataGrid @ref="grilla" Data="clientes" AllowFiltering="true" AllowVirtualization="true" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" FilterMode="FilterMode.Simple" EmptyText="No hay registros" ShowEmptyMessage="true" IsLoading="isBusy">
        <HeaderTemplate>
            <RadzenButton ButtonStyle="ButtonStyle.Secondary" Text="Agregar cliente" Click="AgregarCliente" />
        </HeaderTemplate>
        <Columns>
            <RadzenDataGridColumn Property="@nameof(Cliente.CodigoCliente)" Title="Código" TextAlign="TextAlign.Right" Width="90px" />
            <RadzenDataGridColumn Property="@nameof(Cliente.RazonSocial)" Title="Razón Social" TextAlign="TextAlign.Left" Width="200px" />
            <RadzenDataGridColumn Property="@nameof(Cliente.Observaciones)" Title="Nota" TextAlign="TextAlign.Left" Width="400px" Filterable="false" />
            <RadzenDataGridColumn TextAlign="TextAlign.Center" Width="40px" Filterable="false">
                <Template>
                    <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Warning" Variant="Variant.Flat" Size="ButtonSize.ExtraSmall" @onclick:stopPropagation="true" title="Editar cliente" Click="@(() => Editar(context))" />
                </Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
}
else
{
    <Loader />
}

@code
{
    List<Cliente> clientes = new();
    RadzenDataGrid<Cliente> grilla;
    bool showForm, isBusy;

    protected override async Task OnInitializedAsync()
    {
        clientes = await ClientesService.GetClientes(clienteEspecial:true);
        showForm = true;
    }

    async Task AgregarCliente()
    {
        isBusy = true;
        await DialogService.OpenAsync<ClienteAdd>($"Agregar cliente especial", null, new() { Width = "60vw", Height = "50vh" });
        clientes = await ClientesService.GetClientes(clienteEspecial: true);
        await grilla.Reload();
        isBusy = false;
    }

    async Task Editar(Cliente cliente)
    {
        isBusy = true;
        await DialogService.OpenAsync<ClienteAdd>($"Editar cliente especial", new(){ { "Cliente",cliente} } , new() { Width = "40vw", Height = "40vh" });
        clientes = await ClientesService.GetClientes(clienteEspecial: true);
        await grilla.Reload();
        isBusy = false;
    }
}
