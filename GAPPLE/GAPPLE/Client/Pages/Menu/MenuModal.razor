@inject SeguridadService SeguridadService
@inject DialogService DialogService

<RadzenTemplateForm EditContext="editContext" TItem="Menu" Data="permiso" Submit="Guardar">
    <DataAnnotationsValidator />
    <RadzenRow>
        <RadzenColumn Size="6">
            <RadzenLabel Text="Nombre" Component="nombre" />
            <RadzenTextBox Name="nombre" @bind-Value="permiso.Nombre" Style="width:100%;" AutoCompleteType="AutoCompleteType.Off" />
            <ValidationMessage For="@(() => permiso.Nombre)" />
        </RadzenColumn>
    </RadzenRow>
    <RadzenRow Style="margin-top:15px;">
        <RadzenColumn Size="6">
            <RadzenLabel Text="Tipo" />
            <RadzenDropDown Data="@tipoMenu" @bind-Value="@permiso.Tipo" ValueProperty="@nameof(Opcion.Id)" TextProperty="@nameof(Opcion.Descripcion)" Style="width:100%;" />
            <ValidationMessage For="@(() => permiso.Tipo)" />
        </RadzenColumn>
        <RadzenColumn Size="6">
            <RadzenLabel Text="URL" Component="url" />
            <RadzenTextBox @bind-Value="permiso.Url" Name="url" Style="width:100%;" AutoCompleteType="AutoCompleteType.Off" />
            <ValidationMessage For="@(() => permiso.Url)" />
        </RadzenColumn>
    </RadzenRow>
    <RadzenRow Style="margin-top:15px;">
        <RadzenColumn Size="6">
            <RadzenLabel Text="Icono" Component="icono" />
            <RadzenTextBox @bind-Value="permiso.Icono" Name="icono" Style="width:100%;" AutoCompleteType="AutoCompleteType.Off" />
            <ValidationMessage For="@(() => permiso.Icono)" />
        </RadzenColumn>
        <RadzenColumn Size="6">
            <RadzenLabel Text="Orden" Component="orden" />
            <RadzenNumeric @bind-Value="permiso.Orden" ShowUpDown="false" Name="orden" Style="width:100%;" AutoCompleteType="AutoCompleteType.Off" />
            <ValidationMessage For="@(() => permiso.Orden)" />
        </RadzenColumn>
    </RadzenRow>
    <RadzenRow Style="margin-top:15px;">
        <RadzenColumn Size="3">
            <RadzenButton Text="Cancelar" ButtonStyle="ButtonStyle.Danger" Click="Cancelar" />
        </RadzenColumn>
        <RadzenColumn Size="3">
            <RadzenButton Text="Guardar" ButtonStyle="ButtonStyle.Success" ButtonType="Radzen.ButtonType.Submit" />
        </RadzenColumn>
    </RadzenRow>
</RadzenTemplateForm>

@code {
    [Parameter] public Menu permiso { get; set; }
    [Parameter] public EventCallback<Menu> SaveRow { get; set; }
    IEnumerable<Opcion> tipoMenu;
    EditContext editContext;

    protected override void OnInitialized()
    {
        tipoMenu = new List<Opcion>()
        {
            new('M', "Menú"),
            new('P', "Permiso"),
            new('N', "Notificación")
        };
        editContext = new(permiso);
    }

    async Task Guardar()
    {
        await SaveRow.InvokeAsync(permiso);
    }

    async Task Cancelar()
    {
        await SaveRow.InvokeAsync(null);
    }
}
