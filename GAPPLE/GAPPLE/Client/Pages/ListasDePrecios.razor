@page "/listas-de-precios"

@using GAPPLE.Client.Components.Cliente

@inject OrdenesService OrdenesService

<RadzenText Text="Listas de precios" TextStyle="TextStyle.DisplayH4" TextAlign="TextAlign.Center" />

@if (showForm)
{
	<RadzenRow JustifyContent="JustifyContent.Center">
		<RadzenColumn Size="10" Offset="1">

			<RadzenDataGrid @ref="grilla" Data="listasDePrecios.OrderBy(x => x.Descripcion)" AllowSorting="true" AllowFiltering="true" AllowVirtualization="true" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
			FilterMode="FilterMode.Simple" EmptyText="No hay registros" ShowEmptyMessage="true" Style="height: 82vh; width: 150vh">
				<Columns>
					<RadzenDataGridColumn Property="@nameof(ListaDePrecios.CodigoTango)" Title="Codigo" TextAlign="TextAlign.Right" Width="110px" Sortable="true" />
					<RadzenDataGridColumn Property="@nameof(ListaDePrecios.Descripcion)" Title="Lista de precios" TextAlign="TextAlign.Left" Sortable="false" />
				</Columns>
			</RadzenDataGrid>
		</RadzenColumn>
	</RadzenRow>

}
else
{
	<Loader />
}

@code
{
	bool showForm;

	List<ListaDePrecios> listasDePrecios = new();

	RadzenDataGrid<ListaDePrecios> grilla;

	protected override async Task OnInitializedAsync()
	{
		listasDePrecios = await OrdenesService.GetListasDePrecio();
		showForm = true;
	}
}
