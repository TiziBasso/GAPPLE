@page "/Ofertas"
@using GAPPLE.Client.Components.Oferta

@inject SeguridadService SeguridadService
@inject OfertasService OfertasService
@inject DialogService DialogService
@inject ProductosService ProductosService
@inject NotificationService NotificationService

@if (showPage)
{
    <RadzenText Text="Ofertas" TextAlign="TextAlign.Center" TextStyle="TextStyle.DisplayH4" class="rz-mb-3" />

    <RadzenStack Orientation="Orientation.Horizontal" Wrap="FlexWrap.Wrap" Gap="4px" AlignItems="AlignItems.End" Style="margin-bottom:10px;">

        <RadzenStack Orientation="Orientation.Vertical">
            <RadzenLabel Text="Mes:" Component="mes" />
            <RadzenDatePicker @bind-Value="mes" DateFormat="MM/yyyy" Name="mes" Style="width:8rem" ShowDays="false" CurrentDateChanged=@OnCurrentDateChanged />
        </RadzenStack>

        <RadzenStack Orientation="Orientation.Vertical">
            <RadzenLabel Text="Linea:" Component="cod" />
            <RadzenDropDown Data="lstLineas" @bind-Value="linea" AllowClear="true" Style="width:15rem" />
        </RadzenStack>

        <RadzenStack Orientation="Orientation.Vertical">
            <RadzenLabel Text="Estado:" Component="estado" />
            <RadzenDropDown Data=@Variables.Clasificaciones @bind-Value=@activas Name="estado" Style="width:9rem"
                            ValueProperty=@nameof(Opcion.Id) TextProperty=@nameof(Opcion.Descripcion) Placeholder="(Todas)" AllowClear="true" />
        </RadzenStack>

        <RadzenButton Click="FillOfertas" IsBusy=isLoading ButtonStyle=ButtonStyle.Secondary Icon="search" Size="ButtonSize.Medium" />

    </RadzenStack>

    <RadzenButton Icon="add" Size=ButtonSize.Small Text="Agregar oferta" Click="Agregar" ButtonStyle="ButtonStyle.Secondary"
                  class="rz-mb-2" Disabled="@(isLoading || !listPermisos.Contains("alta"))" />

    <RadzenDataGrid @ref=refGrid Data="lstOfertas" AllowSorting="true" IsLoading="@isLoading" Density="Density.Compact" AllowColumnResize="true" FilterMode="FilterMode.Simple"
                    FilterCaseSensitivity=FilterCaseSensitivity.CaseInsensitive LogicalFilterOperator="LogicalFilterOperator.Or"
                    SelectionMode="DataGridSelectionMode.Single" @bind-Value="selected" AllowVirtualization=true Style="height: 65vh;" EmptyText="">
        <Columns>
            <RadzenDataGridColumn Title="Id" Property="@nameof(Oferta.IdOferta)" TextAlign="TextAlign.Right" Width="100px" />
            <RadzenDataGridColumn Title="Nombre" Property="@nameof(Oferta.Nombre)" TextAlign="TextAlign.Left" Width="300px" />
            <RadzenDataGridColumn Title="Linea" Property="@nameof(Oferta.Linea)" TextAlign="TextAlign.Center" Width="100px" />
            <RadzenDataGridColumn Title="Descuento" Property="@nameof(Oferta.Descuento)" TextAlign="TextAlign.Right" Width="100px">
                <Template>
                    @context.Descuento.ToString("N1") %
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Title="Desde" Property="@nameof(Oferta.Desde)" TextAlign="TextAlign.Center" Width="100px">
                <Template>
                    <span>@context.Desde.ToString("dd/MM/yyyy")</span>
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Title="Hasta" Property="@nameof(Oferta.Hasta)" TextAlign="TextAlign.Center" Width="100px">
                <Template>
                    <span>@context.Hasta.ToString("dd/MM/yyyy")</span>
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Title="Activa" Property="@nameof(Oferta.Activa)" TextAlign="TextAlign.Center" Width="90px">
                <Template>
                    @if (context.Activa)
                    {
                        <RadzenBadge BadgeStyle="BadgeStyle.Success" Text="Activa" />
                    }
                    else
                    {
                        <RadzenBadge BadgeStyle="BadgeStyle.Light" Text="Inactiva" />
                    }
                </Template>
            </RadzenDataGridColumn>

            <RadzenDataGridColumn TextAlign="TextAlign.Center" Width="35px" Sortable="false">
                <Template>
                    <RadzenButton Icon="@(context.Activa ? "toggle_on" : "toggle_off")"
                                  ButtonStyle="@(context.Activa ? ButtonStyle.Success : ButtonStyle.Light)"
                                  Variant="Variant.Flat" Size="ButtonSize.ExtraSmall" @onclick:stopPropagation="true"
                                  title="@(context.Activa ? "Desactivar oferta" : "Activar oferta")"
                                  Disabled="@(isLoading || !listPermisos.Contains("edicion"))"
                                  Click="@(() => AlternarActiva(context))" />
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TextAlign="TextAlign.Center" Width="35px">
                <Template>
                    <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Warning" Variant="Variant.Flat" Size="ButtonSize.ExtraSmall" @onclick:stopPropagation="true" title="Editar oferta" Click="@(() => Editar(context))" />
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TextAlign="TextAlign.Center" Width="35px" Sortable="false">
                <Template>
                    <RadzenButton Icon="content_copy" ButtonStyle="ButtonStyle.Secondary" Variant="Variant.Flat" Size="ButtonSize.ExtraSmall" @onclick:stopPropagation="true"
                                  title="Duplicar oferta" Disabled="@(isLoading || !listPermisos.Contains("alta"))" Click="@(() => Duplicar(context))" />
                </Template>
            </RadzenDataGridColumn>

            <RadzenDataGridColumn TextAlign="TextAlign.Center" Width="35px">
                <Template>
                    <RadzenButton Icon="visibility" ButtonStyle="ButtonStyle.Info" Variant="Variant.Flat" Size="ButtonSize.ExtraSmall" @onclick:stopPropagation="true" title="Ver oferta" Click="@(() => Ver(context))" />
                </Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
}
else
{
    <Loader />
}

@code {
    RadzenDataGrid<Oferta> refGrid;
    List<Oferta> lstOfertas = new();
    bool showPage, isLoading;
    IList<Oferta> selected;
    //List<string> listPermisos = new() { "alta" };
    List<string> listPermisos;

    List<string> lstLineas = new();
    DateTime mes = DateTime.Today.FirstDayOfMonth();
    string linea;
    bool? activas;

    protected override async Task OnInitializedAsync()
    {
        await SeguridadService.ValidatePageAccess();
        listPermisos = await SeguridadService.GetPermisos("ofertas");
        lstLineas = await ProductosService.GetLineas();
        lstOfertas = await OfertasService.GetOfertas(null, linea, mes, activas);
        showPage = true;
    }

    void OnCurrentDateChanged(DateTime args)
    {
        mes = new DateTime(args.Year, args.Month, 1);
    }

    async Task FillOfertas()
    {
        isLoading = true;
        lstOfertas = await OfertasService.GetOfertas(null, linea, mes, activas);
        await refGrid.Reload();
        isLoading = false;
    }

    async Task Agregar()
    {
        isLoading = true;
        var response = await DialogService.OpenAsync<OfertaForm>($"Nueva oferta", new() { { "Oferta", new Oferta() } }, new() { Width = "80vw", Height = "90vh" });
        if (response != null)
        {
            lstOfertas = await OfertasService.GetOfertas(null, linea, mes, activas);
            await refGrid.Reload();
        }
        isLoading = false;
    }

    async Task Editar(Oferta oferta)
    {
        isLoading = true;
        var response = await DialogService.OpenAsync<OfertaForm>($"Oferta {oferta.Nombre}", new() { { "Oferta", oferta } }, new() { Width = "80vw", Height = "90vh" });
        if (response != null)
        {
            lstOfertas = await OfertasService.GetOfertas(null, linea, mes, activas);
            await refGrid.Reload();
        }
        isLoading = false;
    }

    async Task Ver(Oferta oferta)
    {
        isLoading = true;
        await DialogService.OpenAsync<OfertaForm>($"Oferta {oferta.Nombre}", new() { { "Oferta", oferta }, { "DisabledInputs", true } }, new() { Width = "80vw", Height = "90vh" });
        isLoading = false;
    }

    /// <summary>
    /// Activa o desactiva la oferta sin necesidad de abrir el formulario.
    /// </summary>
    async Task AlternarActiva(Oferta oferta)
    {
        string accion = oferta.Activa ? "desactivar" : "activar";

        if (await DialogService.Confirm($"¿Desea {accion} la oferta \"{oferta.Nombre}\"?", MensajesHelper.Title,
                                        new() { OkButtonText = "Sí", CancelButtonText = "No" }) != true)
            return;

        isLoading = true;

        var payload = new Oferta
        {
            IdOferta = oferta.IdOferta,
            Nombre = oferta.Nombre,
            Descripcion = oferta.Descripcion,
            Linea = oferta.Linea,
            Descuento = oferta.Descuento,
            Desde = oferta.Desde,
            Hasta = oferta.Hasta,
            Inclusiones = oferta.Inclusiones,
            Exclusiones = oferta.Exclusiones,
            Activa = !oferta.Activa
        };

        var response = await OfertasService.PutOferta(payload);

        if (response.IsOk)
        {
            oferta.Activa = payload.Activa;
            NotificationService.Notify(NotificationSeverity.Success, MensajesHelper.Title,
                                       $"La oferta \"{oferta.Nombre}\" quedó {(oferta.Activa ? "activa" : "inactiva")}");
            lstOfertas = await OfertasService.GetOfertas(null, linea, mes, activas);
            await refGrid.Reload();
        }
        else
            NotificationService.Notify(NotificationSeverity.Error, MensajesHelper.Title, "No se pudo actualizar la oferta");

        isLoading = false;
    }

    /// <summary>
    /// Abre el formulario con una copia de la oferta seleccionada (borrador nuevo).
    /// Solo hace falta ajustar el porcentaje o las fechas y guardar.
    /// </summary>
    async Task Duplicar(Oferta oferta)
    {
        isLoading = true;

        var copia = new Oferta
        {
            IdOferta = 0,
            Nombre = RecortarNombre($"{oferta.Nombre} (copia)"),
            Descripcion = oferta.Descripcion,
            Linea = oferta.Linea,
            Descuento = oferta.Descuento,
            Desde = DateTime.Today,
            Hasta = DateTime.Today.FirstDayOfMonth().AddMonths(1).AddDays(-1),
            Activa = true,
            Inclusiones = oferta.Inclusiones,
            Exclusiones = oferta.Exclusiones
        };

        var response = await DialogService.OpenAsync<OfertaForm>($"Duplicar oferta {oferta.Nombre}",
            new() { { "Oferta", copia } }, new() { Width = "80vw", Height = "90vh" });

        if (response != null)
        {
            lstOfertas = await OfertasService.GetOfertas(null, linea, mes, activas);
            await refGrid.Reload();
        }

        isLoading = false;
    }

    static string RecortarNombre(string nombre) => nombre.Length > 50 ? nombre[..50] : nombre;
}
