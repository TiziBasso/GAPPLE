@page "/Ofertas"
@using GAPPLE.Client.Components.Oferta

@inject SeguridadService SeguridadService
@inject OfertasService OfertasService
@inject DialogService DialogService

@if (showPage)
{
    <RadzenText Text="Ofertas" TextAlign="TextAlign.Center" TextStyle="TextStyle.DisplayH4" class="rz-mb-3" />

    <RadzenButton Icon="add" Size=ButtonSize.Small Text="Agregar oferta" Click="Agregar"
                  class="rz-mb-2" Disabled="@(isLoading || !listPermisos.Contains("alta"))" />

    <RadzenDataGrid @ref=refGrid Data="lstOfertas" AllowSorting="true" IsLoading="@isLoading" Density="Density.Compact" AllowColumnResize="true" FilterMode="FilterMode.Simple"
                    FilterCaseSensitivity=FilterCaseSensitivity.CaseInsensitive LogicalFilterOperator="LogicalFilterOperator.Or"
                    SelectionMode="DataGridSelectionMode.Single" @bind-Value="selected" AllowVirtualization=true Style="height: 65vh;" EmptyText="">
        <Columns>
            <RadzenDataGridColumn Title="Id" Property="@nameof(Oferta.IdOferta)" TextAlign="TextAlign.Right" Width="100px" />
            <RadzenDataGridColumn Title="Nombre" Property="@nameof(Oferta.Nombre)" TextAlign="TextAlign.Left" Width="300px" />
            <RadzenDataGridColumn Title="Linea" Property="@nameof(Oferta.Linea)" TextAlign="TextAlign.Center" Width="100px" />
            <RadzenDataGridColumn Title="Descuento" Property="@nameof(Oferta.Descuento)" TextAlign="TextAlign.Right" Width="100px">
                <Template>
                    @context.Descuento.ToString("N1") %
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Title="Desde" Property="@nameof(Oferta.Desde)" TextAlign="TextAlign.Center" Width="100px">
                <Template>
                    <span>@context.Desde.ToString("dd/MM/yyyy")</span>
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Title="Hasta" Property="@nameof(Oferta.Hasta)" TextAlign="TextAlign.Center" Width="100px">
                <Template>
                    <span>@context.Hasta.ToString("dd/MM/yyyy")</span>
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Title="Activa" TextAlign="TextAlign.Center" Width="50px">
                <Template>
                    <RadzenCheckBox @bind-Value="context.Activa" ReadOnly="true" />
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TextAlign="TextAlign.Center" Width="35px">
                <Template>
                    <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Warning" Variant="Variant.Flat" Size="ButtonSize.ExtraSmall" @onclick:stopPropagation="true" title="Editar oferta" Click="@(() => Editar(context))" />
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TextAlign="TextAlign.Center" Width="35px">
                <Template>
                    <RadzenButton Icon="visibility" ButtonStyle="ButtonStyle.Info" Variant="Variant.Flat" Size="ButtonSize.ExtraSmall" @onclick:stopPropagation="true" title="Ver oferta" Click="@(() => Ver(context))" />
                </Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
}
else
{
    <Loader />
}

@code {
    RadzenDataGrid<Oferta> refGrid;
    List<Oferta> lstOfertas = new();
    bool showPage, isLoading;
    IList<Oferta> selected;
    List<string> listPermisos = new() { "alta" };

    protected override async Task OnInitializedAsync()
    {
        lstOfertas = await OfertasService.GetOfertas(null, null, null, null);
        showPage = true;
    }

    async Task Agregar()
    {
        isLoading = true;
        var response = await DialogService.OpenAsync<OfertaForm>($"Nueva oferta", new() { { "Oferta", new Oferta() } }, new() { Width = "80vw", Height = "90vh" });
        if (response != null)
        {
            lstOfertas = await OfertasService.GetOfertas(null, null, null, null);
            await refGrid.Reload();
        }
        isLoading = false;
    }

    async Task Editar(Oferta oferta)
    {
        isLoading = true;
        var response = await DialogService.OpenAsync<OfertaForm>($"Oferta {oferta.Nombre}", new() { { "Oferta", oferta } }, new() { Width = "80vw", Height = "90vh" });
        if (response != null)
        {
            lstOfertas = await OfertasService.GetOfertas(null, null, null, null);
            await refGrid.Reload();
        }
        isLoading = false;
    }

    async Task Ver(Oferta oferta)
    {
        isLoading = true;
        await DialogService.OpenAsync<OfertaForm>($"Oferta {oferta.Nombre}", new() { { "Oferta", oferta }, { "DisabledInputs", true } }, new() { Width = "80vw", Height = "90vh" });
        isLoading = false;
    }
}
