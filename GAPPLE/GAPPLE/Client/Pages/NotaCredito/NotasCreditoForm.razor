@page "/notascredito/{OperacionQuery}/{IdQuery:int}"

@inject SeguridadService SeguridadService
@inject NavigationManager NavigationManager
@inject OrdenesService OrdenesService
@inject RadzenDialogService RadzenDialogService
@inject ClientesService ClientesService
@inject MotivosService MotivosService
@inject ProductosService ProductosService
@inject IJSFunction JSFunction

@if (showPage)
{
    <RadzenTemplateForm Data="comprobante" TItem="ComprobanteCabecera" Submit="Guardar" EditContext="editContext"
                        Style="display: grid;grid-template-rows: auto auto 1fr auto;height: calc(100vh - 83px); gap:10px;">
        <DataAnnotationsValidator />
        <CustomValidation @ref="customValidation" />

        <RadzenFieldset AllowCollapse="true" Text="@($"Datos de cabecera {comprobante.ClienteRazonSocial}")">
            <RadzenStack Orientation="Orientation.Horizontal" Gap="10px">
                <RadzenText TextStyle="TextStyle.Subtitle1" Style="color: var(--rz-text-tertiary-color)" Text=@($"Cód. Cliente: {comprobante.CodCliente}") class="rz-mb-2 rz-ml-3" />
                <RadzenText TextStyle="TextStyle.Subtitle1" Style="color: var(--rz-text-tertiary-color)" Text=@($"Razón social: {comprobante.ClienteRazonSocial}") class="rz-mb-2 rz-ml-3" />
                <RadzenText TextStyle="TextStyle.Subtitle1" Style="color: var(--rz-text-tertiary-color)" Text=@($"CUIT: {comprobante.ClienteCuit}") class="rz-mb-2 rz-ml-3" />
            </RadzenStack>

            @* //TODO: Dropdown con las facturas del cliente *@
            <RadzenColumn Size="3">
                <RadzenStack Orientation="Orientation.Vertical" Gap="0">
                    <RadzenLabel Text="Comprobante referencia:" />
                    <TextBoxInput @bind-Value="comprobante.ComprobanteReferencia" />
                    <ValidationMessage For="@(() => comprobante.ComprobanteReferencia)" />
                </RadzenStack>
            </RadzenColumn>

            <RadzenRow Style="margin-top:10px;">
                <RadzenColumn Size="4">
                    <RadzenStack Orientation="Orientation.Vertical" Gap="0">
                        <RadzenLabel Text="Lista de precios:" />
                        <RadzenDropDownDataGrid Data="listasDePrecio" @bind-Value="comprobante.IdListaPrecio" Disabled="@(listaPrecioManual)" Density="Density.Compact" Change=ChangeListaPrecio
                                                TextProperty="@nameof(ListaDePrecios.Descripcion)" ValueProperty="@nameof(ListaDePrecios.CodigoTango)" AllowVirtualization="true"
                                                FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" AllowFilteringByAllStringColumns=true FilterOperator="StringFilterOperator.Contains">
                            <Columns>
                                <RadzenDropDownDataGridColumn Property="@nameof(ListaDePrecios.CodigoTango)" Title="Código" Width="4.5rem" />
                                <RadzenDropDownDataGridColumn Property="@nameof(ListaDePrecios.Descripcion)" Title="Descripción" />
                            </Columns>
                        </RadzenDropDownDataGrid>
                        <ValidationMessage For="@(() => comprobante.IdListaPrecio)" />
                    </RadzenStack>
                </RadzenColumn>

                @* <RadzenColumn Size="4">
                    <RadzenStack Orientation="Orientation.Vertical" Gap="0">
                        <RadzenLabel Text="Cond.Venta:" />
                        <RadzenDropDownDataGrid Data="condicionesDeVenta" @bind-Value="orden.CondicionVenta" Density="Density.Compact" AllowSorting=false Disabled="true"
                                                AllowFiltering=true FilterCaseSensitivity=FilterCaseSensitivity.CaseInsensitive FilterOperator=StringFilterOperator.Contains AllowFilteringByAllStringColumns=true
                                                TextProperty="@nameof(CondicionDeVenta.Descripcion)" ValueProperty="@nameof(CondicionDeVenta.CodigoTango)" AllowVirtualization="true">
                            <Columns>
                                <RadzenDropDownDataGridColumn Property="@nameof(CondicionDeVenta.CodigoTango)" Title="Código" Width="4rem" />
                                <RadzenDropDownDataGridColumn Property="@nameof(CondicionDeVenta.Descripcion)" Title="Descripción" />
                            </Columns>
                        </RadzenDropDownDataGrid>
                        <ValidationMessage For="@(() => orden.CondicionVenta)" />
                    </RadzenStack>
                </RadzenColumn> *@

                @* <RadzenColumn Size="3">
                    <RadzenStack Orientation="Orientation.Vertical" Gap="0">
                        <RadzenLabel Text="F.Entrega:" />
                        <RadzenDatePicker @bind-Value="orden.FechaEntrega" DateFormat="dd/MM/yyyy" Min="DateTime.Today" />
                    </RadzenStack>
                    <ValidationMessage For="@(() => orden.FechaEntrega)" />
                </RadzenColumn> *@
            </RadzenRow>

            <RadzenRow Style="margin-top:10px;">
                @* <RadzenColumn Size="4">
                    <RadzenStack Orientation="Orientation.Vertical" Gap="0">
                        <RadzenLabel Text="Transporte:" />
                        <RadzenDropDownDataGrid Data="transportes" @bind-Value="orden.CodTransporte" Density="Density.Compact" AllowSorting=false
                                                AllowFiltering=true FilterCaseSensitivity=FilterCaseSensitivity.CaseInsensitive FilterOperator=StringFilterOperator.Contains AllowFilteringByAllStringColumns=true
                                                TextProperty="@nameof(Transporte.Descripcion)" ValueProperty="@nameof(Transporte.CodigoTango)" AllowVirtualization="true">
                            <Columns>
                                <RadzenDropDownDataGridColumn Property="@nameof(Transporte.CodigoTango)" Title="Código" Width="4rem" />
                                <RadzenDropDownDataGridColumn Property="@nameof(Transporte.Descripcion)" Title="Descripción" />
                            </Columns>
                        </RadzenDropDownDataGrid>
                    </RadzenStack>
                </RadzenColumn> *@

                <RadzenColumn Size="3">
                    <RadzenStack Orientation="Orientation.Vertical" Gap="0">
                        <RadzenLabel Text="Observaciones:" />
                        <TextAreaInput @bind-Value="comprobante.Observaciones" />
                        <ValidationMessage For="@(() => comprobante.Observaciones)" />
                    </RadzenStack>
                </RadzenColumn>

                <RadzenColumn Size="2">
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems=AlignItems.Center Style="height:100%;">
                        <RadzenStack Orientation="Orientation.Horizontal" Gap="0">
                            <RadzenLabel Text="F:" />
                            <RadzenCheckBox @bind-Value="@comprobante.Factura" />
                        </RadzenStack>

                        <RadzenStack Orientation="Orientation.Horizontal" Gap="0">
                            <RadzenLabel Text="P:" />
                            <RadzenCheckBox @bind-Value="@comprobante.Presupuesto" />
                        </RadzenStack>
                    </RadzenStack>
                </RadzenColumn>
            </RadzenRow>
        </RadzenFieldset>

        <RadzenDataGrid @ref="grid" Data="comprobante.Detalle" TItem="ComprobanteDetalle" Style="min-height: 180px;"
                        Density="Density.Compact" IsLoading="isLoading" AllowAlternatingRows="false" EmptyText="@string.Empty" class="rz-mt-1">
            <HeaderTemplate>
                <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" Style="width: 100%;">
                    <RadzenStack Orientation="Orientation.Horizontal" Gap="1rem" Style="width: fit-content;">

                        <RadzenButton ButtonStyle="ButtonStyle.Secondary" Text="Agregar producto" Click="@InsertRow" Size="ButtonSize.Small" />
                        <RadzenButton ButtonStyle="ButtonStyle.Primary" Icon="search" Text="Buscar producto" Click="@HandleBuscarSKU" Size="ButtonSize.Small" />
                        @* <RadzenButton ButtonStyle="ButtonStyle.Primary" ButtonType="ButtonType.Button" Icon="grid_on" Text="Cargar Excel" Click="@OnCargarArchivo" Size="ButtonSize.Small" /> *@

                        <RadzenButton ButtonStyle="ButtonStyle.Base" Icon="draw" IconColor="@Colors.Secondary" Text="Detalle libre" Size="ButtonSize.Small"
                                      Click="HandleClickDetalleLibre" title="Detalle libre" />
                    </RadzenStack>

                    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" AlignItems="AlignItems.Center" Gap="5rem" Style="width: fit-content;">
                        <RadzenLabel Style="text-wrap:nowrap">
                            Total de líneas: <strong>@(comprobante.Detalle.Count)</strong>
                        </RadzenLabel>

                        <RadzenLabel Style="text-wrap: nowrap; margin-right: 1.5rem;">
                            Total unidades: <strong>
                                @(comprobante.Detalle.Sum(x => x.Cantidad) *
                                                            (comprobante.Presupuesto && comprobante.Factura
                                                            ? 2
                                                            : comprobante.Presupuesto || comprobante.Factura
                                                            ? 1
                                                            : 0))
                            </strong>
                        </RadzenLabel>
                    </RadzenStack>
                </RadzenStack>
            </HeaderTemplate>
            <Columns>
                <RadzenDataGridColumn Title="SKU" TextAlign="TextAlign.Right" Width="100px" OrderIndex="0">
                    <Template Context="data">
                        @if (data.CodProducto == null && data.Detalle == null)
                        {
                            <input id=@($"sku{data.NumeroLinea}") type="number" @bind-value="data.CodProducto" @bind-value:event="oninput"
                                   @onkeydown="@(args => HandleSKUOnKeyDown(args, data))" @onfocusout="@(() => HandleSKUOnFocusOut(data))"
                                   arrowKeyBlocker enterKeyBlocker readonly="@isLoading"
                                   class="rz-textbox table-input-padding" style="width:100%; height: 25px; text-align: right;" />
                        }
                        else
                        {
                            <text>@data.CodProducto</text>
                        }
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn Property="@nameof(ComprobanteDetalle.DescripcionProducto)" Title="Descripción" TextAlign="TextAlign.Left" />
                <RadzenDataGridColumn Title="Cant" TextAlign="TextAlign.Right" Width="65px">
                    <Template Context="data">
                        <input id=@($"cant{data.NumeroLinea}") type="number" @bind-value="data.Cantidad"
                               @onkeydown="@(args => KeyDownCant(args, data))" @onfocusout="@(() => OnFocusOutCant(data))"
                               arrowKeyBlocker enterKeyBlocker
                               class="rz-textbox table-input-padding" style="width:100%; height: 25px; text-align: right;" />
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn Title="Unitario" TextAlign="TextAlign.Right" Width="110px">
                    <Template Context="data">
                        @if (permiteModificarPreciosUnitarios)
                        {
                            <input id=@($"unit{data.NumeroLinea}") type="number" @bind-value="data.PrecioFinalParaInput"
                                   @onkeydown="@(args => KeyDownUnit(args, data))" @onfocusout="@(() => OnFocusOutUnit(data))"
                                   arrowKeyBlocker enterKeyBlocker
                                   class="rz-textbox table-input-padding" style="width:100%; height: 25px; text-align: right;" />
                        }
                        else
                        {
                            @data.PrecioFinalSinDescuentoNiRecargo.ToString("N2")
                        }
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn Title="% Dto" TextAlign="TextAlign.Right" Width="65px">
                    <Template Context="data">
                        @if (Comprobante.Remito == null)
                        {
                            <input id=@($"desc{data.NumeroLinea}") type="number" @bind-value="data.PorcentajeDescuentoLinea"
                                   @onkeydown="@(args => KeyDownDesc(args, data))" @onfocusout="@(() => OnFocusOutDesc(data))"
                                   arrowKeyBlocker enterKeyBlocker
                                   class="rz-textbox table-input-padding" style="width:100%; height: 25px; text-align: right;" />
                        }
                        else
                        {
                            @data.PorcentajeDescuentoLinea.ToString()
                        }
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn Property="@nameof(ComprobanteLinea.PrecioFinalConDescuentoLinea)" Title="Unit. c/dto." TextAlign="TextAlign.Right" Width="110px">
                    <Template Context="data">
                        $@data.PrecioFinalConDescuentoLinea.ToString("N2", new CultureInfo("es-AR"))
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn Property="@nameof(ComprobanteLinea.TotalLineaConImpuestos)" Title="Total" TextAlign="TextAlign.Right" Width="130px">
                    <Template Context="data">
                        $@data.TotalLineaConImpuestosSinPromociones.ToString("N2", new CultureInfo("es-AR"))
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TextAlign="TextAlign.Center" Sortable=false Filterable=false Width="35px">
                    <Template Context="data">
                        @if ((TipoComprobante != TiposComprobante.Remito && TipoComprobante != TiposComprobante.GenerarFactura) && Comprobante.Remito == null)
                        {
                            <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.ExtraSmall"
                                          Click="@(args => DeleteRow(data))" @onclick:stopPropagation="true" title="Eliminar" />
                        }
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>

        <RadzenStack JustifyContent="JustifyContent.Center" Gap="3rem" Orientation="Orientation.Horizontal" class="rz-mt-2">
            <RadzenButton Disabled=@(editMode) ButtonStyle="ButtonStyle.Danger" Icon="cancel" Text="Cancelar" Click="Cancelar" />
            <RadzenButton Disabled=@(editMode) ButtonStyle="ButtonStyle.Success" Icon="save" ButtonType="ButtonType.Submit" Text="Guardar" />
        </RadzenStack>

    </RadzenTemplateForm>
}
else
{
    <Loader />
}

@code {
    [Parameter] public string OperacionQuery { get; set; }
    [Parameter] public int IdQuery { get; set; }
    TipoOperacionEnum tipoOperacion;

    bool showPage, editMode, isLoading;
    ComprobanteCabecera comprobante;
    EditContext editContext;
    CustomValidation customValidation;

    List<ListaDePrecios> listasDePrecio;
    List<Motivo> motivos;
    RadzenDataGrid<ComprobanteDetalle> grid;
    bool listaPrecioManual, permiteModificarPreciosUnitarios, descuentoManual;

    protected override async Task OnInitializedAsync()
    {
        var permisos = await SeguridadService.ValidatePageAccess(Permisos.Menu.NotasCredito);
        ToolsHelpers tH = new(NavigationManager);
        tipoOperacion = tH.ObtenerOperacion(OperacionQuery);

        if (!permisos.Contains(tipoOperacion.ToString().ToLower()))
        {
            await RadzenDialogService.ShowAlertAsync("No tiene permiso para realizar la operación", MensajesHelper.Title);
            BackPage();
            return;
        }

        listaPrecioManual = permisos.Contains(Permisos.ListaPrecio);
        permiteModificarPreciosUnitarios = permisos.Contains(Permisos.PreciosUnitarios);

        listasDePrecio = await OrdenesService.GetListasDePrecio();
        motivos = await MotivosService.GetMotivos(null, null, false, null);

        if (tipoOperacion == TipoOperacionEnum.Alta)
        {
            var aux = await ClientesService.GetClientes(idCliente: IdQuery);
            if (aux == null)
            {
                RadzenDialogService.NotifyInternalServerError();
                BackPage();
                return;
            }

            var cliente = aux.First();
            comprobante = new()
            {
                FechaComprobante = DateOnly.FromDateTime(DateTime.Today),
                IdCliente = cliente.IdCliente,
                ClienteCategoriaIVA = cliente.CategoriaIva,
                ClienteCuit = cliente.CUIT,
                ClienteRazonSocial = cliente.RazonSocial,
                CodCliente = cliente.CodigoCliente,
                IdListaPrecio = int.Parse(cliente.CodListaPrecioDefault)
            };

        }
        else if (tipoOperacion == TipoOperacionEnum.Edicion)
        {
            comprobante = await OrdenesService.GetNotaCredito((int)IdQuery);
            if (comprobante == null)
            {
                RadzenDialogService.NotifyInternalServerError();
                BackPage();
            }
            else if (comprobante.IdEstado != ComprobanteCabeceraEstadoEnum.Pendiente)
            {
                await RadzenDialogService.ShowAlertAsync("La nota de crédito no se encuentra en estado \"Pendiente\" y no puede ser editada", MensajesHelper.Title);
                BackPage();
            }
        }


        editContext = new(comprobante);
        showPage = true;
    }

    private void BackPage() => NavigationManager.NavigateTo("notascredito");

    private void ChangeDescuento(ComprobanteDetalle d)
    {
        grid.UpdateRow(d);
    }

    private async Task HandleSKUOnKeyDown(KeyboardEventArgs e, ComprobanteDetalle linea)
    {
        if (e.Key == KeyboardKeys.Enter & !isLoading)
            await JSFunction.OnBlurInput($"sku{linea.NumeroLinea}");
        else if (e.Key == KeyboardKeys.Escape)
            linea.CodProducto = null;
        else if (e.Key == KeyboardKeys.Right)
            await JSFunction.InputFocusAndSelect($"ean{linea.NumeroLinea}");
        else if (e.Key == KeyboardKeys.Up)
        {
            if (comprobante.Detalle.Any(x => x.NumeroLinea == linea.NumeroLinea - 1))
                await JSFunction.InputFocusAndSelect($"sku{linea.NumeroLinea - 1}");
        }
        else if (e.Key == KeyboardKeys.Down)
        {
            if (comprobante.Detalle.Any(x => x.NumeroLinea == linea.NumeroLinea + 1))
                await JSFunction.InputFocusAndSelect($"sku{linea.NumeroLinea + 1}");
            else
                await JSFunction.InputFocusAndSelect("descPie1");
        }
    }

    private async Task HandleSKUOnFocusOut(ComprobanteDetalle linea)
    {
        if (!string.IsNullOrWhiteSpace(linea.CodProducto) & linea.DescripcionProducto == null)
        {
            isLoading = true;
            var result = await BuscarProducto(linea, linea.CodProducto);
            isLoading = false;

            if (result)
                await JSFunction.InputFocusAndSelect($"cant{linea.NumeroLinea}");
            else
                await JSFunction.InputFocusAndSelect($"sku{linea.NumeroLinea}");
        }
    }

    private async Task<bool> BuscarProducto(ComprobanteDetalle linea, string codProducto)
    {
        var producto = await ProductosService.GetProducto(codProducto, (int)comprobante.IdListaPrecio);

        if (producto != null)
        {
            if (comprobante.Detalle.Exists(s => s.CodProducto == producto.CodigoProducto))
                RadzenDialogService.Notify(NotificationSeverity.Warning, "El SKU fue cargado con anterioridad");

            BuildLinea(linea, producto);

            return true;
        }
        else
        {
            RadzenDialogService.Notify(NotificationSeverity.Info, "No se encontró el producto", "Compruebe los datos ingresados");
            return false;
        }
    }

    private void BuildLinea(ComprobanteDetalle linea, Producto producto)
    {
        linea.CodProducto = producto.CodigoProducto;
        linea.DescripcionProducto = producto.Descripcion;
        linea.Precio = producto.Precio ?? 0;
        // linea.PrecioFinalParaInput = Math.Round(producto.PrecioNeto * (1 + (Comprobante.CalculaIVA ? 0 : producto.IVAPorcentaje / 100)), 2);
    }

    private async Task KeyDownCant(KeyboardEventArgs e, ComprobanteDetalle linea)
    {
        if (e.Key == KeyboardKeys.Enter)
            await JSFunction.InputFocusAndSelect($"desc{linea.NumeroLinea}");
        else if (e.Key == KeyboardKeys.Escape)
            linea.Cantidad = 0;
        else if (e.Key == KeyboardKeys.Right)
            await JSFunction.InputFocusAndSelect($"unit{linea.NumeroLinea}");
        else if (e.Key == KeyboardKeys.Up)
        {
            if (comprobante.Detalle.Any(x => x.NumeroLinea == linea.NumeroLinea - 1))
                await JSFunction.InputFocusAndSelect($"cant{linea.NumeroLinea - 1}");
        }
        else if (e.Key == KeyboardKeys.Down)
        {
            if (comprobante.Detalle.Any(x => x.NumeroLinea == linea.NumeroLinea + 1))
                await JSFunction.InputFocusAndSelect($"cant{linea.NumeroLinea + 1}");
            else
                await JSFunction.InputFocusAndSelect("descPie1");
        }
    }

