            </RadzenRow>

            <RadzenRow Style="margin-top:10px;">
                <RadzenColumn Size="4">
                    <RadzenStack Orientation="Orientation.Vertical" Gap="0">
                        <RadzenLabel Text="Lista de precios:" />
                        <RadzenDropDownDataGrid Data="listasDePrecio" @bind-Value="comprobante.IdListaPrecio" Disabled="@(listaPrecioManual)" Density="Density.Compact" Change=ChangeListaPrecio
                                                TextProperty="@nameof(ListaDePrecios.Descripcion)" ValueProperty="@nameof(ListaDePrecios.CodigoTango)" AllowVirtualization="true"
                                                FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" AllowFilteringByAllStringColumns=true FilterOperator="StringFilterOperator.Contains">
                            <Columns>
                                <RadzenDropDownDataGridColumn Property="@nameof(ListaDePrecios.CodigoTango)" Title="Código" Width="4.5rem" />
                                <RadzenDropDownDataGridColumn Property="@nameof(ListaDePrecios.Descripcion)" Title="Descripción" />
                            </Columns>
