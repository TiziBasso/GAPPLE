                <RadzenDataGridColumn Property="@nameof(ComprobanteDetalle.CodProducto)" Title="Cód." Width="45px" />
                <RadzenDataGridColumn Property="@nameof(ComprobanteDetalle.DescripcionProducto)" Title="Descripción" Width="50px" />
                <RadzenDataGridColumn Property="@nameof(ComprobanteDetalle.Cantidad)" Title="Cant. P" Width="25px" TextAlign="TextAlign.Right" Visible=@(comprobante.Presupuesto)>
                    <FooterTemplate>
                        <strong>
                            Total P: @(comprobante.Detalle.Sum(x => x.Cantidad).ToString("N2"))
                        </strong>
                    </FooterTemplate>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn Property="@nameof(ProductoOrden.CantidadSeleccionada)" Title="Cant F." Width="25px" TextAlign="TextAlign.Right" Visible=@(comprobante.Factura)>
                    <FooterTemplate>
                        <strong>
                            Total F: @(comprobante.Detalle.Sum(x => x.Cantidad).ToString("N2"))
                        </strong>
                    </FooterTemplate>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn Title="Cant. T" Width="50px" TextAlign="TextAlign.Right" Context="data" Visible=@(comprobante.Factura && comprobante.Presupuesto)>
                    <Template>
                        @(data.Cantidad * 2)
                    </Template>
                    <FooterTemplate>
                        <strong>
                            Total: @((comprobante.Detalle.Sum(x => x.Cantidad) * 2).ToString("N2"))
                        </strong>
                    </FooterTemplate>
                </RadzenDataGridColumn>
                @* <RadzenDataGridColumn Visible=@(orden.Factura || orden.Presupuesto) Property="@nameof(ProductoOrden.CantidadProbador)" Title="Probadores" Width="40px" TextAlign="TextAlign.Right" /> *@
                <RadzenDataGridColumn Property="@nameof(ComprobanteDetalle.Descuento)" Title="Descuento" FormatString="{0:N2}%" TextAlign="TextAlign.Right">
                    <Template Context="data">
                        @if (descuentoManual)
                        {
                            <RadzenNumeric @bind-Value=data.Descuento Min="0" Max="100" TValue="decimal" Change="@(args => ChangeDescuento(data))"
                                           ShowUpDown=false AutoCompleteType="AutoCompleteType.Off" TextAlign="TextAlign.Right" />
                        }
                        else
                        {
                            @data.Descuento
                        }
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn Property="@nameof(ComprobanteDetalle.Precio)" Title="Unitario" Width="75px" FormatString="${0:N2}" TextAlign="TextAlign.Right" />
                <RadzenDataGridColumn Property="@nameof(ComprobanteDetalle.PrecioConDescuento)" Title="Unit. c/desc" Width="55px" FormatString="${0:N2}" TextAlign="TextAlign.Right" />
                <RadzenDataGridColumn Property="@nameof(ComprobanteDetalle.PrecioTotal)" Context="precio" Title="Total" Width="75px" FormatString="${0:N2}" TextAlign="TextAlign.Right">
                    <Template>
                        @if (comprobante.Presupuesto && comprobante.Factura)
                        {
                            <span>
                                $@((precio.PrecioTotal * 2).ToString("N2"))
                            </span>
                        }
                        else if (comprobante.Presupuesto || comprobante.Factura)
                        {
                            <span>
                                $@precio.PrecioTotal.ToString("N2")
                            </span>
                        }
                        else
                        {
                            <span>
                                $@((0).ToString("N2"))
                            </span>
                        }
                    </Template>
                    <FooterTemplate>
                        @if (comprobante.Presupuesto && comprobante.Factura)
                        {
                            <strong>
                                Total: $@((comprobante.Detalle.Sum(x => x.PrecioTotal) * 2).ToString("N2"))
                            </strong>
                        }
                        else if (comprobante.Presupuesto || comprobante.Factura)
                        {
                            <strong>
                                Total: $@(comprobante.Detalle.Sum(x => x.PrecioTotal).ToString("N2"))
                            </strong>
                        }
                        else
                        {
                            <strong>
                                Total: $@((0).ToString("N2"))
                            </strong>
                        }
                    </FooterTemplate>
                </RadzenDataGridColumn>
                @* <RadzenDataGridColumn Width="20px" Frozen=true FrozenPosition="FrozenColumnPosition.Right" Resizable=false TextAlign="TextAlign.Center">
            <Template Context="data">
            <RadzenButton ButtonStyle="ButtonStyle.Danger" Icon="delete" Size="ButtonSize.ExtraSmall" Click="@(()=>DeleteRow(data))" />
            </Template>
            </RadzenDataGridColumn> *@
            </Columns>
        </RadzenDataGrid>

        <RadzenStack JustifyContent="JustifyContent.Center" Gap="3rem" Orientation="Orientation.Horizontal" class="rz-mt-2">
            <RadzenButton Disabled=@(editMode) ButtonStyle="ButtonStyle.Danger" Icon="cancel" Text="Cancelar" Click="Cancelar" />
            <RadzenButton Disabled=@(editMode) ButtonStyle="ButtonStyle.Success" Icon="save" ButtonType="ButtonType.Submit" Text="Guardar" />
        </RadzenStack>

    </RadzenTemplateForm>
}
else
{
    <Loader />
}

@code {
    [Parameter] public string OperacionQuery { get; set; }
    [Parameter] public int? IdQuery { get; set; }
    TipoOperacionEnum tipoOperacion;

    bool showPage, editMode;
    ComprobanteCabecera comprobante;
    EditContext editContext;
    CustomValidation customValidation;

    List<Cliente> clientes;
    List<ListaDePrecios> listasDePrecio;
    RadzenDataGrid<ComprobanteDetalle> grid;
    bool listaPrecioManual, descuentoManual;
    protected override async Task OnInitializedAsync()
    {
        var permisos = await SeguridadService.ValidatePageAccess(Permisos.Menu.NotasCredito);
        ToolsHelpers tH = new(NavigationManager);
        tH.Validate(OperacionQuery, IdQuery);
        tipoOperacion = tH.ObtenerOperacion(OperacionQuery);

        if (!permisos.Contains(tipoOperacion.ToString().ToLower()))
        {
            await RadzenDialogService.ShowAlertAsync("No tiene permiso para realizar la operación", MensajesHelper.Title);
            BackPage();
            return;
        }
        listaPrecioManual = permisos.Contains(Permisos.ListaPrecio);

        if (tipoOperacion == TipoOperacionEnum.Alta)
        {
            comprobante = new();

        }
        else if (tipoOperacion == TipoOperacionEnum.Edicion)
        {
            comprobante = await OrdenesService.GetNotaCredito((int)IdQuery);
            if (comprobante == null)
            {
                RadzenDialogService.NotifyInternalServerError();
                BackPage();
            }
            else if (comprobante.IdEstado != ComprobanteCabeceraEstadoEnum.Pendiente)
            {
                await RadzenDialogService.ShowAlertAsync("La nota de crédito no se encuentra en estado \"Pendiente\" y no puede ser editada", MensajesHelper.Title);
                BackPage();
            }
        }


        editContext = new(comprobante);
        showPage = true;
    }

    private void BackPage() => NavigationManager.NavigateTo("notascredito");

    private void ChangeDescuento(ComprobanteDetalle d)
    {
        grid.UpdateRow(d);
    }

    private async Task ChangeCliente()
    {

    }

    private async Task ChangeListaPrecio()
    {

    }

    private async Task OnCargarArchivo()
    {

    }

    private async Task OnAddProducto()
    {

    }

    private async Task OnBuscarProductos()
    {

    }

    private async Task Guardar()
    {

    }

    private async Task Cancelar()
    {
        if (!editContext.IsModified() || await RadzenDialogService.CancelOperation())
            BackPage();
    }
}
