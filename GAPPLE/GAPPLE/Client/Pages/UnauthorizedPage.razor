@page "/errorpage"
@page "/errorpage/{flag}"

<div style="margin:0;display:flex;height:100%;justify-content:center;align-items:center;">
    <div style="display:flex;flex-direction:column;">
        <h1 style="font-size:7rem;display: flex;justify-content: space-evenly;width: 100%;">
            Oops!
            <img style="width:7vw;" src="./assets/ErrorPrecaucion.svg" />
        </h1>
        @switch (Flag)
        {
            case "unauthorized":
                <h4 style="margin:0;padding:0;text-align:center;">No está autorizado para ver la página a la que intentó entrar</h4>
                break;
            case "unavailable":
                <h4 style="margin:0;padding:0;">La página a la que intentó entrar no está disponible</h4>
                break;
            case "unconfigured":
                <h4 style="margin:0;padding:0;">No tiene una sucursal/terminal activa configurada</h4>
                break;
            case "invalid":
                <h4 style="margin:0;padding:0;">La página solicitada no es válida o no existe</h4>
                break;
            case "usernotfound":
                <h4 style="margin:0;padding:0;">El usuario no se encuentra habilitado</h4>
                break;
            case "reparacionecommerce":
                <h4 style="margin:0;padding:0;">No se puede reabrir una reparación correspondiente a una sucursal de ecommerce</h4>
                break;
            case "stock":
                <h4 style="margin:0;padding:0;">No tiene una sucursal asociada, Contacte a sistemas.</h4>
                break;
            default:
                <h4 style="margin:0;padding:0;">La página a la que intentó entrar no está disponible</h4>
                <h4 style="margin:0;padding:0;text-align:center;">o no está autorizado para verla</h4>
                break;
        }
    </div>
</div>

@code {
    [Parameter] public string Flag { get; set; }
}