@page "/expedicion"
@using GAPPLE.Client.Components.Expedicion
@using GAPPLE.Client.Components.Expedicion.Informes

@inject SeguridadService SeguridadService
@inject OrdenesService OrdenesService
@inject DialogService DialogService
@inject RadzenDialogService RadzenDialogService
@inject IJSFunction JSFunction

@if (showPage)
{
    <RadzenText TextStyle="TextStyle.DisplayH4" TextAlign="TextAlign.Center" Text="Expediciones a despachar" class="rz-mb-3" />

    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent=JustifyContent.Right class="rz-mb-2">
        @*Filtros?*@
        <RadzenButton Text="Refrescar" Icon="refresh" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Secondary" Click="FillOrdenes" Disabled=isLoading title="Refrescar ordenes" />
    </RadzenStack>

    <RadzenDataGrid @ref=grid TItem="OrdenExpedicion" Data="expediciones" @bind-Value=selected SelectionMode=DataGridSelectionMode.Multiple IsLoading=isLoading
                    AllowFiltering="true" FilterMode="FilterMode.Simple" AllowSorting="true" AllowColumnResize=true Density=Density.Compact
                    EmptyText="" Style="height:60vh" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" ColumnWidth="80px">
        <HeaderTemplate>
            <RadzenButton Size="ButtonSize.Small" Text="Imprimir seleccionados" Icon="print" Click="Imprimir" ButtonStyle="ButtonStyle.Info" Variant="Variant.Outlined" Disabled=@(!selected.Any()) />
            <RadzenButton Size="ButtonSize.Small" Text="Despachar seleccionados" Icon="send" Click="Despachar" ButtonStyle="ButtonStyle.Success" Disabled=@(!selected.Any()) />
        </HeaderTemplate>
        <Columns>
            <RadzenDataGridColumn Property="@nameof(OrdenExpedicion.Orden)" Title="Cód. orden" MinWidth="10px" />

            <RadzenDataGridColumn Property="@nameof(OrdenExpedicion.IdPedidos)" Title="Id orden" MinWidth="10px" />

            <RadzenDataGridColumn Property="@nameof(OrdenExpedicion.Fecha)" Title="Fecha" FormatString="{0:dd/MM/yyyy HH:mm}"
                                  Filterable=false TextAlign="TextAlign.Center" MinWidth="10px" />

            <RadzenDataGridColumn Property="@nameof(OrdenExpedicion.FechaEntrega)" Title="Fecha entrega" FormatString="{0:dd/MM/yyyy}"
                                  Filterable=false TextAlign="TextAlign.Center" MinWidth="10px" />

            <RadzenDataGridColumn Property="@nameof(OrdenExpedicion.Linea)" Title="Linea" MinWidth="10px" />

            <RadzenDataGridColumn Property="@nameof(OrdenExpedicion.CodCliente)" Title="Cliente" MinWidth="10px" />

            <RadzenDataGridColumn Property="@nameof(OrdenExpedicion.RazonSocial)" Title="Razón social" MinWidth="10px" />

            <RadzenDataGridColumn Property="@nameof(OrdenExpedicion.Articulos)" Title="Artículos" FilterValue="articulosFilter" MinWidth="10px">
                <FilterTemplate>
                    <RadzenNumeric @bind-Value=articulosFilter TextAlign=TextAlign.Right Style="width:100%" ShowUpDown=false />
                </FilterTemplate>
            </RadzenDataGridColumn>

            <RadzenDataGridColumn Property="@nameof(OrdenExpedicion.TieneProbadores)" Title="Probadores" Width="105px" MinWidth="10px"
                                  TextAlign="TextAlign.Center" FilterValue="probadoresFilter" Resizable=false>
                <FilterTemplate>
                    <RadzenDropDown Data=@Variables.Clasificaciones @bind-Value=probadoresFilter Style="width:100%"
                                    ValueProperty=@nameof(Opcion.Id) TextProperty=@nameof(Opcion.Descripcion) Placeholder="(Todos)" />
                </FilterTemplate>
                <Template>
                    @if (context.TieneProbadores)
                    {
                        <RadzenBadge BadgeStyle="BadgeStyle.Warning" Text="@($"SI ({context.CantidadProbadores})")"
                                     title="Lleva probadores: genera un segundo pedido" />
                    }
                    else
                    {
                        <RadzenBadge BadgeStyle="BadgeStyle.Light" Text="NO" title="No lleva probadores" />
                    }
                </Template>
            </RadzenDataGridColumn>

            <RadzenDataGridColumn Property="@nameof(OrdenExpedicion.ObservacionesZentra)" Title="Observaciones" MinWidth="10px" />

            <RadzenDataGridColumn Title="Ver" Width="35px" TextAlign=TextAlign.Center Resizable=false Filterable=false Sortable=false Frozen=true FrozenPosition="FrozenColumnPosition.Right">
                <Template>
                    <RadzenButton ButtonStyle="ButtonStyle.Warning" Icon="edit" Click="@(()=>VerPedido(context))" Size="ButtonSize.ExtraSmall" @onclick:stopPropagation=true />
                </Template>
            </RadzenDataGridColumn>

            <RadzenDataGridColumn Title="Impreso" Width="60px" TextAlign=TextAlign.Center Resizable=false Filterable=false Sortable=false Frozen=true FrozenPosition="FrozenColumnPosition.Right">
                <Template>
                    <RadzenCheckBox Value="context.Impreso" ReadOnly=true @onclick:stopPropagation=true />
                </Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>

    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" AlignItems="AlignItems.Center"
                 Gap="8px" class="rz-mt-2 contador-pedidos">
        @if (selected.Any())
        {
            <RadzenBadge BadgeStyle="BadgeStyle.Info" Text="@($"Seleccionados: {selected.Count}")" />
        }
        @if (conProbadores > 0)
        {
            <RadzenBadge BadgeStyle="BadgeStyle.Warning" Text="@($"Con probadores: {conProbadores}")"
                         title="Ordenes que generan un segundo pedido" />
        }
        <RadzenBadge BadgeStyle="BadgeStyle.Secondary" Text="@($"Pedidos: {expediciones.Count}")" />
    </RadzenStack>

    @if (showPrint)
    {
        <div id="datos" style="height:0; overflow:hidden;">
            @for (int i = 0; i < expedicionesPrint.Count; i++)
            {
                <ImpresionExpediciones Orden=expedicionesPrint[i] Imprimir="@(()=>Print("datos"))" />
            }
        </div>
    }
}
else
{
    <Loader />
}

@code {
    bool showPage, isLoading, showPrint;
    List<OrdenExpedicion> expediciones = new();
    List<OrdenExpedicion>? expedicionesPrint = null;
    RadzenDataGrid<OrdenExpedicion> grid;
    IList<OrdenExpedicion> selected = new List<OrdenExpedicion>();

    int? articulosFilter;
    bool? probadoresFilter;

    int conProbadores => expediciones.Count(x => x.TieneProbadores);

    protected override async Task OnInitializedAsync()
    {
        await SeguridadService.ValidatePageAccess();

        await FillOrdenes();
        showPage = true;
    }

    private async Task FillOrdenes()
    {
        isLoading = true;
        expediciones = await OrdenesService.GetOrdenesExpediciones();
        isLoading = false;
    }

    private async Task VerPedido(OrdenExpedicion orden)
    {
        await DialogService.OpenAsync<ExpedicionCantidades>("Seleccionar cantidades",
            new() {
                { "IdOrden", orden.Orden } },
            new()
                {
                    CloseDialogOnEsc = false,
                    ShowClose = false,
                    CloseDialogOnOverlayClick = false,
                    AutoFocusFirstElement = false,
                    Width = "fit-content",
                    Height = "fit-content",
                    Style = "max-width:80vw; max-height:90vh"
                });
    }

    private async Task Imprimir()
    {
        RadzenDialogService.OpenBusyWithLoader("Imprimiendo...");
        expedicionesPrint = new();
        foreach (var item in selected)
        {
            var aux = await OrdenesService.GetOrdenExpedicionImprimir(item.Orden);
            expedicionesPrint.Add(aux);
        }
        showPrint = true;
    }

    public async Task Print(string id = "print")
    {
        await JSFunction.Imprimir(id);
        showPrint = false;
        expedicionesPrint = null;
        foreach (var item in selected)
        {
            item.Impreso = true;
        }
        selected = new List<OrdenExpedicion>();
        RadzenDialogService.CloseDialog();
    }

    private async Task Despachar()
    {
        RadzenDialogService.OpenBusyWithLoader("Despachando...");
        var response = await OrdenesService.DespacharOrdenes(selected.ToList());
        RadzenDialogService.CloseDialog();
        if (response.IsOk)
        {
            RadzenDialogService.Notify(NotificationSeverity.Success, "Ordenes despachadas correctamente");
            selected = new List<OrdenExpedicion>();
            await FillOrdenes();
        }
        else if (response.Errors != null && response.Errors.Any())
        {
            RadzenDialogService.ShowAlert(response.Errors["error"]);
            await FillOrdenes();
        }
        else
        {
            RadzenDialogService.Notify(NotificationSeverity.Error, "Ha ocurrido un error", response.Message);
        }
    }


}

<style>
    .contador-pedidos {
        width: 100%;
    }

    .rz-custom-header {
        width: 100%;
        justify-content: space-between;
        display: flex;
        padding: 0 10px;
    }
</style>