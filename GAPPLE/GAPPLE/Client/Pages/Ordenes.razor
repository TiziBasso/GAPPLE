@page "/ordenes"

@inject DialogService DialogService

<RadzenText TextStyle="TextStyle.DisplayH4" TextAlign="TextAlign.Center" Text="Ordenes" class="mb-3" />

<RadzenStack Orientation="Orientation.Horizontal" Wrap="FlexWrap.Wrap" Gap="4px">
    <RadzenStack Orientation="Orientation.Vertical">
        ID:
        <input @ref="refIdOrden" type="number" @bind-value="@idOrden" @bind-value:event="oninput" @onkeypress="@((KeyboardEventArgs e) => KeyPress(e))"
               class="rz-textbox" style="width: 5rem; text-align:right" disabled="@(isLoading)" />
    </RadzenStack>

    <RadzenStack Orientation="Orientation.Vertical">
        Código:
        <input type="number" @bind-value="@codigo" @bind-value:event="oninput" @onkeypress="@((KeyboardEventArgs e) => KeyPress(e))"
               class="rz-textbox" style="width: 8rem" disabled="@(isLoading)" />
    </RadzenStack>

    <RadzenStack Orientation="Orientation.Vertical">
        Cliente:
        <input type="text" @bind-value="@cliente" @bind-value:event="oninput" @onkeypress="@((KeyboardEventArgs e) => KeyPress(e))"
               class="rz-textbox" style="width: 20rem" disabled="@(isLoading)" />
    </RadzenStack>

    <RadzenStack Orientation="Orientation.Vertical">
        Desde:
        <RadzenDatePicker @bind-Value="desde" AllowClear="true" DateFormat="dd/MM/yyyy" />
    </RadzenStack>

    <RadzenStack Orientation="Orientation.Vertical">
        Hasta:
        <RadzenDatePicker @bind-Value="hasta" AllowClear="true" DateFormat="dd/MM/yyyy" />
    </RadzenStack>

    <RadzenStack Orientation="Orientation.Vertical">
        Estado:
        <RadzenDropDown Data=@Variables.EstadosNum @bind-Value=@estado
                        ValueProperty=@nameof(Opcion.Id) TextProperty=@nameof(Opcion.Descripcion)
                        Change="HandleEstadosChange" Disabled="@isLoading" Style="width: 7rem;" />
    </RadzenStack>

    <RadzenStack Orientation="Orientation.Vertical">
        Máx. regs.:
        <input type="number" @bind-value="@cantRegs" @bind-value:event="oninput" @onkeypress="@((KeyboardEventArgs e) => KeyPress(e))"
               class="rz-textbox" style="width: 5rem" disabled="@(isLoading)" />
    </RadzenStack>
</RadzenStack>

<RadzenStack Orientation=Orientation.Horizontal Gap="10px" class="rz-mb-1 rz-mt-3">
    <RadzenButton Text="Agregar orden" Icon="add" ButtonStyle="ButtonStyle.Primary" Size=ButtonSize.Medium Click="NuevaOrden" />
    <RadzenButton Text="Exportar Excel" Icon="grid_on" Click="Export" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Secondary" />
</RadzenStack>

<RadzenDataGrid @ref="grid" Data="sampleData.Orders" AllowFiltering="true" FilterMode="FilterMode.Simple" AllowSorting="true" EmptyText="No hay registros para mostrar">
    <Columns>
        <RadzenDataGridColumn TItem="InectoOrder" Title="ID" Property="@nameof(InectoOrder.Id)" Width="50px" TextAlign="TextAlign.Right" />
        <RadzenDataGridColumn TItem="InectoOrder" Title="Código" Property="@nameof(InectoOrder.Codigo)" Width="80px" />
        <RadzenDataGridColumn TItem="InectoOrder" Title="Presupuesto" Property="@nameof(InectoOrder.Presup)" Width="80px" />
        <RadzenDataGridColumn TItem="InectoOrder" Title="Cliente" Property="@nameof(InectoOrder.Cliente)" Width="120px" />
        <RadzenDataGridColumn TItem="InectoOrder" Title="Línea" Property="@nameof(InectoOrder.Linea)" Width="120px" />
        <RadzenDataGridColumn TItem="InectoOrder" Title="Creación" Property="@nameof(InectoOrder.Creacion)" Width="100px" TextAlign="TextAlign.Center">
            <Template>
                <span>@context.Creacion.ToString("dd/MM/yyyy")</span>
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="InectoOrder" Title="Zona" Property="@nameof(InectoOrder.Zona)" Width="120px" />
        <RadzenDataGridColumn TItem="InectoOrder" Title="Pendiente" Property="@nameof(InectoOrder.Pend)" Width="50px" TextAlign="TextAlign.Right" />
        <RadzenDataGridColumn TItem="InectoOrder" Title="Estado" Property="@nameof(InectoOrder.Estado)" Width="80px" TextAlign="TextAlign.Center" />
        <RadzenDataGridColumn TItem="InectoOrder" Title="Tango" Property="@nameof(InectoOrder.Tango)" Width="80px" />
        <RadzenDataGridColumn TItem="InectoOrder" Title="Factura" Property="@nameof(InectoOrder.Factura)" Width="80px" />
        <RadzenDataGridColumn TItem="InectoOrder" Title="Fecha" Property="@nameof(InectoOrder.Fecha)" Width="100px" TextAlign="TextAlign.Center">
            <Template>
                <span>@context.Fecha!.Value.ToString("dd/MM/yyyy")</span>
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="InectoOrder" Title="Unidad" Property="@nameof(InectoOrder.Unid)" Width="70px" TextAlign="TextAlign.Right" />
        <RadzenDataGridColumn TItem="InectoOrder" Title="Entrega" Property="@nameof(InectoOrder.Entrega)" Width="80px" />
        <RadzenDataGridColumn Frozen="true" FrozenPosition="FrozenColumnPosition.Right" TItem="InectoOrder" Filterable="false" Sortable="false" Groupable="false" Resizable="false" TextAlign="TextAlign.Center" Width="110px">
            <Template Context="orden">
                <RadzenButton Icon="info" ButtonStyle="ButtonStyle.Info" Variant="Variant.Flat" Size="ButtonSize.ExtraSmall"
                              Click="@(() => VerOrden(orden))" @onclick:stopPropagation="true" />
                <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Warning" Variant="Variant.Flat" Size="ButtonSize.ExtraSmall"
                              @onclick:stopPropagation="true" />
                <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Flat" Size="ButtonSize.ExtraSmall"
                              @onclick:stopPropagation="true" Click="@(() => Delete(orden))" />
            </Template>
        </RadzenDataGridColumn>
    </Columns>
</RadzenDataGrid>

@code {
    ElementReference refIdOrden;
    InectoOrderSet sampleData = new();
    RadzenDataGrid<InectoOrder> grid;
    List<string> estados = new();
    string filterEstado;
    string cliente;
    bool isLoading;

    int estado = 2, cantRegs = 10;
    int? idOrden, codigo;
    DateTime? desde = DateTime.Today.AddMonths(-1), hasta = DateTime.Today;

    protected override async Task OnInitializedAsync()
    {

    }

    async Task VerOrden(InectoOrder orden)
    {
        await DialogService.OpenAsync<OrdenInfo>($"Orden {orden.Id} - TANGO {orden.Tango}", null, new DialogOptions() { Width = "90vw", Height = "90vh", });
    }

    private async Task KeyPress(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            sampleData = InectoOrderDataSet.GetSampleData(cantRegs);
            estados.Clear();
            estados.AddRange(sampleData.Orders.Select(x => x.Estado).ToList().Distinct());
        }
    }

    async Task Delete(InectoOrder order)
    {
        if ((bool)await DialogService.Confirm($"¿Desea eliminar la orden {order.Id}?",
                    "Confirmación", new ConfirmOptions() { OkButtonText = "Sí", CancelButtonText = "No", ShowClose=false }))
        {
            sampleData.Orders.Remove(order);
            await grid.Reload();
        }
    }

    private async Task HandleEstadosChange()
    {
        sampleData = InectoOrderDataSet.GetSampleData(cantRegs);
        estados.Clear();
        estados.AddRange(sampleData.Orders.Select(x => x.Estado).ToList().Distinct());
    }

    async Task NuevaOrden()
    {
        await DialogService.OpenAsync<OrdenCreacion>("Nueva orden", null, new DialogOptions() { Width = "90vw", Height = "90vh", });
    }

    public async Task Export()
    {
        // DialogCustom.OpenBusy("Exportando...");
        // await ExcelService.ExportProductos(productos, new Query()
        //     {
        //         OrderBy = refGrid.Query.OrderBy,
        //         Filter = refGrid.Query.Filter,
        //         Select = string.Join(",", refGrid.ColumnsCollection.Where(c => c.GetVisible() && !string.IsNullOrEmpty(c.Property))
        //                                                                 .Select(c => c.Property.Contains(".") ? $"{c.Property} as {c.Property.Replace(".", "_")}" : c.Property))
        //     });
        // DialogCustom.CloseDialog();
    }

    public class InectoOrder
    {
        public int Id { get; set; }
        public string Codigo { get; set; }
        public string Presup { get; set; }
        public string Cliente { get; set; }
        public string Linea { get; set; }
        public DateTime Creacion { get; set; }
        public string Zona { get; set; }
        public string Pend { get; set; }
        public string Estado { get; set; }
        public string Tango { get; set; }
        public string Factura { get; set; }
        public DateTime? Fecha { get; set; } // Nullable as the date might be empty
        public int Unid { get; set; }
        public string Entrega { get; set; }
        public bool Aprob { get; set; }
    }

    public class InectoOrderSet
    {
        public List<InectoOrder> Orders { get; set; }

        public InectoOrderSet()
        {
            Orders = new List<InectoOrder>();
        }

        public void AddOrder(InectoOrder order)
        {
            Orders.Add(order);
        }

        public InectoOrder GetOrderById(int id)
        {
            return Orders.FirstOrDefault(o => o.Id == id);
        }

        public void RemoveOrderById(int id)
        {
            var order = GetOrderById(id);
            if (order != null)
            {
                Orders.Remove(order);
            }
        }
    }

    public class InectoOrderDataSet
    {
        public static InectoOrderSet GetSampleData(int numberOfOrders = 15)
        {
            var orderSet = new InectoOrderSet();
            var random = new Random();

            for (int i = 1; i <= numberOfOrders; i++)
            {
                orderSet.AddOrder(new InectoOrder
                    {
                        Id = i,
                        Codigo = $"C{i:00000}",
                        Presup = $"PR{i:0000}",
                        Cliente = $"Cliente {i}",
                        Linea = $"Línea {random.Next(1, 4)}",
                        Creacion = DateTime.Now.AddDays(-random.Next(1, 30)),
                        Zona = $"Zona {GetRandomZona(random)}",
                        Pend = random.Next(0, 5).ToString(),
                        Estado = random.Next(0, 2) == 0 ? "Pendiente" : "Completado",
                        Tango = $"T{random.Next(100, 999)}",
                        Factura = $"F{i:0000}",
                        Fecha = DateTime.Now.AddDays(random.Next(1, 15)),
                        Unid = random.Next(1, 20),
                        Entrega = $"Entrega {GetRandomZona(random)}",
                        Aprob = random.Next(0, 2) == 0
                    });
            }

            return orderSet;
        }

        private static string GetRandomZona(Random random)
        {
            var zonas = new[] { "Norte", "Sur", "Este", "Oeste" };
            return zonas[random.Next(zonas.Length)];
        }
    }
}
