                                                    </RadzenStack>
                                                </RadzenColumn>
                                            </RadzenRow>

                                        </RadzenTabsItem>

                                        @*                                         <RadzenTabsItem Text="Precio de venta">
                                    <ProductoPreciosListado Precios="@Producto.Precios" PreciosHistoricos="preciosHistoricos" />
                                    <ValidationMessage For="@(()=>Producto.Precios)" />
                                    </RadzenTabsItem>*@

                                        @* <RadzenTabsItem Text="Atributos">
                                    <ProductoAtributoListado Atributos="@Producto.Atributos" />
