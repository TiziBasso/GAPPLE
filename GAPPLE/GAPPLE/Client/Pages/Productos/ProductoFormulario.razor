}

@code {
    [Parameter] public string OperacionUrl { get; set; }
    [Parameter] public int? IdProducto { get; set; }
    [Parameter] public string PaisOrigen { get; set; }

    Producto Producto { get; set; }
    EditContext editContext;

    //List<ProductoProveedor> precioCostoHistoricos = new();
    //List<ProductoPrecio> preciosHistoricos = new();

    Operaciones operacion;
    bool disabledInput, mostarPreciosCostos, invalidFamilia, onEdit;
    int tabIndex, render;
    string descripcionFamilia = string.Empty;

    RadzenTextBox refDescripcion;

    protected override async Task OnInitializedAsync()
    {
        bool error = false;
        error = ToolsHelpers.Validate(OperacionUrl, IdProducto);

        operacion = ToolsHelpers.ObtenerOperacion(OperacionUrl);

        if (operacion == Operaciones.Lectura)
            disabledInput = true;
        else if (operacion == Operaciones.Importar && PaisOrigen == null)
        {
            NavigationManager.NavigateTo(Variables.ErrorPages.Invalido);
            error = true;
        }

        //var listPermisos = await SeguridadService.ValidatePageAccess("maestroProductos");
        List<string> listPermisos = new() { "lectura", "ver" };
        if (!listPermisos.Exists(x => x == OperacionUrl))
        {
            NavigationManager.NavigateTo(Tools.Variables.ErrorPages.Desautorizado);
            error = true;
        }

        if (!error)
        {
            //familias = await ProductosService.GetFamilias();

            if (IdProducto == null)
            {
                Producto = new();
                //Producto.Precios = await ProductosService.GetProductosPrecioVentaAlta();
                //Producto.PorcentajeIVA = await ParametrosService.TasaIVA_1();
                Producto.PorcentajeIVA = 21;
            }
            else
            {
                Producto? p = null;
                p = await ProductosService.GetProducto(null, IdProducto);

                if (p == null)
                {
                    NotificationService.Notify(NotificationSeverity.Error, "El producto no existe");
                    NavigationManager.NavigateTo("productos");
                }
                else
                {
                    Producto = p;
                    //precioCostoHistoricos = await ProductosService.GetProductoPreciosCostoHistorico(Producto.IdProducto);
                    //preciosHistoricos = await ProductosService.GetProductoPreciosVentaHistorico(Producto.IdProducto);
                    // if (!Producto.Precios.Any())
                    // {
                    //     Producto.Precios = await ProductosService.GetProductosPrecioVentaAlta();
                    //     Producto.Precios.ForEach(x => x.IdProducto = Producto.IdProducto);
                    // }
                }
            }

            mostarPreciosCostos = listPermisos.Exists(x => x == "mostrarprecioscostos");

            editContext = new(Producto);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        render++;

        if (render == 2)
            await refDescripcion.FocusAsync();
    }

    private void HandleTabChange(int index)
    {
        if (index == 3)
        {
            //   if (!Producto.Proveedores.Any())
            tabIndex = 1;
        }
    }

    private async Task Cancelar()
    {
        if (operacion == Operaciones.Lectura)
            NavigationManager.NavigateTo("productos");
        else if ((bool)await DialogService.Confirm("¿Desea cancelar la operación?", "Integra", new ConfirmOptions() { OkButtonText = "Sí", CancelButtonText = "No", ShowClose = false }))
            NavigationManager.NavigateTo("productos");
    }

    private async Task Submit()
    {
        var errors = new Dictionary<string, List<string>>();

        // if (Producto.Precios.FindAll(x => x.PrecioNeto == 0).Any())
        //     errors.Add(nameof(Producto.Precios), new() { "Hay precios de venta en 0" });

        // if (!errors.ContainsKey(nameof(Producto.Precios)))
        //     if (Producto.Precios.FindAll(x => x.PrecioFinal <= 0).Any())
        //         errors.Add(nameof(Producto.Precios), new() { "El precio final no puede ser menor o igual a 0" });

        // if (Producto.Proveedores.FindAll(x => x.PrecioCosto == 0).Any())
        //     errors.Add(nameof(Producto.Proveedores), new() { "Hay proveedores con precios de costo en 0" });

        if (errors.Any())
            NotificationService.Notify(NotificationSeverity.Error, "No se puede completar la operación, compruebe que todos los datos ingresados sean correctos!");
        else
        {
            if ((bool)await DialogService.Confirm("¿Desea guardar la operación?", "Integra", new ConfirmOptions() { OkButtonText = "Sí", CancelButtonText = "No", ShowClose = false }))
            {
                DialogCustom.OpenBusyWithLoader("Guardando...");
                Response response;
                if (operacion == Operaciones.Alta)
                    response = await ProductosService.PostProducto(Producto);
                else
                    response = await ProductosService.PutProducto(Producto);

                DialogCustom.CloseDialog();

                if (!response.IsSuccessStatusCode)
                {
                    if (response.Errors != null && response.Errors.Any())
                    {
                        NotificationService.Notify(NotificationSeverity.Error, "No se puede completar la operación, compruebe que todos los datos ingresados sean correctos!");
                        HandleTabChange(1);
                    }
                    else
                        NotificationService.Notify(NotificationSeverity.Error, "Ha ocurrido un error inesperado!", "Por favor contacte a sistemas!");
                }
                else if (operacion == Operaciones.Alta)
                {
                    await Task.Delay(1);
                    if (operacion == Operaciones.Alta)
                    {
                        Dictionary<string, object> parametros = new();
                        parametros.Add("codigo", Producto.CodigoProducto);
                        ParametrosDeConsulta.Clear();
                        ParametrosDeConsulta.Save(ParametrosDeConsulta.Pages.ProductosIndex, parametros);

                        string message = $"Código interno: <strong>{Producto.CodigoProducto}</strong>";

                        await DialogService.Alert(message, "Producto creado",
                                                    new AlertOptions()
                                                        {
                                                            OkButtonText = "Ok",
                                                            Height = "fit-content",
                                                            Width = "fit-content",
                                                            ShowClose = false,
                                                            Style = "max-height:25rem; max-width:30rem"
                                                        });
                    }

                    NotificationService.Notify(NotificationSeverity.Success, "Datos guardados correctamente!");
                    NavigationManager.NavigateTo("productos");
                }
                else
                {
                    NotificationService.Notify(NotificationSeverity.Success, "Datos guardados correctamente!");
                    NavigationManager.NavigateTo("productos");
                }
            }
        }
    }

    private void InvalidSubmit()
    {
        invalidFamilia = editContext.GetValidationMessages(editContext.Field(nameof(Producto.Clasificacion))).Any();
        editContext.Validate();
        var errors = editContext.GetValidationMessages().ToList();
        DialogCustom.ShowErrors(errors);
    }

