@inject ProductosService ProductosService
@inject DialogService DialogService
@inject NotificationService NotificationService
@inject NavigationManager NavigationManager
@inject ParametrosDeConsulta ParametrosDeConsulta
@inject ToolsHelpers ToolsHelpers
@inject DialogCustom DialogCustom

@if (editContext != null)
{
    <RadzenText TextStyle="TextStyle.DisplayH4" TextAlign="TextAlign.Center" Text="Datos del producto" />

    <RadzenTemplateForm EditContext="editContext" TItem="Producto" Submit="Submit" InvalidSubmit="InvalidSubmit">
