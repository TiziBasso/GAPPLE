            </CascadingValue>
        </CascadingValue>

        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.Center" Gap="1rem" class="rz-mt-8">
            @if (operacion == Operaciones.Lectura)
