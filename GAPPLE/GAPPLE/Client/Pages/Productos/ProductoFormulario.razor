                <CascadingValue Value="@disabledInput" Name="DisabledInput" IsFixed="true">
                    <CascadingValue Value="@Producto.Descripcion" Name="DescripcionProducto">

                        <RadzenRow class="rz-mt-2">
                            <RadzenColumn Size="12">
                                <RadzenTabs RenderMode="TabRenderMode.Client" SelectedIndex="tabIndex" SelectedIndexChanged="HandleTabChange" Style="height: 540px;">
                                    <Tabs>
                                        <RadzenTabsItem Text="Datos generales">
                                            @* <RadzenRow>
                                        <RadzenColumn Size="12" SizeMD="6">
                                        <RadzenStack Orientation="Orientation.Vertical" Gap="0">
                                        <RadzenLabel Text="Familia:" />
                                        <div class="input-group-left">
                                        <RadzenTextBox Name="sub-familia" Value="@descripcionFamilia" ReadOnly="true" Disabled="disabledInput" Style="width: calc(100% - 50px); height:auto"
                                        class="@(invalidFamilia ? "invalid" : null)" />
                                        <span class="input-group-btn">
                                        <RadzenButton ButtonStyle="ButtonStyle.Secondary" Variant="Variant.Flat" Style="width: 50px;" Click="HandleClickFamilia" Disabled="disabledInput">
                                        <i class="bi bi-file-medical me-2 fs-5"></i>
                                        </RadzenButton>
                                        </span>
                                        </div>
                                        <ValidationMessage For="@(() => Producto.IdFamilia)" />
                                        </RadzenStack>
                                        </RadzenColumn>
                                        </RadzenRow> *@

                                            <RadzenRow class="rz-mt-3">
                                                <RadzenColumn Size="12" SizeMD="8">
                                                    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center" Gap="5px" Style="height: 100%; margin-top:5px;">
                                                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="5px">
                                                            <RadzenLabel Text="Pasivo:" Component="pasivo" />
                                                            <RadzenCheckBox @bind-Value="@Producto.Pasivo" Name="pasivo" Disabled="disabledInput" />
                                                        </RadzenStack>
                                                    </RadzenStack>
                                                </RadzenColumn>
                                            </RadzenRow>


                                            <RadzenRow JustifyContent="JustifyContent.SpaceBetween" class="rz-mt-3">
                                                <RadzenColumn Size="12" SizeSM="2">
                                                    <RadzenStack Orientation="Orientation.Vertical" Gap="5px">
                                                        <RadzenLabel Text="% de IVA:" />
                                                        <RadzenNumeric @bind-Value="Producto.PorcentajeIVA" TValue="decimal?" Format="#0.00" TextAlign="TextAlign.Right" ShowUpDown="false" Disabled="disabledInput" />
                                                        <ValidationMessage For="@(() => Producto.PorcentajeIVA)" />
                                                    </RadzenStack>
                                                </RadzenColumn>

                                                <RadzenColumn Size="12" SizeSM="2">
                                                    <RadzenStack Orientation="Orientation.Vertical" Gap="5px">
                                                        <RadzenLabel Text="Precio:" />
                                                        <RadzenNumeric @bind-Value="Producto.Precio" TValue="decimal?" Format="#0.00" TextAlign="TextAlign.Right" ShowUpDown="false" Disabled="disabledInput" />
                                                        <ValidationMessage For="@(() => Producto.PorcentajeIVA)" />
                                                    </RadzenStack>
                                                </RadzenColumn>
                                            </RadzenRow>

                                            <RadzenRow class="rz-mt-3">
                                                <RadzenColumn Size="12">
                                                    <RadzenStack Orientation="Orientation.Vertical" Gap="5px">
                                                        <RadzenLabel Text="Observaciones:" />
