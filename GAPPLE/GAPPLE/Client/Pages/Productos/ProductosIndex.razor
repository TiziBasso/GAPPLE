    <RadzenStack Orientation="Orientation.Horizontal" Wrap="FlexWrap.Wrap" Gap="4px" class="rz-mb-3">
        <RadzenStack Orientation="Orientation.Vertical">
            <RadzenLabel Text="Código:" Component="codigo" />
            <input @ref="refCodigoInterno" type="number" id="codigo" @bind-value="@codigoInterno" @bind-value:event="oninput" @onkeypress="KeyPress"
