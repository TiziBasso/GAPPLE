        </RadzenStack>

        <RadzenStack Orientation="Orientation.Vertical">
            <RadzenLabel Text="Descripción:" Component="desc" />
            <input type="text" id="desc" @bind-value="@descripcion" @bind-value:event="oninput" @onkeypress="KeyPress" class="rz-textbox" style="width: 20rem" disabled="@(isLoading)" autocomplete="off" />
        </RadzenStack>

        <RadzenStack Orientation="Orientation.Vertical">
            <RadzenLabel Text="Proveedor:" Component="proveedor" />
