    </RadzenDataGrid>
}
else
{
    <Loader />
}

@code {
    CancellationTokenSource cancellationToken = new CancellationTokenSource();
    ElementReference refCodigoInterno;

    int? codigoInterno, skuWeb, cantRegs = 200;
    string ean, descripcion, proveedor, familia, codSegunProveedor, marca;
    int estado, index, render;

    RadzenDataGrid<Producto> refGrid;
    List<Producto> productos { get; set; } = new();
    IList<Producto> selectedProduct;

    //Variables para filtros sobre la grilla
    string codigoInternoFilter, descripcionFilter, familiasFilter, marcasFilter, proveedorFilter;
    bool isLoading, showPage;

    List<string> listPermisos = new();
    Dictionary<string, object> parametros = new();

    protected override async Task OnInitializedAsync()
    {
        //await SeguridadService.ValidatePageAccess();
        //listPermisos = await SeguridadService.GetPermisos("maestroProductos");
        listPermisos = new()
        {
            "ver"
        };

        estado = 2;

        if (this.ParametrosDeConsulta.Page == ParametrosDeConsulta.Pages.ProductosIndex && this.ParametrosDeConsulta.Parametros.Any())
        {
            if (ParametrosDeConsulta.Parametros.ContainsKey("codigo"))
                codigoInterno = (int)ParametrosDeConsulta.Parametros["codigo"];

            if (ParametrosDeConsulta.Parametros.ContainsKey("ean"))
                ean = (string)ParametrosDeConsulta.Parametros["ean"];

            if (ParametrosDeConsulta.Parametros.ContainsKey("descripcion"))
                descripcion = (string)ParametrosDeConsulta.Parametros["descripcion"];

            if (ParametrosDeConsulta.Parametros.ContainsKey("proveedor"))
                proveedor = (string)ParametrosDeConsulta.Parametros["proveedor"];

            if (ParametrosDeConsulta.Parametros.ContainsKey("familia"))
                familia = (string)ParametrosDeConsulta.Parametros["familia"];

            if (ParametrosDeConsulta.Parametros.ContainsKey("marca"))
                marca = (string)ParametrosDeConsulta.Parametros["marca"];

            if (ParametrosDeConsulta.Parametros.ContainsKey("codsegunproveedor"))
                codSegunProveedor = (string)ParametrosDeConsulta.Parametros["codsegunproveedor"];

            if (ParametrosDeConsulta.Parametros.ContainsKey("skuweb"))
                skuWeb = (int)ParametrosDeConsulta.Parametros["skuweb"];

            if (ParametrosDeConsulta.Parametros.ContainsKey("cantregs"))
                cantRegs = (int)ParametrosDeConsulta.Parametros["cantregs"];

            if (ParametrosDeConsulta.Parametros.ContainsKey("estado"))
                estado = (int)ParametrosDeConsulta.Parametros["estado"];

            if (ParametrosDeConsulta.Parametros.ContainsKey("index"))
                index = (int)ParametrosDeConsulta.Parametros["index"];

            await FillProductos();
        }
        else
            ParametrosDeConsulta.Clear();

        showPage = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        render++;
        if (render == 2)
        {
            await refCodigoInterno.FocusAsync();
            if (this.ParametrosDeConsulta.Page == ParametrosDeConsulta.Pages.ProductosIndex && this.ParametrosDeConsulta.Parametros.Any())
            {
                await refGrid.SelectRow(productos[index]);
                // await JSFunction.ScrollGridToIndex(refGrid.UniqueID, index);
            }
        }
    }

    private async Task KeyPress(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await FillProductos();
        }
    }

    private void ImportarProducto()
    {
        navigationManager.NavigateTo("productos/importar");
    }

    private async Task FillProductos()
    {
        isLoading = true;
        parametros.Clear();

        if (codigoInterno != null && codigoInterno != 0) parametros.Add("codigo", codigoInterno);
        if (!string.IsNullOrWhiteSpace(ean)) parametros.Add("ean", ean.Trim());
        if (!string.IsNullOrWhiteSpace(descripcion)) parametros.Add("descripcion", descripcion.Trim());
        if (!string.IsNullOrWhiteSpace(proveedor)) parametros.Add("proveedor", proveedor.Trim());
        if (!string.IsNullOrWhiteSpace(familia)) parametros.Add("familia", familia.Trim());
        if (!string.IsNullOrWhiteSpace(marca)) parametros.Add("marca", marca.Trim());
        if (!string.IsNullOrWhiteSpace(codSegunProveedor)) parametros.Add("codsegunproveedor", codSegunProveedor.Trim());
        if (skuWeb != null) parametros.Add("skuweb", skuWeb);
        parametros.Add("estado", estado);
        if (cantRegs != null && cantRegs != 0) parametros.Add("cantregs", cantRegs);

        bool? pasivo = null;
        if (estado == 2)
            pasivo = false;
        else if (estado == 3)
            pasivo = true;

        productos = await ProductosService.GetProductos(null, codigoInterno, ean, descripcion, proveedor, null, familia, marca,
            codSegunProveedor, null, skuWeb, pasivo, cantRegs, false, cancellationToken);

        isLoading = false;

        if (!productos.Any())
        {
            NotificationService.Notify(summary: "La búsqueda no ha devuelto resultados");
            if (render > 2)
                await refCodigoInterno.FocusAsync();
        }
    }

    private void NuevoProducto()
    {
        navigationManager.NavigateTo("producto/alta");
    }

    private async Task VerProducto(Producto producto)
    {
        DialogCustom.OpenBusy("Cargando...");
        await refGrid.SelectRow(producto);
        GuardarParametrosDeConsulta(productos.FindIndex(x => x == selectedProduct.FirstOrDefault()));
        navigationManager.NavigateTo($"producto/ver/{producto.IdProducto}");
    }

    private async Task ModificarProducto(Producto producto)
    {
        DialogCustom.OpenBusy("Cargando...");
        await refGrid.SelectRow(producto);
        GuardarParametrosDeConsulta(productos.FindIndex(x => x == selectedProduct.FirstOrDefault()));
        navigationManager.NavigateTo($"producto/edicion/{producto.IdProducto}");
    }

    private async Task VerProductoSku(Producto producto)
    {
        DialogCustom.OpenBusy("Cargando...");
        await refGrid.SelectRow(producto);
        GuardarParametrosDeConsulta(productos.FindIndex(x => x == selectedProduct.FirstOrDefault()));
        navigationManager.NavigateTo($"skus/{producto.IdProducto}");
    }

    private async Task RowExpand(Producto producto)
    {
        await refGrid.SelectRow(producto);
    }

    private void GuardarParametrosDeConsulta(int index)
    {
        parametros.Add("index", index);
        ParametrosDeConsulta.Save(ParametrosDeConsulta.Pages.ProductosIndex, parametros);
    }

    private async Task HandleEstadosChange()
    {
        await FillProductos();
    }

    // public async Task Export()
    // {
    //     DialogCustom.OpenBusy("Exportando...");
    //     await ExcelService.ExportProductos(productos, new Query()
    //         {
    //             OrderBy = refGrid.Query.OrderBy,
    //             Filter = refGrid.Query.Filter,
    //             Select = string.Join(",", refGrid.ColumnsCollection.Where(c => c.GetVisible() && !string.IsNullOrEmpty(c.Property)).Select(c => c.Property.Contains(".") ? $"{c.Property} as {c.Property.Replace(".", "_")}" : c.Property))
    //         });
    //     DialogCustom.CloseDialog();
    // }

    public void Dispose()
    {
        cancellationToken?.Cancel();
        cancellationToken?.Dispose();
    }
}
