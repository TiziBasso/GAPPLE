            <RadzenDataGridColumn TItem="Producto" Property="@(nameof(Producto.Descripcion))" Title="Descripción" FilterValue="@descripcionFilter"
                                  Groupable="false" Width="300px">
                <FilterTemplate>
                    <input type="text" @bind-value="@descripcionFilter" @bind-value:event="oninput" class="rz-textbox" style="width: 100%" />
                </FilterTemplate>
            </RadzenDataGridColumn>
            @* <RadzenDataGridColumn TItem="Producto" Property="@(nameof(Producto.Familia))" Title="Familia" Width="150px" FilterValue="@familiasFilter">
        <FilterTemplate>
        <input type="text" @bind-value="@familiasFilter" @bind-value:event="oninput" class="rz-textbox" style="width: 100%" />
        </FilterTemplate>
        </RadzenDataGridColumn> *@
            @* <RadzenDataGridColumn TItem="Producto" Property="@(nameof(Producto.Proveedor))" Title="Proveedor" Width="150px" FilterValue="@proveedorFilter">
        <FilterTemplate>
        <input type="text" @bind-value="@proveedorFilter" @bind-value:event="oninput" class="rz-textbox" style="width: 100%" />
        </FilterTemplate>
        </RadzenDataGridColumn> *@
            <RadzenDataGridColumn TItem="Producto" Property="@(nameof(Producto.Pasivo))" Title="Pasivo" TextAlign="TextAlign.Center" Width="75px"
                                  Filterable="false" Sortable="false" Groupable="false" Resizable="false">
                <Template Context="producto">
                    <RadzenCheckBox @bind-Value=@producto.Pasivo Disabled=true />
                </Template>
            </RadzenDataGridColumn>
            @* <RadzenDataGridColumn TItem="Producto" Property="@(nameof(Producto.PrecioCosto))" Title="Precio costo" TextAlign="TextAlign.Right" Width="120px"
