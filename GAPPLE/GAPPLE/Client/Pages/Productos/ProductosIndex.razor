        </RadzenStack>

        <RadzenStack Orientation="Orientation.Vertical">
            <RadzenLabel Text="Familia:" Component="familia" />
            <input type="text" id="familia" @bind-value="@familia" @bind-value:event="oninput" @onkeypress="KeyPress" class="rz-textbox" style="width: 13rem" disabled="@(isLoading)" autocomplete="off" />
        </RadzenStack>

        <RadzenStack Orientation="Orientation.Vertical">
            <RadzenLabel Text="Marca:" Component="marca" />
            <input type="text" id="marca" @bind-value="@marca" @bind-value:event="oninput" @onkeypress="KeyPress" class="rz-textbox" style="width: 13rem" disabled="@(isLoading)" autocomplete="off" />
        </RadzenStack>

        <RadzenStack Orientation="Orientation.Vertical">
            <RadzenLabel Text="Cód.s/prov:" Component="codProv" />
            <input type="text" id="codProv" @bind-value="@codSegunProveedor" @bind-value:event="oninput" @onkeypress="KeyPress" class="rz-textbox" style="width: 6rem" disabled="@(isLoading)" autocomplete="off" />
        </RadzenStack>

        <RadzenStack Orientation="Orientation.Vertical">
            <RadzenLabel Text="SKU Web:" Component="skuWeb" />
            <input type="number" id="skuWeb" @bind-value="@skuWeb" @bind-value:event="oninput" @onkeypress="KeyPress" class="rz-textbox" style="width: 5rem" disabled="@(isLoading)" autocomplete="off" />
        </RadzenStack>

        <RadzenStack Orientation="Orientation.Vertical">
            <RadzenLabel Text="Estado:" Component="estado" />
            <RadzenDropDown Data=@Variables.EstadosNum @bind-Value=@estado Name="estado"
                            ValueProperty=@nameof(Opcion.Id) TextProperty=@nameof(Opcion.Descripcion)
                            Change="HandleEstadosChange" Disabled="@isLoading" Style="width: 8rem;" />
        </RadzenStack>

        <RadzenStack Orientation="Orientation.Vertical">
            <RadzenLabel Text="Máx. regs.:" Component="maxRegs" />
            <input type="number" id="maxRegs" @bind-value="@cantRegs" @bind-value:event="oninput" @onkeypress="KeyPress" class="rz-textbox" style="width: 5rem" disabled="@(isLoading)" autocomplete="off" />
        </RadzenStack>
    </RadzenStack>

    <RadzenStack Orientation=Orientation.Horizontal Gap="10px" class="rz-mb-1">
        <RadzenButton Text="Agregar producto" Icon="add" ButtonStyle="ButtonStyle.Secondary" Size=ButtonSize.Small Click="NuevoProducto" Disabled="@(isLoading || !listPermisos.Contains("alta"))" />
        @* <RadzenButton Text="Exportar a Excel" Icon="grid_on" Click="Export" Size="ButtonSize.Small" Disabled="@(!productos.Any() || isLoading)" /> *@
    </RadzenStack>

    <RadzenDataGrid @ref="@refGrid" Data="productos" AllowSorting="true" AllowGrouping="true" AllowFiltering="true" Density="Density.Compact"
                    IsLoading="@isLoading" AllowColumnResize="true" FilterMode="FilterMode.Simple"
