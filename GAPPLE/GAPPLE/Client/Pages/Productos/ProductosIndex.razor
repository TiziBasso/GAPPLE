@page "/productos"

@using System.Threading
@using System.Globalization
@using GAPPLE.Client.Components.Productos
@implements IDisposable

@inject ProductosService ProductosService
@inject OrdenesService OrdenesService
@inject IJSFunction JSFunction
@inject SeguridadService SeguridadService
@inject ParametrosDeConsulta ParametrosDeConsulta
@inject NavigationManager navigationManager
@inject NotificationService NotificationService
@inject DialogService DialogService
@inject RadzenDialogService RadzenDialogService
@inject RadzenCustom RadzenCustom

@if (showPage)
{
    <RadzenText TextStyle="TextStyle.DisplayH4" TextAlign="TextAlign.Center" Text="Maestro de producto" class="rz-mb-3" />

    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.End" Wrap="FlexWrap.Wrap" Gap="4px" class="rz-mb-3">
        <RadzenStack Orientation="Orientation.Vertical">
            <RadzenLabel Text="Código Producto:" Component="codigo" />
            <input @ref="refCodigoInterno" type="text" id="codigo" @bind-value="@codigoProducto" @bind-value:event="oninput" @onkeypress="KeyPress"
                   class="rz-textbox" style="width: 9rem; text-align: right;" disabled="@(isLoading)" autocomplete="off" />
        </RadzenStack>

        <RadzenStack Orientation="Orientation.Vertical">
            <RadzenLabel Text="Descripción:" Component="desc" />
            <input type="text" id="desc" @bind-value="@descripcion" @bind-value:event="oninput" @onkeypress="KeyPress" class="rz-textbox" style="width: 20rem" disabled="@(isLoading)" autocomplete="off" />
        </RadzenStack>

        <RadzenStack Orientation="Orientation.Vertical">
            <RadzenLabel Text="Clasificado:" Component="estado" />
            <RadzenDropDown Data=@Variables.Clasificaciones @bind-Value=@clasificacion Name="estado" Placeholder="Todos"
                            ValueProperty=@nameof(Opcion.Id) TextProperty=@nameof(Opcion.Descripcion)
                            Disabled="@isLoading" Style="width: 8rem;" />
        </RadzenStack>

        <RadzenStack Orientation="Orientation.Vertical">
            <RadzenLabel Text="Estado:" Component="pasivo" />
            <RadzenDropDown Data=@Variables.EstadosPasivo @bind-Value=@pasivo Name="pasivo" Placeholder="Ambos"
                            ValueProperty=@nameof(Opcion.Id) TextProperty=@nameof(Opcion.Descripcion)
                            Disabled="@isLoading" Style="width: 8rem;" />
        </RadzenStack>

        <RadzenStack Orientation="Orientation.Vertical">
            <RadzenLabel Text="Marca:" Component="marca" />
            <RadzenDropDown Data=@lineas @bind-Value=@marca Name="marca" Placeholder="Todas" AllowClear="true" AllowFiltering="true"
                            FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" Disabled="@isLoading" Style="width: 12rem;" />
        </RadzenStack>

        <RadzenStack Orientation="Orientation.Vertical">
            <RadzenLabel Text="Precios de lista:" Component="listas" />
            <RadzenDropDown TValue="IEnumerable<string>" Data=@listasDePrecio @bind-Value=@listasSeleccionadas Name="listas" Multiple="true" AllowClear="true"
                            AllowFiltering="true" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" FilterOperator="StringFilterOperator.Contains"
                            ValueProperty=@nameof(ListaDePrecios.CodigoTango) TextProperty=@nameof(ListaDePrecios.Descripcion)
                            Placeholder="Ninguna" MaxSelectedLabels="2" SelectedItemsText="listas seleccionadas"
                            AllowFiltering="true" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" FilterOperator="StringFilterOperator.Contains"
                            FilterPlaceholder="Buscar lista..." Disabled="@(isLoading || cargandoPrecios)" Style="width: 16rem;" Change="@(_ => CargarPrecios())" />
        </RadzenStack>

        <RadzenButton Click="FillProductos" IsBusy=isLoading Icon="search" Size="ButtonSize.Medium" ButtonStyle="ButtonStyle.Secondary" />
    </RadzenStack>

    <RadzenStack Orientation=Orientation.Horizontal Gap="10px" class="rz-mb-1">
        @* <RadzenButton Text="Agregar producto" Icon="add" ButtonStyle="ButtonStyle.Secondary" Size=ButtonSize.Small Click="NuevoProducto" Disabled="@(isLoading || !listPermisos.Contains("alta"))" /> *@
        <RadzenButton Text="Exportar orden de impresión" Icon="download" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Secondary" Variant="Variant.Outlined"
                      Click="ExportarOrden" Disabled="@isLoading" title="Descarga en Excel el Orden / Orden depósito de los productos que cumplen los filtros de búsqueda" />
        <RadzenButton Text="Importar orden de impresión" Icon="upload" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Secondary" Variant="Variant.Outlined"
                      Click="ImportarOrden" Disabled="@isLoading" title="Actualiza el Orden / Orden depósito de los productos desde un Excel" />
        @if (cargandoPrecios)
        {
            <RadzenText TextStyle="TextStyle.Caption" Style="align-self:center">@($"Cargando precios... (faltan {listasPendientes} lista{(listasPendientes == 1 ? "" : "s")})")</RadzenText>
        }
    </RadzenStack>

    <RadzenDataGrid @ref="@refGrid" Data="productos" AllowSorting="true" AllowFiltering="true" Density="Density.Compact"
                    IsLoading="@isLoading" AllowColumnResize="true" FilterMode="FilterMode.Simple"
                    FilterCaseSensitivity=FilterCaseSensitivity.CaseInsensitive LogicalFilterOperator="LogicalFilterOperator.Or"
                    SelectionMode="DataGridSelectionMode.Single" @bind-Value="selectedProduct" AllowVirtualization=true
                    ExpandMode="DataGridExpandMode.Single" RowExpand="@((Producto args) => RowExpand(args))" Style="height: 65vh;" EmptyText="">
        <Columns>
            <RadzenDataGridColumn TItem="Producto" Property="@(nameof(Producto.CodigoProducto))" Title="Código" TextAlign="TextAlign.Right"
                                  Width="90px" FilterValue="@codigoInternoFilter" Groupable="false" Resizable="false">
                <FilterTemplate>
                    <input type="text" @bind-value="@codigoInternoFilter" @bind-value:event="oninput" class="rz-textbox" style="width: 100%" />
                </FilterTemplate>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="Producto" Property="@(nameof(Producto.Descripcion))" Title="Descripción" FilterValue="@descripcionFilter"
                                  Groupable="false" Width="300px">
                <FilterTemplate>
                    <input type="text" @bind-value="@descripcionFilter" @bind-value:event="oninput" class="rz-textbox" style="width: 100%" />
                </FilterTemplate>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="Producto" Property="@(nameof(Producto.Pasivo))" Title="Pasivo" TextAlign="TextAlign.Center" Width="75px"
                                  Filterable="false" Sortable="false" Groupable="false" Resizable="false">
                <Template Context="producto">
                    <RadzenCheckBox @bind-Value=@producto.Pasivo TValue="bool" Change="@(() => Change(producto))" />
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="Producto" Property="@(nameof(Producto.Orden))" Title="Orden" FilterOperator="FilterOperator.Contains"
                                  Width="150px" Filterable=false Groupable="false" Resizable="false">
                <Template Context="producto">
                    <RadzenNumeric TValue="int" @bind-Value="producto.Orden" Change="@(() => Change(producto))" ShowUpDown=false TextAlign="TextAlign.Right" />
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="Producto" Property="@(nameof(Producto.OrdenDeposito))" Title="Orden depósito" FilterOperator="FilterOperator.Contains"
                                  Width="150px" Filterable=false Groupable="false" Resizable="false">
                <Template Context="producto">
                    <RadzenNumeric TValue="int?" @bind-Value="producto.OrdenDeposito" Change="@(() => Change(producto))" ShowUpDown=false TextAlign="TextAlign.Right" />
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="Producto" Property="@(nameof(Producto.Linea))" Title="Linea" FilterOperator="FilterOperator.Contains"
                                  Width="300px" Groupable="false" Resizable="false" />
            @* Id_STA es int: el operador Contains no aplica sobre enteros y la grilla tiraba excepción al filtrar (SCRUM-156) *@
            <RadzenDataGridColumn TItem="Producto" Property="@(nameof(Producto.Id_STA))" Title="Cód. Tango" FilterOperator="FilterOperator.Equals"
                                  FilterValue="@codTangoFilter" TextAlign="TextAlign.Right" Width="150px" Groupable="false" Resizable="false">
                <FilterTemplate>
                    <RadzenNumeric TValue="int?" @bind-Value=codTangoFilter Style="width:100%" ShowUpDown=false Min="0" TextAlign="TextAlign.Right" />
                </FilterTemplate>
            </RadzenDataGridColumn>
            @* Una columna de precio vigente por cada lista seleccionada (SCRUM-158). Van al final porque la
               grilla agrega al final las columnas que se crean dinámicamente al cambiar la selección. *@
            @foreach (var lista in ListasVisibles)
            {
                <RadzenDataGridColumn TItem="Producto" @key="lista.CodigoTango" Title="@($"Precio {lista.Descripcion}")" TextAlign="TextAlign.Right"
                                      Width="160px" Filterable="false" Sortable="false" Groupable="false">
                    <Template Context="producto">
                        @FormatearPrecio(lista.CodigoTango, producto.CodigoProducto)
                    </Template>
                </RadzenDataGridColumn>
            }
            @* <RadzenDataGridColumn TItem="Producto" Filterable="false" Sortable="false" Groupable="false" Resizable="false" TextAlign="TextAlign.Center" Width="35px"
                                  Frozen="true" FrozenPosition="FrozenColumnPosition.Left">
                <Template Context="producto">
                    <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Warning" Variant="Variant.Flat" Size="ButtonSize.ExtraSmall"
                                  Click="@(() => ModificarProducto(producto))" @onclick:stopPropagation="true" title="Editar producto" />
                </Template>
            </RadzenDataGridColumn> *@
        </Columns>
    </RadzenDataGrid>
}
else
{
    <Loader />
}

@code {
    CancellationTokenSource cancellationToken = new CancellationTokenSource();
    ElementReference refCodigoInterno;

    bool? clasificacion = null, pasivo = false;
    string? codigoProducto, descripcion, proveedor, familia, codSegunProveedor, marca;
    int render, index;

    RadzenDataGrid<Producto> refGrid;
    List<Producto> productos { get; set; } = new();
    IList<Producto> selectedProduct;

    //Variables para filtros sobre la grilla
    string? codigoInternoFilter, descripcionFilter, lineasFilter;
    int? codTangoFilter;
    bool isLoading, showPage, cargandoPrecios;
    int listasPendientes;

    // Filtro por marca (en el maestro la marca es la "Linea" del producto)
    List<string> lineas = new();

    // Columnas de precio: una por cada lista seleccionada. Los precios se cachean por lista.
    List<ListaDePrecios> listasDePrecio = new();
    // El botón "limpiar" del dropdown múltiple asigna null: se normaliza a vacío para no romper ListasVisibles/CargarPrecios
    IEnumerable<string> _listasSeleccionadas = Enumerable.Empty<string>();
    IEnumerable<string> listasSeleccionadas
    {
        get => _listasSeleccionadas;
        set => _listasSeleccionadas = value ?? Enumerable.Empty<string>();
    }
    Dictionary<string, Dictionary<string, decimal>> preciosPorLista = new();
    static readonly CultureInfo culturaAR = new("es-AR");

    IEnumerable<ListaDePrecios> ListasVisibles =>
        listasDePrecio.Where(x => listasSeleccionadas.Contains(x.CodigoTango));

    //List<string> listPermisos = new();
    Dictionary<string, object> parametros = new();

    protected override async Task OnInitializedAsync()
    {
        await SeguridadService.ValidatePageAccess();
        //listPermisos = await SeguridadService.GetPermisos("maestroProductos");

        lineas = (await ProductosService.GetLineas() ?? new()).Where(x => !string.IsNullOrWhiteSpace(x)).OrderBy(x => x).ToList();
        listasDePrecio = (await OrdenesService.GetListasDePrecio() ?? new()).OrderBy(x => x.Descripcion).ToList();
        // Algunas listas vienen de Tango sin nombre (ej. 691): se muestran con su código para poder identificarlas
        foreach (var lista in listasDePrecio.Where(x => string.IsNullOrWhiteSpace(x.Descripcion)))
            lista.Descripcion = $"Lista {lista.CodigoTango} (sin nombre)";
        // No se preselecciona ninguna lista: en Tango no hay forma confiable de saber cuáles están vigentes
        // (todas figuran habilitadas y sin fecha hasta). El usuario elige con el buscador del dropdown.
        listasSeleccionadas = Enumerable.Empty<string>();

        if (this.ParametrosDeConsulta.Page == ParametrosDeConsulta.Pages.ProductosIndex && this.ParametrosDeConsulta.Parametros.Any())
        {
            if (ParametrosDeConsulta.Parametros.ContainsKey("codigo"))
                codigoProducto = ParametrosDeConsulta.Parametros["codigo"].ToString()!;

            if (ParametrosDeConsulta.Parametros.ContainsKey("descripcion"))
                descripcion = (string)ParametrosDeConsulta.Parametros["descripcion"];

            if (ParametrosDeConsulta.Parametros.ContainsKey("clasificacion"))
                clasificacion = (bool)ParametrosDeConsulta.Parametros["clasificacion"];

            if (ParametrosDeConsulta.Parametros.ContainsKey("marca"))
                marca = ParametrosDeConsulta.Parametros["marca"].ToString();

            await FillProductos();
        }
        else
            ParametrosDeConsulta.Clear();

        showPage = true;
    }

    private async Task Change(Producto producto)
    {
        RadzenCustom.OpenBusyWithLoader();
        var response = await ProductosService.PutProducto(producto);
        if (response.IsOk)
            NotificationService.Notify(NotificationSeverity.Success, "Los datos se han guardado");
        RadzenCustom.CloseDialog();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        render++;
        if (render == 2)
        {
            await refCodigoInterno.FocusAsync();
            if (this.ParametrosDeConsulta.Page == ParametrosDeConsulta.Pages.ProductosIndex && this.ParametrosDeConsulta.Parametros.Any())
            {
                await refGrid.SelectRow(productos[index]);
                // await JSFunction.ScrollGridToIndex(refGrid.UniqueID, index);
            }
        }
    }

    private async Task KeyPress(KeyboardEventArgs e)
    {
        if (e.Key == KeyboardKeys.Enter)
            await FillProductos();
    }

    private void ImportarProducto() =>
        navigationManager.NavigateTo("productos/importar");

    private async Task FillProductos()
    {
        isLoading = true;
        parametros.Clear();

        if (!string.IsNullOrWhiteSpace(codigoProducto)) parametros.Add("codigo", codigoProducto);
        if (!string.IsNullOrWhiteSpace(descripcion)) parametros.Add("descripcion", descripcion.Trim());
        if (clasificacion != null) parametros.Add("clasificacion", clasificacion);
        if (!string.IsNullOrWhiteSpace(marca)) parametros.Add("marca", marca);

        productos = await ProductosService.GetProductos(codigoProducto, descripcion, clasificacion, pasivo, string.IsNullOrWhiteSpace(marca) ? null : marca, cancellationToken);

        isLoading = false;

        if (!productos.Any())
        {
            NotificationService.Notify(summary: "La búsqueda no ha devuelto resultados");
            if (render > 2)
                await refCodigoInterno.FocusAsync();
        }
        else
            await CargarPrecios();
    }

    /// <summary>
    /// Trae (una sola vez por lista) los precios vigentes de las listas seleccionadas que todavía no están en memoria.
    /// Solo se consulta si ya hay productos en la grilla.
    /// </summary>
    private async Task CargarPrecios()
    {
        if (!productos.Any()) return;

        var faltantes = listasSeleccionadas.Where(x => !preciosPorLista.ContainsKey(x)).ToList();
        if (!faltantes.Any()) return;

        cargandoPrecios = true;
        listasPendientes = faltantes.Count;
        StateHasChanged();
        try
        {
            // Las listas se piden en paralelo y cada una se muestra apenas llega
            await Task.WhenAll(faltantes.Select(CargarPreciosLista));
        }
        finally
        {
            // Siempre se apaga el indicador, aunque algún pedido falle o se cancele
            cargandoPrecios = false;
            listasPendientes = 0;
            StateHasChanged();
        }
    }

    private async Task CargarPreciosLista(string codLista)
    {
        Dictionary<string, decimal>? precios = null;
        try
        {
            precios = await ProductosService.GetPreciosLista(codLista, cancellationToken);
        }
        catch (OperationCanceledException)
        {
            return; // se salió de la página
        }
        catch (Exception)
        {
            precios = null;
        }

        if (precios != null)
            preciosPorLista[codLista] = precios;
        else
            NotificationService.Notify(NotificationSeverity.Error, MensajesHelper.Title,
                $"No se pudieron obtener los precios de la lista {listasDePrecio.FirstOrDefault(x => x.CodigoTango == codLista)?.Descripcion ?? codLista}");

        listasPendientes--;
        StateHasChanged();
    }

    private string FormatearPrecio(string codLista, string? codigoProducto)
    {
        if (codigoProducto == null || !preciosPorLista.TryGetValue(codLista, out var precios))
            return string.Empty;

        return precios.TryGetValue(codigoProducto.Trim(), out decimal precio) ? $"$ {precio.ToString("N2", culturaAR)}" : "-";
    }

    private async Task ExportarOrden()
    {
        RadzenDialogService.OpenBusyWithLoader("Exportando...");
        var archivo = await ProductosService.ExportarOrdenExcel(codigoProducto, descripcion, clasificacion, pasivo, string.IsNullOrWhiteSpace(marca) ? null : marca);
        RadzenDialogService.CloseDialog();

        if (archivo == null)
            RadzenDialogService.NotifyInternalServerError();
        else
            await JSFunction.DownloadFile(archivo, $"OrdenImpresion_{DateTime.Now:yyyyMMdd_HHmm}.xlsx");
    }

    private async Task ImportarOrden()
    {
        await DialogService.OpenAsync<ImportarOrdenExcelModal>("Importar orden de impresión",
            new() { { "Callback", EventCallback.Factory.Create<int>(this, OrdenImportado) } },
            new() { ShowClose = false, CloseDialogOnEsc = false, CloseDialogOnOverlayClick = false, Width = "36rem", Height = "fit-content" });
    }

    private async Task OrdenImportado(int actualizados)
    {
        DialogService.Close();

        NotificationService.Notify(NotificationSeverity.Success, MensajesHelper.Title,
            actualizados == 0 ? "El archivo no tenía cambios de orden" : $"Se actualizó el orden de {actualizados} producto(s)");

        if (actualizados > 0 && productos.Any())
            await FillProductos();
    }

    private void NuevoProducto()
    {
        navigationManager.NavigateTo("producto/alta");
    }

    private async Task VerProducto(Producto producto)
    {
        RadzenDialogService.OpenBusy("Cargando...");
        await refGrid.SelectRow(producto);
        GuardarParametrosDeConsulta(productos.FindIndex(x => x == selectedProduct.FirstOrDefault()));
        navigationManager.NavigateTo($"producto/ver/{producto.IdProducto}");
    }

    private async Task ModificarProducto(Producto producto)
    {
        RadzenDialogService.OpenBusy("Cargando...");
        await refGrid.SelectRow(producto);
    }

    private async Task VerProductoSku(Producto producto)
    {
        RadzenDialogService.OpenBusy("Cargando...");
        await refGrid.SelectRow(producto);
        GuardarParametrosDeConsulta(productos.FindIndex(x => x == selectedProduct.FirstOrDefault()));
        navigationManager.NavigateTo($"skus/{producto.IdProducto}");
    }

    private async Task RowExpand(Producto producto)
    {
        await refGrid.SelectRow(producto);
    }

    private void GuardarParametrosDeConsulta(int index)
    {
        parametros.Add("index", index);
        ParametrosDeConsulta.Save(ParametrosDeConsulta.Pages.ProductosIndex, parametros);
    }

    private async Task HandleEstadosChange()
    {
        await FillProductos();
    }

    // public async Task Export()
    // {
    //     RadzenDialogService.OpenBusy("Exportando...");
    //     await ExcelService.ExportProductos(productos, new Query()
    //         {
    //             OrderBy = refGrid.Query.OrderBy,
    //             Filter = refGrid.Query.Filter,
    //             Select = string.Join(",", refGrid.ColumnsCollection.Where(c => c.GetVisible() && !string.IsNullOrEmpty(c.Property)).Select(c => c.Property.Contains(".") ? $"{c.Property} as {c.Property.Replace(".", "_")}" : c.Property))
    //         });
    //     RadzenDialogService.CloseDialog();
    // }

    public void Dispose()
    {
        cancellationToken?.Cancel();
        cancellationToken?.Dispose();
    }
}
