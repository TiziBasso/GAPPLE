    <RadzenDataGridColumn TItem="ProductoPrecio" Property="@nameof(ProductoPrecio.Fecha)" Title="Vigencia" FormatString="{0:dd/MM/yyyy}"
    TextAlign="TextAlign.Center" Width="110px" />
    <RadzenDataGridColumn TItem="ProductoPrecio" Property="@nameof(ProductoPrecio.PrecioCosto)" Title="Precio costo" FormatString="{0:C2}"
    TextAlign="TextAlign.Right" Width="110px" Visible=@(listPermisos.Contains("mostrarprecioscostos")) />
    <RadzenDataGridColumn TItem="ProductoPrecio" Property="@nameof(ProductoPrecio.PorcentajeMargen)" Title="Margen"
