@page "/acuerdos"
@using GAPPLE.Client.Components.Acuerdos

@inject RadzenDialogService RadzenDialogService
@inject AcuerdosService AcuerdosService
@inject ParametrosDeConsulta ParametrosDeConsulta
@inject SeguridadService SeguridadService
@inject ProductosService ProductosService
@inject ToolsService ToolsService

@if (showPage)
{
    <RadzenText TextStyle="TextStyle.DisplayH4" TextAlign="TextAlign.Center" Text="Acuerdos con clientes" class="rz-mb-3" />

    <RadzenStack Orientation="Orientation.Horizontal" Wrap="FlexWrap.Wrap" Gap="4px" AlignItems="AlignItems.End">

        <RadzenStack Orientation="Orientation.Vertical">
            <RadzenLabel Text="Desde:" Component="desde" />
            <RadzenDatePicker @bind-Value="request.FechaDesde" DateFormat="dd/MM/yyyy" Name="desde" Style="width:8rem" />
        </RadzenStack>

        <RadzenStack Orientation="Orientation.Vertical">
            <RadzenLabel Text="Hasta:" Component="hasta" />
            <RadzenDatePicker @bind-Value="request.FechaHasta" DateFormat="dd/MM/yyyy" Max="DateTime.Today" Name="hasta" Style="width:8rem" />
        </RadzenStack>

        <RadzenStack Orientation="Orientation.Vertical">
            <RadzenLabel Text="Cód. cliente:" Component="codCliente" />
            <TextBoxInput @bind-Value=request.CodCliente id="codCliente" OnKeyDown="OnKeyDown" />
        </RadzenStack>

        <RadzenStack Orientation="Orientation.Vertical">
            <RadzenLabel Text="Razón social:" Component="razonSocial" />
            <TextBoxInput @bind-Value=request.RazonSocial id="razonSocial" OnKeyDown="OnKeyDown" />
        </RadzenStack>

        <RadzenStack Orientation="Orientation.Vertical">
            <RadzenLabel Text="Estado:" Component="estado" />
            <RadzenDropDown Data=@estados @bind-Value=@request.IdEstado Name="estado"
                            ValueProperty=@nameof(Estado<AcuerdosEstadoEnum>.Id) TextProperty=@nameof(Estado<AcuerdosEstadoEnum>.Descripcion)
                            Placeholder="(Todos)" AllowClear=true Style="width: 13rem;" />
        </RadzenStack>

        <RadzenButton Text="Buscar" Icon="search" Size="ButtonSize.Medium" ButtonStyle="ButtonStyle.Secondary" Click="FillAcuerdos" />
    </RadzenStack>

    <RadzenStack Orientation=Orientation.Horizontal Gap="10px" class="rz-mb-1 rz-mt-3">
        <RadzenButton Text="Agregar acuerdo" Icon="add" ButtonStyle="ButtonStyle.Secondary" Size=ButtonSize.Small Click="AgregarAcuerdo" Visible=@(permiteAlta) />
    </RadzenStack>

    <RadzenDataGrid @ref="grid" TItem="AcuerdoCliente" Data="acuerdosClientes" AllowFiltering=true FilterMode="FilterMode.Simple" AllowSorting=true
                    FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" ExpandMode="DataGridExpandMode.Single"
                    AllowColumnResize=true Density=Density.Compact
                    ShowEmptyMessage="false" Style="height:60vh" ColumnWidth="30px">
        <Columns>
            <RadzenDataGridColumn Property="@nameof(AcuerdoCliente.CodigoCliente)" Title="Cód. cliente" Width="120px" />
            <RadzenDataGridColumn Property="@nameof(AcuerdoCliente.RazonSocial)" Title="Razón social" Width="150px" />
        </Columns>
        <Template Context="cliente">
            <RadzenDataGrid TItem="Acuerdo" Data="AplicarFiltros(cliente.Acuerdos)" AllowFiltering="true" FilterMode="FilterMode.Simple" AllowSorting="true" AllowColumnResize="true"
                            ShowEmptyMessage="false" Density="Density.Compact" Style="height:20rem;" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" ColumnWidth="70px"
                            CellRender="@CellRender">
                <Columns>
                    <RadzenDataGridColumn Property="@nameof(Acuerdo.Linea)" Title="Linea" Width="120px" />
                    
                    <RadzenDataGridColumn Property="@nameof(Acuerdo.Condicion)" Title="Linea" Width="120px" />
                    
                    <RadzenDataGridColumn Property="@nameof(Acuerdo.DescripcionEstado)" Title="Estado" Filterable="false" Width="100px" Groupable="false" />

                    <RadzenDataGridColumn Property="@nameof(Acuerdo.FechaDesde)" Title="Fecha desde" FormatString="{0:dd/MM/yyyy}" TextAlign=TextAlign.Center Width="100px" Groupable="false"
                                          FilterMode="FilterMode.Simple">
                        <FilterTemplate>
                            <RadzenDatePicker @bind-Value=desdeFilter Max="DateTime.Today" AllowClear=true Style="width:100%" DateFormat="dd/MM/yyyy" />
                        </FilterTemplate>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn Property="@nameof(Acuerdo.FechaHasta)" Title="Fecha hasta" FormatString="{0:dd/MM/yyyy}" TextAlign=TextAlign.Center Width="100px" Groupable="false"
                                          FilterMode="FilterMode.Simple">
                        <FilterTemplate>
                            <RadzenDatePicker @bind-Value=hastaFilter Max="DateTime.Today" AllowClear=true Style="width:100%" DateFormat="dd/MM/yyyy" />
                        </FilterTemplate>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn Property="@nameof(Acuerdo.Vigente)" Title="Vigente" TextAlign=TextAlign.Center Filterable="false" Width="70px" Groupable="false">
                        <Template>
                            <RadzenCheckBox Value="context.Vigente" ReadOnly=true Style="cursor:default" />
                        </Template>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn Frozen="true" FrozenPosition="FrozenColumnPosition.Right" Visible=@permiteAprobacion
                                          Filterable="false" Sortable="false" Groupable="false" Resizable="false" TextAlign="TextAlign.Center" Width="35px">
                        <Template Context="acuerdo">
                            <RadzenButton Icon="done" ButtonStyle="ButtonStyle.Success" Variant="Variant.Flat" Size="ButtonSize.ExtraSmall" title="Aprobar"
                                          Click="@(() => AprobarAcuerdo(cliente, acuerdo))" @onclick:stopPropagation="true"
                                          Visible="@(acuerdo.IdEstado == AcuerdosEstadoEnum.PendienteAprobacion && acuerdo.Vigente)" />
                        </Template>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn Frozen="true" FrozenPosition="FrozenColumnPosition.Right" Visible=@permiteCancelar
                                          Filterable="false" Sortable="false" Groupable="false" Resizable="false" TextAlign="TextAlign.Center" Width="35px">
                        <Template Context="acuerdo">
                            <RadzenButton Icon="cancel" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Flat" Size="ButtonSize.ExtraSmall" title="Cancelar acuerdo"
                                          Visible="@(acuerdo.IdEstado == AcuerdosEstadoEnum.Activo)"
                                          Click="@(() => CancelarAcuerdo(cliente, acuerdo))" @onclick:stopPropagation="true" />
                        </Template>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn Frozen="true" FrozenPosition="FrozenColumnPosition.Right" Visible=@permiteMontos
                                          Filterable="false" Sortable="false" Groupable="false" Resizable="false" TextAlign="TextAlign.Center" Width="35px">
                        <Template Context="acuerdo">
                            <RadzenButton Icon="info" ButtonStyle="ButtonStyle.Info" Variant="Variant.Flat" Size="ButtonSize.ExtraSmall" title="Total ingresado"
                                          Click="@(() => InfoAcuerdo(cliente, acuerdo))" @onclick:stopPropagation="true" />
                        </Template>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn Frozen="true" FrozenPosition="FrozenColumnPosition.Right" Visible=@permiteEdicion
                                          Filterable="false" Sortable="false" Groupable="false" Resizable="false" TextAlign="TextAlign.Center" Width="35px">
                        <Template Context="acuerdo">
                            <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Warning" Variant="Variant.Flat" Size="ButtonSize.ExtraSmall" title="Editar acuerdo"
                                          Click="@(() => EditarAcuerdo(cliente, acuerdo))" @onclick:stopPropagation="true" />
                        </Template>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn Frozen="true" FrozenPosition="FrozenColumnPosition.Right" Visible=@permiteEliminar
                                          Filterable="false" Sortable="false" Groupable="false" Resizable="false" TextAlign="TextAlign.Center" Width="35px">
                        <Template Context="acuerdo">
                            <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Flat" Size="ButtonSize.ExtraSmall" title="Eliminar acuerdo"
                                          Click="@(() => DeleteAcuerdo(cliente, acuerdo))" @onclick:stopPropagation="true" />
                        </Template>
                    </RadzenDataGridColumn>
                </Columns>
            </RadzenDataGrid>
        </Template>
    </RadzenDataGrid>
}
else
{
    <Loader />
}

@code {
    bool showPage;
    AcuerdosRequest request = new()
    {
        FechaDesde = DateTime.Now.AddMonths(-1),
        FechaHasta = DateTime.Now.EndOfDay(),
        IdEstado = AcuerdosEstadoEnum.Activo
    };

    RadzenDataGrid<AcuerdoCliente> grid;
    List<AcuerdoCliente> acuerdosClientes = [];
    int render = 0;
    List<string> lineas = [];
    List<Estado<AcuerdosEstadoEnum?>> estados = [];

    bool permiteAlta, permiteEdicion, permiteAprobacion, permiteMontos, permiteEliminar, permiteCancelar;
    DateTime? desdeFilter, hastaFilter;

    protected override async Task OnInitializedAsync()
    {
        await SeguridadService.ValidatePageAccess();
        var permisos = await SeguridadService.GetPermisos(Permisos.Menu.Acuerdos);
        permiteAlta = permisos.Contains(Permisos.Alta);
        permiteEdicion = permisos.Contains(Permisos.Edicion);
        permiteAprobacion = permisos.Contains(Permisos.Aprobacion);
        permiteMontos = permisos.Contains(Permisos.Montos);
        permiteEliminar = permisos.Contains(Permisos.Eliminar);
        permiteCancelar = permisos.Contains(Permisos.Cancelar);

        estados = await ToolsService.GetEstados<AcuerdosEstadoEnum?>(new() { Seccion = "Acuerdos", ShowNull = true });
        lineas = await ProductosService.GetLineas();

        if (ParametrosDeConsulta.Page == ParametrosDeConsulta.Pages.Acuerdos && ParametrosDeConsulta.Parametros.Any())
        {
            if (ParametrosDeConsulta.Parametros.ContainsKey("request"))
                request = (AcuerdosRequest)ParametrosDeConsulta.Parametros["request"];
        }
        else
            ParametrosDeConsulta.Clear();

        showPage = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        render++;

        if (render == 2)
        {
            await FillAcuerdos();
            StateHasChanged();
            await grid.Reload();
        }
    }

    private List<Acuerdo> AplicarFiltros(List<Acuerdo> acuerdos)
    {
        var aux = acuerdos.AsQueryable();

        if (desdeFilter != null) aux = aux.FilterDate(x => x.FechaDesde, desdeFilter);
        if (hastaFilter != null) aux = aux.FilterDate(x => x.FechaHasta, hastaFilter);

        return aux.ToList();
    }

    private async Task FillAcuerdos()
    {
        RadzenDialogService.OpenBusyWithLoader("Buscando...");
        acuerdosClientes.Clear();
        var response = await AcuerdosService.GetAcuerdos(request);
        RadzenDialogService.CloseDialog();
        if (response.IsOk)
        {
            ParametrosDeConsulta.Save(ParametrosDeConsulta.Pages.Acuerdos, new() { { "request", request } });
            var aux = (List<AcuerdoCliente>)response.Data;
            if (aux.Count > 0)
                acuerdosClientes = aux;
            else
                RadzenDialogService.NotifyEmptyResponse();
        }
        else if (response.IsBadRequest && response.Errors?.Count > 0)
            await RadzenDialogService.ShowAlertAsync(response.Errors, MensajesHelper.Title);
        else
            RadzenDialogService.NotifyInternalServerError();
    }

    private async Task DeleteAcuerdo(AcuerdoCliente acuerdoCliente, Acuerdo acuerdo)
    {
        RadzenDialogService.OpenBusyWithLoader("Cargando...");
        var aux = await AcuerdosService.GetAcuerdosMontos(new() { IdAcuerdo = acuerdo.IdAcuerdo });
        RadzenDialogService.CloseDialog();
        if (aux.IsOk)
        {
            if (((List<AcuerdoMonto>)aux.Data).Count != 0)
            {
                await RadzenDialogService.Alert("El acuerdo no se puede eliminar porque ya tiene montos cargados", MensajesHelper.Title, RadzenHelper.Alert());
                return;
            }
            else if (await RadzenDialogService.ConfirmOperation())
            {
                RadzenDialogService.OpenBusyWithLoader("Eliminando...");
                var response = await AcuerdosService.DeleteAcuerdos(acuerdo);
                RadzenDialogService.CloseDialog();
                if (response.IsOk)
                {
                    RadzenDialogService.NotifySuccess("El acuerdo", "se eliminado");
                    acuerdoCliente.Acuerdos.Remove(acuerdo);
                    await grid.Reload();
                }
                else
                    RadzenDialogService.NotifyInternalServerError();
            }
        }
        else
            RadzenDialogService.NotifyInternalServerError();
    }

    private async Task AprobarAcuerdo(AcuerdoCliente acuerdoCliente, Acuerdo acuerdo) =>
        await CambiarEstadoAcuerdo(acuerdoCliente, acuerdo, AcuerdosEstadoEnum.Activo, "aprobar", "Aprobando...");

    private async Task CancelarAcuerdo(AcuerdoCliente acuerdoCliente, Acuerdo acuerdo) =>
        await CambiarEstadoAcuerdo(acuerdoCliente, acuerdo, AcuerdosEstadoEnum.Cancelado, "cancelar", "Cancelando...");

    private async Task CambiarEstadoAcuerdo(AcuerdoCliente acuerdoCliente, Acuerdo acuerdo, AcuerdosEstadoEnum nuevoEstado, string operacion, string loadingText)
    {
        if (await RadzenDialogService.ConfirmOperation(operacion, "el acuerdo"))
        {
            RadzenDialogService.OpenBusyWithLoader(loadingText);

            var response = await AcuerdosService.CambiarEstadoAcuerdo(acuerdo, nuevoEstado);

            RadzenDialogService.CloseDialog();

            if (response.IsOk)
            {
                var index = acuerdoCliente.Acuerdos.FindIndex(x => x.IdAcuerdo == acuerdo.IdAcuerdo);

                if (index >= 0)
                    acuerdoCliente.Acuerdos[index] = (Acuerdo)response.Data;

                await grid.Reload();
            }
            else if (response.Errors?.Count > 0)
                RadzenDialogService.ShowAlert(response.Errors, MensajesHelper.Title);
            else if (!string.IsNullOrWhiteSpace(response.Message))
                RadzenDialogService.ShowAlert(response.Message, MensajesHelper.Title);
            else
                RadzenDialogService.NotifyInternalServerError();
        }
    }

    private async Task InfoAcuerdo(AcuerdoCliente acuerdoCliente, Acuerdo acuerdo) =>
        await RadzenDialogService.OpenAsync<AcuerdosMontosIndex>($"Acuerdo {acuerdo.IdAcuerdo}", new() { { "AcuerdoCliente", acuerdoCliente }, { "Acuerdo", acuerdo } },
                                                                new() { Width = "90vw", Height = "90vh" });

    private async Task AgregarAcuerdo() =>
        await AbrirModal(new(), new(), TipoOperacionEnum.Alta);

    private async Task EditarAcuerdo(AcuerdoCliente acuerdoCliente, Acuerdo acuerdo)
    {
        RadzenDialogService.OpenBusyWithLoader("Cargando...");
        var aux = await AcuerdosService.GetAcuerdosMontos(new() { IdAcuerdo = acuerdo.IdAcuerdo });
        RadzenDialogService.CloseDialog();

        if (aux.IsOk)
        {
            if (((List<AcuerdoMonto>)aux.Data).Count != 0)
                await RadzenDialogService.Alert("El acuerdo no se puede editar porque ya tiene montos cargados", MensajesHelper.Title, RadzenHelper.Alert());
            else
                await AbrirModal((AcuerdoCliente)acuerdoCliente.Clone(), (Acuerdo)acuerdo.Clone(), TipoOperacionEnum.Edicion);
        }
        else
            RadzenDialogService.NotifyInternalServerError();

    }

    private async Task AbrirModal(AcuerdoCliente acuerdoCliente, Acuerdo acuerdo, TipoOperacionEnum operacion)
    {
        await RadzenDialogService.OpenAsync<AcuerdosForm>(operacion == TipoOperacionEnum.Edicion ? $"Acuerdo {acuerdo.IdAcuerdo}" : "Nuevo acuerdo",
                                                        new() { { "AcuerdoCliente", acuerdoCliente}, { "Acuerdo", acuerdo }, { "TipoOperacion", operacion },
                                                        { "OnSave", EventCallback.Factory.Create<AcuerdoCliente>(this, OnSave) } }, new() { Height = "25rem", Width = "50rem" });
    }

    private async Task OnSave(AcuerdoCliente acuerdoCliente)
    {
        RadzenDialogService.CloseDialog();
        var cliente = acuerdosClientes.FirstOrDefault(x => x.IdCliente == acuerdoCliente.IdCliente);
        if (cliente == null)
        {
            acuerdosClientes.Add(acuerdoCliente);
        }
        else
        {

            cliente.Acuerdos.RemoveAll(x => x.IdAcuerdo == acuerdoCliente.Acuerdos[0].IdAcuerdo);
            cliente.Acuerdos.Add(acuerdoCliente.Acuerdos[0]);
        }
        await grid.Reload();
    }

    void CellRender(RowRenderEventArgs<Acuerdo> args)
    {
        if (args.Data.IdEstado == AcuerdosEstadoEnum.Activo)
            args.Attributes.Add("style", $"background-color: var(--rz-success-lighter);");
    }

    private async Task OnKeyDown(string key)
    {
        if (key == KeyboardKeys.Enter)
            await FillAcuerdos();
    }
}
