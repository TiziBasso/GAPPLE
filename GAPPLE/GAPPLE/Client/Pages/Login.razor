@page "/"
@layout LoginLayout

@inject HttpClient httpClient
@using GAPPLE.Client.Extensiones
@using GAPPLE.Shared
@using Microsoft.AspNetCore.Components.Authorization
@inject AuthenticationStateProvider autenticacionProvider
@inject NavigationManager navManager

<div class="login-container">
    <div class="welcome-section">
        <h1>Bienvenido a Zentra</h1>
        <ul class="items-list">
            <li>Realiza pedidos de manera rápida y sin complicaciones.</li>
            <li>Estamos listos para ayudarte.</li>
            <li>Inicia sesión y descubre Zentra.</li>
        </ul>
    </div>

    <div class="login-section">
        <img src="./Assets/Logo_Ital.png" alt="Logo Italcosmetica" class="logo" />
        <h2>Iniciar Sesión</h2>
        <p>Ingrese sus credenciales para acceder a Zentra</p>
        @if (!string.IsNullOrEmpty(ErrorMessage))
        {
            <p class="error-message">@ErrorMessage</p>
        }
        <EditForm Model="@login" OnValidSubmit="IniciarSesion">
            <DataAnnotationsValidator />
            <div class="form-group">
                <label for="email">Usuario: </label>
                <InputText id="email" class="form-control" @bind-Value="login.Correo" placeholder="nombre usuario" />
                <ValidationMessage For="@(() => login.Correo)" />
            </div>
            <div class="form-group">
                <label for="password">Contraseña:</label>
                <InputText id="password" type="password" class="form-control" @bind-Value="login.Clave" />
                <ValidationMessage For="@(() => login.Clave)" />
            </div>
            <div style="display:flex;justify-content:center;">
            <button type="submit" class="btn btn-primary">Ingresar</button>
            </div>
        </EditForm>
    </div>
</div>

@code {
    private LoginDTO login = new LoginDTO();
    string? ErrorMessage = null;

    private async Task IniciarSesion()
    {
        ErrorMessage = null;
        var loginResponse = await httpClient.PostAsJsonAsync<LoginDTO>("/api/seguridad/Login", login);
        if (loginResponse.IsSuccessStatusCode)
        {
            var sesionUsuario = await loginResponse.Content.ReadFromJsonAsync<SesionDTO>();
            var autenticacionExt = (AutenticacionExtension)autenticacionProvider;
            await autenticacionExt.ActualizarEstadoAutenticacion(sesionUsuario);

            navManager.NavigateTo("/home");
        }
        else
        {
            ErrorMessage = "Las credenciales no son correctas";
        }
    }
}

