@page "/home"

@using Microsoft.AspNetCore.Authorization;
@using Microsoft.AspNetCore.Components.Authorization;
@attribute [Authorize]

@inject OrdenesService OrdenesService

<PageTitle>Index</PageTitle>

<RadzenRow Style="--rz-text-h2-line-height: 1; --rz-text-h2-font-weight: 200;">
    <RadzenColumn Size="12" SizeMD="12" SizeXL="2">
        <RadzenRow>
            <RadzenColumn Size="12" SizeMD="4" SizeXL="12">
                <RadzenCard Variant="Variant.Outlined" Style="height: 100%;">
                    <RadzenStack JustifyContent="JustifyContent.SpaceBetween" Style="height: 100%;">
                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Start" JustifyContent="JustifyContent.SpaceBetween">
                            <RadzenText TextStyle="TextStyle.H6">Progreso</RadzenText>
                            <RadzenText TextStyle="TextStyle.H2" class="rz-color-info rz-m-0">@($"{Math.Round(closeRatioPercentage)}%")</RadzenText>
                        </RadzenStack>
                        <RadzenProgressBar ProgressBarStyle="ProgressBarStyle.Info" @bind-Value=@closeRatioPercentage ShowValue="false" Style="--rz-progressbar-background-color: var(--rz-info-lighter); --rz-progressbar-height: 1rem;" />
                    </RadzenStack>
                </RadzenCard>
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="4" SizeXL="12">
                <RadzenCard Variant="Variant.Outlined" Style="height: 100%;">
                    <RadzenStack Gap="0">
                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Start" JustifyContent="JustifyContent.SpaceBetween">
                            <RadzenText TextStyle="TextStyle.H6">Ordenes abiertas</RadzenText>
                            <RadzenText TextStyle="TextStyle.H2" class="rz-color-danger rz-m-0">@openIssues?.Count()</RadzenText>
                        </RadzenStack>
                        <RadzenSparkline Style="width: 100%; height: 80px;">
                            <RadzenColumnSeries Data=@openIssuesByDate ValueProperty="Count" CategoryProperty="Week" Title="ordenes" Fill="var(--rz-danger)" />
                            <RadzenColumnOptions Margin="0" />
                            <RadzenCategoryAxis Padding="20" Visible="false" />
                        </RadzenSparkline>
                    </RadzenStack>
                </RadzenCard>
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="4" SizeXL="12">
                <RadzenCard Variant="Variant.Outlined" Style="height: 100%;">
                    <RadzenStack Gap="0">
                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Start" JustifyContent="JustifyContent.SpaceBetween">
                            <RadzenText TextStyle="TextStyle.H6">Ordenes cerradas</RadzenText>
                            <RadzenText TextStyle="TextStyle.H2" class="rz-color-success rz-m-0">@closedIssues?.Count()</RadzenText>
                        </RadzenStack>
                        <RadzenSparkline Style="width: 100%; height: 80px;">
                            <RadzenColumnSeries Data=@closedIssuesByDate ValueProperty="Count" CategoryProperty="Week" Title="ordenes" Fill="var(--rz-success)" />
                            <RadzenColumnOptions Margin="0" Width="30" />
                            <RadzenCategoryAxis Padding="20" Visible="false" />
                        </RadzenSparkline>
                    </RadzenStack>
                </RadzenCard>
            </RadzenColumn>
        </RadzenRow>
    </RadzenColumn>
</RadzenRow>

<style>
    .rz-tabview-panel {
        height: 100%;
    }

    .rz-default,
    .rz-dark,
    .rz-standard,
    .rz-standard-dark,
    .rz-software,
    .rz-software-dark,
    .rz-humanistic,
    .rz-humanistic-dark {
        .rz-card:has(.rz-tabview)
    {
        --rz-card-border: none;
    }

    }
</style>

@code {
    IEnumerable<OrdenDashboard> issues;
    IEnumerable<OrdenDashboard> openIssues;
    IEnumerable<OrdenDashboard> closedIssues;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            fetchingData = true;
            try
            {
                issues = await OrdenesService.GetOrdenDashboard();
                openIssues = issues.Where(x => x.AltaRegistro != null);
                closedIssues = issues.Where(x => x.FechaAprobacion != null);

                closeRatio = closedIssues.Count() / (double)issues.Count();
                closeRatioPercentage = closeRatio * 100;

                openIssuesByDate = openIssues.GroupBy(issue => issue.AltaRegistro.Value)
                        .Select(group => new IssueGroup
                            {
                                Week = group.Key,
                                Count = group.Count()
                            });

                closedIssuesByDate = closedIssues.GroupBy(issue => issue.FechaAprobacion.Value)
                        .Select(group => new IssueGroup
                            {
                                Week = group.Key,
                                Count = group.Count()
                            });

                error = null;
                fetchingData = false;
            }
            catch (Exception ex)
            {
                error = ex.Message;
            }

            StateHasChanged();
        }
    }

    IEnumerable<IssueGroup> openIssuesByDate;
    IEnumerable<IssueGroup> closedIssuesByDate;
    double closeRatio = 0;
    double closeRatioPercentage = 0;
    int currentPage = 0;
    int totalPages = 0;
    bool fetchingData = false;
    string error = null;



}