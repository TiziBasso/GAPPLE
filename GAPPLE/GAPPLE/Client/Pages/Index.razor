@page "/home"

@using Microsoft.AspNetCore.Authorization;
@using Microsoft.AspNetCore.Components.Authorization;
@using GAPPLE.Client.Extensiones
@attribute [Authorize]

@inject AuthenticationStateProvider autenticacionProvider
@inject OrdenesService OrdenesService
@inject SeguridadService SeguridadService

<PageTitle>Index</PageTitle>

@if (showHome)
{
    <RadzenRow Style="--rz-text-h2-line-height: 1; --rz-text-h2-font-weight: 200;">
        <RadzenColumn Size="12" SizeMD="12" SizeXL="2">
            <RadzenRow>
                <RadzenColumn Size="12" SizeMD="4" SizeXL="12">
                    <RadzenCard Variant="Variant.Outlined" Style="height: 100%;">
                        <RadzenStack JustifyContent="JustifyContent.SpaceBetween" Style="height: 100%;">
                            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Start" JustifyContent="JustifyContent.SpaceBetween">
                                <RadzenText TextStyle="TextStyle.H6">Progreso</RadzenText>
                                <RadzenText TextStyle="TextStyle.H2" class="rz-color-info rz-m-0">@($"{Math.Round(closeRatioPercentage)}%")</RadzenText>
                            </RadzenStack>
                            <RadzenProgressBar ProgressBarStyle="ProgressBarStyle.Info" @bind-Value=@closeRatioPercentage ShowValue="false" Style="--rz-progressbar-background-color: var(--rz-info-lighter); --rz-progressbar-height: 1rem;" />
                        </RadzenStack>
                    </RadzenCard>
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="4" SizeXL="12">
                    <RadzenCard Variant="Variant.Outlined" Style="height: 100%;">
                        <RadzenStack Gap="0">
                            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Start" JustifyContent="JustifyContent.SpaceBetween">
                                <RadzenText TextStyle="TextStyle.H6">Ordenes abiertas</RadzenText>
                                <RadzenText TextStyle="TextStyle.H2" class="rz-color-danger rz-m-0">@openIssues?.Count()</RadzenText>
                            </RadzenStack>
                            <RadzenSparkline Style="width: 100%; height: 80px;">
                                <RadzenColumnSeries Data=@openIssuesByDate ValueProperty="Count" CategoryProperty="Week" Title="ordenes" Fill="var(--rz-danger)" />
                                <RadzenColumnOptions Margin="0" />
                                <RadzenCategoryAxis Padding="20" Visible="false" />
                            </RadzenSparkline>
                        </RadzenStack>
                    </RadzenCard>
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="4" SizeXL="12">
                    <RadzenCard Variant="Variant.Outlined" Style="height: 100%;">
                        <RadzenStack Gap="0">
                            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Start" JustifyContent="JustifyContent.SpaceBetween">
                                <RadzenText TextStyle="TextStyle.H6">Ordenes cerradas</RadzenText>
                                <RadzenText TextStyle="TextStyle.H2" class="rz-color-success rz-m-0">@closedIssues?.Count()</RadzenText>
                            </RadzenStack>
                            <RadzenSparkline Style="width: 100%; height: 80px;">
                                <RadzenColumnSeries Data=@closedIssuesByDate ValueProperty="Count" CategoryProperty="Week" Title="ordenes" Fill="var(--rz-success)" />
                                <RadzenColumnOptions Margin="0" Width="30" />
                                <RadzenCategoryAxis Padding="20" Visible="false" />
                            </RadzenSparkline>
                        </RadzenStack>
                    </RadzenCard>
                </RadzenColumn>

                <RadzenColumn Size="12" SizeMD="4" SizeXL="12">
                    <RadzenCard Style="width:290px;height:fit-content">
                        <div style="display:flex; align-items:center; justify-content:center; overflow:visible;text-align:center">
                            <strong>Cantidad de productos aprobados del mes</strong>
                        </div>
                        <hr />
                        <div style="width:100%;display:flex; align-items:center; justify-content:center">
                            <h5 class="DashBoardH5">@cantidadesProductos.CantidadAprobada</h5>
                        </div>
                    </RadzenCard>
                </RadzenColumn>

                <RadzenColumn Size="12" SizeMD="4" SizeXL="12">
                    <RadzenCard Style="width:290px;height:fit-content">
                        <div style="display:flex; align-items:center; justify-content:center; overflow:visible;text-align:center">
                            <strong>Cantidad de productos pendientes del mes</strong>
                        </div>
                        <hr />
                        <div style="width:100%;display:flex; align-items:center; justify-content:center">
                            <h5 class="DashBoardH5">@cantidadesProductos.CantidadPendiente</h5>
                        </div>
                    </RadzenCard>
                </RadzenColumn>

            </RadzenRow>
        </RadzenColumn>
    </RadzenRow>
}

<style>
    .rz-tabview-panel {
        height: 100%;
    }

    .rz-default,
    .rz-dark,
    .rz-standard,
    .rz-standard-dark,
    .rz-software,
    .rz-software-dark,
    .rz-humanistic,
    .rz-humanistic-dark {
        .rz-card:has(.rz-tabview)

    {
        --rz-card-border: none;
    }

    }
</style>

@code {
    IEnumerable<OrdenDashboard> issues;
    IEnumerable<OrdenDashboard> openIssues;
    IEnumerable<OrdenDashboard> closedIssues;

    CantidadesProductosDashboard cantidadesProductos = new();

    bool showHome;
    int idUsuario;

    protected override async Task OnInitializedAsync()
    {
        var autenticacionExt = (AutenticacionExtension)autenticacionProvider;
        var auth = await autenticacionExt.GetAuthenticationStateAsync();
        idUsuario = int.Parse(auth.User.FindFirst("IdUsuario")?.Value);
        var data = await SeguridadService.GetMenu(idUsuario);
        menuRecursivo(data);
    }

    void menuRecursivo(List<MenuNew> data)
    {
        foreach (var item in data)
        {
            if (item.Id == 2)
                showHome = true;

            if (item.Items != null && item.Items.Count > 0)
                menuRecursivo(item.Items);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            fetchingData = true;
            try
            {
                cantidadesProductos = await OrdenesService.GetCantidadesDeProductos(idUsuario);
                issues = await OrdenesService.GetOrdenDashboard(idUsuario);
                openIssues = issues.Where(x => x.AltaRegistro != null);
                closedIssues = issues.Where(x => x.FechaAprobacion != null);

                closeRatio = closedIssues.Count() / (double)issues.Count();
                closeRatioPercentage = closeRatio * 100;

                openIssuesByDate = openIssues.GroupBy(issue => issue.AltaRegistro.Value)
                        .Select(group => new IssueGroup
                            {
                                Week = group.Key,
                                Count = group.Count()
                            });

                closedIssuesByDate = closedIssues.GroupBy(issue => issue.FechaAprobacion.Value)
                        .Select(group => new IssueGroup
                            {
                                Week = group.Key,
                                Count = group.Count()
                            });

                error = null;
                fetchingData = false;
            }
            catch (Exception ex)
            {
                error = ex.Message;
            }

            StateHasChanged();
        }
    }

    IEnumerable<IssueGroup> openIssuesByDate;
    IEnumerable<IssueGroup> closedIssuesByDate;
    double closeRatio = 0;
    double closeRatioPercentage = 0;
    int currentPage = 0;
    int totalPages = 0;
    bool fetchingData = false;
    string error = null;



}