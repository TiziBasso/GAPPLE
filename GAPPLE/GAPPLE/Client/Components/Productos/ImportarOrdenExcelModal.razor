@* Importa el orden de impresión (Orden / Orden depósito) de los productos desde un Excel.
   El formato es el mismo que descarga el botón "Exportar orden" del maestro de productos. *@

@inject ProductosService ProductosService
@inject NotificationService NotificationService
@inject DialogService DialogService
@inject RadzenDialogService RadzenDialogService
@inject FileService FileService

<CustomFileInput @bind-FileValue=file />

<hr />

<RadzenText TextStyle="TextStyle.DisplayH6" TextAlign="TextAlign.Center" Style="display:flex; align-items:center; justify-content:center;">
    Formato de carga del excel
    <RadzenButton Size=ButtonSize.ExtraSmall ButtonStyle=ButtonStyle.Info Icon="download" Click="DownloadTemplate" Style="margin-left:5px;"
                  title="Descargar plantilla vacía" />
</RadzenText>
<RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.Center">
    <div style="outline:none" class="rz-data-grid rz-datatable rz-datatable-scrollable rz-density-compact">
        <div class="rz-data-grid-data">
            <table class="rz-grid-table rz-grid-table-fixed rz-grid-table-striped">
                <thead>
                    <tr>
                        <th style="width:30px;"><span class="rz-column-title headerCustom" style="display:block; height:19px;">@string.Empty</span></th>
                        <th style="width:80px"><span class="rz-column-title headerCustom">A</span></th>
                        <th style="width:60px"><span class="rz-column-title headerCustom">B</span></th>
                        <th style="width:80px"><span class="rz-column-title headerCustom">C</span></th>
                    </tr>
                    <tr>
                        <th><span class="rz-column-title headerCustom" style="padding:0; height:35px;">1</span></th>
                        <th><span class="rz-column-title">Código</span></th>
                        <th><span class="rz-column-title">Orden</span></th>
                        <th><span class="rz-column-title">Orden <br />depósito</span></th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td style="background-color:var(--rz-grid-header-background-color)"><span style="display:flex; justify-content:center;">2</span></td>
                        <td>656091</td>
                        <td>1</td>
                        <td>10</td>
                    </tr>
                    <tr>
                        <td style="background-color:var(--rz-grid-header-background-color)"><span style="display:flex; justify-content:center;">3</span></td>
                        <td>8023</td>
                        <td>2</td>
                        <td></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</RadzenStack>

<RadzenText TextStyle="TextStyle.Caption" TextAlign="TextAlign.Center" class="rz-mt-2" Style="display:block">
    Las columnas se identifican por el encabezado (se ignoran las demás, p. ej. Descripción o Línea).<br />
    Orden vacío: se mantiene el actual. Orden depósito vacío: se borra.<br />
    Si alguna fila tiene errores no se guarda ningún cambio.
</RadzenText>

<RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.Center" Gap="2rem" class="rz-mt-4">
    <RadzenButton ButtonStyle="ButtonStyle.Danger" Icon="cancel" Text="Cancelar" Click="Cancelar" Disabled=isLoading />
    <RadzenButton ButtonStyle="ButtonStyle.Success" Icon="file_upload" Text="Procesar" Click="Procesar" IsBusy=isLoading />
</RadzenStack>

@code {
    IBrowserFile file;
    bool isLoading;

    private async Task Procesar()
    {
        if (file == null)
        {
            NotificationService.Notify(NotificationSeverity.Info, "Debe ingresar un archivo");
            return;
        }

        isLoading = true;
        RadzenDialogService.OpenBusyWithLoader("Procesando archivo...");

        using var stream = file.OpenReadStream(maxAllowedSize: file.Size + 1024);
        using var ms = new MemoryStream();
        await stream.CopyToAsync(ms);

        var response = await ProductosService.ImportarOrdenExcel(new ByteArrayRequest { File = ms.ToArray() });
        RadzenDialogService.CloseDialog();
        isLoading = false;

        if (response.IsOk)
            DialogService.Close((int)response.Data);
        else if (response.Errors != null && response.Errors.Count > 0)
            RadzenDialogService.ShowAlert(response.Errors);
        else
            RadzenDialogService.NotifyInternalServerError();
    }

    private async Task DownloadTemplate()
    {
        RadzenDialogService.OpenBusy("Descargando...");
        await FileService.DownloadTemplate(["Código", "Orden", "Orden depósito"], "OrdenImpresion");
        RadzenDialogService.CloseDialog();
    }

    private void Cancelar() => DialogService.Close(null);
}
