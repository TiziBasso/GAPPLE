<div class="picklist-container">
    <RadzenStack Gap="5" Orientation="Orientation.Vertical" Style="width:45%">
        <input class="rz-textbox" placeholder="Buscar..." @bind-value="filtroIzquierda" @bind-value:event="oninput" />
        <div class="list-box">
            <h5>Listado de Productos</h5>
            <ul class="Lista-ul">
                @foreach (var grupo in FiltrarListaIzquierda(filtroIzquierda))
                {
                    <li class="li-familia">
                        <label @onclick="@(e => MoverFamiliaCompleta(grupo.Key))">
                            <span class="familia-titulo">@grupo.Key</span>
                        </label>
                        <ul class="lista-ul-producto">
                            @foreach (var producto in grupo)
                            {
                                <li class="li-producto" @onclick="@(e => MoverProductoDerecha(producto.CodigoProducto))">
                                    <label>
                                        <span >@producto.Descripcion</span>
                                    </label>
                                </li>
                            }
                        </ul>
                    </li>
                }
                @if (!FiltrarListaIzquierda(filtroIzquierda).Any())
                {
                    <span>No hay datos para mostrar</span>
                }
            </ul>
        </div>
    </RadzenStack>

    <RadzenStack>
        <RadzenIcon Icon="sync_alt" />
    </RadzenStack>

    <RadzenStack Gap="5" Orientation="Orientation.Vertical" Style="width:45%">
        <input class="rz-textbox" placeholder="Buscar..." @bind-value="filtroDerecha" @bind-value:event="oninput" />
        <div class="list-box">
            <h5>Productos de la Oferta</h5>
            <ul class="Lista-ul">
                @foreach (var grupo in FiltrarListaDerecha(filtroDerecha))
                {
                    <li class="li-familia">
                        <label @onclick="@(e => MoverFamiliaCompletaIzquierda(grupo.Key))">
                            <span class="familia-titulo">@grupo.Key</span>
                        </label>
                        <ul class="lista-ul-producto">
                            @foreach (var producto in grupo)
                            {
                                <li class="li-producto" @onclick="@(e => MoverProductoIzquierda(producto.CodigoProducto))">
                                    <label>
                                        <span>@producto.Descripcion</span>
                                    </label>
                                </li>
                            }
                        </ul>
                    </li>
                }
                @if (!FiltrarListaDerecha(filtroDerecha).Any())
                {
                    <span>No hay datos para mostrar</span>
                }
            </ul>
        </div>
    </RadzenStack>
</div>

@code {
    [Parameter] public List<ProductoParaOfertas> ProductosIzquierda { get; set; }
    [Parameter] public List<ProductoParaOfertas> ProductosDerecha { get; set; }

    string? filtroIzquierda, filtroDerecha;

    private void MoverFamiliaCompleta(string familia)
    {
        var productosAMover = ProductosIzquierda.Where(p => p.Familia == familia).ToList();
        foreach (var producto in productosAMover)
        {
            ProductosDerecha.Add(producto);
            ProductosIzquierda.Remove(producto);
        }
    }
    private void MoverProductoDerecha(string codigoProducto)
    {
        ProductosDerecha.Add(ProductosIzquierda.Find(x => x.CodigoProducto == codigoProducto)!);
        ProductosIzquierda.Remove(ProductosIzquierda.Find(x => x.CodigoProducto == codigoProducto)!);
    }

    private void MoverFamiliaCompletaIzquierda(string familia)
    {
        var productosAMover = ProductosDerecha.Where(p => p.Familia == familia).ToList();
        foreach (var producto in productosAMover)
        {
            ProductosIzquierda.Add(producto);
            ProductosDerecha.Remove(producto);
        }
    }

    private void MoverProductoIzquierda(string codigoProducto)
    {
        ProductosIzquierda.Add(ProductosDerecha.Find(x => x.CodigoProducto == codigoProducto)!);
        ProductosDerecha.Remove(ProductosDerecha.Find(x => x.CodigoProducto == codigoProducto)!);
    }

    private IEnumerable<IGrouping<string, ProductoParaOfertas>> FiltrarListaIzquierda(string filtro)
    {
        if (!string.IsNullOrEmpty(filtro))
            return ProductosIzquierda.Where(x => x.Descripcion.ToUpper().Contains(filtro!.ToUpper())).GroupBy(p => p.Familia).ToList();
        return ProductosIzquierda.GroupBy(p => p.Familia);
    }
    private IEnumerable<IGrouping<string, ProductoParaOfertas>> FiltrarListaDerecha(string filtro)
    {
        if (!string.IsNullOrEmpty(filtro))
            return ProductosDerecha.Where(x => x.Descripcion.ToUpper().Contains(filtro!.ToUpper())).GroupBy(p => p.Familia).ToList();
        return ProductosDerecha.GroupBy(p => p.Familia);
    }
}