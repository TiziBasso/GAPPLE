@using GAPPLE.Client.Components.Productos

@inject ReclamosService     ReclamosService
@inject ProductosService    ProductosService
@inject ClientesService     ClientesService
@inject RadzenDialogService RadzenDialogService
@inject DialogService       DialogService
@inject IJSFunction         JSFunction

@if (showPage)
{
    <RadzenTemplateForm EditContext="editContext" Data="reclamo" TItem="Reclamo" Submit="Guardar"
    Style="display:grid; grid-template-rows:auto 1fr auto; height:100%; gap:8px;">
        <DataAnnotationsValidator />

        <RadzenFieldset Text="Datos del reclamo">
            <RadzenRow Gap="8px">

                <RadzenColumn Size=4>
                    <RadzenStack Orientation="Orientation.Vertical" Gap="2px">
                        <RadzenLabel Text="Cliente *" Component="fCliente" />
                        <RadzenDropDownDataGrid @bind-Value="reclamo.IdCliente"
                        Data="clientes"
                        Name="fCliente"
                        ValueProperty="@nameof(Cliente.IdCliente)"
                        TextProperty="@nameof(Cliente.RazonSocial)"
                        Change="OnClienteChange"
                        AllowFiltering=true
                        FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                        AllowFilteringByAllStringColumns=true
                        AllowVirtualization=true
                        Density="Density.Compact"
                        Style="width:100%">
                            <Columns>
                                <RadzenDropDownDataGridColumn Property="@nameof(Cliente.CodigoCliente)" Title="Código"      Width="80px" />
                                <RadzenDropDownDataGridColumn Property="@nameof(Cliente.RazonSocial)"   Title="Razón social" />
                            </Columns>
                        </RadzenDropDownDataGrid>
                        <ValidationMessage For="@(() => reclamo.IdCliente)" />
                    </RadzenStack>
                </RadzenColumn>

                <RadzenColumn Size=2>
                    <RadzenStack Orientation="Orientation.Vertical" Gap="2px">
                        <RadzenLabel Text="Tipo *" Component="fTipo" />
                        <RadzenDropDown TValue="ReclamoTipoEnum?"
                        @bind-Value="reclamo.Tipo"
                        Data="tiposOpciones"
                        Name="fTipo"
                        ValueProperty="@nameof(Estado<ReclamoTipoEnum?>.Id)"
                        TextProperty="@nameof(Estado<ReclamoTipoEnum?>.Descripcion)"
                        Placeholder="Seleccione..."
                        Style="width:100%" />
                        <ValidationMessage For="@(() => reclamo.Tipo)" />
                    </RadzenStack>
                </RadzenColumn>

                <RadzenColumn Size=3>
                    <RadzenStack Orientation="Orientation.Vertical" Gap="2px">
                        <RadzenLabel Text="Motivo *" Component="fMotivo" />
                        <RadzenDropDown TValue="ReclamoMotivoEnum?"
                        @bind-Value="reclamo.Motivo"
                        Data="motivosOpciones"
                        Name="fMotivo"
                        ValueProperty="@nameof(Estado<ReclamoMotivoEnum?>.Id)"
                        TextProperty="@nameof(Estado<ReclamoMotivoEnum?>.Descripcion)"
                        Placeholder="Seleccione..."
                        Style="width:100%" />
                        <ValidationMessage For="@(() => reclamo.Motivo)" />
                    </RadzenStack>
                </RadzenColumn>

                <RadzenColumn Size=3>
                    <RadzenStack Orientation="Orientation.Vertical" Gap="2px">
                        <RadzenLabel Text="Cód. Pedido" Component="fCodPedido" />
                        <RadzenTextBox @bind-Value="reclamo.CodPedido" Name="fCodPedido"
                        Placeholder="PED-000000" Style="width:100%" MaxLength="50" />
                    </RadzenStack>
                </RadzenColumn>

            </RadzenRow>
        </RadzenFieldset>

        <RadzenFieldset Text="Productos afectados (SKUs)" Style="overflow-y:auto;">

            <RadzenStack Orientation="Orientation.Horizontal" Gap="6px" class="rz-mb-2">
                <RadzenButton Icon="add" Text="Agregar SKU"
                Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Secondary"
                Click="AgregarSku" Disabled="isLoading" />
                <RadzenButton Icon="search" Text="Buscar producto"
                Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Primary"
                Click="HandleBuscarSKU" Disabled="isLoading" />
            </RadzenStack>

            @if (reclamo.Detalle.Count == 0)
            {
                <RadzenText Text="No hay productos agregados. Haga clic en 'Agregar SKU' o en 'Buscar producto'."
                TextStyle="TextStyle.Caption"
                style="color:var(--rz-text-secondary-color); font-style:italic;" />
            }
            else
            {
                <RadzenDataGrid @ref="skuGrid"
                Data="reclamo.Detalle"
                Density="Density.Compact"
                AllowSorting=false AllowFiltering=false ShowEmptyMessage=false
                IsLoading="isLoading">
                    <Columns>

                        <RadzenDataGridColumn Title="Cód. Producto / SKU *" Width="180px">
                            <Template Context="d">
                                <RadzenStack Orientation="Orientation.Horizontal" Gap="2px" AlignItems="AlignItems.Center">
                                    <input id="@($"sku{d.NumeroLinea}")"
                                    type="text"
                                    value="@d.SKU"
                                    @oninput="@(e => d.SKU = e.Value?.ToString())"
                                    @onkeydown="@(e => HandleSkuKeyDown(e, d))"
                                    @onfocusout="@(() => HandleSkuFocusOut(d))"
                                    readonly="@isLoading"
                                    placeholder="Código producto..."
                                    class="rz-textbox table-input-padding"
                                    style="width:100%; height:25px;" />
                                </RadzenStack>
                            </Template>
                        </RadzenDataGridColumn>

                        <RadzenDataGridColumn Title="Descripción del producto">
                            <Template Context="d">
                                <RadzenTextBox @bind-Value="d.DescripcionProducto"
                                Placeholder="Se completa automáticamente..."
                                Style="width:100%" MaxLength="500"
                                Disabled="isLoading" />
                            </Template>
                        </RadzenDataGridColumn>

                        <RadzenDataGridColumn Title="Cant." Width="80px">
                            <Template Context="d">
                                <input id="@($"cant{d.NumeroLinea}")"
                                type="number" min="1"
                                value="@d.Cantidad"
                                @onchange="@(e => d.Cantidad = int.TryParse(e.Value?.ToString(), out int v) ? v : 1)"
                                @onkeydown="@(e => HandleCantKeyDown(e, d))"
                                class="rz-textbox table-input-padding"
                                style="width:100%; height:25px; text-align:right;" />
                            </Template>
                        </RadzenDataGridColumn>

                        <RadzenDataGridColumn Title="Lote" Width="120px">
                            <Template Context="d">
                                <RadzenTextBox @bind-Value="d.Lote"
                                Placeholder="Lote"
                                Style="width:100%" MaxLength="100"
                                Disabled="isLoading" />
                            </Template>
                        </RadzenDataGridColumn>

                        <RadzenDataGridColumn Title="Vencimiento" Width="145px">
                            <Template Context="d">
                                <RadzenDatePicker @bind-Value="d.Vencimiento"
                                DateFormat="dd/MM/yyyy"
                                Style="width:100%"
                                Disabled="isLoading" />
                            </Template>
                        </RadzenDataGridColumn>

                        <RadzenDataGridColumn Title="" Width="45px" TextAlign="TextAlign.Center"
                        Resizable=false Sortable=false>
                            <Template Context="d">
                                <RadzenButton Size="ButtonSize.ExtraSmall" Icon="close"
                                ButtonStyle="ButtonStyle.Danger" Variant="Variant.Flat"
                                Click="@(() => QuitarSku(d))"
                                Disabled="isLoading"
                                title="Quitar fila" />
                            </Template>
                        </RadzenDataGridColumn>

                    </Columns>
                </RadzenDataGrid>
            }
        </RadzenFieldset>

        <RadzenFieldset Text="Descripción y resolución">
            <RadzenRow Gap="8px">
                <RadzenColumn Size=6>
                    <RadzenStack Orientation="Orientation.Vertical" Gap="2px">
                        <RadzenLabel Text="Descripción del problema" Component="fDescripcion" />
                        <RadzenTextArea @bind-Value="reclamo.Descripcion" Name="fDescripcion"
                        Rows=4 Style="width:100%; resize:vertical;"
                        Placeholder="Detalle el reclamo del cliente..." MaxLength="2000" />
                        <ValidationMessage For="@(() => reclamo.Descripcion)" />
                    </RadzenStack>
                </RadzenColumn>
                <RadzenColumn Size=6>
                    <RadzenStack Orientation="Orientation.Vertical" Gap="2px">
                        <RadzenLabel Text="Resolución / Acción realizada" Component="fResolucion" />
                        <RadzenTextArea @bind-Value="reclamo.Resolucion" Name="fResolucion"
                        Rows=4 Style="width:100%; resize:vertical;"
                        Placeholder="Indique la resolución tomada (ej: NC, devolución, etc)..." MaxLength="2000" />
                        <ValidationMessage For="@(() => reclamo.Resolucion)" />
                    </RadzenStack>
                </RadzenColumn>
            </RadzenRow>
        </RadzenFieldset>

        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceAround">
            <RadzenButton Icon="cancel" Text="Cancelar"       ButtonStyle="ButtonStyle.Danger"  Click="Cancelar" />
            <RadzenButton Icon="save"   Text="Guardar reclamo" ButtonStyle="ButtonStyle.Success"
            ButtonType="ButtonType.Submit" Disabled="isLoading" />
        </RadzenStack>

    </RadzenTemplateForm>
}
else
{
    <Loader />
}

@code {

    [Parameter] public EventCallback<Reclamo> AfterSave     { get; set; }
    [Parameter] public Reclamo                Reclamo       { get; set; }
    [Parameter] public TipoOperacionEnum      TipoOperacion { get; set; }

    Reclamo          reclamo;
    bool             showPage;
    bool             isLoading;
    List<Cliente>    clientes = [];
    EditContext       editContext;
    ValidationMessageStore messageStore;
    RadzenDataGrid<ReclamoDetalle> skuGrid;

    List<Estado<ReclamoTipoEnum?>> tiposOpciones = [];
    List<Estado<ReclamoMotivoEnum?>> motivosOpciones = [];

    protected override async Task OnInitializedAsync()
    {
        reclamo = (Reclamo)Reclamo.Clone();
        reclamo.Detalle = Reclamo.Detalle
            .Select((d, i) => { var c = (ReclamoDetalle)d.Clone(); c.NumeroLinea = i + 1; return c; })
            .ToList();

        tiposOpciones = [
            new Estado<ReclamoTipoEnum?>(ReclamoTipoEnum.Grave,    "Grave"),
            new Estado<ReclamoTipoEnum?>(ReclamoTipoEnum.Moderado, "Moderado"),
            new Estado<ReclamoTipoEnum?>(ReclamoTipoEnum.Leve,     "Leve")
        ];

        motivosOpciones = [
            new Estado<ReclamoMotivoEnum?>(ReclamoMotivoEnum.Vencidos,           "Vencidos"),
            new Estado<ReclamoMotivoEnum?>(ReclamoMotivoEnum.Faltantes,          "Faltantes"),
            new Estado<ReclamoMotivoEnum?>(ReclamoMotivoEnum.Calidad,            "Calidad / Roturas"),
            new Estado<ReclamoMotivoEnum?>(ReclamoMotivoEnum.ErroresFabricacion, "Errores de fabricación"),
            new Estado<ReclamoMotivoEnum?>(ReclamoMotivoEnum.Administrativo,     "Administrativo")
        ];

        clientes = await ClientesService.GetClientes() ?? [];

        editContext  = new(reclamo);
        editContext.OnValidationRequested += HandleValidation;
        editContext.OnFieldChanged        += (s, e) => messageStore?.Clear(e.FieldIdentifier);
        messageStore = new(editContext);

        showPage = true;
    }

    // ── Validación ───────────────────────────────────────────────────────────
    private void HandleValidation(object sender, ValidationRequestedEventArgs args)
    {
        messageStore?.Clear();
        if (reclamo.IdCliente == null)
            messageStore?.Add(() => reclamo.IdCliente, "Debe seleccionar un cliente");
        if (reclamo.Tipo == null)
            messageStore?.Add(() => reclamo.Tipo, "Debe seleccionar el tipo de reclamo");
        if (reclamo.Motivo == null)
            messageStore?.Add(() => reclamo.Motivo, "Debe seleccionar el motivo del reclamo");
    }

    // ── Cliente: actualiza nombre en cabecera ─────────────────────────────────
    private void OnClienteChange(object value)
    {
        if (value is int idCliente)
        {
            var cli = clientes.FirstOrDefault(c => c.IdCliente == idCliente);
            if (cli != null)
            {
                reclamo.CodigoCliente      = cli.CodigoCliente;
                reclamo.ClienteRazonSocial = cli.RazonSocial;
            }
        }
    }

    private async Task HandleSkuKeyDown(KeyboardEventArgs e, ReclamoDetalle d)
    {
        if (e.Key == KeyboardKeys.Enter && !isLoading)
            await JSFunction.OnBlurInput($"sku{d.NumeroLinea}");
        else if (e.Key == KeyboardKeys.Escape)
        {
            d.SKU               = null;
            d.DescripcionProducto = null;
        }
    }

    // Cuando el usuario sale del campo SKU: busca el producto y autocompleta descripción
    private async Task HandleSkuFocusOut(ReclamoDetalle d)
    {
        if (string.IsNullOrWhiteSpace(d.SKU) || isLoading)
            return;

        isLoading = true;
        StateHasChanged();

        var encontrado = await BuscarYCompletarProducto(d);

        isLoading = false;
        StateHasChanged();

        if (encontrado)
            await JSFunction.InputFocusAndSelect($"cant{d.NumeroLinea}");
        else
            await JSFunction.InputFocusAndSelect($"sku{d.NumeroLinea}");
    }

    // Busca el producto por código y completa DescripcionProducto
    private async Task<bool> BuscarYCompletarProducto(ReclamoDetalle d)
    {
        var resultados = await ProductosService.GetProductos(codigoProducto: d.SKU, descripcion: null,
                                                              clasificado: null, pasivo: false, linea: null);
        if (resultados == null || resultados.Count == 0)
        {
            RadzenDialogService.Notify(NotificationSeverity.Info,
                "Producto no encontrado",
                $"No se encontró el código \"{d.SKU}\". Puede ingresar la descripción manualmente.");
            return false;
        }

        if (resultados.Count == 1)
        {
            // Resultado único → autocompletar
            d.SKU                 = resultados[0].CodigoProducto;
            d.DescripcionProducto = resultados[0].Descripcion;
            await skuGrid.Reload();
            return true;
        }

        // Múltiples resultados → abrir el buscador con los resultados ya filtrados
        RadzenDialogService.Notify(NotificationSeverity.Info,
            "Varios productos encontrados",
            "Se abrirá el buscador para que seleccione el correcto.");
        await Task.Delay(600);
        await HandleBuscarSkuLinea(d);
        return false;
    }

    private async Task HandleCantKeyDown(KeyboardEventArgs e, ReclamoDetalle d)
    {
        if (e.Key == KeyboardKeys.Enter)
        {
            var next = reclamo.Detalle.FirstOrDefault(x => x.NumeroLinea == d.NumeroLinea + 1);
            if (next != null)
                await JSFunction.InputFocusAndSelect($"sku{next.NumeroLinea}");
        }
    }

    private async Task AgregarSku()
    {
        var linea = new ReclamoDetalle
        {
            NumeroLinea = reclamo.Detalle.Any() ? reclamo.Detalle.Max(x => x.NumeroLinea) + 1 : 1
        };
        reclamo.Detalle.Add(linea);
        await Task.Delay(50);
        await skuGrid.Reload();
        await JSFunction.FocusInput($"sku{linea.NumeroLinea}");
    }

    private async Task QuitarSku(ReclamoDetalle d)
    {
        reclamo.Detalle.Remove(d);

        for (int i = 0; i < reclamo.Detalle.Count; i++)
            reclamo.Detalle[i].NumeroLinea = i + 1;

        await Task.Delay(40);
        await skuGrid.Reload();
    }

    private async Task HandleBuscarSkuLinea(ReclamoDetalle d)
    {
        var resultado = await RadzenDialogService.OpenAsync<ProductoBusqueda>(
            "Búsqueda de producto",
            new Dictionary<string, object> { { "Pasivo", false } },
            new DialogOptions { Width = "60rem", Height = "90vh" });

        if (resultado is ProductoOrden producto)
        {
            d.SKU                 = producto.CodigoProducto;
            d.DescripcionProducto = producto.Descripcion;
            await skuGrid.Reload();
            await Task.Delay(50);
            await JSFunction.InputFocusAndSelect($"cant{d.NumeroLinea}");
        }
    }

    private async Task HandleBuscarSKU()
    {
        await RadzenDialogService.OpenAsync<ProductoBusqueda>(
            "Búsqueda de productos",
            new Dictionary<string, object>
            {
                { "Pasivo",          false },
                { "MultiSelect",     true  },
                { "CallbackMultiple", EventCallback.Factory.Create<List<ProductoOrden>>(this, OnProductosSeleccionados) }
            },
            new DialogOptions { Width = "60rem", Height = "90vh" });
    }

    private async Task OnProductosSeleccionados(List<ProductoOrden> productos)
    {
        RadzenDialogService.CloseDialog();
        isLoading = true;

        foreach (var p in productos)
        {
            // Evitar duplicados
            if (reclamo.Detalle.Any(d => d.SKU == p.CodigoProducto))
                continue;

            reclamo.Detalle.Add(new ReclamoDetalle
            {
                SKU                 = p.CodigoProducto,
                DescripcionProducto = p.Descripcion,
                Cantidad            = 1,
                NumeroLinea         = reclamo.Detalle.Any() ? reclamo.Detalle.Max(x => x.NumeroLinea) + 1 : 1
            });
        }

        await skuGrid.Reload();
        isLoading = false;

        if (reclamo.Detalle.Any())
        {
            await Task.Delay(50);
            await JSFunction.InputFocusAndSelect($"cant{reclamo.Detalle.Last().NumeroLinea}");
        }
    }

    private async Task Guardar()
    {
        if (!editContext.Validate())
        {
            RadzenDialogService.ShowAlert(editContext.GetValidationMessages().ToList());
            return;
        }

        if (reclamo.Detalle.Count == 0)
        {
            RadzenDialogService.ShowAlert("Debe agregar al menos un SKU afectado.");
            return;
        }

        if (!await RadzenDialogService.ConfirmOperation())
            return;

        var response = TipoOperacion switch
        {
            TipoOperacionEnum.Alta    => await ReclamosService.PostReclamo(reclamo),
            TipoOperacionEnum.Edicion => await ReclamosService.PutReclamo(reclamo),
            _                         => null
        };

        if (response == null || response.IsInternalServerError)
            RadzenDialogService.NotifyInternalServerError();
        else if (response.IsBadRequest && response.Errors?.Count > 0)
            RadzenDialogService.ShowAlert(response.Errors);
        else if (response.IsOk)
            await AfterSave.InvokeAsync((Reclamo)response.Data);
    }

    private async Task Cancelar()
    {
        if (!editContext.IsModified() || await RadzenDialogService.CancelOperation())
            RadzenDialogService.CloseDialog();
    }
}
