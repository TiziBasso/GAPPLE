@using System.Globalization
@using GAPPLE.Client.Components.Productos

@inject ReclamosService ReclamosService
@inject ProductosService ProductosService
@inject ClientesService ClientesService
@inject ComprobantesService ComprobantesService
@inject RadzenDialogService RadzenDialogService
@inject DialogService DialogService
@inject IJSFunction JSFunction

@if (showPage)
{
    <RadzenTemplateForm EditContext="editContext" Data="reclamo" TItem="Reclamo" Submit="Guardar"
                        Style="display:grid; grid-template-rows:auto 1fr auto; height:100%; gap:8px;">

        <RadzenFieldset Text="Datos del reclamo">
            <RadzenRow Gap="8px">

                <RadzenColumn Size=12 SizeMD=6 SizeLG=4>
                    <RadzenStack Orientation="Orientation.Vertical" Gap="2px">
                        <RadzenLabel Text="Cliente *" Component="fCliente" />
                        <RadzenDropDownDataGrid @bind-Value="reclamo.CodigoCliente"
                                                Data="clientes"
                                                Name="fCliente"
                                                ValueProperty="@nameof(Cliente.CodigoCliente)"
                                                TextProperty="@nameof(Cliente.RazonSocial)"
                                                Change="OnClienteChange"
                                                LoadData="OnLoadClientes"
                                                AllowFiltering=true
                                                FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                                FilterDelay="400"
                                                IsLoading="cargandoClientes"
                                                EmptyText="@(clientesFiltro?.Trim().Length >= 2 ? "Sin resultados" : "Escriba al menos 2 letras para buscar...")"
                                                Density="Density.Compact"
                                                Style="width:100%"
                                                PopupStyle="max-height:320px; overflow-y:auto; overflow-x:hidden;">
                            <Columns>
                                <RadzenDropDownDataGridColumn Property="@nameof(Cliente.CodigoCliente)" Title="Código" Width="80px" />
                                <RadzenDropDownDataGridColumn Property="@nameof(Cliente.RazonSocial)" Title="Razón social" />
                            </Columns>
                        </RadzenDropDownDataGrid>
                        <ValidationMessage For="@(() => reclamo.CodigoCliente)" />
                    </RadzenStack>
                </RadzenColumn>

                <RadzenColumn Size=6 SizeMD=3 SizeLG=2>
                    <RadzenStack Orientation="Orientation.Vertical" Gap="2px">
                        <RadzenLabel Text="Tipo *" Component="fTipo" />
                        <RadzenDropDown TValue="ReclamoTipoEnum?"
                                        @bind-Value="reclamo.Tipo"
                                        Data="tiposOpciones"
                                        Name="fTipo"
                                        ValueProperty="@nameof(Estado<ReclamoTipoEnum?>.Id)"
                                        TextProperty="@nameof(Estado<ReclamoTipoEnum?>.Descripcion)"
                                        Placeholder="Seleccione..."
                                        Style="width:100%" />
                        <ValidationMessage For="@(() => reclamo.Tipo)" />
                    </RadzenStack>
                </RadzenColumn>

                <RadzenColumn Size=6 SizeMD=3 SizeLG=3>
                    <RadzenStack Orientation="Orientation.Vertical" Gap="2px">
                        <RadzenLabel Text="Motivo *" Component="fMotivo" />
                        <RadzenDropDown TValue="ReclamoMotivoEnum?"
                                        @bind-Value="reclamo.Motivo"
                                        Data="motivosOpciones"
                                        Name="fMotivo"
                                        ValueProperty="@nameof(Estado<ReclamoMotivoEnum?>.Id)"
                                        TextProperty="@nameof(Estado<ReclamoMotivoEnum?>.Descripcion)"
                                        Placeholder="Seleccione..."
                                        Style="width:100%" />
                        <ValidationMessage For="@(() => reclamo.Motivo)" />
                    </RadzenStack>
                </RadzenColumn>

                <RadzenColumn Size=12 SizeMD=4 SizeLG=2>
                    <RadzenStack Orientation="Orientation.Vertical" Gap="2px">
                        <RadzenLabel Text="Nota de crédito" Component="fCodNC" />
                        <RadzenStack Orientation="Orientation.Horizontal" Gap="0" Style="width:100%">
                            <RadzenTextBox @bind-Value="reclamo.NumeroFactura" Name="fCodNC"
                                           Placeholder="Nº de NC" Style="width:100%" Disabled="cargandoNC" MaxLength="50"
                                           Change="@(args => BuscarDetalleNC(args))" />
                            <RadzenButton Icon="search" Size="ButtonSize.Medium" ButtonStyle="ButtonStyle.Secondary"
                                          Click="@(() => BuscarDetalleNC(reclamo.NumeroFactura))"
                                          Disabled="@(cargandoNC || string.IsNullOrWhiteSpace(reclamo.NumeroFactura))"
                                          title="Cargar productos de la NC" IsBusy="cargandoNC" />
                        </RadzenStack>
                        <RadzenText Visible="cargandoNC" TextStyle="TextStyle.Caption"
                                    Style="color:var(--rz-text-secondary-color)" Text="Buscando productos de la NC..." />
                    </RadzenStack>
                </RadzenColumn>
                <RadzenColumn Size=6 SizeMD=4 SizeLG=2>
                    <RadzenStack Orientation="Orientation.Vertical" Gap="2px">
                        <RadzenLabel Text="N Factura" Component="fNFAC" />
                        <RadzenStack Orientation="Orientation.Horizontal" Gap="0" Style="width:100%">
                            <RadzenTextBox @bind-Value="reclamo.NFAC" Name="fNFAC"
                                           Placeholder="Nº Factura" Style="width:100%" />
                        </RadzenStack>
                    </RadzenStack>
                </RadzenColumn>
                <RadzenColumn Size=6 SizeMD=4 SizeLG=2>
                    <RadzenStack Orientation="Orientation.Vertical" Gap="2px">
                        <RadzenLabel Text="Fecha:" Component="fec" />
                        <RadzenStack Orientation="Orientation.Horizontal" Gap="0" Style="width:100%">
                            <RadzenDatePicker @bind-Value="reclamo.Fecha"></RadzenDatePicker>
                        </RadzenStack>
                    </RadzenStack>
                </RadzenColumn>
            </RadzenRow>
        </RadzenFieldset>

        <RadzenFieldset Text="Productos afectados (SKUs)" Style="overflow-y:auto;min-height:250px;">

            <RadzenDataGrid @ref="skuGrid" Data="reclamo.Detalle" TItem="ReclamoDetalle"
                            Style="min-height: 180px;" Density="Density.Compact" IsLoading="isLoading"
                            AllowAlternatingRows="false" EmptyText="@string.Empty" class="rz-mt-1">
                <HeaderTemplate>
                    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" Style="width: 100%;">
                        <RadzenStack Orientation="Orientation.Horizontal" Gap="1rem" Style="width: fit-content;">
                            <RadzenButton ButtonStyle="ButtonStyle.Secondary" Icon="add" Text="Agregar producto"
                                          Click="@AgregarSku" Size="ButtonSize.Small" Disabled="isLoading" />
                            <RadzenButton ButtonStyle="ButtonStyle.Primary" Icon="search" Text="Buscar producto"
                                          Click="@HandleBuscarSKU" Size="ButtonSize.Small" Disabled="isLoading" />
                        </RadzenStack>

                        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" AlignItems="AlignItems.Center" Gap="5rem" Style="width: fit-content;">
                            <RadzenLabel Style="text-wrap:nowrap">
                                Total de líneas: <strong>@(totalLineas)</strong>
                            </RadzenLabel>
                            <RadzenLabel Style="text-wrap: nowrap; margin-right: 1.5rem;">
                                Total unidades: <strong>@(totalUnidades)</strong>
                            </RadzenLabel>
                        </RadzenStack>
                    </RadzenStack>
                    <ValidationMessage For="@(() => reclamo.Detalle)" />
                    @if (reclamo.Detalle.Count == 0)
                    {
                        <RadzenText Text="No hay productos agregados. Use 'Agregar producto', 'Buscar producto' o ingrese un número de NC."
                                    TextStyle="TextStyle.Caption"
                                    style="color:var(--rz-text-secondary-color); font-style:italic;" />
                    }
                </HeaderTemplate>
                <Columns>

                    <RadzenDataGridColumn Title="Cód. prod. *" TextAlign="TextAlign.Right" Width="130px" OrderIndex="0">
                        <Template Context="d">
                            <input id="@($"sku{d.NumeroLinea}")" type="text" value="@d.SKU"
                                   @oninput="@(e => d.SKU = e.Value?.ToString())"
                                   @onkeydown="@(e => HandleSkuKeyDown(e, d))"
                                   @onfocusout="@(() => HandleSkuFocusOut(d))"
                                   arrowKeyBlocker enterKeyBlocker readonly="@isLoading"
                                   placeholder="Código producto..."
                                   class="rz-textbox table-input-padding" style="width:100%; height:25px; text-align:right;" />
                        </Template>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn Property="@nameof(ReclamoDetalle.DescripcionProducto)" Title="Descripción" TextAlign="TextAlign.Left" />

                    <RadzenDataGridColumn Title="Cant" TextAlign="TextAlign.Right" Width="65px">
                        <Template Context="d">
                            <input id="@($"cant{d.NumeroLinea}")" type="number" min="1" @bind-value="d.Cantidad"
                                   @onkeydown="@(e => HandleCantKeyDown(e, d))" @onfocusout="@(() => OnFocusOutCant(d))"
                                   arrowKeyBlocker enterKeyBlocker disabled="@isLoading"
                                   class="rz-textbox table-input-padding" style="width:100%; height:25px; text-align:right;" />
                        </Template>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn Title="Lote" Width="150px">
                        <Template Context="d">
                            <input id="@($"lote{d.NumeroLinea}")" type="text" value="@d.Lote"
                                   @oninput="@(e => d.Lote = e.Value?.ToString())"
                                   @onkeydown="@(e => HandleLoteKeyDown(e, d))"
                                   maxlength="100" disabled="@isLoading"
                                   placeholder="Lote"
                                   class="rz-textbox table-input-padding" style="width:100%; height:25px;" />
                        </Template>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn Title="Vencimiento" Width="145px">
                        <Template Context="d">
                            <RadzenDatePicker @bind-Value="d.Vencimiento" DateFormat="dd/MM/yyyy"
                                              Style="width:100%" Disabled="isLoading" />
                        </Template>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn TextAlign="TextAlign.Center" Sortable=false Filterable=false Width="35px">
                        <Template Context="d">
                            <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.ExtraSmall"
                                          Disabled="isLoading" Click="@(args => QuitarSku(d))"
                                          @onclick:stopPropagation="true" title="Eliminar" />
                        </Template>
                    </RadzenDataGridColumn>

                </Columns>
            </RadzenDataGrid>
        </RadzenFieldset>

        <RadzenFieldset Text="Descripción y resolución">
            <RadzenRow Gap="8px">
                <RadzenColumn Size=12 SizeLG=6>
                    <RadzenStack Orientation="Orientation.Vertical" Gap="2px">
                        <RadzenLabel Text="Descripción del problema" Component="fDescripcion" />
                        <RadzenTextArea @bind-Value="reclamo.Descripcion" Name="fDescripcion"
                                        Rows=4 Style="width:100%; resize:vertical;"
                                        Placeholder="Detalle el reclamo del cliente..." MaxLength="2000" />
                        <ValidationMessage For="@(() => reclamo.Descripcion)" />
                    </RadzenStack>
                </RadzenColumn>
                <RadzenColumn Size=12 SizeLG=6>
                    <RadzenStack Orientation="Orientation.Vertical" Gap="2px">
                        <RadzenLabel Text="Resolución / Acción realizada" Component="fResolucion" />
                        <RadzenTextArea @bind-Value="reclamo.Resolucion" Name="fResolucion"
                                        Rows=4 Style="width:100%; resize:vertical;"
                                        Placeholder="Indique la resolución tomada (ej: NC, devolución, etc)..." MaxLength="2000" />
                        <ValidationMessage For="@(() => reclamo.Resolucion)" />
                    </RadzenStack>
                </RadzenColumn>
            </RadzenRow>
        </RadzenFieldset>

        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceAround">
            <RadzenButton Icon="cancel" Text="Cancelar" ButtonStyle="ButtonStyle.Danger" Click="Cancelar" />
            <RadzenButton Icon="save" Text="Guardar reclamo" ButtonStyle="ButtonStyle.Success"
                          ButtonType="ButtonType.Submit" Disabled="isLoading" />
        </RadzenStack>

    </RadzenTemplateForm>
}
else
{
    <Loader />
}

@code {

    [Parameter] public EventCallback<Reclamo> AfterSave { get; set; }
    [Parameter] public Reclamo Reclamo { get; set; }
    [Parameter] public TipoOperacionEnum TipoOperacion { get; set; }

    Reclamo reclamo;
    bool showPage;
    bool isLoading;
    bool cargandoNC;
    int? ultimoIdComprobanteCargado;
    int totalLineas, totalUnidades;
    List<Cliente> clientes = [];
    bool cargandoClientes;
    string clientesFiltro;
    const int MaxResultadosCliente = 50;
    EditContext editContext;
    ValidationMessageStore messageStore;
    RadzenDataGrid<ReclamoDetalle> skuGrid;

    List<Estado<ReclamoTipoEnum?>> tiposOpciones = [];
    List<Estado<ReclamoMotivoEnum?>> motivosOpciones = [];

    protected override async Task OnInitializedAsync()
    {
        reclamo = (Reclamo)Reclamo.Clone();
        reclamo.Detalle = Reclamo.Detalle
            .Select((d, i) => { var c = (ReclamoDetalle)d.Clone(); c.NumeroLinea = i + 1; return c; })
            .ToList();

        tiposOpciones = [
            new Estado<ReclamoTipoEnum?>(ReclamoTipoEnum.Grave,    "Grave"),
            new Estado<ReclamoTipoEnum?>(ReclamoTipoEnum.Moderado, "Moderado"),
            new Estado<ReclamoTipoEnum?>(ReclamoTipoEnum.Leve,     "Leve")
        ];

        motivosOpciones = [
            new Estado<ReclamoMotivoEnum?>(ReclamoMotivoEnum.BultosCruzados, "Bultos cruzados"),
            new Estado<ReclamoMotivoEnum?>(ReclamoMotivoEnum.Devolucion, "Devolución"),
            new Estado<ReclamoMotivoEnum?>(ReclamoMotivoEnum.CortoVencimiento, "Corto vencimiento"),
            new Estado<ReclamoMotivoEnum?>(ReclamoMotivoEnum.ErrorFabricacion, "Error de fabricación"),
            new Estado<ReclamoMotivoEnum?>(ReclamoMotivoEnum.ErrorAdministrativo, "Error administrativo"),
            new Estado<ReclamoMotivoEnum?>(ReclamoMotivoEnum.ErrorCargaVendedor, "Error de carga del vendedor"),
            new Estado<ReclamoMotivoEnum?>(ReclamoMotivoEnum.ErrorEnvio, "Error de envío"),
            new Estado<ReclamoMotivoEnum?>(ReclamoMotivoEnum.Faltantes, "Faltante"),
            new Estado<ReclamoMotivoEnum?>(ReclamoMotivoEnum.FaltanteCDA, "Faltante CDA"),
            new Estado<ReclamoMotivoEnum?>(ReclamoMotivoEnum.ErrorCliente, "Error cliente"),
            new Estado<ReclamoMotivoEnum?>(ReclamoMotivoEnum.ProblemaDeCalidad, "Problema de calidad"),
            new Estado<ReclamoMotivoEnum?>(ReclamoMotivoEnum.ProblemaDeEmpaque, "Problema de empaque"),
            new Estado<ReclamoMotivoEnum?>(ReclamoMotivoEnum.ProductoIncompleto, "Producto incompleto"),
            new Estado<ReclamoMotivoEnum?>(ReclamoMotivoEnum.Vencidos,"Vencidos"),
        ];

        // No se precarga el padrón completo de clientes (puede ser muy grande):
        // solo se trae el cliente ya seleccionado (edición), si corresponde.
        // El resto se busca a demanda desde OnLoadClientes mientras el usuario escribe.
        if (!string.IsNullOrWhiteSpace(reclamo.CodigoCliente))
            clientes = await ClientesService.GetClientes(codCliente: reclamo.CodigoCliente) ?? [];

        if (int.TryParse(reclamo.NumeroFactura, out int idComprobanteInicial) && idComprobanteInicial > 0)
            ultimoIdComprobanteCargado = idComprobanteInicial;

        editContext = new(reclamo);
        editContext.OnValidationRequested += HandleValidation;
        editContext.OnFieldChanged += (s, e) => messageStore?.Clear(e.FieldIdentifier);
        messageStore = new(editContext);

        SetTotales();
        showPage = true;
    }

    // ── Validación ───────────────────────────────────────────────────────────
    private void HandleValidation(object sender, ValidationRequestedEventArgs args)
    {
        messageStore?.Clear();
        if (string.IsNullOrWhiteSpace(reclamo.CodigoCliente))
            messageStore?.Add(() => reclamo.CodigoCliente, "Debe seleccionar un cliente");
        if (reclamo.Tipo == null)
            messageStore?.Add(() => reclamo.Tipo, "Debe seleccionar el tipo de reclamo");
        if (reclamo.Motivo == null)
            messageStore?.Add(() => reclamo.Motivo, "Debe seleccionar el motivo del reclamo");
    }

    // ── Cliente: actualiza nombre en cabecera ─────────────────────────────────
    private void OnClienteChange(object value)
    {
        if (value is string codCliente)
        {
            var cli = clientes.FirstOrDefault(c => c.CodigoCliente == codCliente);
            if (cli != null)
            {
                reclamo.CodigoCliente = cli.CodigoCliente;
                reclamo.ClienteRazonSocial = cli.RazonSocial;
            }
        }
    }

    // ── Cliente: búsqueda a demanda (no se carga todo el padrón en memoria) ───
    private async Task OnLoadClientes(LoadDataArgs args)
    {
        clientesFiltro = args.Filter;

        if (string.IsNullOrWhiteSpace(args.Filter) || args.Filter.Trim().Length < 2)
        {
            // Sin texto de búsqueda: solo se conserva visible el cliente ya seleccionado (si hay).
            clientes = !string.IsNullOrWhiteSpace(reclamo.CodigoCliente)
                ? clientes.Where(c => c.CodigoCliente == reclamo.CodigoCliente).ToList()
                : [];
            return;
        }

        cargandoClientes = true;
        StateHasChanged();

        var filtro = args.Filter.Trim();
        var porRazonSocial = ClientesService.GetClientes(razonSocial: filtro);
        var porCodigo = ClientesService.GetClientes(codCliente: filtro);
        await Task.WhenAll(porRazonSocial.AsTask(), porCodigo.AsTask());

        clientes = (porRazonSocial.Result ?? [])
            .Concat(porCodigo.Result ?? [])
            .GroupBy(c => c.CodigoCliente)
            .Select(g => g.First())
            .OrderBy(c => c.RazonSocial)
            .Take(MaxResultadosCliente)
            .ToList();

        cargandoClientes = false;
    }

    // ── Nota de crédito: trae y agrega sus productos al reclamo ───────────────
    private async Task BuscarDetalleNC(string numeroNC)
    {
        if (cargandoNC)
            return;

        if (!int.TryParse(numeroNC?.Trim(), out int idComprobante) || idComprobante <= 0)
        {
            if (!string.IsNullOrWhiteSpace(numeroNC))
                RadzenDialogService.Notify(NotificationSeverity.Warning,
                    "Número de NC inválido",
                    "Ingrese solo el número de la nota de crédito.");
            return;
        }

        if (ultimoIdComprobanteCargado == idComprobante)
            return;

        cargandoNC = true;
        StateHasChanged();

        NotaCreditoResumen resumen;
        try
        {
            resumen = await ComprobantesService.GetNotaCreditoResumen(idComprobante);
        }
        catch
        {
            resumen = null;
        }

        if (resumen == null || (resumen.CodCliente == null && resumen.Detalle.Count == 0))
        {
            cargandoNC = false;
            RadzenDialogService.Notify(NotificationSeverity.Warning,
                "Nota de crédito no encontrada",
                $"No se encontró información para la NC {idComprobante}.");
            return;
        }

        // Autocompletar cliente ─────────────────────────────────────────────
        if (!string.IsNullOrWhiteSpace(resumen.CodCliente))
        {
            bool hayConflicto = !string.IsNullOrWhiteSpace(reclamo.CodigoCliente)
                                 && reclamo.CodigoCliente != resumen.CodCliente;

            bool asignar = !hayConflicto || await RadzenDialogService.Confirm(
                $"La NC {idComprobante} pertenece al cliente \"{resumen.ClienteRazonSocial}\", distinto del ya seleccionado. ¿Desea reemplazarlo?",
                MensajesHelper.Title, RadzenHelper.Confirm()) == true;

            if (asignar)
            {
                reclamo.CodigoCliente = resumen.CodCliente;
                reclamo.ClienteRazonSocial = resumen.ClienteRazonSocial;

                if (!clientes.Any(c => c.CodigoCliente == resumen.CodCliente))
                    clientes.Add(new Cliente { CodigoCliente = resumen.CodCliente, RazonSocial = resumen.ClienteRazonSocial });
            }
        }

        // Agregar productos ──────────────────────────────────────────────────
        int agregados = 0;
        foreach (var item in resumen.Detalle)
        {
            if (reclamo.Detalle.Any(d => d.SKU == item.CodProducto))
                continue;

            reclamo.Detalle.Add(new ReclamoDetalle
            {
                SKU = item.CodProducto,
                DescripcionProducto = item.DescripcionProducto,
                Cantidad = item.Cantidad > 0 ? item.Cantidad : 1,
                NumeroLinea = reclamo.Detalle.Any() ? reclamo.Detalle.Max(x => x.NumeroLinea) + 1 : 1
            });
            agregados++;
        }

        ultimoIdComprobanteCargado = idComprobante;
        cargandoNC = false;

        if (skuGrid != null) await skuGrid.Reload();
        SetTotales();

        if (agregados > 0)
            RadzenDialogService.Notify(NotificationSeverity.Success,
                "Productos cargados",
                $"Se agregaron {agregados} producto(s) de la NC {idComprobante}.");
        else if (resumen.Detalle.Count > 0)
            RadzenDialogService.Notify(NotificationSeverity.Info,
                "Sin productos nuevos",
                "Los productos de esa NC ya estaban cargados en el reclamo.");
    }

    private async Task HandleSkuKeyDown(KeyboardEventArgs e, ReclamoDetalle d)
    {
        if (e.Key == KeyboardKeys.Enter && !isLoading)
            await JSFunction.OnBlurInput($"sku{d.NumeroLinea}");
        else if (e.Key == KeyboardKeys.Escape)
        {
            d.SKU = null;
            d.DescripcionProducto = null;
        }
        else if (e.Key == KeyboardKeys.Up)
        {
            var prev = reclamo.Detalle.FirstOrDefault(x => x.NumeroLinea == d.NumeroLinea - 1);
            if (prev != null) await JSFunction.InputFocusAndSelect($"sku{prev.NumeroLinea}");
        }
        else if (e.Key == KeyboardKeys.Down)
        {
            var next = reclamo.Detalle.FirstOrDefault(x => x.NumeroLinea == d.NumeroLinea + 1);
            if (next != null) await JSFunction.InputFocusAndSelect($"sku{next.NumeroLinea}");
        }
    }

    // Cuando el usuario sale del campo SKU: busca el producto y autocompleta descripción
    private async Task HandleSkuFocusOut(ReclamoDetalle d)
    {
        if (string.IsNullOrWhiteSpace(d.SKU) || isLoading)
            return;

        isLoading = true;
        StateHasChanged();

        var encontrado = await BuscarYCompletarProducto(d);

        isLoading = false;
        StateHasChanged();

        if (encontrado)
            await JSFunction.InputFocusAndSelect($"cant{d.NumeroLinea}");
        else
            await JSFunction.InputFocusAndSelect($"sku{d.NumeroLinea}");
    }

    // Busca el producto por código y completa DescripcionProducto
    private async Task<bool> BuscarYCompletarProducto(ReclamoDetalle d)
    {
        var resultados = await ProductosService.GetProductos(codigoProducto: d.SKU, descripcion: null,
                                                              clasificado: null, pasivo: false, linea: null);
        if (resultados == null || resultados.Count == 0)
        {
            RadzenDialogService.Notify(NotificationSeverity.Info,
                "Producto no encontrado",
                $"No se encontró el código \"{d.SKU}\". Puede ingresar la descripción manualmente.");
            return false;
        }

        if (resultados.Count == 1)
        {
            // Resultado único → autocompletar
            d.SKU = resultados[0].CodigoProducto;
            d.DescripcionProducto = resultados[0].Descripcion;
            if (skuGrid != null) await skuGrid.Reload();
            return true;
        }

        // Múltiples resultados → abrir el buscador con los resultados ya filtrados
        RadzenDialogService.Notify(NotificationSeverity.Info,
            "Varios productos encontrados",
            "Se abrirá el buscador para que seleccione el correcto.");
        await Task.Delay(600);
        await HandleBuscarSkuLinea(d);
        return false;
    }

    private async Task HandleCantKeyDown(KeyboardEventArgs e, ReclamoDetalle d)
    {
        if (e.Key == KeyboardKeys.Enter)
            await JSFunction.InputFocusAndSelect($"lote{d.NumeroLinea}");
        else if (e.Key == KeyboardKeys.Up)
        {
            var prev = reclamo.Detalle.FirstOrDefault(x => x.NumeroLinea == d.NumeroLinea - 1);
            if (prev != null) await JSFunction.InputFocusAndSelect($"cant{prev.NumeroLinea}");
        }
        else if (e.Key == KeyboardKeys.Down)
        {
            var next = reclamo.Detalle.FirstOrDefault(x => x.NumeroLinea == d.NumeroLinea + 1);
            if (next != null) await JSFunction.InputFocusAndSelect($"cant{next.NumeroLinea}");
        }
    }

    private async Task HandleLoteKeyDown(KeyboardEventArgs e, ReclamoDetalle d)
    {
        if (e.Key == KeyboardKeys.Enter)
        {
            var next = reclamo.Detalle.FirstOrDefault(x => x.NumeroLinea == d.NumeroLinea + 1);
            if (next != null)
                await JSFunction.InputFocusAndSelect($"sku{next.NumeroLinea}");
        }
    }

    private void OnFocusOutCant(ReclamoDetalle d)
    {
        if (d.Cantidad <= 0)
            d.Cantidad = 1;
        SetTotales();
    }

    private async Task AgregarSku()
    {
        var linea = new ReclamoDetalle
        {
            Cantidad = 1,
            NumeroLinea = reclamo.Detalle.Any() ? reclamo.Detalle.Max(x => x.NumeroLinea) + 1 : 1
        };
        reclamo.Detalle.Add(linea);
        SetTotales();
        if (skuGrid != null) await skuGrid.Reload();
        await Task.Delay(1);
        await JSFunction.FocusInput($"sku{linea.NumeroLinea}");
    }

    private async Task QuitarSku(ReclamoDetalle d)
    {
        if (await RadzenDialogService.Confirm(MensajesHelper.Confirm("eliminar", "la línea"), MensajesHelper.Title, RadzenHelper.Confirm()) != true)
            return;

        reclamo.Detalle.Remove(d);

        for (int i = 0; i < reclamo.Detalle.Count; i++)
            reclamo.Detalle[i].NumeroLinea = i + 1;

        SetTotales();
        if (skuGrid != null) await skuGrid.Reload();
    }

    private async Task HandleBuscarSkuLinea(ReclamoDetalle d)
    {
        var resultado = await RadzenDialogService.OpenAsync<ProductoBusqueda>(
            "Búsqueda de producto",
            new Dictionary<string, object> { { "Pasivo", false } },
            new DialogOptions { Width = "60rem", Height = "90vh" });

        if (resultado is ProductoOrden producto)
        {
            d.SKU = producto.CodigoProducto;
            d.DescripcionProducto = producto.Descripcion;
            if (skuGrid != null) await skuGrid.Reload();
            await Task.Delay(50);
            await JSFunction.InputFocusAndSelect($"cant{d.NumeroLinea}");
        }
    }

    private async Task HandleBuscarSKU()
    {
        await RadzenDialogService.OpenAsync<ProductoBusqueda>(
            "Búsqueda de productos",
            new Dictionary<string, object>
                {
                { "Pasivo",          false },
                { "MultiSelect",     true  },
                { "CallbackMultiple", EventCallback.Factory.Create<List<ProductoOrden>>(this, OnProductosSeleccionados) }
                },
            new DialogOptions { Width = "60rem", Height = "90vh" });
    }

    private async Task OnProductosSeleccionados(List<ProductoOrden> productos)
    {
        RadzenDialogService.CloseDialog();
        isLoading = true;

        foreach (var p in productos)
        {
            // Evitar duplicados
            if (reclamo.Detalle.Any(d => d.SKU == p.CodigoProducto))
                continue;

            reclamo.Detalle.Add(new ReclamoDetalle
            {
                SKU = p.CodigoProducto,
                DescripcionProducto = p.Descripcion,
                Cantidad = 1,
                NumeroLinea = reclamo.Detalle.Any() ? reclamo.Detalle.Max(x => x.NumeroLinea) + 1 : 1
            });
        }

        SetTotales();
        if (skuGrid != null) await skuGrid.Reload();
        isLoading = false;

        if (reclamo.Detalle.Any())
        {
            await Task.Delay(50);
            await JSFunction.InputFocusAndSelect($"cant{reclamo.Detalle.Last().NumeroLinea}");
        }
    }

    private void SetTotales()
    {
        totalLineas = reclamo.Detalle.Count;
        totalUnidades = reclamo.Detalle.Sum(x => x.Cantidad);
    }

    private async Task Guardar()
    {
        if (!editContext.Validate())
        {
            RadzenDialogService.ShowAlert(editContext.GetValidationMessages().ToList());
            return;
        }

        if (reclamo.Detalle.Count == 0)
        {
            RadzenDialogService.ShowAlert("Debe agregar al menos un SKU afectado.");
            return;
        }

        if (!await RadzenDialogService.ConfirmOperation())
            return;

        RadzenDialogService.OpenBusyWithLoader("Guardando...");

        var response = TipoOperacion switch
        {
            TipoOperacionEnum.Alta => await ReclamosService.PostReclamo(reclamo),
            TipoOperacionEnum.Edicion => await ReclamosService.PutReclamo(reclamo),
            _ => null
        };

        RadzenDialogService.CloseDialog();

        if (response == null || response.IsInternalServerError)
            RadzenDialogService.NotifyInternalServerError();
        else if (response.IsBadRequest && response.Errors?.Count > 0)
            RadzenDialogService.ShowAlert(response.Errors);
        else if (response.IsOk)
            await AfterSave.InvokeAsync((Reclamo)response.Data);
    }

    private async Task Cancelar()
    {
        if (!editContext.IsModified() || await RadzenDialogService.CancelOperation())
            RadzenDialogService.CloseDialog();
    }
}

