    private async Task HandleClickDetalleLibre()
    {
        var res = await RadzenDialogService.OpenAsync<ComprobanteAgregarDetalleLibre>(
            "Agregar línea de detalle libre", new() { }
        );

        if (res != null)
        {
            var detalleLibre = (ComprobanteDetalleLibre)res;
            ComprobanteDetalle linea = new() { NumeroLinea = Lineas.Count + 1 };
            linea.IdProducto = -1;
            linea.Detalle = detalleLibre.Concepto;
            linea.Cantidad = 1;
            Lineas.Add(linea);
            if (Lineas.Count == 1)
                selectedRow = Lineas.Take(1).ToList();
            await refGrid.Reload();
            await Task.Delay(1);
            await JSFunction.InputFocusAndSelect($"unit{linea.NumeroLinea}");
            SetTotales();
        }
    }
