<RadzenDataGrid @ref="refGrid" Data="Lineas" TItem="ComprobanteDetalle" Style="min-height: 180px;"
                Density="Density.Compact" IsLoading="isLoading" AllowAlternatingRows="false" EmptyText="@string.Empty" class="rz-mt-1">
    <HeaderTemplate>
        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" Style="width: 100%;">
            <RadzenStack Orientation="Orientation.Horizontal" Gap="1rem" Style="width: fit-content;">
                <RadzenButton ButtonStyle="ButtonStyle.Secondary" Icon="add" Text="Agregar producto" Click="@InsertRow" Size="ButtonSize.Small" Disabled=@Disabled />
                <RadzenButton ButtonStyle="ButtonStyle.Primary" Icon="search" Text="Buscar producto" Click="@HandleBuscarSKU" Size="ButtonSize.Small" Disabled=@Disabled />

                @if (IngresarLineaManual)
                {
                    <RadzenButton ButtonStyle="ButtonStyle.Base" Icon="draw" IconColor="@Colors.Secondary" Text="Detalle libre" Size="ButtonSize.Small"
                                  Click="HandleClickDetalleLibre" title="Detalle libre" Disabled=@Disabled />
                }

                @* @if (PermiteFacturarRemitos)
                    {
                        <RadzenButton ButtonStyle="ButtonStyle.Base" Icon="gesture_select" IconColor="@Colors.Secondary" Text="Seleccionar remito" Size="ButtonSize.Small"
                                      Click="HandleClickSeleccionarRemito" title="Seleccionar remito" />
                    } *@
            </RadzenStack>

            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" AlignItems="AlignItems.Center" Gap="5rem" Style="width: fit-content;">
                <RadzenLabel Style="text-wrap:nowrap">
                    Total de líneas: <strong>@(totalLineas)</strong>
                </RadzenLabel>

                <RadzenLabel Style="text-wrap: nowrap; margin-right: 1.5rem;">
                    Total unidades: <strong>@(totalUnidades)</strong>
                </RadzenLabel>
            </RadzenStack>
        </RadzenStack>
        <ValidationMessage For="@(() => Comprobante.Detalle)" />
    </HeaderTemplate>
    <Columns>

        <RadzenDataGridColumn Title="Cód. prod." TextAlign="TextAlign.Right" Width="100px" OrderIndex="0">
            <Template Context="data">
                @if (data.IdProducto == 0)
                {
                    <input id=@($"sku{data.NumeroLinea}") type="number" @bind-value="data.CodProducto" @bind-value:event="oninput"
                           @onkeydown="@(args => HandleSKUOnKeyDown(args, data))" @onfocusout="@(() => HandleSKUOnFocusOut(data))"
                           arrowKeyBlocker enterKeyBlocker readonly="@isLoading"
                           class="rz-textbox table-input-padding" style="width:100%; height: 25px; text-align: right;" />
                }
                else
                {
                    <text>@data.CodProducto</text>
                }
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Property="@nameof(ComprobanteDetalle.DescripcionProducto)" Title="Descripción" TextAlign="TextAlign.Left" />
        <RadzenDataGridColumn Title="Cant" TextAlign="TextAlign.Right" Width="65px">
            <Template Context="data">
                <input id=@($"cant{data.NumeroLinea}") type="number" @bind-value="data.Cantidad"
                       @onkeydown="@(args => KeyDownCant(args, data))" @onfocusout="@(() => OnFocusOutCant(data))"
                       arrowKeyBlocker enterKeyBlocker disabled=@Disabled
                       class="rz-textbox table-input-padding" style="width:100%; height: 25px; text-align: right;" />
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Title="Unitario" TextAlign="TextAlign.Right" Width="110px">
            <Template Context="data">
                @if (!Disabled && (ModificarPreciosUnitarios | IngresarLineaManual))
                {
                    <input id=@($"unit{data.NumeroLinea}") type="number" @bind-value="data.Precio" step="0.01"
                           @onkeydown="@(args => KeyDownUnit(args, data))" @onfocusout="@(() => OnFocusOutUnit(data))"
                           arrowKeyBlocker enterKeyBlocker
                           class="rz-textbox table-input-padding" style="width:100%; height: 25px; text-align: right;" />
                }
                else
                {
                    @data.Precio.ToString("N2")
                }
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Title="% Dto" TextAlign="TextAlign.Right" Width="65px">
            <Template Context="data">
                <input id=@($"desc{data.NumeroLinea}") type="number" @bind-value="data.Descuento"
                       @onkeydown="@(args => KeyDownDesc(args, data))" @onfocusout="@(() => OnFocusOutDesc(data))"
                       arrowKeyBlocker enterKeyBlocker disabled=@Disabled
                       class="rz-textbox table-input-padding" style="width:100%; height: 25px; text-align: right;" />
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Property="@nameof(ComprobanteDetalle.PrecioConDescuento)" Title="Unit. c/dto." TextAlign="TextAlign.Right" Width="110px">
            <Template Context="data">
                $@data.PrecioConDescuento.ToString("N2", new CultureInfo("es-AR"))
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Property="@nameof(ComprobanteDetalle.PrecioTotal)" Title="Total" TextAlign="TextAlign.Right" Width="130px">
            <Template Context="data">
                $@data.PrecioTotal.ToString("N2", new CultureInfo("es-AR"))
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TextAlign="TextAlign.Center" Sortable=false Filterable=false Width="35px">
            <Template Context="data">
                <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.ExtraSmall" Disabled=@Disabled
                              Click="@(args => DeleteRow(data))" @onclick:stopPropagation="true" title="Eliminar" />
            </Template>
        </RadzenDataGridColumn>
    </Columns>
</RadzenDataGrid>

@code {
    [Parameter] public ComprobanteCabecera Comprobante { get; set; }
    [Parameter] public List<ComprobanteDetalle> Lineas { get; set; }
    [Parameter] public bool ModificarPreciosUnitarios { get; set; }
    [Parameter] public bool IngresarLineaManual { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public EventCallback Render { get; set; }

    Dictionary<int, decimal> preciosAgrupadosPorInterno = new();

    ComprobanteDetalle Linea { get; set; }

    RadzenDataGrid<ComprobanteDetalle> refGrid;

    IList<ComprobanteDetalle> selectedRow;

    bool isLoading;
    int totalLineas, totalUnidades;
    //int? idTipoListaPreciosAux;

    protected override async Task OnInitializedAsync()
    {
        //idTipoListaPreciosAux = Comprobante.IdListaPrecio;

        if (Lineas.Any())
            SetTotales();
    }

    private async Task HandleSKUOnKeyDown(KeyboardEventArgs e, ComprobanteDetalle linea)
    {
        if (e.Key == KeyboardKeys.Enter & !isLoading)
            await JSFunction.OnBlurInput($"sku{linea.NumeroLinea}");
        else if (e.Key == KeyboardKeys.Escape)
            linea.CodProducto = null;
        else if (e.Key == KeyboardKeys.Right)
            await JSFunction.InputFocusAndSelect($"ean{linea.NumeroLinea}");
        else if (e.Key == KeyboardKeys.Up)
        {
            if (Lineas.Any(x => x.NumeroLinea == linea.NumeroLinea - 1))
                await JSFunction.InputFocusAndSelect($"sku{linea.NumeroLinea - 1}");
        }
        else if (e.Key == KeyboardKeys.Down)
        {
            if (Lineas.Any(x => x.NumeroLinea == linea.NumeroLinea + 1))
                await JSFunction.InputFocusAndSelect($"sku{linea.NumeroLinea + 1}");
        }
    }

    private async Task HandleSKUOnFocusOut(ComprobanteDetalle linea)
    {
        if (!string.IsNullOrWhiteSpace(linea.CodProducto) & linea.IdProducto == 0 & !isLoading)
        {
            isLoading = true;
            var result = await BuscarProducto(linea, linea.CodProducto);
            isLoading = false;

            if (result)
            {
                await JSFunction.InputFocusAndSelect($"cant{linea.NumeroLinea}");
                SetTotales();
                await Render.InvokeAsync();
            }
            else
                await JSFunction.InputFocusAndSelect($"sku{linea.NumeroLinea}");
        }
    }

    private async Task HandleCodprOnKeyDown(KeyboardEventArgs e, ComprobanteDetalle linea)
    {

        if (e.Key == KeyboardKeys.Enter & !isLoading)
            await JSFunction.OnBlurInput($"codspr{linea.NumeroLinea}");
        else if (e.Key == KeyboardKeys.Escape)
            linea.CodProducto = null;
        else if (e.Key == KeyboardKeys.Right)
            await JSFunction.InputFocusAndSelect($"ean{linea.NumeroLinea}");
        else if (e.Key == KeyboardKeys.Up)
        {
            if (Lineas.Any(x => x.NumeroLinea == linea.NumeroLinea - 1))
                await JSFunction.InputFocusAndSelect($"codspr{linea.NumeroLinea - 1}");
        }
        else if (e.Key == KeyboardKeys.Down)
        {
            if (Lineas.Any(x => x.NumeroLinea == linea.NumeroLinea + 1))
                await JSFunction.InputFocusAndSelect($"codspr{linea.NumeroLinea + 1}");
        }
    }

    private async Task KeyDownDesc(KeyboardEventArgs e, ComprobanteDetalle linea)
    {
        if (e.Key == KeyboardKeys.Enter)
        {
            if (Lineas.Last().NumeroLinea != linea.NumeroLinea)
                await JSFunction.InputFocusAndSelect($"desc{linea.NumeroLinea + 1}");
        }
        else if (e.Key == KeyboardKeys.Left)
            await JSFunction.InputFocusAndSelect($"unit{linea.NumeroLinea}");
        else if (e.Key == KeyboardKeys.Up)
        {
            if (Lineas.Any(x => x.NumeroLinea == linea.NumeroLinea - 1))
                await JSFunction.InputFocusAndSelect($"desc{linea.NumeroLinea - 1}");
        }
        else if (e.Key == KeyboardKeys.Down)
        {
            if (Lineas.Any(x => x.NumeroLinea == linea.NumeroLinea + 1))
                await JSFunction.InputFocusAndSelect($"desc{linea.NumeroLinea + 1}");
        }
    }

    private async Task OnFocusOutCant(ComprobanteDetalle linea)
    {
        if (linea.Cantidad <= 0)
            linea.Cantidad = 0;

        SetTotales();
        await Render.InvokeAsync();
    }

    private async Task OnFocusOutDesc(ComprobanteDetalle linea)
    {
        if (linea.Descuento > 100)
            linea.Descuento = 100;
        else if (linea.Descuento < 0)
            linea.Descuento = 0;

        await Render.InvokeAsync();
    }

    private async Task OnFocusOutUnit(ComprobanteDetalle linea)
    {
        if (linea.Precio < 0)
            linea.Precio = 0;
        else
        {
            linea.Precio = decimal.Parse(linea.Precio.ToString("N2"));
            linea.Precio = linea.Precio;
        }
        await Render.InvokeAsync();
    }

    private async Task KeyDownCant(KeyboardEventArgs e, ComprobanteDetalle linea)
    {
        if (e.Key == KeyboardKeys.Enter)
        {
            await JSFunction.InputFocusAndSelect($"desc{linea.NumeroLinea}");
        }
        else if (e.Key == KeyboardKeys.Right)
        {
            await JSFunction.InputFocusAndSelect($"unit{linea.NumeroLinea}");
        }
        else if (e.Key == KeyboardKeys.Up)
        {
            if (Lineas.Any(x => x.NumeroLinea == linea.NumeroLinea - 1))
                await JSFunction.InputFocusAndSelect($"cant{linea.NumeroLinea - 1}");
        }
        else if (e.Key == KeyboardKeys.Down)
        {
            if (Lineas.Any(x => x.NumeroLinea == linea.NumeroLinea + 1))
                await JSFunction.InputFocusAndSelect($"cant{linea.NumeroLinea + 1}");
        }
    }

    private async Task KeyDownUnit(KeyboardEventArgs e, ComprobanteDetalle linea)
    {
        if (e.Key == KeyboardKeys.Enter)
            await JSFunction.InputFocusAndSelect($"desc{linea.NumeroLinea}");
        else if (e.Key == KeyboardKeys.Right)
            await JSFunction.InputFocusAndSelect($"desc{linea.NumeroLinea}");
        else if (e.Key == KeyboardKeys.Left)
            await JSFunction.InputFocusAndSelect($"cant{linea.NumeroLinea}");
        else if (e.Key == KeyboardKeys.Up)
        {
            if (Lineas.Any(x => x.NumeroLinea == linea.NumeroLinea - 1))
                await JSFunction.InputFocusAndSelect($"unit{linea.NumeroLinea - 1}");
        }
        else if (e.Key == KeyboardKeys.Down)
        {
            if (Lineas.Any(x => x.NumeroLinea == linea.NumeroLinea + 1))
                await JSFunction.InputFocusAndSelect($"unit{linea.NumeroLinea + 1}");
        }
    }

    private async Task InsertRow()
    {
        Linea = new() { Cantidad = 1 };
        Linea.NumeroLinea = Lineas.Any() ? Lineas.Max(x => x.NumeroLinea) + 1 : 1;

        Lineas.Add(Linea);
        if (Lineas.Count == 1)
            selectedRow = Lineas.Take(1).ToList();
        await refGrid.Reload();
        SetTotales();
        await Task.Delay(1);
        await JSFunction.FocusInput($"sku{Lineas.Last().NumeroLinea}");
        Linea = null;
    }

    private void ChequearNumerosLineas()
    {
        int i = 1;
        foreach (var linea in Lineas)
        {
            linea.NumeroLinea = i;
            i++;
        }
    }

    private async Task DeleteRow(ComprobanteDetalle linea)
    {
        string msg;
        if (linea.IdProducto != 0)
            msg = $"el producto {linea.CodProducto}";
        else
            msg = "la linea";

        if (await RadzenDialogService.Confirm(MensajesHelper.Confirm("eliminar", msg), MensajesHelper.Title, RadzenHelper.Confirm()) == true)
        {
            Lineas.Remove(linea);
            ChequearNumerosLineas();
            await refGrid.Reload();
            await Render.InvokeAsync();
            SetTotales();
        }
    }

    private async Task<bool> BuscarProducto(ComprobanteDetalle linea, string codProducto = null)
    {
        var producto = await ProductosService.GetProductoOrden(codProducto, Comprobante.CodListaPrecio);

        if (producto == null)
        {
            RadzenDialogService.Notify(NotificationSeverity.Info, "No se encontró el producto", "Compruebe los datos ingresados");
            return false;
        }
        else if (Comprobante.Detalle.Exists(s => s.CodProducto == producto.CodigoProducto && s.IdProducto != 0))
        {
            RadzenDialogService.Notify(NotificationSeverity.Warning, "El producto fue cargado con anterioridad");
            return false;
        }
        else
        {
            BuildLinea(linea, producto);
            return true;
        }
    }

    private async Task HandleBuscarSKU()
    {
        var result = await RadzenDialogService.OpenAsync<ProductoBusqueda>(
            "Busqúeda de SKU",
            new() { { "Pasivo", false }, { "MultiSelect", true }, { "CodListaPrecio", Comprobante.CodListaPrecio },
                    { "CallbackMultiple", EventCallback.Factory.Create<List<ProductoOrden>>(this, OnBuscarSKU) } },
            new() { Width = "60rem", Height = "90vh" });
    }

    private async Task OnBuscarSKU(List<ProductoOrden> skus)
    {
        RadzenDialogService.CloseDialog();
        RadzenDialogService.OpenBusy("Cargando...");
        isLoading = true;
        bool lineaAñadida = false;
        foreach (var sku in skus)
        {
            var linea = new ComprobanteDetalle() { NumeroLinea = Lineas.Count + 1, Cantidad = 1 };
            Lineas.Add(linea);
            if (Lineas.Count == 1)
                selectedRow = Lineas.Take(1).ToList();
            BuildLinea(linea, sku);
            lineaAñadida = true;
        }
        await refGrid.Reload();
        await Render.InvokeAsync();
        SetTotales();
        isLoading = false;
        RadzenDialogService.CloseDialog();

        if (lineaAñadida)
        {
            await Task.Delay(1);
            await JSFunction.InputFocusAndSelect($"cant{Lineas.Last().NumeroLinea}");
        }
    }

    private void BuildLinea(ComprobanteDetalle linea, ProductoOrden producto)
    {
        linea.IdProducto = producto.IdProducto;
        linea.CodProducto = producto.CodigoProducto;
        linea.DescripcionProducto = producto.Descripcion;
        linea.Precio = producto.Precio;
    }

    private void SetTotales()
    {
        totalLineas = Lineas.Count;
        totalUnidades = Lineas.Select(x => x.Cantidad).Sum();
    }

    public void RenderComponent()
    {
        StateHasChanged();
    }

    public async Task ReloadGrid() => await refGrid.Reload();

    private void Submit(ComprobanteDetalle args)
    {

    }

