@if (showModal)
{
    <div id="print" style="display:none">
        @for (int i = 0; i < cantPages; i++)
        {
            GetData(i);
            <Page Pedido=Pedido PageNum="i+1" CantPages="cantPages" ShouldPrint=@(ShouldPrint) Imprimir="Imprimir"
                  Detalle="detalle" Pendientes="pendientes" ShowProbadores=showProbadores />
        }
    </div>
}

@code {
    [Parameter, EditorRequired] public Orden Pedido { get; set; }
    [Parameter] public EventCallback Imprimir { get; set; }
    [Parameter] public List<OrdenDetalle> Detalle { get; set; }
    [Parameter] public List<OrdenDetalle>? Pendientes { get; set; } = null;
    [Parameter] public bool ShouldPrint { get; set; } = true;

    List<OrdenDetalle>? detalle = new(), pendientes = new();


    bool showModal, showProbadores;
    int cantPages = 0, lineasXPag = 40, aux;

    protected override void OnInitialized()
    {
        int sumLineas = Detalle!.Count + 1;


        bool? anyDetalle = Detalle?.Any(x => x.CantidadProbador > 0);
        bool? anyPendiente = Pendientes?.Any(x => x.CantidadProbador > 0);
        
        bool anyD = (anyDetalle != null ? (bool)anyDetalle : false);
        bool anyP = (anyPendiente != null ? (bool)anyPendiente : false);

        showProbadores = anyD || anyP;

        if (Pendientes != null && Pendientes.Any())
            sumLineas += Pendientes.Count + 3;

        cantPages = sumLineas / lineasXPag;
        if (sumLineas % lineasXPag != 0 || cantPages == 0) cantPages++;

        showModal = true;
    }

    private void GetData(int page)
    {
        int showed = page * lineasXPag, remaining = lineasXPag;

        detalle = Detalle.Skip(showed)?.Take(remaining).ToList();
        remaining -= detalle!.Count;
        if (detalle.Count > 0) showed -= detalle.Count;
        else showed -= Detalle!.Count;

        //No preguntar por el +3, funciona. Tampoco cambiar LineasXPag porque se rompe xd, si se toca esto hay que cambiar la logica y que sea solo 1 List<T>
        int showedPend = 0;
        if (page != 0 && remaining == lineasXPag)
        {
            aux++;
            showedPend = (Detalle.Count % (lineasXPag * aux)) + 3;
        }
        else remaining--;

        pendientes = Pendientes?.Skip(showedPend)?.Take(remaining).ToList();
        if (pendientes != null)
        {
            remaining -= pendientes.Count;
            if (pendientes.Count > 0) showed -= pendientes.Count;
            else showed -= Pendientes!.Count;
        }
    }
}
