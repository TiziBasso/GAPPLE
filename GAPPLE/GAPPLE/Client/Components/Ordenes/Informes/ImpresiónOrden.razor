@if (showModal)
{
    <div id="print" style="display:none">
        @for (int i = 0; i < cantPages; i++)
        {
            GetData(i);
            <Page Pedido=Pedido PageNum="i+1" CantPages="cantPages" ShouldPrint=@(ShouldPrint) Imprimir="Imprimir"
            Detalle="detalle" ShowProbadores=showProbadores />
        }
    </div>
}

@code {
    [Parameter, EditorRequired] public Orden Pedido { get; set; }
    [Parameter] public EventCallback Imprimir { get; set; }
    [Parameter] public List<OrdenDetalle> Detalle { get; set; }
    [Parameter] public List<OrdenDetalle>? Pendientes { get; set; } = null;
    [Parameter] public bool ShouldPrint { get; set; } = true;

    List<OrdenDetalle>? detalleCompleto = new();
    List<OrdenDetalle>? detalle = new();

    bool showModal, showProbadores;
    int cantPages = 0, lineasXPag = 49, aux;

    protected override void OnInitialized()
    {
        Console.WriteLine("CanDetalle " + Detalle.Count);

        detalleCompleto!.AddRange(Detalle);
        if (Pendientes != null)
        {
            detalleCompleto.AddRange(Pendientes);
            Console.WriteLine("CanPendientes " + Pendientes.Count);
        }

        int sumLineas = detalleCompleto.Count + 1;
        if (Pendientes != null && Pendientes.Any()) sumLineas++;

        bool anyDetalle = Detalle?.Any(x => x.CantidadProbador > 0) ?? false;
        bool anyPendiente = Pendientes?.Any(x => x.CantidadProbador > 0) ?? false;

        showProbadores = anyDetalle || anyPendiente;

        cantPages = sumLineas / lineasXPag;
        if (sumLineas % lineasXPag != 0 || cantPages == 0) cantPages++;

        showModal = true;
    }

    private void GetData(int page)
    {
        detalle = detalleCompleto!.Skip(page * lineasXPag)?.Take(lineasXPag).ToList();
    }

    // private void GetData(int page)
