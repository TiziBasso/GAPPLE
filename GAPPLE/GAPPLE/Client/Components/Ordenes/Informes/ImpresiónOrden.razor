@if (showModal)
{
    <div id="print" style="display:none">
        @for (int i = 0; i < cantPages; i++)
        {
            GetData(i);
            <Page Pedido=Pedido PageNum="i + 1" CantPages="cantPages" ShouldPrint=@(ShouldPrint) Imprimir="Imprimir"
                  Detalle="detalle" ShowProbadores=showProbadores ShowObsequios="showObsequios" />
        }
    </div>
}

@code {
    [Parameter, EditorRequired] public Orden Pedido { get; set; }
    [Parameter] public EventCallback Imprimir { get; set; }
    [Parameter] public List<OrdenDetalle> Detalle { get; set; }
    [Parameter] public List<OrdenDetalle> Pendientes { get; set; } = null;
    [Parameter] public bool ShouldPrint { get; set; } = true;

    List<OrdenDetalle> detalleCompleto = new();
    List<OrdenDetalle> detalle = new();

    bool showModal, showProbadores, showObsequios;
    int cantPages = 0, lineasXPag = 49, aux;

    protected override void OnInitialized()
    {
        detalleCompleto.AddRange(
            Detalle.Select(x => new OrdenDetalle()
            {
                Descripcion = x.Descripcion,
                NumeroLinea = x.NumeroLinea,
                CodProducto = x.CodProducto,
                Descuento = x.Descuento,
                Probador = x.Probador,

                Cantidad = x.CantidadAprobada,
                CantidadAprobada = x.CantidadAprobada,

                CantidadObsequio = x.CantidadObsequioAprobada,
                CantidadObsequioAprobada = x.CantidadObsequioAprobada,

                CantidadProbador = x.CantidadProbadorAprobada,
                CantidadProbadorAprobada = x.CantidadProbadorAprobada,
            })
        );

        // Pendientes
        if (Pendientes != null)
        {
            detalleCompleto.AddRange(
                Pendientes.Select(x => new OrdenDetalle()
                {
                    Descripcion = x.Descripcion,
                    NumeroLinea = x.NumeroLinea,
                    CodProducto = x.CodProducto,
                    Descuento = x.Descuento,
                    Probador = x.Probador,

                    Cantidad = x.Cantidad - x.CantidadAprobada,
                    CantidadAprobada = 0,

                    CantidadObsequio = x.CantidadObsequio - x.CantidadObsequioAprobada,
                    CantidadObsequioAprobada = 0,

                    CantidadProbador = x.CantidadProbador - x.CantidadProbadorAprobada,
                    CantidadProbadorAprobada = 0,
                })
            );
        }

        int sumLineas = detalleCompleto.Count + 1;
        if (Pendientes != null && Pendientes.Any()) sumLineas++;

        bool anyDetalleProb = Detalle?.Any(x => x.CantidadProbador > 0) ?? false;
        bool anyPendienteProb = Pendientes?.Any(x => x.CantidadProbador > 0) ?? false;
        showProbadores = anyDetalleProb || anyPendienteProb;

        bool anyDetalleObs = Detalle?.Any(x => x.CantidadObsequio > 0) ?? false;
        bool anyPendienteObs = Pendientes?.Any(x => x.CantidadObsequio > 0) ?? false;
        showObsequios = anyDetalleObs || anyPendienteObs;

        cantPages = sumLineas / lineasXPag;
        if (sumLineas % lineasXPag != 0 || cantPages == 0) cantPages++;

        showModal = true;
    }

    private void GetData(int page)
    {
        detalle = detalleCompleto!.Skip(page * lineasXPag)?.Take(lineasXPag).ToList();
    }

