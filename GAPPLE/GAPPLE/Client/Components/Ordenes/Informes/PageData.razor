<table style="border-collapse: collapse;width: 100%;">
    @if (Detalle != null && Detalle.Any())
    {
        <thead style="font-style: italic;">
            <tr>
                <th style="border:1px solid;border-right: none; padding: 5px;">#</th>
                <th style="border:1px solid;border-right: none; padding: 5px;">ID</th>
                <th style="border:1px solid;border-right: none;padding: 5px;">Producto</th>
                <th style="border:1px solid;border-right: none;padding: 5px;">Cantidad</th>
                <th style="border:1px solid;border-right: none;padding: 5px;">Descuento</th>
                @if (ShowProbadores)
                {
                    <th style="border:1px solid;padding: 5px;">Probador</th>
                }
                @if (ShowObsequios)
                {
                    <th style="border:1px solid;padding: 5px;">Obsequios</th>
                }
            </tr>
        </thead>
        <tbody style="font-size: 11pt;">
            @foreach (var item in Detalle)
            {
                i++;
                <tr>
                    <td style="text-align: end;">@(item.NumeroLinea != 0 ? item.NumeroLinea : i)</td>
                    <td style="text-align: end;">@item.CodProducto</td>
                    <td>@item.Descripcion</td>
                    <td style="text-align: end;">@item.CantidadAprobada</td>
                    <td style="text-align: end;">@item.Descuento %</td>
                    @if (ShowProbadores)
                    {
                        <td style="text-align: end;">@(item.CantidadProbadorAprobada != 0 ? item.CantidadProbadorAprobada : "")</td>
                    }
                    @if (ShowObsequios)
                    {
                        <td style="text-align: end;">@(item.CantidadObsequioAprobada != 0 ? item.CantidadObsequioAprobada : "")</td>
                    }
                </tr>
            }
            @* Total general del pedido (no de la hoja): solo en la hoja donde termina el listado de aprobados *@
            @if (TotalAprobados != null)
            {
                <tr style="border-top: 2px solid;">
                    <td colspan="2"></td>
                    <td colspan="2" style="text-align: end;"><strong>Total aprobados: @TotalAprobados.Cantidad</strong></td>
                    <td colspan="1"></td>
                    @if (ShowProbadores)
                    {
                        <td colspan="1" style="text-align: end;"><strong>@TotalAprobados.Probador</strong></td>
                    }
                    @if (ShowObsequios)
                    {
                        <td colspan="1" style="text-align: end;"><strong>@TotalAprobados.Obsequio</strong></td>
                    }
                </tr>
            }
        </tbody>
    }

    @if (Pendientes != null && Pendientes.Any())
    {
        i = 0;
        <tfoot style="font-style: italic;">
            <tr>
                <th colspan="6" style="border: 1px solid black;border-right: none;border-left: none;">PENDIENTES</th>
            </tr>
            @* <tr>
                <th style="border:1px solid;border-right: none; padding: 5px;">#</th>
                <th style="border:1px solid;border-right: none; padding: 5px;">ID</th>
                <th style="border:1px solid;border-right: none;padding: 5px;">Producto</th>
                <th style="border:1px solid;border-right: none;padding: 5px;">Cantidad</th>
                <th style="border:1px solid;border-right: none;padding: 5px;">Descuento</th>
                <th style="border:1px solid;padding: 5px;">Probador</th>
            </tr> *@
            @foreach (var item in Pendientes)
            {
                i++;
                <tr style="font-size: 11pt;">
                    <td style="text-align: end;">@(item.NumeroLinea != 0 ? item.NumeroLinea : i)</td>
                    <td style="text-align: end;">@item.CodProducto</td>
                    <td>@item.Descripcion</td>
                    <td style="text-align: end;">@item.CantidadPendiente</td>
                    <td style="text-align: end;">@item.Descuento %</td>
                    @if (ShowProbadores)
                    {
                        <td style="text-align: end;">@(item.CantidadProbadorPendiente != 0 ? item.CantidadProbadorPendiente : "")</td>
                    }
                    @if (ShowObsequios)
                    {
                        <td style="text-align: end;">@(item.CantidadObsequioPendiente != 0 ? item.CantidadObsequioPendiente : "")</td>
                    }
                </tr>
            }
            @* Total general de pendientes del pedido: solo en la hoja donde termina ese listado *@
            @if (TotalPendientes != null)
            {
                <tr style="border-top: 2px solid;">
                    <td colspan="2"></td>
                    <td colspan="2" style="text-align: end;"><strong>Total pendientes: @TotalPendientes.Cantidad</strong></td>
                    <td colspan="1"></td>
                    @if (ShowProbadores)
                    {
                        <td colspan="1" style="text-align: end;"><strong>@TotalPendientes.Probador</strong></td>
                    }
                    @if (ShowObsequios)
                    {
                        <td colspan="1" style="text-align: end;"><strong>@TotalPendientes.Obsequio</strong></td>
                    }
                </tr>
            }
        </tfoot>
    }
</table>
@code {
    [Parameter] public List<OrdenDetalle> Detalle { get; set; } = null;
    [Parameter] public List<OrdenDetalle> Pendientes { get; set; } = null;
    [Parameter] public bool ShowProbadores { get; set; } = false;
    [Parameter] public bool ShowObsequios { get; set; } = false;
    [Parameter] public TotalesImpresion TotalAprobados { get; set; }
    [Parameter] public TotalesImpresion TotalPendientes { get; set; }

    int i = 0;
}
