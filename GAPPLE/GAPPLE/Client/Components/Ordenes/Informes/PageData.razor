<table style="border-collapse: collapse;width: 100%;">
    @if (Detalle != null && Detalle.Any())
    {
        <thead style="font-style: italic;">
            <tr>
                <th style="border:1px solid;border-right: none; padding: 5px;">#</th>
                <th style="border:1px solid;border-right: none; padding: 5px;">ID</th>
                <th style="border:1px solid;border-right: none;padding: 5px;">Producto</th>
                <th style="border:1px solid;border-right: none;padding: 5px;">Cantidad</th>
                <th style="border:1px solid;border-right: none;padding: 5px;">Descuento</th>
                <th style="border:1px solid;padding: 5px;">Probador</th>
            </tr>
        </thead>
        <tbody style="font-size: 11pt;">
            @foreach (var item in Detalle)
            {
                @(i++)
                <tr>
                    <td style="text-align: end;">@(item.NumeroLinea != 0 ? item.NumeroLinea : i)</td>
                    <td style="text-align: end;">@item.CodProducto</td>
                    <td>@item.Descripcion</td>
                    <td style="text-align: end;">@item.Cantidad</td>
                    <td style="text-align: end;">@item.Descuento %</td>
                    <td></td>
                </tr>
            }
            <tr>
                <td colspan="2"></td>
                <td colspan="2" style="text-align: end;">Total: @Detalle.Sum(x => x.Cantidad)</td>
                <td colspan="2"></td>
            </tr>
        </tbody>
    }
    @if (Pendientes != null && Pendientes.Any())
    {
        @(i = 0)
        <tfoot style="font-style: italic;">
            <tr>
                <th colspan="6" style="border: 1px solid black;border-right: none;border-left: none;">PENDIENTES</th>
            </tr>
            @foreach (var item in Pendientes)
            {
                @(i++)
                <tr style="font-size: 11pt;">
                    <td style="text-align: end;">@(item.NumeroLinea != 0 ? item.NumeroLinea : i)</td>
                    <td style="text-align: end;">@item.CodProducto</td>
                    <td>@item.Descripcion</td>
                    <td style="text-align: end;">@item.CantidadPendiente</td>
                    <td colspan="2"></td>
                </tr>
            }
        </tfoot>
    }
</table>
@code {
    [Parameter] public List<OrdenDetalle>? Detalle { get; set; } = null;
    [Parameter] public List<OrdenDetalle>? Pendientes { get; set; } = null;

    int i = 0;
}
