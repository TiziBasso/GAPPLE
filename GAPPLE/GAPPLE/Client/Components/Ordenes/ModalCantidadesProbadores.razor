@inject DialogService DialogService
@inject NotificationService NotificationService


<RadzenDataGrid TItem="OrdenDetalle" Data="Detalle!.Where(x=>x.Probador || x.TieneObsequio)" Density="Density.Compact">
    <Columns>
        <RadzenDataGridColumn TItem="OrdenDetalle" Property="@nameof(OrdenDetalle.CodProducto)" Title="Producto" />
        <RadzenDataGridColumn TItem="OrdenDetalle" Width="140px" Title="Cant. probador">
            <Template>
                <RadzenNumeric @bind-Value=context.CantidadProbador ShowUpDown=false Min="0" Style="width:100%;padding-right:10px;" TextAlign="TextAlign.Right" Disabled=@(!context.Probador) InputAttributes="@(new Dictionary<string, object>() { { "style", "width:100% !important;" } })" />
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="OrdenDetalle" Width="140px" Title="Cant. obsequio">
            <Template>
                <RadzenNumeric @bind-Value=context.CantidadObsequio ShowUpDown=false Min="0" Style="width:100%;padding-right:10px;" TextAlign="TextAlign.Right" InputAttributes="@(new Dictionary<string, object>() { { "style", "width:100% !important;" } })" />
            </Template>
        </RadzenDataGridColumn>
    </Columns>
</RadzenDataGrid>

<RadzenStack JustifyContent="JustifyContent.Center" Gap="3rem" Orientation="Orientation.Horizontal" class="rz-mt-2">
    <RadzenButton ButtonStyle="ButtonStyle.Danger" Icon="cancel" Text="Cancelar" Click="Cancelar" />
    <RadzenButton ButtonStyle="ButtonStyle.Success" Icon="save" Text="Guardar" Click="Guardar" />
</RadzenStack>


@code {
    [Parameter, EditorRequired] public List<OrdenDetalle> Detalle { get; set; }

    private bool Validar()
    {
        bool valido = true;

        if (Detalle.Where(x => x.Probador || x.TieneObsequio).Any(x => x.CantidadProbador == 0 && x.CantidadObsequio == 0))
        {
            NotificationService.Notify(NotificationSeverity.Info, "Hay productos sin cantidades", "Revise los datos cargados");
            valido = false;
        }

        return valido;
    }

    private async Task Guardar()
    {
        if (Validar() && await DialogService.Confirm(MensajesHelper.Confirm(), MensajesHelper.Title, new() { OkButtonText = "Sí", CancelButtonText = "No" }) == true)
            DialogService.Close(true);
    }

    private async Task Cancelar()
    {
        if (await DialogService.Confirm(MensajesHelper.Confirm("cancelar"), MensajesHelper.Title, new() { OkButtonText = "Sí", CancelButtonText = "No" }) == true)
            DialogService.Close(false);
    }
}