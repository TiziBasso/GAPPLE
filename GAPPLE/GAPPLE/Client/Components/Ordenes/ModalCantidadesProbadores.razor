@inject DialogService DialogService

@if (showComponent)
{
    <RadzenDataGrid TItem="OrdenDetalle" Data="Detalle" Density="Density.Compact">
        <Columns>
            <RadzenDataGridColumn TItem="OrdenDetalle" Property="@nameof(OrdenDetalle.CodProducto)" Title="Producto" />
            <RadzenDataGridColumn TItem="OrdenDetalle" Width="80px" Title="Cantidad">
                <Template>
                    <RadzenNumeric @bind-Value=context.CantidadProbador ShowUpDown=false Min="1" Style="width:100%" TextAlign="TextAlign.Right" />
                </Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>

    <RadzenStack JustifyContent="JustifyContent.Center" Gap="3rem" Orientation="Orientation.Horizontal" class="rz-mt-2">
        <RadzenButton ButtonStyle="ButtonStyle.Danger" Icon="cancel" Text="Cancelar" Click="Cancelar" />
        <RadzenButton ButtonStyle="ButtonStyle.Success" Icon="save" Text="Guardar" Click="Guardar" />
    </RadzenStack>

}
else
{
    <Loader />
}


@code {
    [Parameter, EditorRequired] public List<OrdenDetalle> Detalle { get; set; }

    bool showComponent;

    protected override void OnInitialized()
    {
        foreach (var item in Detalle)
            if (item.CantidadProbador == 0)
                item.CantidadProbador = 1;
        showComponent = true;
    }

    private async Task Guardar()
    {
        if (await DialogService.Confirm(MensajesHelper.Confirm(), MensajesHelper.Title, new() { OkButtonText = "Sí", CancelButtonText = "No" }) == true)
            DialogService.Close(true);
    }

    private async Task Cancelar()
    {
        if (await DialogService.Confirm(MensajesHelper.Confirm("cancelar"), MensajesHelper.Title, new() { OkButtonText = "Sí", CancelButtonText = "No" }) == true)
            DialogService.Close(false);
    }
}
