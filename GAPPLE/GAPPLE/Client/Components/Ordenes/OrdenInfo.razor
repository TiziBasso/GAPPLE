</RadzenRow>
<RadzenRow Style="margin-top:10px;">
    <RadzenDataGrid Data="ordenDetail" EmptyText="No hay registros para mostrar">
        <Columns>
            <RadzenDataGridColumn TItem="OrdenDetail" Title="#" Property="@nameof(OrdenDetail.Linea)" />
            <RadzenDataGridColumn TItem="OrdenDetail" Title="ID" Property="@nameof(OrdenDetail.ID)" />
            <RadzenDataGridColumn TItem="OrdenDetail" Title="Producto" Property="@nameof(OrdenDetail.Producto)" />
            <RadzenDataGridColumn TItem="OrdenDetail" Title="Cantidad" Property="@nameof(OrdenDetail.Cantidad)" />
            <RadzenDataGridColumn TItem="OrdenDetail" Title="Descuento" Property="@nameof(OrdenDetail.Descuento)" />
            <RadzenDataGridColumn TItem="OrdenDetail" Title="Probador" Property="@nameof(OrdenDetail.Probador)" />
        </Columns>
    </RadzenDataGrid>
</RadzenRow>
<RadzenRow Style="margin-top:10px;" JustifyContent="JustifyContent.Center">
    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.Center">
        <RadzenButton Text="Cancelar" Icon="cancel" ButtonStyle="ButtonStyle.Danger" />
        <RadzenButton Text="Imprimir" Icon="print" ButtonStyle="ButtonStyle.Primary" />
    </RadzenStack>
</RadzenRow>

@code {
    List<OrdenDetail> ordenDetail = new();

    protected override void OnInitialized()
    {
        ordenDetail.Add(new OrdenDetail()
            {
                Linea = 1,
                ID = 025280,
                Producto = "Sh. T.Vitae Neutro",
                Cantidad = 156,
                Descuento = 6
            });
        ordenDetail.Add(new OrdenDetail()
            {
                Linea = 2,
                ID = 032922,
                Producto = "T.VITAE-Oxig.Cr.30 Vol.x 850ml",
                Cantidad = 1268,
                Descuento = 6
            });
    }

    class OrdenDetail
    {
        public int Linea { get; set; }
        public int ID { get; set; }
        public string Producto { get; set; }
        public int Cantidad { get; set; }
        public int Descuento { get; set; }
        public int? Probador { get; set; }

    }
}
