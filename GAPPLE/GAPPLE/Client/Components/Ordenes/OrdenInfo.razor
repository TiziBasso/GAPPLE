                    <RadzenStack Orientation="Orientation.Horizontal">
                        <strong>Condición:</strong>
                        <RadzenText Text="Inscripto" />
                    </RadzenStack>
                </RadzenColumn>
            </RadzenRow>
        </RadzenFieldset>
        <RadzenFieldset Text="Datos de la orden" AllowCollapse="true">
