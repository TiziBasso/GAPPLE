<RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.Center" Gap="2rem" class="rz-mt-4">
    <RadzenButton ButtonStyle="ButtonStyle.Danger" Icon="cancel" Text="Cancelar" Click="Cancelar" />
    <RadzenButton ButtonStyle="ButtonStyle.Success" Icon="file_upload" Text="Procesar" Click="Procesar" />
</RadzenStack>

@code {
    /// <summary>Código de cliente para aplicar descuentos por artículo. Opcional.</summary>
    [Parameter] public string CodCliente { get; set; }

    /// <summary>Código de lista de precios para calcular precios del servidor. Opcional.</summary>
    [Parameter] public string CodListaPrecio { get; set; }

    /// <summary>IDs de ofertas seleccionadas separados por coma. Opcional.</summary>
    [Parameter] public string OfertasSeleccionadas { get; set; }

    [Parameter] public EventCallback<List<ProductoArchivo>> Callback { get; set; }

    IBrowserFile file;
    bool isLoading;
    CustomFileInput refCustom;
    ByteArrayRequest request = new();

    private async Task Procesar()
    {
        if (file == null)
        {
            NotificationService.Notify(NotificationSeverity.Info, "Debe ingresar un archivo");
            return;
        }

        isLoading = true;
        RadzenDialogService.OpenProgressBar("Procesando archivo");
        await SignalRService.StartConnection();

        request.CodListaPrecio = CodListaPrecio ?? string.Empty;
        request.CodCliente = CodCliente ?? string.Empty;
        request.ConnectionId = SignalRService.GetConnectionId();
        request.OfertasSeleccionadas = OfertasSeleccionadas;

        using var stream = file.OpenReadStream();
        using var ms = new MemoryStream();
        await stream.CopyToAsync(ms);
        request.File = ms.ToArray();

        var response = await ProductosService.ProcesarArchivo(request);
        RadzenDialogService.CloseDialog();

        if (response.IsOk)
        {
            if (Callback.HasDelegate)
                await Callback.InvokeAsync((List<ProductoArchivo>)response.Data);
            else
                DialogService.Close((List<ProductoArchivo>)response.Data);
        }
        else if (response.Errors != null && response.Errors.Count > 0)
            RadzenDialogService.ShowAlert(response.Errors);
        else
            RadzenDialogService.NotifyInternalServerError();

        isLoading = false;
    }

    private async Task DownloadTemplate()
    {
        RadzenDialogService.OpenBusy("Descargando...");
        await FileService.DownloadTemplate(["Cód. del producto", "Cantidad", "Probadores", "Obsequios"], "Productos");
        RadzenDialogService.CloseDialog();
    }

    private void Cancelar() => DialogService.Close(null);

    public async ValueTask DisposeAsync()
    {
        await SignalRService.StopConnection();
    }
}
