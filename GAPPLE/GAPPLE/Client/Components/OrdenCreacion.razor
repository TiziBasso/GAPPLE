<div class="OrdenForm" style="display: grid;gap: 12px;grid-template-columns: repeat(4, 1fr);">
    <RadzenStack>
        <RadzenLabel Text="Línea:" />
        <RadzenDropDown Data="lstLineas" @bind-Value="valorAux" Change="BuscarProductos" Disabled=DisabledInputs Style="width:15rem" />
    </RadzenStack>
    <RadzenStack>
        <RadzenLabel Text="Cliente:" />
        <RadzenTextBox />
    </RadzenStack>
    <RadzenStack>
        <RadzenLabel Text="Zona:" />
        <RadzenTextBox />
    </RadzenStack>
    <RadzenStack>
        <RadzenLabel Text="Lista de precios:" />
        <RadzenTextBox />
    </RadzenStack>
    <RadzenStack Orientation="Orientation.Horizontal" Gap="0">
        <RadzenLabel Text="F:" />
        <RadzenCheckBox @bind-Value="@F" />
    </RadzenStack>
    <RadzenStack Orientation="Orientation.Horizontal" Gap="0">
        <RadzenLabel Text="P:" />
        <RadzenCheckBox @bind-Value="@P" />
    </RadzenStack>
    <RadzenStack>
        <RadzenLabel Text="Transporte:" />
        <RadzenTextBox />
    </RadzenStack>
    <RadzenStack>
        <RadzenLabel Text="Cód.Trans:" />
        <RadzenTextBox />
    </RadzenStack>
    <RadzenStack>
        <RadzenLabel Text="Cond.Venta:" />
        <RadzenTextBox />
    </RadzenStack>
    <RadzenStack>
        <RadzenLabel Text="Entregar en:" />
        <RadzenTextBox />
    </RadzenStack>
    <RadzenStack Orientation="Orientation.Vertical">
        <RadzenStack Orientation="Orientation.Horizontal" Gap="0">
            <RadzenLabel Text="Probadores:" />
            <RadzenCheckBox @bind-Value="@probadores" />
        </RadzenStack>
        <RadzenStack Orientation="Orientation.Horizontal" Gap="0">
            <RadzenLabel Text="Obsequios/CartasColores/Desc.Extra:" />
            <RadzenCheckBox @bind-Value="@obsequios" />
        </RadzenStack>
        <RadzenStack Orientation="Orientation.Horizontal" Gap="0">
            <RadzenLabel Text="Multitester/Exhibidor:" />
            <RadzenCheckBox @bind-Value="@exhibidor" />
        </RadzenStack>
    </RadzenStack>
    <RadzenStack>
        <RadzenLabel Text="Notas:" />
        <RadzenTextArea />
    </RadzenStack>
    <RadzenStack>
        <RadzenLabel Text="Ofertas:" />
        <RadzenTextBox />
    </RadzenStack>
    <RadzenStack>
        <RadzenLabel Text="F.Entrega:" />
        <RadzenTextBox />
    </RadzenStack>
</div>

<div class="OrdenProductos" style="margin-top: 15px;display: grid; grid-template-columns: repeat(auto-fill,minmax(180px,1fr))">
    @for (int i = 0; i < 25; i++)
    {
        int columnaActual = i;
        <RadzenCard Style="border-radius:0;padding:0;">
            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.Center" Gap="1rem" Style="border-bottom: 1px solid rgba(0, 0, 0, .2);padding-top: .5rem;">
                Familia
            </RadzenStack>
            <RadzenStack Orientation="Orientation.Vertical" Gap="0" Style="padding:1rem;">
                @for (int j = 0; j < random.Next(3, 9); j++)
                {
                    bool check = false;
                    string inputId = $"input_{columnaActual}_{j}";

                    <RadzenStack Style="font-size:smaller;" Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween">
                        <span>@random.Next(1000000, 10000000)</span>
                        <RadzenStack Orientation="Orientation.Horizontal" Gap="0" AlignItems="AlignItems.Center">
                            <input type="number" id="@inputId" class="inputTable" />
                            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0">
                                <RadzenCheckBox @bind-Value="check" />
                                <RadzenLabel />
                            </RadzenStack>
                        </RadzenStack>
                        <span>%</span>
                    </RadzenStack>
                }
            </RadzenStack>
        </RadzenCard>
    }
</div>

@code {
    [Parameter] public bool DisabledInputs { get; set; }
    Random random = new Random();
    bool F, P, probadores, obsequios, exhibidor;
    private int fila = 0, columna = 0;
    List<string> lstLineas = new();
    string valorAux;

    async Task BuscarProductos()
    {
        Oferta.Linea = valorAux;
        lstProductosOferta = new();
        lstProductos = await ProductosService.GetProductosParaOfertas(Oferta.Linea);
        lstProductos = lstProductos.OrderBy(x => x.Familia).ToList();
    }
}
