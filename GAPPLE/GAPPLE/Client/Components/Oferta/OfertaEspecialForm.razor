@inject ProductosService ProductosService
@inject OfertasService OfertasService
@inject ClientesService ClientesService
@inject DialogService DialogService
@inject NotificationService NotificationService

@if (showForm)
{
    <RadzenTemplateForm EditContext="editContext" Data="Oferta" TItem="Oferta" Submit="Guardar">

        <DataAnnotationsValidator />

        <RadzenStack Style="width:100%" Orientation="Orientation.Horizontal" Gap="10px" Wrap="FlexWrap.Wrap" class="rz-mb-2">
            <RadzenStack Orientation="Orientation.Vertical" Gap="5px">
                <RadzenLabel Text="Nombre:" />
                <RadzenTextBox @bind-Value="Oferta.Nombre" Disabled=DisabledInputs Style="width:15rem" />
                <ValidationMessage For="@(() => Oferta.Nombre)" />
            </RadzenStack>

            <RadzenStack Orientation="Orientation.Vertical" Gap="5px">
                <RadzenLabel Text="Linea:" />
                <RadzenDropDown Data="lstLineas" @bind-Value="valorAux" Change="BuscarProductos" Disabled=DisabledInputs Style="width:15rem" />
                <ValidationMessage For="@(() => Oferta.Linea)" />
            </RadzenStack>

            <RadzenStack Orientation="Orientation.Vertical" Gap="5px">
                <RadzenLabel Text="Descuento:" />
                <RadzenNumeric TValue="decimal" @bind-Value="Oferta.Descuento" TextAlign="TextAlign.Right" Min="0" Max="100"
                               ShowUpDown="false" Disabled=DisabledInputs Format="N1" Style="width:10rem" />
                <ValidationMessage For="@(() => Oferta.Descuento)" />
            </RadzenStack>

            <RadzenStack Orientation="Orientation.Vertical" Gap="5px">
                <RadzenLabel Text="Fecha desde:" />
                <RadzenDatePicker @bind-Value="Oferta.Desde" Disabled=DisabledInputs DateFormat="dd/MM/yyyy" Min="DateTime.Today.AddDays(-7)" Style="width:10rem" />
                <ValidationMessage For="@(() => Oferta.Desde)" />
            </RadzenStack>

            <RadzenStack Orientation="Orientation.Vertical" Gap="5px">
                <RadzenLabel Text="Fecha hasta:" />
                <RadzenDatePicker @bind-Value="Oferta.Hasta" Disabled=DisabledInputs DateFormat="dd/MM/yyyy" Min="DateTime.Today" Style="width:10rem" />
                <ValidationMessage For="@(() => Oferta.Hasta)" />
            </RadzenStack>
        </RadzenStack>

        <RadzenStack Orientation="Orientation.Vertical" Gap="5px" Style="width:45%;">
            <RadzenLabel Text="Cliente:" />
            <RadzenDropDown @bind-Value="Oferta.CodCliente" Data="clientes" TextProperty="@nameof(Cliente.RazonSocial)" ValueProperty="@nameof(Cliente.CodigoCliente)"
                            AllowFiltering="true" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" Disabled=DisabledInputs />
        </RadzenStack>

        <RadzenStack Orientation="Orientation.Vertical" Gap="5px" Style="width:100%" class="rz-mb-2">
            <RadzenLabel Text="Detalle:" />
            <RadzenTextArea @bind-Value="Oferta.Descripcion" Disabled=DisabledInputs MaxLength="250" Rows="3" Style="width:100%; resize:none;" />
            <ValidationMessage For="@(() => Oferta.Descripcion)" />
        </RadzenStack>

        <RadzenFieldset Text="Productos" class="rz-mb-2">
            <PickList ProductosIzquierda="lstProductos" ProductosDerecha="lstProductosOferta" DisabledInputs=DisabledInputs />
            <RadzenCustomValidator Text="Debe seleccionar al menos un producto" Validator="Validator" />
        </RadzenFieldset>

        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceAround">
            @if (DisabledInputs)
            {
                <RadzenButton Icon="arrow_back" Text="Volver" ButtonStyle="ButtonStyle.Danger" Click="Cancelar" />
            }
            else
            {
                <RadzenButton Icon="cancel" Text="Cancelar" ButtonStyle="ButtonStyle.Danger" Click="Cancelar" />
                <RadzenButton Icon="save" Text="Guardar" ButtonStyle="ButtonStyle.Success" ButtonType="ButtonType.Submit" />
            }
        </RadzenStack>
    </RadzenTemplateForm>
}
else
{
    <Loader />
}

@code {
    [Parameter] public Oferta Oferta { get; set; }
    [Parameter] public bool DisabledInputs { get; set; }
    List<Cliente> clientes = new();
    List<ProductoParaOfertas> lstProductos = new List<ProductoParaOfertas>();
    List<ProductoParaOfertas> lstProductosOferta = new List<ProductoParaOfertas>();
    List<string> lstLineas = new();
    EditContext editContext;
    bool showForm;

    string valorAux;

    bool esNueva;

    protected override async Task OnInitializedAsync()
    {
        lstLineas = await ProductosService.GetLineas();
        clientes = await ClientesService.GetClientes();
        if (Oferta.IdOferta > 0)
        {
            valorAux = Oferta.Linea;
            await BuscarProductos();
            List<string> incluidos = Oferta.Inclusiones!.Split('|').ToList();
            lstProductosOferta.AddRange(lstProductos.Where(x => incluidos.Exists(e => e == x.CodigoProducto)));
            lstProductosOferta.ForEach(x => lstProductos.Remove(x));
        }
        else
            esNueva = true;

        editContext = new(Oferta);
        showForm = true;
    }

    async Task BuscarProductos()
    {
        if (lstProductosOferta.Any())
        {
            if (await DialogService.Confirm("Si cambia de linea se eliminaran los productos ingresados ¿desea continuar?", "ATENCIÓN", new() { OkButtonText = "Sí", CancelButtonText = "No" }) == true)
            {
                Oferta.Linea = valorAux;
                lstProductosOferta = new();
                lstProductos = await ProductosService.GetProductosParaOfertas(Oferta.Linea);
                lstProductos = lstProductos.OrderBy(x => x.Familia).ToList();
            }
            else
                valorAux = Oferta.Linea;
        }
        else
        {
            Oferta.Linea = valorAux;
            lstProductos = await ProductosService.GetProductosParaOfertas(Oferta.Linea);
            lstProductos = lstProductos.OrderBy(x => x.Familia).ToList();
        }
    }

    private bool Validator()
    {
        if (!lstProductosOferta.Any())
            return false;

        return true;
    }

    async Task Cancelar()
    {
        if (!editContext.IsModified() || await DialogService.Confirm(MensajesHelper.Confirm("cancelar"), MensajesHelper.Title, new() { OkButtonText = "Sí", CancelButtonText = "No" }) == true)
            DialogService.Close();
    }

    async Task Guardar()
    {
        Oferta.Inclusiones = string.Join('|', lstProductosOferta.Select(x => x.CodigoProducto));
        if (esNueva)
        {
            Oferta.Hasta = Oferta.Hasta.AddHours(23).AddMinutes(59).AddSeconds(59) ;
            await OfertasService.PostOfertaEspecial(Oferta);
            NotificationService.Notify(NotificationSeverity.Success, MensajesHelper.Title, MensajesHelper.SaveSuccess(Oferta.Nombre));
        }
        else
        {
            await OfertasService.PutOfertaEspecial(Oferta);
            NotificationService.Notify(NotificationSeverity.Success, MensajesHelper.Title, MensajesHelper.SaveSuccess(Oferta.Nombre));
        }
        DialogService.Close(Oferta);
    }
}

