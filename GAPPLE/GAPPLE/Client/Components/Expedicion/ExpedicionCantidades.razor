@inject DialogService DialogService
@inject OrdenesService OrdenesService

@if (showComponent)
{
    <RadzenStack Orientation="Orientation.Horizontal" Gap="1rem" Style="font-size:small" class="rz-mb-2">
        <RadzenText Text="@("Pedidos " + orden.IdPedidos)" />
        <RadzenText Text="@("Tango " + orden.CodTango != string.Empty ? orden.CodTango:orden.IdPedidos.Contains(",") ? "NO - NO":"NO")" />
        <RadzenText Text="@("Fecha " + orden.Fecha.ToString("dd/MM/yyyy"))" />
    </RadzenStack>

    <RadzenStack Orientation="Orientation.Vertical" Gap="10px" class="rz-mb-2">
        <RadzenStack Orientation="Orientation.Horizontal" Gap="3rem">
            <RadzenText><strong>Cliente: </strong> @orden.RazonSocial </RadzenText>
            <RadzenText><strong>CUIT: </strong> @orden.CUIT </RadzenText>
            <RadzenText><strong>Vendedor: </strong> @orden.Vendedor </RadzenText>
            <RadzenText><strong>Categoría IVA: </strong> @orden.CondicionIVA </RadzenText>
        </RadzenStack>
    </RadzenStack>

    <RadzenStack Orientation="Orientation.Vertical" Gap="10px" class="rz-mb-2">
        <RadzenStack Orientation="Orientation.Horizontal" Gap="3rem">
            <RadzenText><strong>Fecha de entrega: </strong> @orden.FechaEntrega.ToString("dd/MM/yyyy") </RadzenText>
            <RadzenText><strong>Lugar de entrega: </strong> @orden.EntregarEn </RadzenText>
            <RadzenText><strong>Transporte: </strong> @orden.Transporte </RadzenText>
            <RadzenText><strong>Zona: </strong> @orden.Zona) </RadzenText>
        </RadzenStack>
    </RadzenStack>
    <RadzenStack Orientation="Orientation.Vertical" Gap="10px" class="rz-mb-2">
        <RadzenStack Orientation="Orientation.Horizontal" Gap="3rem">
            <RadzenText><strong>Observaciones: </strong> @orden.Observaciones </RadzenText>
        </RadzenStack>
    </RadzenStack>

    <RadzenDataGrid TItem=OrdenExpedicionDetalle Data="orden.Detalle" Style="height:fit-content; max-height:30vh">
        <Columns>
            <RadzenDataGridColumn TItem="OrdenExpedicionDetalle" Property="@nameof(OrdenExpedicionDetalle.NumLinea)" TextAlign=TextAlign.Right Title="Item" Width="30px" />
            <RadzenDataGridColumn TItem="OrdenExpedicionDetalle" Property="@nameof(OrdenExpedicionDetalle.CodProducto)" TextAlign=TextAlign.Right Title="Cód." Width="90px" />
            <RadzenDataGridColumn TItem="OrdenExpedicionDetalle" Property="@nameof(OrdenExpedicionDetalle.DescripcionProducto)" TextAlign=TextAlign.Right Title="Producto" Width="90px">
                <FooterTemplate>
                    <RadzenText TextAlign=TextAlign.Right><strong>TOTAL:</strong></RadzenText>
                </FooterTemplate>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="OrdenExpedicionDetalle" Property="@nameof(OrdenExpedicionDetalle.CantidadF)" TextAlign=TextAlign.Right Title="F" Width="50px" Visible=showF>
                <FooterTemplate>
                    <RadzenText TextAlign=TextAlign.Right>@orden.Detalle.Sum(x => x.CantidadF)</RadzenText>
                </FooterTemplate>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="OrdenExpedicionDetalle" Property="@nameof(OrdenExpedicionDetalle.CantidadX)" TextAlign=TextAlign.Right Title="X" Width="50px" Visible=showX>
                <FooterTemplate>
                    <RadzenText TextAlign=TextAlign.Right>@orden.Detalle.Sum(x => x.CantidadX)</RadzenText>
                </FooterTemplate>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="OrdenExpedicionDetalle" Title="T" TextAlign=TextAlign.Right Width="50px" Visible=@(showX && showF)>
                <Template>
                    <strong>@(context.CantidadAprobada)</strong>
                </Template>
                <FooterTemplate>
                    <RadzenText TextAlign=TextAlign.Right><strong>@((orden.Detalle.Sum(x => x.CantidadF) + orden.Detalle.Sum(x => x.CantidadX)).ToString())</strong></RadzenText>
                </FooterTemplate>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="OrdenExpedicionDetalle" Property="@nameof(OrdenExpedicionDetalle.CantidadProbadorF)" TextAlign=TextAlign.Right Title="Probadores F" Width="100px" Visible=showF>
                <FooterTemplate>
                    <RadzenText TextAlign=TextAlign.Right>@orden.Detalle.Sum(x => x.CantidadProbadorF)</RadzenText>
                </FooterTemplate>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="OrdenExpedicionDetalle" Property="@nameof(OrdenExpedicionDetalle.CantidadProbadorX)" TextAlign=TextAlign.Right Title="Probadores X" Width="100px" Visible=showX>
                <FooterTemplate>
                    <RadzenText TextAlign=TextAlign.Right>@orden.Detalle.Sum(x => x.CantidadProbadorX)</RadzenText>
                </FooterTemplate>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="OrdenExpedicionDetalle" TextAlign=TextAlign.Right Title="Probadores totales" Width="140px" Visible=@(showX && showF)>
                <Template>
                    <strong>@(context.CantidadProbador - context.CantidadProbadorCancelada)</strong>
                </Template>
                <FooterTemplate>
                    <RadzenText TextAlign=TextAlign.Right><strong>@(orden.Detalle.Sum(x => x.CantidadProbadorF) + orden.Detalle.Sum(x => x.CantidadProbadorX))</strong></RadzenText>
                </FooterTemplate>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="OrdenExpedicionDetalle" TextAlign=TextAlign.Center Width="35px" Frozen=true FrozenPosition="FrozenColumnPosition.Right">
                <Template>
                    <RadzenButton Size="ButtonSize.ExtraSmall" Icon="arrow_downward" ButtonStyle="ButtonStyle.Info" />
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="OrdenExpedicionDetalle" TextAlign=TextAlign.Center Width="35px" Frozen=true FrozenPosition="FrozenColumnPosition.Right">
                <Template>
                    <RadzenButton Size="ButtonSize.ExtraSmall" Icon="edit" ButtonStyle="ButtonStyle.Warning" />
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="OrdenExpedicionDetalle" TextAlign=TextAlign.Center Width="35px" Frozen=true FrozenPosition="FrozenColumnPosition.Right">
                <Template>
                    <RadzenButton Size="ButtonSize.ExtraSmall" Icon="cancel" ButtonStyle="ButtonStyle.Danger" />
                </Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>

    <RadzenText Text="Pendientes" class="rz-mb-2 rz-mt-2" TextStyle="TextStyle.DisplayH5" Style="color:var(--rz-text-disabled-color)" />

    <RadzenDataGrid TItem=OrdenExpedicionDetalle Data="orden.Detalle" Style="height:fit-content; max-height:30vh">
        <Columns>
            <RadzenDataGridColumn TItem="OrdenExpedicionDetalle" Property="@nameof(OrdenExpedicionDetalle.NumLinea)" TextAlign=TextAlign.Right Title="Item" Width="30px" />
            <RadzenDataGridColumn TItem="OrdenExpedicionDetalle" Property="@nameof(OrdenExpedicionDetalle.CodProducto)" TextAlign=TextAlign.Right Title="Cód." Width="90px" />
            <RadzenDataGridColumn TItem="OrdenExpedicionDetalle" Property="@nameof(OrdenExpedicionDetalle.DescripcionProducto)" TextAlign=TextAlign.Right Title="Producto" Width="90px">
                <FooterTemplate>
                    <RadzenText TextAlign=TextAlign.Right><strong>TOTAL:</strong></RadzenText>
                </FooterTemplate>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="OrdenExpedicionDetalle" Property="@nameof(OrdenExpedicionDetalle.CantidadF)" TextAlign=TextAlign.Right Title="F" Width="50px" Visible=showF>
                <FooterTemplate>
                    <RadzenText TextAlign=TextAlign.Right>@orden.Detalle.Sum(x => x.CantidadF)</RadzenText>
                </FooterTemplate>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="OrdenExpedicionDetalle" Property="@nameof(OrdenExpedicionDetalle.CantidadX)" TextAlign=TextAlign.Right Title="X" Width="50px" Visible=showX>
                <FooterTemplate>
                    <RadzenText TextAlign=TextAlign.Right>@orden.Detalle.Sum(x => x.CantidadX)</RadzenText>
                </FooterTemplate>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="OrdenExpedicionDetalle" Title="T" TextAlign=TextAlign.Right Width="50px" Visible=@(showX && showF)>
                <Template>
                    <strong>@(context.Cantidad - context.CantidadAprobada)</strong>
                </Template>
                <FooterTemplate>
                    <RadzenText TextAlign=TextAlign.Right><strong>@((orden.Detalle.Sum(x => x.CantidadF) + orden.Detalle.Sum(x => x.CantidadX)).ToString())</strong></RadzenText>
                </FooterTemplate>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="OrdenExpedicionDetalle" Property="@nameof(OrdenExpedicionDetalle.CantidadProbadorF)" TextAlign=TextAlign.Right Title="Probadores F" Width="100px" Visible=showF>
                <FooterTemplate>
                    <RadzenText TextAlign=TextAlign.Right>@orden.Detalle.Sum(x => x.CantidadProbadorF)</RadzenText>
                </FooterTemplate>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="OrdenExpedicionDetalle" Property="@nameof(OrdenExpedicionDetalle.CantidadProbadorX)" TextAlign=TextAlign.Right Title="Probadores X" Width="100px" Visible=showX>
                <FooterTemplate>
                    <RadzenText TextAlign=TextAlign.Right>@orden.Detalle.Sum(x => x.CantidadProbadorX)</RadzenText>
                </FooterTemplate>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="OrdenExpedicionDetalle" TextAlign=TextAlign.Right Title="Probadores totales" Width="140px" Visible=@(showX && showF)>
                <Template>
                    <strong>@(context.CantidadCancelada)</strong>
                </Template>
                <FooterTemplate>
                    <RadzenText TextAlign=TextAlign.Right><strong>@(orden.Detalle.Sum(x => x.CantidadProbadorF) + orden.Detalle.Sum(x => x.CantidadProbadorX))</strong></RadzenText>
                </FooterTemplate>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="OrdenExpedicionDetalle" TextAlign=TextAlign.Center Width="35px" Frozen=true FrozenPosition="FrozenColumnPosition.Right">
                <Template>
                    <RadzenButton Size="ButtonSize.ExtraSmall" Icon="arrow_upward" ButtonStyle="ButtonStyle.Info" />
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="OrdenExpedicionDetalle" TextAlign=TextAlign.Center Width="35px" Frozen=true FrozenPosition="FrozenColumnPosition.Right">
                <Template>
                    <RadzenButton Size="ButtonSize.ExtraSmall" Icon="edit" ButtonStyle="ButtonStyle.Warning" />
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="OrdenExpedicionDetalle" TextAlign=TextAlign.Center Width="35px" Frozen=true FrozenPosition="FrozenColumnPosition.Right">
                <Template>
                    <RadzenButton Size="ButtonSize.ExtraSmall" Icon="cancel" ButtonStyle="ButtonStyle.Danger" />
                </Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>


    <RadzenStack JustifyContent="JustifyContent.Center" Gap="3rem" Orientation="Orientation.Horizontal" class="rz-mt-2">
        <RadzenButton ButtonStyle="ButtonStyle.Danger" Icon="cancel" Text="Cancelar" Click="Cancelar" />
        <RadzenButton ButtonStyle="ButtonStyle.Success" Icon="save" Text="Guardar" Click="Guardar" />
    </RadzenStack>
}
else
{
    <Loader />
}

@code {
    [Parameter] public string IdOrden { get; set; }

    OrdenExpedicion orden;

    bool showComponent, showX, showF;

    protected override async Task OnInitializedAsync()
    {
        orden = await OrdenesService.GetOrdenExpedicion(IdOrden);
        showX = orden.Detalle.Sum(x => x.CantidadX + x.CantidadProbadorX) > 0;
        showF = orden.Detalle.Sum(x => x.CantidadF + x.CantidadProbadorF) > 0;
        showComponent = true;
    }

    private async Task Cancelar()
    {
        if (await DialogService.Confirm(MensajesHelper.Confirm("cancelar"), MensajesHelper.Title, new() { OkButtonText = "Sí", CancelButtonText = "No" }) == true)
            DialogService.Close();
    }

    private async Task Guardar()
    {
        if (await DialogService.Confirm(MensajesHelper.Confirm(), MensajesHelper.Title, new() { OkButtonText = "Sí", CancelButtonText = "No" }) == true)
        {
            //post y cosas
            DialogService.Close();
        }
    }
}
