@inject DialogService DialogService
@inject DialogCustom DialogCustom
@inject NotificationService NotificationService
@inject OrdenesService OrdenesService

@if (showComponent)
{
    <RadzenStack Orientation="Orientation.Horizontal" Gap="1rem" Style="font-size:small" class="rz-mb-2">
        <RadzenText Text="@("Pedidos " + orden.IdPedidos)" />
        <RadzenText Text="@("Tango " + orden.CodTango != string.Empty ? orden.CodTango:orden.IdPedidos.Contains(",") ? "NO - NO":"NO")" />
        <RadzenText Text="@("Fecha " + orden.Fecha.Value.ToString("dd/MM/yyyy"))" />
    </RadzenStack>

    <RadzenStack Orientation="Orientation.Vertical" Gap="10px" class="rz-mb-2">
        <RadzenStack Orientation="Orientation.Horizontal" Gap="3rem">
            <RadzenText><strong>Cliente: </strong> @orden.RazonSocial </RadzenText>
            <RadzenText><strong>CUIT: </strong> @orden.CUIT </RadzenText>
            <RadzenText><strong>Vendedor: </strong> @orden.Vendedor </RadzenText>
            <RadzenText><strong>Categoría IVA: </strong> @orden.CondicionIVA </RadzenText>
        </RadzenStack>
    </RadzenStack>

    <RadzenStack Orientation="Orientation.Vertical" Gap="10px" class="rz-mb-2">
        <RadzenStack Orientation="Orientation.Horizontal" Gap="3rem">
            <RadzenText><strong>Fecha de entrega: </strong> @(orden.FechaEntrega != null ? orden.FechaEntrega.Value.ToString("dd/MM/yyyy") : "") </RadzenText>
            <RadzenText><strong>Lugar de entrega: </strong> @orden.EntregarEn </RadzenText>
            <RadzenText><strong>Transporte: </strong> @orden.Transporte </RadzenText>
            <RadzenText><strong>Zona: </strong> @orden.Zona </RadzenText>
        </RadzenStack>
    </RadzenStack>
    <RadzenStack Orientation="Orientation.Vertical" Gap="10px" class="rz-mb-2">
        <RadzenStack Orientation="Orientation.Horizontal" Gap="3rem">
            <RadzenText><strong>Observaciones: </strong> @orden.OrdenCompra </RadzenText>
        </RadzenStack>
    </RadzenStack>

    <RadzenDataGrid @ref=gridUp @bind-Value=selected1 TItem=OrdenExpedicionDetalle
                    Data="orden.Detalle.Where(x=>x.CantidadAprobada > 0 || x.CantidadProbadorAprobada > 0 || x.CantidadObsequioAprobada > 0)"
                    Style="height:fit-content; max-height:25vh; min-height:1rem;" EmptyText="" AllowVirtualization=true Density="Density.Compact" SelectionMode="DataGridSelectionMode.Single">
        <Columns>
            <RadzenDataGridColumn Property="@nameof(OrdenExpedicionDetalle.NumLinea)" TextAlign=TextAlign.Right Title="Item" Width="40px" />
            <RadzenDataGridColumn Property="@nameof(OrdenExpedicionDetalle.CodProducto)" TextAlign=TextAlign.Right Title="Cód." Width="90px" />
            <RadzenDataGridColumn Property="@nameof(OrdenExpedicionDetalle.DescripcionProducto)" TextAlign=TextAlign.Right Title="Producto" Width="280px">
                <FooterTemplate>
                    <RadzenText TextAlign=TextAlign.Right><strong>TOTAL:</strong></RadzenText>
                </FooterTemplate>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Property="@nameof(OrdenExpedicionDetalle.CantidadAprobadaF)" TextAlign=TextAlign.Right Title="F" Width="80px" Visible=showF>
                <EditTemplate>
                    <RadzenNumeric @bind-Value=lineaEdit.CantidadAprobadaF ShowUpDown=false Min="0" Max="context.CantidadF" />
                </EditTemplate>
                <FooterTemplate>
                    <RadzenText TextAlign=TextAlign.Right>@orden.Detalle.Sum(x => x.CantidadAprobadaF)</RadzenText>
                </FooterTemplate>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Property="@nameof(OrdenExpedicionDetalle.CantidadAprobadaX)" TextAlign=TextAlign.Right Title="X" Width="80px" Visible=showX>
                <EditTemplate>
                    <RadzenNumeric @bind-Value=lineaEdit.CantidadAprobadaX ShowUpDown=false Min="0" Max="context.CantidadX" />
                </EditTemplate>
                <FooterTemplate>
                    <RadzenText TextAlign=TextAlign.Right>@orden.Detalle.Sum(x => x.CantidadAprobadaX)</RadzenText>
                </FooterTemplate>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="OrdenExpedicionDetalle" Title="T" TextAlign=TextAlign.Right Width="50px" Visible=@(showX && showF)>
                <Template>
                    <strong>@(context.CantidadAprobada)</strong>
                </Template>
                <FooterTemplate>
                    <RadzenText TextAlign=TextAlign.Right><strong>@((orden.Detalle.Sum(x => x.CantidadAprobadaF) + orden.Detalle.Sum(x => x.CantidadAprobadaX)).ToString())</strong></RadzenText>
                </FooterTemplate>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Property="@nameof(OrdenExpedicionDetalle.CantidadProbadorAprobadaF)" TextAlign=TextAlign.Right Title="Probadores" Width="100px" Visible=showF>
                <EditTemplate>
                    <RadzenNumeric @bind-Value=lineaEdit.CantidadProbadorAprobadaF ShowUpDown=false Min="0" Max="context.CantidadProbadorF" />
                </EditTemplate>
                <FooterTemplate>
                    <RadzenText TextAlign=TextAlign.Right>@orden.Detalle.Sum(x => x.CantidadProbadorAprobadaF)</RadzenText>
                </FooterTemplate>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Property="@nameof(OrdenExpedicionDetalle.CantidadProbadorAprobadaX)" TextAlign=TextAlign.Right Title="Probadores" Width="100px" Visible=@(showX && !showF)>
                <EditTemplate>
                    <RadzenNumeric @bind-Value=lineaEdit.CantidadProbadorAprobadaX ShowUpDown=false Min="0" Max="context.CantidadProbadorX" />
                </EditTemplate>
                <FooterTemplate>
                    <RadzenText TextAlign=TextAlign.Right>@orden.Detalle.Sum(x => x.CantidadProbadorAprobadaX)</RadzenText>
                </FooterTemplate>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TextAlign=TextAlign.Center Width="35px" Frozen=true FrozenPosition="FrozenColumnPosition.Right">
                <Template>
                    <RadzenButton Size="ButtonSize.ExtraSmall" Icon="arrow_downward" ButtonStyle="ButtonStyle.Info" Click="@(()=>BajarLinea(context))" Disabled=editMode />
                </Template>
                <EditTemplate>
                    <RadzenButton Size="ButtonSize.ExtraSmall" Icon="save" ButtonStyle="ButtonStyle.Success" Click="@(()=>SaveUpRow(context))" />
                </EditTemplate>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TextAlign=TextAlign.Center Width="35px" Frozen=true FrozenPosition="FrozenColumnPosition.Right">
                <Template>
                    <RadzenButton Size="ButtonSize.ExtraSmall" Icon="edit" ButtonStyle="ButtonStyle.Warning" Click="@(()=>EditUpRow(context))" Disabled=editMode />
                </Template>
                <EditTemplate>
                    <RadzenButton Size="ButtonSize.ExtraSmall" Icon="cancel" ButtonStyle="ButtonStyle.Danger" Click="@(()=>CancelUpRow(context))" />
                </EditTemplate>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>

    <RadzenText Text="Pendientes" class="rz-mb-2 rz-mt-2" TextStyle="TextStyle.DisplayH5" Style="color:var(--rz-text-disabled-color)" />

    <RadzenDataGrid @ref=gridDown @bind-Value=selected2 TItem=OrdenExpedicionDetalle
                    Data="orden.Detalle.Where(x=>x.CantidadPendiente > 0 || x.CantidadProbadorPendiente > 0 || x.CantidadObsequioPendiente > 0)"
                    Style="height:fit-content; max-height:25vh; min-height:1rem;" EmptyText="" AllowVirtualization=true Density="Density.Compact" SelectionMode="DataGridSelectionMode.Single">
        <Columns>
            <RadzenDataGridColumn Property="@nameof(OrdenExpedicionDetalle.NumLinea)" TextAlign=TextAlign.Right Title="Item" Width="40px" />
            <RadzenDataGridColumn Property="@nameof(OrdenExpedicionDetalle.CodProducto)" TextAlign=TextAlign.Right Title="Cód." Width="90px" />
            <RadzenDataGridColumn Property="@nameof(OrdenExpedicionDetalle.DescripcionProducto)" TextAlign=TextAlign.Right Title="Producto" Width="280px">
                <FooterTemplate>
                    <RadzenText TextAlign=TextAlign.Right><strong>TOTAL:</strong></RadzenText>
                </FooterTemplate>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Property="@nameof(OrdenExpedicionDetalle.CantidadPendienteF)" TextAlign=TextAlign.Right Title="F" Width="80px" Visible=showF>
                <EditTemplate>
                    <RadzenNumeric @bind-Value=lineaEdit.CantidadAprobadaF ShowUpDown=false Min="0" Max="context.CantidadF" />
                </EditTemplate>
                <FooterTemplate>
                    <RadzenText TextAlign=TextAlign.Right>@orden.Detalle.Sum(x => x.CantidadPendienteF)</RadzenText>
                </FooterTemplate>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Property="@nameof(OrdenExpedicionDetalle.CantidadPendienteX)" TextAlign=TextAlign.Right Title="X" Width="80px" Visible=showX>
                <EditTemplate>
                    <RadzenNumeric @bind-Value=lineaEdit.CantidadAprobadaX ShowUpDown=false Min="0" Max="context.CantidadX" />
                </EditTemplate>
                <FooterTemplate>
                    <RadzenText TextAlign=TextAlign.Right>@orden.Detalle.Sum(x => x.CantidadPendienteX)</RadzenText>
                </FooterTemplate>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="OrdenExpedicionDetalle" Title="T" TextAlign=TextAlign.Right Width="50px" Visible=@(showX && showF)>
                <Template>
                    <strong>@(context.Cantidad - context.CantidadAprobada)</strong>
                </Template>
                <FooterTemplate>
                    <RadzenText TextAlign=TextAlign.Right><strong>@((orden.Detalle.Sum(x => x.CantidadPendiente)).ToString())</strong></RadzenText>
                </FooterTemplate>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Property="@nameof(OrdenExpedicionDetalle.CantidadProbadorPendienteF)" TextAlign=TextAlign.Right Title="Probadores" Width="100px" Visible=showF>
                <EditTemplate>
                    <RadzenNumeric @bind-Value=lineaEdit.CantidadProbadorAprobadaF ShowUpDown=false Min="0" Max="context.CantidadProbadorF" />
                </EditTemplate>
                <FooterTemplate>
                    <RadzenText TextAlign=TextAlign.Right>@orden.Detalle.Sum(x => x.CantidadProbadorPendienteF)</RadzenText>
                </FooterTemplate>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Property="@nameof(OrdenExpedicionDetalle.CantidadProbadorPendienteX)" TextAlign=TextAlign.Right Title="Probadores" Width="100px" Visible=@(showX && !showF)>
                <EditTemplate>
                    <RadzenNumeric @bind-Value=lineaEdit.CantidadProbadorAprobadaX ShowUpDown=false Min="0" Max="context.CantidadProbadorX" />
                </EditTemplate>
                <FooterTemplate>
                    <RadzenText TextAlign=TextAlign.Right>@orden.Detalle.Sum(x => x.CantidadProbadorPendienteX)</RadzenText>
                </FooterTemplate>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TextAlign=TextAlign.Center Width="35px" Frozen=true FrozenPosition="FrozenColumnPosition.Right">
                <Template>
                    <RadzenButton Size="ButtonSize.ExtraSmall" Icon="arrow_upward" ButtonStyle="ButtonStyle.Info" Click="@(()=>SubirLinea(context))" Disabled=editMode />
                </Template>
                <EditTemplate>
                    <RadzenButton Size="ButtonSize.ExtraSmall" Icon="save" ButtonStyle="ButtonStyle.Success" Click="@(()=>SaveDownRow(context))" />
                </EditTemplate>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TextAlign=TextAlign.Center Width="35px" Frozen=true FrozenPosition="FrozenColumnPosition.Right">
                <Template>
                    <RadzenButton Size="ButtonSize.ExtraSmall" Icon="edit" ButtonStyle="ButtonStyle.Warning" Click="@(()=>EditDownRow(context))" Disabled=editMode />
                </Template>
                <EditTemplate>
                    <RadzenButton Size="ButtonSize.ExtraSmall" Icon="cancel" ButtonStyle="ButtonStyle.Danger" Click="@(()=>CancelDownRow(context))" />
                </EditTemplate>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>


    <RadzenStack JustifyContent="JustifyContent.Center" Gap="3rem" Orientation="Orientation.Horizontal" class="rz-mt-2">
        <RadzenButton ButtonStyle="ButtonStyle.Danger" Icon="cancel" Text="Cancelar" Click="Cancelar" Disabled=editMode />
        <RadzenButton ButtonStyle="ButtonStyle.Success" Icon="save" Text="Guardar" Click="Guardar" Disabled=editMode />
    </RadzenStack>
}
else
{
    <Loader />
}

@code {
    [Parameter] public string IdOrden { get; set; }

    OrdenExpedicion orden;

    bool showComponent, showX, showF, editMode;
    OrdenExpedicionDetalle lineaEdit;
    IList<OrdenExpedicionDetalle> selected1, selected2;

    RadzenDataGrid<OrdenExpedicionDetalle> gridUp, gridDown;

    protected override async Task OnInitializedAsync()
    {
        orden = await OrdenesService.GetOrdenExpedicion(IdOrden);
        showX = orden.Detalle.Sum(x => x.CantidadX + x.CantidadProbadorX) > 0;
        showF = orden.Detalle.Sum(x => x.CantidadF + x.CantidadProbadorF) > 0;
        showComponent = true;
    }

    private async Task Cancelar()
    {
        if (await DialogService.Confirm(MensajesHelper.Confirm("cancelar"), MensajesHelper.Title, new() { OkButtonText = "Sí", CancelButtonText = "No" }) == true)
            DialogService.Close();
    }

    private async Task Guardar()
    {
        if (await DialogService.Confirm(MensajesHelper.Confirm(), MensajesHelper.Title, new() { OkButtonText = "Sí", CancelButtonText = "No" }) == true)
        {
            DialogCustom.OpenBusyWithLoader("Guardando...");
            var response = await OrdenesService.PostExpedicionDetalle(orden);
            DialogCustom.CloseDialog();
            if (response.IsSuccessStatusCode)
            {
                NotificationService.Notify(NotificationSeverity.Success, MensajesHelper.SaveSuccess());
                DialogService.Close();
            }
            else
                NotificationService.Notify(NotificationSeverity.Error, MensajesHelper.ErrorSummary500, MensajesHelper.ErrorDetail500);
        }
    }

    private void SubirLinea(OrdenExpedicionDetalle linea)
    {
        linea.HuboCambios = true;
        linea.CantidadAprobadaX = linea.CantidadX;
        linea.CantidadAprobadaF = linea.CantidadF;
        linea.CantidadProbadorAprobadaF = linea.CantidadProbadorF;
        linea.CantidadProbadorAprobadaX = linea.CantidadProbadorX;
        linea.CantidadObsequioAprobadaF = linea.CantidadObsequioF;
        linea.CantidadObsequioAprobadaX = linea.CantidadObsequioX;
    }

    private void BajarLinea(OrdenExpedicionDetalle linea)
    {
        linea.HuboCambios = true;
        linea.CantidadAprobadaX = 0;
        linea.CantidadAprobadaF = 0;
        linea.CantidadProbadorAprobadaX = 0;
        linea.CantidadProbadorAprobadaF = 0;
        linea.CantidadObsequioAprobadaF = 0;
        linea.CantidadObsequioAprobadaX = 0;
    }

    private async Task EditUpRow(OrdenExpedicionDetalle linea)
    {
        editMode = true;
        lineaEdit = (OrdenExpedicionDetalle)linea.Clone();
        await gridUp.EditRow(linea);
    }

    private async Task EditDownRow(OrdenExpedicionDetalle linea)
    {
        editMode = true;
        lineaEdit = (OrdenExpedicionDetalle)linea.Clone();
        lineaEdit.CantidadAprobadaF = lineaEdit.CantidadPendienteF;
        lineaEdit.CantidadAprobadaX = lineaEdit.CantidadPendienteX;
        lineaEdit.CantidadProbadorAprobadaF = lineaEdit.CantidadProbadorPendienteF;
        lineaEdit.CantidadProbadorAprobadaX = lineaEdit.CantidadProbadorPendienteX;
        await gridDown.EditRow(linea);
    }

    private async Task SaveDownRow(OrdenExpedicionDetalle linea)
    {
        linea.HuboCambios = true;
        linea.CantidadAprobadaF = lineaEdit.CantidadAprobadaF;
        linea.CantidadAprobadaX = lineaEdit.CantidadAprobadaX;
        linea.CantidadProbadorAprobadaF = lineaEdit.CantidadProbadorAprobadaF;
        linea.CantidadProbadorAprobadaX = lineaEdit.CantidadProbadorAprobadaX;
        editMode = false;
        await gridDown.UpdateRow(linea);
        await gridDown.Reload();
    }

    private async Task SaveUpRow(OrdenExpedicionDetalle linea)
    {
        linea.HuboCambios = true;
        linea.CantidadAprobadaF = lineaEdit.CantidadAprobadaF;
        linea.CantidadAprobadaX = lineaEdit.CantidadAprobadaX;
        linea.CantidadProbadorAprobadaF = lineaEdit.CantidadProbadorAprobadaF;
        linea.CantidadProbadorAprobadaX = lineaEdit.CantidadProbadorAprobadaX;
        linea.CantidadObsequioAprobadaF = lineaEdit.CantidadObsequioAprobadaF;
        linea.CantidadObsequioAprobadaX = lineaEdit.CantidadObsequioAprobadaX;
        editMode = false;
        await gridUp.UpdateRow(linea);
        await gridUp.Reload();
    }

    private void CancelDownRow(OrdenExpedicionDetalle linea)
    {
        editMode = false;
        gridDown.CancelEditRow(linea);
    }

    private void CancelUpRow(OrdenExpedicionDetalle linea)
    {
        editMode = false;
        gridUp.CancelEditRow(linea);
    }

}
