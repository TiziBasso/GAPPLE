@inject OrdenesService OrdenesService

@if (showModal)
{
    <div id="print" style="">
        @* Va dentro del contenido impreso porque el iframe de impresión no carga el CSS de la app.
           table-layout fixed + nowrap: ninguna celda pasa a 2 renglones (lo que no entra se corta con "…"),
           así cada fila ocupa siempre una línea y el cálculo de líneas por página se mantiene. *@
        <style>
            .exp-tabla { table-layout: fixed; border-collapse: collapse; width: 100%; font-size: 13.3pt; }
            .exp-tabla th, .exp-tabla td { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        </style>
        @for (int i = 0; i < paginas.Count; i++)
        {
            var pagina = paginas[i];
            <Page Orden=Orden PageNum="i + 1" CantPages="paginas.Count" ShouldPrint=@(ShouldPrint && i == paginas.Count - 1) Imprimir="Imprimir"
                  Detalle="pagina.Detalle" ShowF=@(Orden.Detalle.Any(x=>x.CantidadF > 0)) ShowX=@(Orden.Detalle.Any(x=>x.CantidadX > 0))
                  ShowPF=@(Orden.Detalle.Any(x=>x.CantidadProbadorF > 0)) ShowPX=@(Orden.Detalle.Any(x=>x.CantidadProbadorX > 0))
                  ShowOF=@(Orden.Detalle.Any(x=>x.CantidadObsequioF > 0)) ShowOX=@(Orden.Detalle.Any(x=>x.CantidadObsequioX > 0))
                  ShowPendiente="pagina.ShowPendientes" Pendiente="pagina.Pendientes"
                  TotalAprobados="@(pagina.MostrarTotalAprobados ? totalAprobados : null)"
                  TotalPendientes="@(pagina.MostrarTotalPendientes ? totalPendientes : null)" />
        }
    </div>
}

@code {
    [Parameter, EditorRequired] public OrdenExpedicion Orden { get; set; }
    [Parameter] public EventCallback Imprimir { get; set; }
    [Parameter] public bool ShouldPrint { get; set; } = true;

    private class Pagina
    {
        public List<OrdenExpedicionDetalle> Detalle { get; set; } = new();
        public List<OrdenExpedicionDetalle> Pendientes { get; set; } = new();
        public bool ShowPendientes { get; set; }
        // El total general de cada listado se imprime una sola vez, debajo de su última fila
        public bool MostrarTotalAprobados { get; set; }
        public bool MostrarTotalPendientes { get; set; }
    }

    List<Pagina> paginas = new();
    TotalesImpresion totalAprobados = new(), totalPendientes = new();

    bool showModal;
    const int lineasXPag0 = 36, lineasXPagN = 40;
    // Fila de total general (aprobados / pendientes) y las 2 filas de encabezado de PENDIENTES
    const int lineasTotal = 1, lineasEncabezadoPendientes = 2;

    protected override void OnInitialized()
    {
        // Líneas aprobadas (lo que se arma). Cada renglón aparece una sola vez.
        var aprobados = Orden.Detalle
            .Where(x => x.CantidadAprobada > 0 || x.CantidadProbadorAprobada > 0 || x.CantidadObsequioAprobada > 0)
            .Select(x => new OrdenExpedicionDetalle()
            {
                DescripcionProducto = x.DescripcionProducto,
                NumLinea = x.NumLinea,
                CodProducto = x.CodProducto,
                CantidadF = x.CantidadF,
                CantidadX = x.CantidadX,
                CantidadAprobadaF = x.CantidadAprobadaF,
                CantidadAprobadaX = x.CantidadAprobadaX,

                CantidadObsequioX = x.CantidadObsequioX,
                CantidadObsequioF = x.CantidadObsequioF,
                CantidadObsequioAprobadaX = x.CantidadObsequioAprobadaX,
                CantidadObsequioAprobadaF = x.CantidadObsequioAprobadaF,

                CantidadProbadorX = x.CantidadProbadorX,
                CantidadProbadorF = x.CantidadProbadorF,
                CantidadProbadorAprobadaX = x.CantidadProbadorAprobadaX,
                CantidadProbadorAprobadaF = x.CantidadProbadorAprobadaF,
            })
            .ToList();

        // Pendientes: se arman SOLO desde Orden.Detalle. Antes se filtraba sobre la lista combinada
        // (aprobados + pendientes) y una línea aprobada parcialmente aparecía dos veces.
        var pendientes = Orden.Detalle
            .Where(x => x.CantidadPendiente > 0 || x.CantidadProbadorPendiente > 0 || x.CantidadObsequioPendiente > 0)
            .Select(x => new OrdenExpedicionDetalle()
            {
                DescripcionProducto = x.DescripcionProducto,
                NumLinea = x.NumLinea,
                CodProducto = x.CodProducto,
                CantidadF = x.CantidadF - x.CantidadAprobadaF,
                CantidadX = x.CantidadX - x.CantidadAprobadaX,
                CantidadAprobadaF = 0,
                CantidadAprobadaX = 0,

                CantidadObsequioX = x.CantidadObsequioX - x.CantidadObsequioAprobadaX,
                CantidadObsequioF = x.CantidadObsequioF - x.CantidadObsequioAprobadaF,
                CantidadObsequioAprobadaX = 0,
                CantidadObsequioAprobadaF = 0,

                CantidadProbadorX = x.CantidadProbadorX - x.CantidadProbadorAprobadaX,
                CantidadProbadorF = x.CantidadProbadorF - x.CantidadProbadorAprobadaF,
                CantidadProbadorAprobadaX = 0,
                CantidadProbadorAprobadaF = 0,
            })
            .ToList();

        // Totales del pedido completo (no de cada hoja): SCRUM-168 aprobados, SCRUM-166 pendientes
        totalAprobados = new()
        {
            Cantidad = aprobados.Sum(x => x.CantidadAprobada),
            Probador = aprobados.Sum(x => x.CantidadProbadorAprobada),
            Obsequio = aprobados.Sum(x => x.CantidadObsequioAprobada)
        };
        totalPendientes = new()
        {
            Cantidad = pendientes.Sum(x => x.CantidadPendiente),
            Probador = pendientes.Sum(x => x.CantidadProbadorPendiente),
            Obsequio = pendientes.Sum(x => x.CantidadObsequioPendiente)
        };

        paginas = Paginar(aprobados, pendientes);
        showModal = true;
    }

    // Reparte las filas en páginas consumiendo cada fila una sola vez:
    // primero los aprobados y, cuando se terminan, los pendientes en el espacio que queda.
    // Así no se repiten SKUs ni quedan páginas vacías.
    // El total general de cada listado ocupa una línea y va en la misma hoja que su última fila.
    private static List<Pagina> Paginar(List<OrdenExpedicionDetalle> aprobados, List<OrdenExpedicionDetalle> pendientes)
    {
        var result = new List<Pagina>();
        int iAprobado = 0, iPendiente = 0;

        do
        {
            int capacidad = result.Count == 0 ? lineasXPag0 : lineasXPagN;
            var pagina = new Pagina();

            if (iAprobado < aprobados.Count)
            {
                int tomar = FilasQueEntran(aprobados.Count - iAprobado, capacidad);
                pagina.Detalle = aprobados.Skip(iAprobado).Take(tomar).ToList();
                iAprobado += tomar;
                capacidad -= tomar;

                if (iAprobado == aprobados.Count)
                {
                    pagina.MostrarTotalAprobados = true;
                    capacidad -= lineasTotal;
                }
            }

            int disponible = capacidad - lineasEncabezadoPendientes;
            if (iAprobado >= aprobados.Count && iPendiente < pendientes.Count && disponible > 0)
            {
                int tomar = FilasQueEntran(pendientes.Count - iPendiente, disponible);
                if (tomar > 0)
                {
                    pagina.Pendientes = pendientes.Skip(iPendiente).Take(tomar).ToList();
                    iPendiente += tomar;
                    pagina.ShowPendientes = true;
                    pagina.MostrarTotalPendientes = iPendiente == pendientes.Count;
                }
            }

            result.Add(pagina);
        }
        while (iAprobado < aprobados.Count || iPendiente < pendientes.Count);

        return result;
    }

    // Si las filas restantes entran junto con la línea del total, van todas.
    // Si no, se llena la hoja, pero sin consumir la última fila: así el total nunca queda solo en una hoja aparte.
    private static int FilasQueEntran(int restantes, int capacidad) =>
        restantes + lineasTotal <= capacidad ? restantes : Math.Min(restantes - 1, capacidad);
}
