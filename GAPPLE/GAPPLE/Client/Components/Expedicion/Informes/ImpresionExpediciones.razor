@inject OrdenesService OrdenesService

@if (showModal)
{
    <div id="print" style="">
        @for (int i = 0; i < cantPages; i++)
        {
            GetData(i);
            @* <Page Orden=Orden PageNum="i+1" CantPages="cantPages" ShouldPrint=@(ShouldPrint && i == cantPages - 1) Imprimir="Imprimir"
                  Detalle="detalle" ShowF=@(Orden.Detalle.Any(x=>x.CantidadF > 0)) ShowX=@(Orden.Detalle.Any(x=>x.CantidadX > 0))
                  ShowPF=@(Orden.Detalle.Any(x=>x.CantidadProbadorF > 0)) ShowPX=@(Orden.Detalle.Any(x=>x.CantidadProbadorX > 0))
                  ShowOF=@(Orden.Detalle.Any(x=>x.CantidadObsequioF > 0)) ShowOX=@(Orden.Detalle.Any(x=>x.CantidadObsequioX > 0))
                  ShowPendiente="showPendientes" Pendiente="pendiente" /> *@
            <Page Orden=Orden PageNum="i + 1" CantPages="cantPages" ShouldPrint=@(ShouldPrint && i == cantPages - 1) Imprimir="Imprimir"
                  Detalle="detalle" ShowF=@(Orden.Detalle.Any(x=>x.CantidadF > 0)) ShowX=@(Orden.Detalle.Any(x=>x.CantidadX > 0))
                  ShowPF=@(Orden.Detalle.Any(x=>x.CantidadProbadorF > 0)) ShowPX=@(Orden.Detalle.Any(x=>x.CantidadProbadorX > 0))
                  ShowOF=@(Orden.Detalle.Any(x=>x.CantidadObsequioF > 0)) ShowOX=@(Orden.Detalle.Any(x=>x.CantidadObsequioX > 0))
                  ShowPendiente="showPendientes" Pendiente="pendienteRemain" />
        }
    </div>
}

@code {
    [Parameter, EditorRequired] public OrdenExpedicion Orden { get; set; }
    [Parameter] public EventCallback Imprimir { get; set; }
    [Parameter] public bool ShouldPrint { get; set; } = true;

    bool showPendientes;
    List<OrdenExpedicionDetalle> detalle = new();
    List<OrdenExpedicionDetalle> pendiente = new();
    List<OrdenExpedicionDetalle> pendienteRemain = new();
    List<OrdenExpedicionDetalle> detalleCompleto = new();


    bool showModal;
    int cantPages = 1, lineasXPag0 = 36, lineasXPagN = 40;

    protected override void OnInitialized()
    {
        detalleCompleto.AddRange(
            Orden.Detalle.Where(x => x.CantidadAprobada > 0 || x.CantidadProbadorAprobada > 0 || x.CantidadObsequioAprobada > 0).Select(x => new OrdenExpedicionDetalle()
            {
                DescripcionProducto = x.DescripcionProducto,
                NumLinea = x.NumLinea,
                CodProducto = x.CodProducto,
                CantidadF = x.CantidadF,
                CantidadX = x.CantidadX,
                CantidadAprobadaF = x.CantidadAprobadaF,
                CantidadAprobadaX = x.CantidadAprobadaX,

                CantidadObsequioX = x.CantidadObsequioX,
                CantidadObsequioF = x.CantidadObsequioF,
                CantidadObsequioAprobadaX = x.CantidadObsequioAprobadaX,
                CantidadObsequioAprobadaF = x.CantidadObsequioAprobadaF,

                CantidadProbadorX = x.CantidadProbadorX,
                CantidadProbadorF = x.CantidadProbadorF,
                CantidadProbadorAprobadaX = x.CantidadProbadorAprobadaX,
                CantidadProbadorAprobadaF = x.CantidadProbadorAprobadaF,
            })
        );

        // Pendientes
        if (Orden.Detalle.Any(x => x.CantidadPendiente > 0 || x.CantidadProbadorPendiente > 0 || x.CantidadObsequioPendiente > 0))
        {
            detalleCompleto.AddRange(
                Orden.Detalle.Where(x => x.CantidadPendiente > 0 || x.CantidadProbadorPendiente > 0 || x.CantidadObsequioPendiente > 0).Select(x => new OrdenExpedicionDetalle()
                {
                    DescripcionProducto = x.DescripcionProducto,
                    NumLinea = x.NumLinea,
                    CodProducto = x.CodProducto,
                    CantidadF = x.CantidadF - x.CantidadAprobadaF,
                    CantidadX = x.CantidadX - x.CantidadAprobadaX,
                    CantidadAprobadaF = 0,
                    CantidadAprobadaX = 0,

                    CantidadObsequioX = x.CantidadObsequioX - x.CantidadObsequioAprobadaX,
                    CantidadObsequioF = x.CantidadObsequioF - x.CantidadObsequioAprobadaF,
                    CantidadObsequioAprobadaX = 0,
                    CantidadObsequioAprobadaF = 0,

                    CantidadProbadorX = x.CantidadProbadorX - x.CantidadProbadorAprobadaX,
                    CantidadProbadorF = x.CantidadProbadorF - x.CantidadProbadorAprobadaF,
                    CantidadProbadorAprobadaX = 0,
                    CantidadProbadorAprobadaF = 0,
                })
            );
        }

        int sumLineas = detalleCompleto!.Count + 1 + detalleCompleto.Sum(x => (x.CantidadObsequioPendiente > 0 || x.CantidadPendiente > 0 || x.CantidadProbadorPendiente > 0) ? 1 : 0);

        if (sumLineas / lineasXPag0 > 0)
        {
            var aux = ((sumLineas - lineasXPag0) / lineasXPagN);
            if (((sumLineas - lineasXPag0) % lineasXPagN) > 0) aux++;
            cantPages += aux;
        }

        pendiente = detalleCompleto.Where(x => x.CantidadObsequioPendiente > 0 || x.CantidadPendiente > 0 || x.CantidadProbadorPendiente > 0).ToList();

        showModal = true;
    }

    // private void GetData(int page)
    // {
    //     int showed = page == 0 ? 0 : lineasXPag0 + (lineasXPagN * (page - 1)),
    //         remaining = page == 0 ? lineasXPag0 : lineasXPagN;

    //     if(remaining > 0)
    //         detalle = Orden.Detalle.Skip(showed)?.Take(remaining).ToList();

    //     int total = Orden.Detalle.Count;
    //     showPendientes = showed + remaining >= total;
    // }

    private void GetData(int page)
    {
        int showed = page == 0
            ? 0
            : lineasXPag0 + (lineasXPagN * (page - 1));

        int remaining = page == 0
            ? lineasXPag0
            : lineasXPagN;

        int totalDetalle = detalleCompleto.Count;

        // =========================
        // DETALLE
        // =========================
        detalle = new List<OrdenExpedicionDetalle>();

        if (remaining > 0 && showed < totalDetalle)
        {
            detalle = detalleCompleto
                .Where(x => x.CantidadAprobada > 0 || x.CantidadProbadorAprobada > 0 || x.CantidadObsequioAprobada > 0)
                .Skip(showed)
                .Take(remaining)
                .ToList();
        }

        int usadosDetalle = detalle.Count;
        int espacioRestante = remaining - usadosDetalle;

        // =========================
        // PENDIENTES
        // =========================
        pendienteRemain = new List<OrdenExpedicionDetalle>();

        if (espacioRestante > 0)
        {
            // Cuántos pendientes ya deberían haberse mostrado en páginas anteriores
            int pendientesSkip = Math.Max(0, showed - totalDetalle);

            pendienteRemain = pendiente
                .Skip(pendientesSkip)
                .Take(espacioRestante)
                .ToList();
        }

        // Mostrar pendientes solo si ya se terminaron los detalles
        showPendientes = showed + remaining >= totalDetalle;
    }

}
