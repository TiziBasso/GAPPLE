<div style="font-family: Arial, Helvetica, sans-serif;width: 21cm;height: 30cm; break-after:page">
    <div>
        <strong>@(Orden.Fecha.ToString("dd/MM/yyyy"))</strong>
    </div>
    <div style="display: grid;gap: 10px;margin-top: 10px;">
        <div style="display: flex;justify-content: space-between;">
            <strong style="width: fit-content;">Cliente: (@Orden.CodCliente) @Orden.RazonSocial</strong>
            <strong style="width: fit-content;">CUIT: @Orden.CUIT</strong>
            <strong style="width: fit-content;">@Orden.CondicionIVA</strong>
        </div>
        <div style="display: flex;justify-content: space-between;">
            <strong style="width: fit-content;">Entregar En: @Orden.FechaEntrega</strong>
        </div>
        <div style="display: flex;justify-content: space-between;">
            <strong style="width: fit-content;">Observaciones: @Orden.Observaciones</strong>
        </div>
    </div>
    <div style="margin-top: 10px;height: 26cm;">
        <PageData Detalle="Detalle" ShowF=@(Detalle.Sum(x=>x.CantidadF + x.CantidadProbadorF) > 0) ShowX=@(Detalle.Sum(x=>x.CantidadX + x.CantidadProbadorX) > 0) />
    </div>
    <div style="width: 100%;margin-top: 10px;">
        <span style="text-align: end;width: 100%;display: block;">Página @PageNum de @CantPages</span>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public EventCallback Imprimir { get; set; }
    [Parameter, EditorRequired] public OrdenExpedicion Orden { get; set; }
    [Parameter, EditorRequired] public int CantPages { get; set; }
    [Parameter, EditorRequired] public int PageNum { get; set; }
    [Parameter] public bool ShouldPrint { get; set; } = true;
    [Parameter, EditorRequired] public List<OrdenExpedicionDetalle> Detalle { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (PageNum == CantPages && ShouldPrint)
        {
            await Task.Delay(100);
            await Imprimir.InvokeAsync();
        }
    }
}
