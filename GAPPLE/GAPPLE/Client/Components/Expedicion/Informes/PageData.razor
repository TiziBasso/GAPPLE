<table style="border-collapse: collapse;width: 100%;">
    <thead style="font-style: italic;">
        <tr>
            <th style="border:1px solid;border-right: none; padding: 5px; width:10%;">#</th>
            <th style="border:1px solid;border-right: none; padding: 5px; width:20%;">ID</th>
            <th style="border:1px solid;border-right: none;padding: 5px; width:30%;">Producto</th>
            @if (ShowF)
            {
                <th style="border:1px solid;border-right: none;padding: 5px; width:10%;">F</th>
            }
            @if (ShowX)
            {
                <th style="border:1px solid;border-right:none;padding: 5px; width:10%;">X</th>
            }
            <th style="border:1px solid;border-right:none;padding: 5px; width:10%;">T</th>
            @if (ShowPX || ShowPF)
            {
                <th style="border:1px solid;padding: 5px; width:10%;">Probador</th>
            }
            @if (ShowOX || ShowOF)
            {
                <th style="border:1px solid;padding: 5px; width:10%;">Obsequio</th>
            }
        </tr>
    </thead>
    <tbody style="font-size: 11pt;">
        @foreach (var item in Detalle)
        {
            <tr style="border-bottom:1px solid; margin-bottom:5px; margin-top:5px; line-height:1.5;">
                <td style="text-align: end;padding:1px;">@item.NumLinea</td>
                <td style="text-align: center;padding:1px;">@item.CodProducto</td>
                <td style="padding:1px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">@item.DescripcionProducto</td>
                @if (ShowF)
                {
                    <td style="text-align: end;padding:1px;">@item.CantidadF</td>
                }
                @if (ShowX)
                {
                    <td style="text-align: end;padding:1px;">@item.CantidadX</td>
                }
                <td style="text-align:end;padding:1px;">@item.Cantidad</td>
                @if (ShowPF)
                {
                    <td style="text-align: end;padding:1px;">@item.CantidadProbadorF</td>
                }
                @if (ShowPX)
                {
                    <td style="text-align: end;padding:1px;">@item.CantidadProbadorX</td>
                }
                @if (ShowOF)
                {
                    <td style="text-align: end;padding:1px;">@item.CantidadObsequioF</td>
                }
                @if (ShowOX)
                {
                    <td style="text-align: end;padding:1px;">@item.CantidadObsequioX</td>
                }
                <td></td>
            </tr>
        }
        <tr>
            <td colspan="2"></td>
            <td style="text-align: end;"><strong>Total: </strong></td>
            @if (ShowF)
            {
                <td style="text-align: end;"><strong>@Detalle.Sum(x => x.CantidadF)</strong></td>
            }
            @if (ShowX)
            {
                <td style="text-align: end;"><strong>@Detalle.Sum(x => x.CantidadX)</strong></td>
            }
            <td style="text-align: end;"><strong>@Detalle.Sum(x => x.Cantidad)</strong></td>
            @if (ShowPF)
            {
                <td style="text-align: end;"><strong>@Detalle.Sum(x => x.CantidadProbadorF)</strong></td>
            }
            @if (ShowPX)
            {
                <td style="text-align: end;"><strong>@Detalle.Sum(x => x.CantidadProbadorX)</strong></td>
            }
            @if (ShowOF)
            {
                <td style="text-align: end;"><strong>@Detalle.Sum(x => x.CantidadObsequioF)</strong></td>
            }
            @if (ShowOX)
            {
                <td style="text-align: end;"><strong>@Detalle.Sum(x => x.CantidadObsequioX)</strong></td>
            }
        </tr>
    </tbody>
    @if (ShowPendientes)
    {
        <tfoot style="font-style: italic;">
            <tr>
                <th colspan="5" style="border: 1px solid black;border-right: none;border-left: none;">PENDIENTES</th>
            </tr>
            <tr>
                <th style="border:1px solid;border-right: none;padding: 5px;">ID</th>
                <th style="border:1px solid;border-right: none;padding: 5px;width:60%">Producto</th>
                <th style="border:1px solid;border-right: none;padding: 5px;">Cantidad</th>
                <th style="border:1px solid;border-right: none;padding: 5px;">Probador</th>
                <th style="border:1px solid;border-right: none;padding: 5px;">Obsequio</th>
            </tr>
            @foreach (var item in Pendiente)
            {
                <tr style="font-size: 11pt;">
                    <td style="text-align: end;">@item.CodProducto</td>
                    <td>@item.DescripcionProducto</td>
                    <td style="text-align: end;">@item.CantidadPendiente</td>
                    <td style="text-align: end;">@(item.CantidadProbadorPendiente != 0 ? item.CantidadProbadorPendiente : "")</td>
                    <td style="text-align: end;">@(item.CantidadObsequioPendiente != 0 ? item.CantidadObsequioPendiente : "")</td>
                </tr>
            }
        </tfoot>
    }
</table>
@code {
    [Parameter] public List<OrdenExpedicionDetalle> Detalle { get; set; }
    [Parameter] public List<OrdenExpedicionDetalle> Pendiente { get; set; }
    [Parameter] public bool ShowPendientes { get; set; }
    [Parameter] public bool ShowX { get; set; }
    [Parameter] public bool ShowF { get; set; }
    [Parameter] public bool ShowPF { get; set; }
    [Parameter] public bool ShowPX { get; set; }
    [Parameter] public bool ShowOF { get; set; }
    [Parameter] public bool ShowOX { get; set; }
}
