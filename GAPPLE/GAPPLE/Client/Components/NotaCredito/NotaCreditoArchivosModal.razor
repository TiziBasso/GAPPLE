@implements IDisposable

@inject IJSRuntime JS
@inject RadzenDialogService RadzenDialogService
@inject FileService FileService
@inject SignalRService SignalRService
@inject ProgressBarService ProgressBarService
@inject ComprobantesService ComprobantesService

<InputFile OnChange="OnFilesSelected" multiple style="display:none" @ref="fileInput" />

<RadzenButton Text="Seleccionar archivos" Click="@AbrirSelector" ButtonStyle="ButtonStyle.Secondary" class="rz-mb-3" />

<RadzenDataGrid @ref="radzenDataGrid" Data="@files" TItem="IBrowserFile" Density="Density.Compact" ShowEmptyMessage="false" Style="height:36rem; width:100%">
    <Columns>
        <RadzenDataGridColumn TItem="IBrowserFile" Property="Name" Title="Nombre" />
        <RadzenDataGridColumn TItem="IBrowserFile" Title="Tamaño">
            <Template Context="file">
                @($"{file.Size / 1024} KB")
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="IBrowserFile" TextAlign="TextAlign.Center" Width="35px" Frozen=true FrozenPosition="FrozenColumnPosition.Right">
            <Template Context="file">
                <RadzenButton Icon="close" Click="@(() => Eliminar(file))" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.ExtraSmall" />
            </Template>
        </RadzenDataGridColumn>
    </Columns>
</RadzenDataGrid>

<RadzenStack JustifyContent="JustifyContent.Center" Gap="3rem" Orientation="Orientation.Horizontal" class="rz-mt-2">
    <RadzenButton ButtonStyle="ButtonStyle.Danger" Icon="cancel" Text="Cancelar" Click="@(() => RadzenDialogService.CloseDialog())" />
    <RadzenButton ButtonStyle="ButtonStyle.Success" Icon="save" Click="ProcesarArchivos" Text="Guardar" />
</RadzenStack>

@code {
    [Parameter] public int IdComprobante { get; set; }
    [Parameter] public List<string> NombresCargados { get; set; }
    [Parameter] public EventCallback<List<NotaCreditoArchivo>> Callback { get; set; }
    CancellationTokenSource cancellationToken = new();
    private List<IBrowserFile> files = new();
    private InputFile fileInput;
    RadzenDataGrid<IBrowserFile> radzenDataGrid;
    List<NotaCreditoArchivo> archivos = new();

    private async Task AbrirSelector()
    {
        await JS.InvokeVoidAsync("eval", "document.querySelector('input[type=file]').click()");
    }

    private void OnFilesSelected(InputFileChangeEventArgs e)
    {
        files.AddRange(e.GetMultipleFiles());
        radzenDataGrid.Reload();
    }

    private async Task ProcesarArchivos()
    {
        var g = files.GroupBy(f => f.Name);

        if (g.Any(x => x.Count() > 1))
            RadzenDialogService.Notify(NotificationSeverity.Info, "Se seleccionaron dos archivos con el mismo nombre");
        else if (NombresCargados.Any(x => files.Any(y => y.Name == x)))
            RadzenDialogService.Notify(NotificationSeverity.Info, "Ya hay un archivo cargado con el mismo nombre");
        else
        {
            string aux = files.Count == 1 ? "archivo" : "archivos";
            if (await RadzenDialogService.ConfirmOperation($"subir {files.Count}", aux))
                await SubirArchivos(files, cancellationToken);
        }
    }

    private async Task SubirArchivos(List<IBrowserFile> files, CancellationTokenSource cancellationToken)
    {
        var errores = new List<string>();

        RadzenDialogService.OpenProgressBar("Subiendo archivos...");

        try
        {
            await SignalRService.StartConnection();
            var connectionId = SignalRService.GetConnectionId();

            int i = 0;
            foreach (var file in files)
            {
                try
                {
                    var archivo = new NotaCreditoArchivo { NombreArchivo = file.Name, TipoArchivo = file.ContentType.ToString(), FechaSubida = DateTime.Today };
                    i++;
                    ProgressBarService.Update($"Archivo {i}/{files.Count}");
                    // 1. Subida en chunks
                    var chunks = await FileService.PostChunkFile(Variables.FilesEntity.NotasCredito, $"{IdComprobante:000000}", file, ProgressBarService.Update, cancellationToken);
                    if (!chunks.IsOk)
                    {
                        errores.Add(file.Name);
                        continue;
                    }

                    // 2. Confirmación
                    var complete = await FileService.PostCompleteFile(Variables.FilesEntity.NotasCredito, $"{IdComprobante:000000}", file.Name, (int)chunks.Data);
                    if (!complete.IsOk)
                    {
                        errores.Add(file.Name);
                        continue;
                    }

                    // 3. Guardar resultado (path)
                    archivo.Path = complete.Message;
                    archivos.Add(archivo);
                }
                catch
                {
                    errores.Add(file.Name);
                }
            }
        }
        finally
        {
            RadzenDialogService.CloseDialog();
        }

        // Notificaciones finales (no cortes todo a mitad, reportá)
        if (errores.Any())
        {
            RadzenDialogService.Notify(NotificationSeverity.Warning, $"Fallaron {errores.Count} archivos");
            return;
        }

        var final = await ComprobantesService.PostNotaCreditoArchivo(IdComprobante, archivos);

        if (final.IsOk)
            await Callback.InvokeAsync((List<NotaCreditoArchivo>)final.Data);
        else
            RadzenDialogService.Notify(NotificationSeverity.Error, "Ocurrio un error asignando los archivos al comprobante");
    }

    void Eliminar(IBrowserFile file)
    {
        files.Remove(file);
        radzenDataGrid.Reload();
    }

    public void Dispose()
    {
        cancellationToken.Cancel();
        cancellationToken.Dispose();
    }
}
