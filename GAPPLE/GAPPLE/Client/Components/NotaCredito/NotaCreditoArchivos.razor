@inject ComprobantesService ComprobantesService

@if (showForm)
{
    <RadzenDataGrid Data="notaCreditoArchivos" Density="Density.Compact">
        <HeaderTemplate>
            <RadzenButton Icon="upload" ButtonStyle="ButtonStyle.Info" Variant="Variant.Flat" Size="ButtonSize.ExtraSmall"
            Click="@(() => CargarArchivo())" @onclick:stopPropagation="true" />
        </HeaderTemplate>
        <Columns>
            <RadzenDataGridColumn Property="@nameof(NotaCreditoArchivo.IdArchivo)" Title="Cód" />
            <RadzenDataGridColumn Property="@nameof(NotaCreditoArchivo.NombreArchivo)" Title="Nombre" />
            <RadzenDataGridColumn Property="@nameof(NotaCreditoArchivo.FechaSubida)" Title="Fecha subida" />
            <RadzenDataGridColumn>
                <Template>
                    <RadzenButton Icon="download" ButtonStyle="ButtonStyle.Info" Variant="Variant.Flat" Size="ButtonSize.ExtraSmall"
                    Click="@(() => DescargarArchivo(context))" @onclick:stopPropagation="true" />
                </Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
}
else
{
    <Loader />
}

@code {
    [Parameter] public int IdComprobante { get; set; }
    public List<NotaCreditoArchivo> notaCreditoArchivos = new();
    bool showForm;

    protected override async Task OnInitializedAsync()
    {
        notaCreditoArchivos = await ComprobantesService.GetArchivos(IdComprobante);
        showForm = true;
    }

    public async Task DescargarArchivo(NotaCreditoArchivo nc)
    {
        
    }
}
