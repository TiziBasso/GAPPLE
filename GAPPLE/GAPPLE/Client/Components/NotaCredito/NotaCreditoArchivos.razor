@page "/notacreditoarchivos/{IdComprobante:int}"
@using GAPPLE.Client.Pages.NotaCredito
@inject ComprobantesService ComprobantesService
@inject NavigationManager NavigationManager
@inject RadzenDialogService RadzenDialogService
@inject FileService FileService

@if (showForm)
{
    <RadzenDataGrid Data="notaCreditoArchivos" Density="Density.Compact">
        <HeaderTemplate>
            <RadzenButton Icon="upload" Text="Agregar archivos" ButtonStyle="ButtonStyle.Info" Variant="Variant.Flat" Size="ButtonSize.ExtraSmall"
                          Click="@(() => CargarArchivo())" @onclick:stopPropagation="true" />
        </HeaderTemplate>
        <Columns>
            <RadzenDataGridColumn Property="@nameof(NotaCreditoArchivo.IdArchivo)" Title="Cód" />
            <RadzenDataGridColumn Property="@nameof(NotaCreditoArchivo.NombreArchivo)" Title="Nombre" />
            <RadzenDataGridColumn Property="@nameof(NotaCreditoArchivo.FechaSubida)" Title="Fecha subida" />
            <RadzenDataGridColumn>
                <Template>
                    <RadzenButton Icon="download" ButtonStyle="ButtonStyle.Info" Variant="Variant.Flat" Size="ButtonSize.ExtraSmall"
                                  Click="@(() => DescargarArchivo(context))" @onclick:stopPropagation="true" />
                </Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>

    <RadzenButton Text="Volver" Click="Volver" ButtonStyle="ButtonStyle.Secondary" />
}
else
{
    <Loader />
}

@code {
    [Parameter] public int IdComprobante { get; set; }
    public List<NotaCreditoArchivo> notaCreditoArchivos = new();
    bool showForm;

    protected override async Task OnInitializedAsync()
    {
        notaCreditoArchivos = await ComprobantesService.GetArchivos(IdComprobante);
        showForm = true;
    }

    public async Task DescargarArchivo(NotaCreditoArchivo nc)
    {

    }

    async Task CargarArchivo()
    {
        var result = await RadzenDialogService.OpenAsync<ArchivosTest>("Cargar archivos", null, new DialogOptions
        {
            Width = "500px",
            Height = "300px"
        });

        if (result != null)
        {
            RadzenDialogService.OpenBusyWithLoader();
            List<NotaCreditoArchivo> archivos = new();
            foreach(var item in (List<string>)result)
            {
                archivos.Add(new NotaCreditoArchivo
                {
                    IdComprobante = IdComprobante,
                    NombreArchivo = item.Substring(item.LastIndexOf("/")+1),
                    FechaSubida = DateTime.Today,
                    Path = item,
                    TipoArchivo = "arch"
                });
            }
            await ComprobantesService.PostNotaCreditoArchivo(archivos);
        }

        notaCreditoArchivos = await ComprobantesService.GetArchivos(IdComprobante);
        RadzenDialogService.CloseDialog();
    }

    void Volver()
    {
        NavigationManager.NavigateTo($"/notascredito");
    }
}
