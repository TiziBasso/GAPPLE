@inherits LayoutComponentBase

@inject IJSRuntime JS

@using GAPPLE.Client.Extensiones
@using Microsoft.AspNetCore.Components.Authorization;
@inject AuthenticationStateProvider autenticacionProvider
@inject SesionDTO SesionDTO
@inject NavigationManager navManager
@inject NotificationService NotificationService
@inject DialogService DialogService
@inject DialogCustom DialogCustom
@inject SeguridadService SeguridadService

<AuthorizeView>
    <Authorized>
        @if (showPage)
        {
            <RadzenLayout Style="width:100vw;">
                <RadzenHeader>
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Gap="0">
                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center">
                            <RadzenSidebarToggle MouseEnter="@(() => sidebarExpanded =true)" />
                            <RadzenImage Path="./Assets/Logo_Ital.png" Style="width:11rem;" />
                        </RadzenStack>
                        <RadzenAppearanceToggle />
                        <RadzenProfileMenu>
                            <Template>
                                <RadzenLabel Text="@authenticationState.User.Identity!.Name" />
                            </Template>
                            <ChildContent>
                                @if (SesionDTO.Rol == "1")
                                {
                                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                                        <div class="top-row px-4" style="width:100%">
                                            <a @onclick="Sincronizar" href="javascript:void(0)">Sincronizar datos</a>
                                        </div>
                                        <RadzenTheme Theme="default" />
                                    </RadzenStack>
                                }

                                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                                    <div class="top-row px-4" style="width:100%">
                                        <a @onclick="CerrarSesion" href="javascript:void(0)">Salir</a>
                                    </div>
                                    <RadzenTheme Theme="default" />
                                </RadzenStack>
                            </ChildContent>
                        </RadzenProfileMenu>
                    </RadzenStack>
                </RadzenHeader>

                <RadzenSidebar @bind-Expanded="@sidebarExpanded" Responsive="false" Style="position: absolute;z-index:3;" MouseEnter="@(() => sidebarExpanded =true)" MouseLeave="@(() => sidebarExpanded =false)">
                    <RadzenStack AlignItems="AlignItems.End" Class="rz-p-2">
                        <RadzenStack>
                            <RadzenButton Icon="west" Variant="Variant.Text" ButtonStyle="ButtonStyle.Secondary" Click="@(() => sidebarExpanded = false)" />
                        </RadzenStack>
                    </RadzenStack>
                    <NavMenu />
                </RadzenSidebar>

                <RadzenBody>
                    @Body
                </RadzenBody>
                @if (sidebarExpanded)
                {
                    <div @onclick="@(() => sidebarExpanded = false)" class="rz-dialog-mask" style="position: absolute; z-index: 2"></div>
                }
            </RadzenLayout>

            <RadzenComponents />
        }
    </Authorized>
    <NotAuthorized>

        @{
            if (context.User.Identity?.IsAuthenticated != true)
                navManager.NavigateTo("/");
            else
            {
                <p class="alert alert-danger">No esta autorizado para ver esta pagina</p>
            }
        }

    </NotAuthorized>
</AuthorizeView>

@code
{
    AuthenticationState authenticationState = new(new System.Security.Claims.ClaimsPrincipal());
    bool sidebarExpanded = true, modoOscuro, showPage;

    protected override async Task OnInitializedAsync()
    {
        var autenticacionExt = (AutenticacionExtension)autenticacionProvider;
        authenticationState = await autenticacionExt.GetAuthenticationStateAsync();
        if (authenticationState.User.Identity.Name != null)
        {
            SesionDTO.IdUsuario = int.Parse(authenticationState.User.FindFirst("idUsuario")!.Value);
            SesionDTO.Rol = authenticationState.User.FindFirst("Perfil")!.Value;
            SesionDTO.Nombre = authenticationState.User.Identity.Name;
        }
        showPage = true;
    }

    private async Task CerrarSesion()
    {
        var autenticacionExt = (AutenticacionExtension)autenticacionProvider;
        await autenticacionExt.ActualizarEstadoAutenticacion(null);
        navManager.NavigateTo("/", true);
    }

    async Task Sincronizar()
    {
        if (await DialogService.Confirm("La operación de sincronización puede requerir varios minutos. ¿Continuar?", MensajesHelper.Title, new() { OkButtonText = "Sí", CancelButtonText = "No" }) == true)
        {
            DialogCustom.OpenBusyWithLoader("Sincronizando");
            var response = await SeguridadService.SincronizarTodo();
            DialogCustom.CloseDialog();
            if (response.IsSuccessStatusCode)
                NotificationService.Notify(NotificationSeverity.Success, "Datos sincronizados correctamente");
            else
                NotificationService.Notify(NotificationSeverity.Error, "Uno a más datos no pudieron ser sincronizados");
        }
    }
}