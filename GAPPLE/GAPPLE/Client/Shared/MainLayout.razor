@inherits LayoutComponentBase

@inject IJSRuntime JS

@using GAPPLE.Client.Extensiones
@using Microsoft.AspNetCore.Components.Authorization;
@inject AuthenticationStateProvider autenticacionProvider
@inject NavigationManager navManager

<AuthorizeView>
    <Authorized>

        <RadzenLayout Style="width:100vw;">
            <RadzenHeader>
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Gap="0">
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center">
                        <RadzenSidebarToggle Click="@(() => sidebarExpanded = !sidebarExpanded)" />
                        <RadzenImage Path="./Assets/Logo_Ital.png" Style="width:11rem;" />
                    </RadzenStack>
                    <RadzenProfileMenu>
                        <Template>
                            <RadzenLabel Text="ADMIN" />
                        </Template>
                        <ChildContent>
                            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                                <div class="top-row px-4">
                                    <a @onclick="CerrarSesion" href="javascript:void(0)">Salir</a>
                                </div>
                                @* <RadzenLabel Text="Modo oscuro:" /> *@
                                @* <RadzenSwitch @bind-Value="modoOscuro" Change=@(args => CambiarTema(args)) /> *@
                                <RadzenTheme Theme="default" />
                            </RadzenStack>
                        </ChildContent>
                    </RadzenProfileMenu>
                </RadzenStack>
            </RadzenHeader>
            <RadzenSidebar @bind-Expanded="@sidebarExpanded" Responsive="false" Style="position: absolute;z-index:3;">
                <RadzenStack AlignItems="AlignItems.End" Class="rz-p-2">
                    <RadzenStack>
                        <RadzenButton Icon="west" Variant="Variant.Text" ButtonStyle="ButtonStyle.Secondary" Click="@(() => sidebarExpanded = false)" />
                    </RadzenStack>
                </RadzenStack>
                <NavMenu />
            </RadzenSidebar>

            <RadzenBody>
                @Body
            </RadzenBody>
            @if (sidebarExpanded)
            {
                <div @onclick="@(() => sidebarExpanded = false)" class="rz-dialog-mask" style="position: absolute; z-index: 2"></div>
            }
        </RadzenLayout>

        <RadzenComponents />
    </Authorized>
</AuthorizeView>

@code
{
    bool sidebarExpanded = true, modoOscuro;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {

    }

    private async Task CerrarSesion()
    {
        var autenticacionExt = (AutenticacionExtension)autenticacionProvider;
        await autenticacionExt.ActualizarEstadoAutenticacion(null);
        navManager.NavigateTo("/", true);
    }
}