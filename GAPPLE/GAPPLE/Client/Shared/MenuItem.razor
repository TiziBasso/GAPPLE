@inject ContextMenuService ContextMenuService
@inject SeguridadService SeguridadService
@inject NavigationManager NavigationManager
@inject NotificationService NotificationService
@inject IJSRuntime JS

@if (Menu.Items == null)
{
    @if (Menu.IdPadre == 1)
    {
        <li id="@Menu.Id" data-nodoActivo="0" @onclick="@(args => OnClickLI(args))" @oncontextmenu="@(args => OnCellContextMenu(args))" @oncontextmenu:preventDefault="true">
            <a style="display: flex;gap: 5px;text-decoration:none" href="@Menu.Path">
                @if (!string.IsNullOrEmpty(Menu.Icon))
                {
                    <RadzenIcon Icon="@Menu.Icon" />
                }
                @Menu.Text
            </a>
        </li>
    }
    else
    {
        <li data-nodoActivo="0" data-nodoVisible="0" id="@Menu.Id" @onclick="@OnClickLI" @oncontextmenu="@(args => OnCellContextMenu(args))" @oncontextmenu:preventDefault="true">
            <a style="display: flex;gap: 5px;font-weight:400;text-decoration:none" href="@Menu.Path">
                @if (!string.IsNullOrEmpty(Menu.Icon))
                {
                    <RadzenIcon Icon="@Menu.Icon" />
                }
                @Menu.Text
            </a>
        </li>
    }
}
else
{
    @if (Menu.IdPadre == 1)
    {
        <li id="@Menu.Id" expand="0" @onclick="@OnClickA">
            @if (!string.IsNullOrEmpty(Menu.Icon))
            {
                <RadzenIcon Icon="@Menu.Icon" />
            }
            <div style="width: 100%;display: flex;justify-content: space-between;">
                @Menu.Text
                <RadzenIcon Icon="keyboard_arrow_down" id="@("icon" + Menu.Id)" />
            </div>
        </li>
    }
    else
    {
        <li data-nodoActivo="0" expand="0" data-nodoVisible="0" id="@Menu.Id" @onclick="@OnClickA">
            @if (!string.IsNullOrEmpty(Menu.Icon))
            {
                <RadzenIcon Icon="@Menu.Icon" />
            }
            <div style="width: 100%;display: flex;justify-content: space-between;">
                @Menu.Text
                <RadzenIcon Icon="keyboard_arrow_down" id="@("icon" + Menu.Id)" />
            </div>
        </li>
    }
    <ul>
        @foreach (var item in Menu.Items)
        {
            <MenuItem Menu=@item />
        }
    </ul>
}

@code {
    [Parameter] public MenuNew Menu { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && Menu.IdPadre == 1)
        {
            var uri = new Uri(NavigationManager.Uri);
            await JS.InvokeVoidAsync("BuscarNodoActivo", uri.AbsolutePath);
        }
    }

    async Task OnClickLI(MouseEventArgs args)
    {
        if (Menu.IdPadre != 1)
            await JS.InvokeVoidAsync("ActivarNodoMenu", Menu.Id);

        if (Menu.Items != null && Menu.Items.Any())
            await JS.InvokeVoidAsync("ExpandirMenu", Menu.Id);
    }

    async Task OnClickA()
    {
        if (Menu.IdPadre != 1)
            await JS.InvokeVoidAsync("ActivarNodoMenu", Menu.Id);

        if (Menu.Items.Any())
            await JS.InvokeVoidAsync("ExpandirMenu", Menu.Id);
    }

