@using Microsoft.AspNetCore.Components.Authorization
@using GAPPLE.Client.Extensiones
@inject SeguridadService SeguridadService
@inject AuthenticationStateProvider autenticacionProvider
@inject IJSRuntime js

<RadzenPanelMenu Style="overflow-y: hidden;width: 100%;height: calc(100% - 52px);" Multiple=false >
    <ChildContent>
        @if (data != null)
        {
            <RadzenStack Orientation="Orientation.Horizontal" Gap="0">

                <input type="text" @bind-value="@filterDescripcion" @bind-value:event="oninput" @onkeydown=@(args=>OnKeyDown(args))
                class="rz-textbox rz-mb-2 rz-ml-2" style="width: 95%" placeholder="Buscar en el menu..." autocomplete=off />

                <RadzenIcon Icon="clear" Visible=@(!string.IsNullOrWhiteSpace(filterDescripcion)) @onclick=@(()=>Reset()) class="ClearButton" />
            </RadzenStack>

            <div id="menuMio">
                <ul id="padreMenu" style="overflow-x:hidden;overflow-y:auto;height:calc(100vh - 96px);">
                    @foreach (var menu in Filter(filterDescripcion))
                    {
                        <MenuItem Menu="@menu" />
                    }
                </ul>
            </div>
        }
    </ChildContent>
</RadzenPanelMenu>

@code {
    // [Parameter] EventCallback 
    List<MenuNew> data { get; set; }
    string filterDescripcion = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        var autenticacionExt = (AutenticacionExtension)autenticacionProvider;
        var auth = await autenticacionExt.GetAuthenticationStateAsync();
        data = await SeguridadService.GetMenu(int.Parse(auth.User.FindFirst("IdUsuario")?.Value));
    }

    private void OnKeyDown(KeyboardEventArgs args)
    {
        if (args.Code == KeyboardKeys.Space) filterDescripcion += " ";
    }

    private void Reset()
    {
        filterDescripcion = null;
    }

    public List<MenuNew> Filter(string term)
    {
        if (string.IsNullOrEmpty(term)) return data[0].Items;

        bool contains(string value) => value != null && value.Contains(term, StringComparison.OrdinalIgnoreCase);

        bool filter(MenuNew menu) => contains(menu.Text);

        bool deepFilter(MenuNew menu) => filter(menu) || menu.Items?.Any(m => deepFilter(m)) == true;

        return data[0].Items.Where(menu => menu.Items?.Any(deepFilter) == true || filter(menu))
                       .Select(menu => new MenuNew
                           {
                               Id = menu.Id,
                               IdPadre = menu.IdPadre,
                               Text = menu.Text,
                               Path = menu.Path,
                               Icon = menu.Icon,
                               Expanded = true,
                               Items = filter(menu) ? menu.Items : menu.Items?.Where(deepFilter).Select(m => new MenuNew
                               {
                                   Id = m.Id,
                                   IdPadre = m.IdPadre,
                                   Text = m.Text,
                                   Path = m.Path,
                                   Icon = m.Icon,
                                   Expanded = true,
                                   Items = filter(m) ? m.Items : m.Items?.Where(deepFilter).ToList()
                               }).ToList()
                           }).ToList();
    }

    // private bool collapseNavMenu = true;

    // private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    // private void ToggleNavMenu()
    // {
    //     collapseNavMenu = !collapseNavMenu;
    // }
}

