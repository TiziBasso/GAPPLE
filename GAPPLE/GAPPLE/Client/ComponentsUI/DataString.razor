<RadzenDataGrid TItem="string" Data="Data" Style="height:100%; width:100%" Density=Density.Compact
                AllowFiltering=false AllowSorting=true>
    <Columns>
        <RadzenDataGridColumn TItem="string" Title=@Title TextAlign="@TextAlign">
            <Template>
                @context
            </Template>
        </RadzenDataGridColumn>
    </Columns>
    <EmptyTemplate>
        <p style="color: lightgrey; font-size: 24px; text-align: center; margin: 2rem;">No hay registros para mostrar.</p>
    </EmptyTemplate>
</RadzenDataGrid>

@code {
    [Parameter] public List<string> Data { get; set; } = new();
    [Parameter] public string Title { get; set; } = "Nombre";
    [Parameter] public TextAlign TextAlign { get; set; } = TextAlign.Left;
}
