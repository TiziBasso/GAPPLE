<RadzenDataGrid TItem="StringItem" Data="Items" Density="Density.Compact" Style="height:100%; width:100%;"
                AllowFiltering="false" AllowSorting="true" ShowEmptyMessage="false">
    <Columns>
        <RadzenDataGridColumn Property="@nameof(StringItem.Value)" Title=@Title TextAlign="@TextAlign" />
    </Columns>
</RadzenDataGrid>

@code {
    [Parameter] public List<string> Data { get; set; }
    [Parameter] public string Title { get; set; } = "Nombre";
    [Parameter] public TextAlign TextAlign { get; set; } = TextAlign.Left;

    List<StringItem> Items = [];

    protected override void OnInitialized()
    {
        Data.ForEach(x => Items.Add(new StringItem(x)));
    }

    private class StringItem
    {
        public StringItem(string s)
        {
            Value = s;
        }

        public string Value { get; set; }
    }
}
