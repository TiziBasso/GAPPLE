@using System.IO
@using GAPPLE.Shared.Helpers
@using Microsoft.AspNetCore.Components.Forms
@using System.Linq.Expressions

@inject NotificationService NotificationService
@inject RadzenDialogService RadzenDialogService


<RadzenStack Orientation=Orientation.Vertical JustifyContent="JustifyContent.Center" AlignItems="AlignItems.Center">
	<div class="@("rz-fileupload " + (disabled ? "rz-state-empty " : null) + _fieldCssClasses)" @attributes="AdditionalAttributes">
		<div class="rz-fileupload-buttonbar" style="text-align:center;">
			<span class="rz-fileupload-choose rz-button rz-secondary" style="display:block">
				<InputFile OnChange="CargarArchivo"
						   AdditionalAttributes=@(new Dictionary<string, object>() { { "accept", Accept }, { "style", "display:block;width:100%;height:100%;" } }) />
				<span class="rz-button-text" style="padding:10px">Seleccionar archivo</span>
			</span>
		</div>
		<div class="rz-fileupload-content rz-corner-bottom">
			<div class="rz-fileupload-files">
				<div class="rz-fileupload-row">
					<div>
						<span>@NombreArchivo</span>
					</div>

					<div tabindex="0">
						<RadzenButton Click="@Reset" title="Borrar" Size="ButtonSize.Small" Icon="close" ButtonStyle="ButtonStyle.Light" Disabled=@disabled />
					</div>
				</div>
			</div>
		</div>
	</div>
</RadzenStack>

@code {
	[CascadingParameter] private EditContext EditContext { get; set; }
	[Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object> AdditionalAttributes { get; set; }

	/// <summary>
	/// Especifica los tipos de archivos permitidos para la operación.
	/// Se pueden combinar múltiples valores utilizando operadores bitwise (|).
	/// </summary>
	/// <value>Por defecto: <see cref="FileTypes.XLSX"/>.</value>
	[Parameter] public FilesHelper.Types AcceptedTypes { get; set; } = FilesHelper.Types.XLSX;
	/// <summary>
	/// Tamaño máximo de archivo permitido en bytes.
	/// Se divide 2 veces por 1024 para el mensaje de error;
	/// </summary>
	/// <value>Por defecto 5242880, 5MB.</value>
	[Parameter] public long MaxSize { get; set; } = 5242880;

	/// <summary>
	/// Atributo para el FileInput, en el dialog muestra solo estos archivos inicialmente.
	/// </summary>
	/// <value>Por defecto ".xlsx", para más de uno van separados por ','</value>
	[Parameter] public string Accept { get; set; }
	/// <summary>
	/// El tipo de archivo que se ingresó
	/// </summary>
#pragma warning disable BL0007 // Component parameter should be a simple type
	[Parameter]
	public FilesHelper.Types Type
	{
		get => _type;
		set
		{
			if (value == _type)
				return;
			_type = value;
			if (TypeChanged.HasDelegate)
				TypeChanged.InvokeAsync(_type);
		}
	}
	[Parameter] public EventCallback<FilesHelper.Types> TypeChanged { get; set; }
	private FilesHelper.Types _type;

	[Parameter]
	public string NombreArchivo
	{
		get => _nombreArchivo;
		set
		{
			if (value == _nombreArchivo)
				return;
			_nombreArchivo = value;
			if (NombreArchivoChanged.HasDelegate)
				NombreArchivoChanged.InvokeAsync(_nombreArchivo);
		}
	}
	[Parameter] public EventCallback<string> NombreArchivoChanged { get; set; }
	string _nombreArchivo;

	/// <summary>
	/// Sobreescribe la manera en la que se guarda el byteFile, en caso de tener valor se ejecuta luego de las validaciones de tipo y peso
	/// </summary>
	[Parameter] public EventCallback<InputFileChangeEventArgs> OnCargaArchivo { get; set; }

	[Parameter]
	public IBrowserFile FileValue
	{
		get => browserFile;
		set
		{
			if (value == browserFile)
				return;
			browserFile = value;
			if (FileValueChanged.HasDelegate)
				FileValueChanged.InvokeAsync(browserFile);
		}
	}
	[Parameter] public EventCallback<IBrowserFile> FileValueChanged { get; set; }
	[Parameter] public Expression<Func<IBrowserFile>> FileValueExpression { get; set; }
	[Parameter]
	public byte[] Value
	{
		get => bytesFile;
		set
		{
			if (value == bytesFile)
				return;
			bytesFile = value;
			if (ValueChanged.HasDelegate)
				ValueChanged.InvokeAsync(bytesFile);
		}
	}
#pragma warning restore BL0007 // Component parameter should be a simple type

	[Parameter] public EventCallback<byte[]> ValueChanged { get; set; }
	[Parameter] public Expression<Func<byte[]>> ValueExpression { get; set; }

	private IBrowserFile browserFile = null;
	private byte[] bytesFile = null;

	FieldIdentifier _fieldIdentifier;
	string _fieldCssClasses => EditContext?.FieldCssClass(_fieldIdentifier) ?? "";
	bool disabled => (Value == null && FileValue == null);

	protected override void OnInitialized()
	{
		Accept = string.Join(",", AcceptedTypes.GetDisplayDescription());

		if (ValueExpression != null)
			_fieldIdentifier = FieldIdentifier.Create(ValueExpression);
		else if (FileValueExpression != null)
			_fieldIdentifier = FieldIdentifier.Create(FileValueExpression);
		else
			_fieldIdentifier = default;
	}

	private async Task CargarArchivo(InputFileChangeEventArgs e)
	{
		try
		{
			RadzenDialogService.OpenBusyWithLoader("Cargando archivo...");
			if (!AcceptedTypes.HasFlag(FilesHelper.GetTypeFromMime(e.File.ContentType)))
			{
				NotificationService.Notify(NotificationSeverity.Error, MensajesHelper.ErrorFileType);
				return;
			}
			else
				Type = FilesHelper.GetTypeFromMime(e.File.ContentType);

			if (e.File.Size > MaxSize)
			{
				string mb = ((MaxSize / 1024) / 1024).ToString() + "MB";
				NotificationService.Notify(NotificationSeverity.Error, MensajesHelper.ErrorFileSize(mb));
				return;
			}

			var file = e.File;
			NombreArchivo = file.Name;

			if (OnCargaArchivo.HasDelegate)
				await OnCargaArchivo.InvokeAsync(e);
			else if (FileValueChanged.HasDelegate)
				FileValue = file;
			else if (ValueChanged.HasDelegate)
			{
				var fileContent = new StreamContent(e.File.OpenReadStream());
				byte[] bytes = await fileContent.ReadAsByteArrayAsync();
				Value = bytes;
			}

			EditContext?.NotifyFieldChanged(_fieldIdentifier);
		}
		catch (Exception ex)
		{
			Console.WriteLine(ex.ToString());
			NotificationService.Notify(NotificationSeverity.Error, MensajesHelper.ErrorSummary500, MensajesHelper.ErrorDetail500);
		}
		finally
		{
			RadzenDialogService.CloseDialog();
		}
	}

	public void Reset()
	{
		Value = null;
		FileValue = null;
		NombreArchivo = null;
		EditContext?.NotifyFieldChanged(_fieldIdentifier);
	}
}