@typeparam TItem

@if (!string.IsNullOrEmpty(Message))
{
    <div class="validation-tooltip">@Message</div>
}

@code {
    [Parameter] public TItem Item { get; set; }
    [Parameter] public Func<TItem, string> Validate { get; set; }

    private string Message { get; set; }

    protected override void OnParametersSet()
    {
        if (Validate != null)
        {
            Message = Validate(Item);
        }
    }
}

<style>
    .validation-tooltip {
        position: absolute;
        margin-top: 1px;
        padding: 5px;
        background-color: #f44336;
        color: white;
        border-radius: 5px;
        font-size: 12px;
        z-index: 1000;
        white-space: nowrap;
    }
</style>
