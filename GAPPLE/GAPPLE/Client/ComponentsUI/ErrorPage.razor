<div style="margin:0;display:flex;height:100%;justify-content:center;align-items:center;">
	<div style="justify-content: center;display: flex;align-items: center;">
		<img style="width:15vw;" src="./assets/ErrorPrecaucion.svg" />
		@switch (Flag)
		{
			case "unavailable":
				<h1 style="margin:0;padding:0;">La página a la que intentó entrar no está disponible</h1>
				break;
			case "unconfigured":
				<h1 style="margin:0;padding:0;">No se ha seleccionado una sucursal activa. Por favor, elija una para continuar.</h1>
				break;
			case "invalid":
				<h1 style="margin:0;padding:0;">La página solicitada no es válida o no existe</h1>
				break;
			case "usernotfound":
				<h1 style="margin:0;padding:0;">El usuario no se encuentra habilitado</h1>
				break;
			case "terminal":
				<h1 style="margin:0;padding:0;">La sucursal activa seleccionada no está habilitada para esta operación. Por favor, elija otra para continuar.</h1>
				break;
			default:
				<h1 stle="margin:0;padding:0;">La página a la que intentó entrar no está disponible</h1>
				<h1 style="margin:0;padding:0;text-align:center;">o no está autorizado para verla</h1>
				break;
		}
	</div>
</div>

@code {
	[Parameter] public string Flag { get; set; }
}